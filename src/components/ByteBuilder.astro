---
// Interactive 8-bit place-value row: tapping a tile flips it between 0 and 1,
// and the decimal total below updates live from the values of the lit tiles.
//
// This tool is a cheat vector while the Practice quiz is active (a student
// could flip these tiles to match the quiz's current byte and read the
// answer off the total), so the page hides the whole "Try It Yourself"
// section during that time rather than this component locking itself — see
// the inline script at the bottom of reading-a-byte.astro.
const bitCount = 8;
const values = Array.from({ length: bitCount }, (_, i) => 2 ** (bitCount - 1 - i));
---

<div class="byte-builder" data-values={JSON.stringify(values)}>
	<p class="byte-builder-hint">Tap a tile to flip it.</p>
	<div class="pv-tiles">
		{
			values.map((value, i) => (
				<div class="pv-tile-col">
					<span class="pv-value-label">{value}</span>
					<button
						type="button"
						class="pv-tile pv-tile-btn"
						data-value="0"
						data-index={i}
						aria-pressed="false"
						aria-label={`Bit worth ${value}, currently 0, tap to flip`}
					>
						0
					</button>
				</div>
			))
		}
	</div>
	<p class="byte-builder-total">
		<span class="byte-builder-total-label">Decimal value</span>
		<span class="byte-builder-total-value" data-total>0</span>
	</p>
</div>

<script>
	document.querySelectorAll<HTMLElement>(".byte-builder").forEach((root) => {
		const values = JSON.parse(root.dataset.values ?? "[]") as number[];
		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>(".pv-tile-btn"));
		const totalEl = root.querySelector<HTMLElement>("[data-total]");

		function update() {
			const total = buttons.reduce(
				(sum, btn, i) => sum + (btn.dataset.value === "1" ? values[i] : 0),
				0,
			);
			if (totalEl) totalEl.textContent = String(total);
		}

		buttons.forEach((btn) => {
			btn.addEventListener("click", () => {
				const next = btn.dataset.value === "1" ? "0" : "1";
				btn.dataset.value = next;
				btn.textContent = next;
				btn.setAttribute("aria-pressed", next === "1" ? "true" : "false");
				btn.setAttribute(
					"aria-label",
					`Bit worth ${values[Number(btn.dataset.index)]}, currently ${next}, tap to flip`,
				);
				update();
			});
		});

		update();
	});
</script>

<style>
	.byte-builder {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1rem;
	}

	.byte-builder-hint {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.pv-tiles {
		display: flex;
		width: 100%;
		max-width: 30rem;
		gap: 0.25rem;
		justify-content: center;
	}

	.pv-tile-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		flex: 1 1 0;
		max-width: 3.4rem;
	}

	/*
	 * Squeezing all 8 tiles into one row on a narrow phone shrinks each one
	 * below a comfortable tap target (~28px). These tiles are the one bit
	 * display on the page a student actually taps, so on narrow viewports
	 * wrap them into two rows of four instead, which roughly doubles each
	 * tile's size.
	 */
	@media (max-width: 420px) {
		.pv-tiles {
			flex-wrap: wrap;
			row-gap: 0.5rem;
		}

		.pv-tile-col {
			flex: 0 1 calc(25% - 0.27rem);
			max-width: none;
		}
	}

	.pv-value-label {
		font-family: var(--font-mono);
		font-size: clamp(0.6rem, 2.4vw, 0.75rem);
		color: var(--color-text-muted);
	}

	.pv-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 18%;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1rem, 4.2vw, 1.5rem);
		color: var(--color-text-muted);
	}

	.pv-tile-btn {
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.pv-tile-btn:hover {
		border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
	}

	.pv-tile-btn:active {
		transform: scale(0.93);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.pv-tile--on,
	.pv-tile-btn[aria-pressed="true"] {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	.byte-builder-total {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.byte-builder-total-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.byte-builder-total-value {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1.4rem, 5vw, 1.8rem);
		color: #fff3d6;
		text-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}
</style>
