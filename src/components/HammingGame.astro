---
interface Props {
	bitLength: number;
	maxAttempts?: number;
}

const { bitLength, maxAttempts = 6 } = Astro.props;
const bitIndices = Array.from({ length: bitLength }, (_, i) => i);
---

<div class="hamming-game" data-bit-length={bitLength} data-max-attempts={maxAttempts}>
	<p class="toggle-hint">Tap a bit to flip it between 0 and 1, then press Guess.</p>
	<form class="guess-form">
		<div
			class="bit-toggles"
			role="group"
			aria-label={`${bitLength}-bit guess`}
			style={`--bit-count: ${bitLength}`}
		>
			{
				bitIndices.map((i) => (
					<button
						type="button"
						class="bit-toggle"
						data-value="0"
						data-index={i}
						aria-pressed="false"
						aria-label={`Bit ${i + 1}, currently 0, tap to flip`}
					>
						<svg class="bit-digit" viewBox="0 0 60 100" aria-hidden="true">
							<polygon class="segment" data-seg="a" points="8,8 14,2 46,2 52,8 46,14 14,14" />
							<polygon class="segment" data-seg="b" points="52,8 58,14 58,44 52,50 46,44 46,14" />
							<polygon class="segment" data-seg="c" points="52,50 58,56 58,86 52,92 46,86 46,56" />
							<polygon class="segment" data-seg="d" points="8,92 14,86 46,86 52,92 46,98 14,98" />
							<polygon class="segment" data-seg="e" points="8,50 14,56 14,86 8,92 2,86 2,56" />
							<polygon class="segment" data-seg="f" points="8,8 14,14 14,44 8,50 2,44 2,14" />
							<polygon class="segment" data-seg="g" points="8,50 14,44 46,44 52,50 46,56 14,56" />
						</svg>
					</button>
				))
			}
		</div>
		<button type="submit" class="guess-submit">Guess</button>
	</form>
	<p class="game-status" role="status"></p>
	<div class="game-banner" hidden>
		<p class="game-banner-main"></p>
		<p class="game-banner-flavor"></p>
	</div>
	<button type="button" class="play-again" hidden>Play Again</button>
	<div class="guess-history"></div>
</div>

<style>
	.hamming-game {
		--led-on: #ffae2e;
		--led-on-digit: #fff3d6;
		--led-off-bg: #120d09;
		--led-off-border: #2b1f16;
		--seg-ghost: #1c140f;
		--seg-dim: #4a3420;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 0.75rem 0.85rem;
	}

	.toggle-hint {
		margin: 0;
		text-align: center;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.guess-form {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.bit-toggles {
		display: flex;
		width: 100%;
		gap: 0.4rem;
		justify-content: center;
		flex-wrap: nowrap;
	}

	.bit-toggle {
		width: clamp(1.6rem, calc((100% - (var(--bit-count) - 1) * 0.4rem) / var(--bit-count)), 2.4rem);
		aspect-ratio: 1 / 1;
		height: auto;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 24%;
		border: 1px solid var(--led-off-border);
		background:
			radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.07), transparent 60%),
			var(--led-off-bg);
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.bit-digit {
		width: 68%;
		height: 68%;
		overflow: visible;
		pointer-events: none;
	}

	.segment {
		fill: var(--seg-ghost);
		transition:
			fill 0.15s ease,
			filter 0.15s ease;
	}

	.bit-toggle[data-value="0"] .segment.shape-on,
	.guess-tile[data-value="0"] .segment.shape-on {
		fill: var(--seg-dim);
	}

	.bit-toggle[data-value="1"] .segment.shape-on,
	.guess-tile[data-value="1"] .segment.shape-on {
		fill: var(--led-on-digit);
		filter:
			drop-shadow(0 0 4px var(--led-on))
			drop-shadow(0 0 10px var(--led-on));
	}

	.bit-toggle:hover {
		border-color: color-mix(in srgb, var(--led-on) 45%, var(--led-off-border));
	}

	.bit-toggle:active {
		transform: scale(0.94);
	}

	.bit-toggle[aria-pressed="true"] {
		border-color: var(--led-on);
		box-shadow:
			0 0 12px color-mix(in srgb, var(--led-on) 80%, transparent),
			0 0 26px color-mix(in srgb, var(--led-on) 55%, transparent);
	}

	.bit-toggle[aria-pressed="true"]:not(:disabled) {
		animation: bit-toggle-glow 2.4s ease-in-out infinite;
	}

	.bit-toggle:disabled {
		cursor: not-allowed;
		opacity: 0.7;
	}

	@keyframes bit-toggle-glow {
		0%,
		100% {
			box-shadow:
				0 0 10px color-mix(in srgb, var(--led-on) 65%, transparent),
				0 0 18px color-mix(in srgb, var(--led-on) 38%, transparent);
		}
		50% {
			box-shadow:
				0 0 16px color-mix(in srgb, var(--led-on) 100%, transparent),
				0 0 34px color-mix(in srgb, var(--led-on) 70%, transparent);
		}
	}

	.guess-submit {
		padding: 0.45rem 1.6rem;
		border: 1px solid var(--led-on);
		border-radius: 8px;
		background: color-mix(in srgb, var(--led-on) 18%, var(--led-off-bg));
		color: var(--led-on-digit);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		text-shadow: 0 0 6px var(--led-on);
		box-shadow:
			0 0 10px color-mix(in srgb, var(--led-on) 45%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
		transition:
			transform 0.1s ease,
			box-shadow 0.15s ease,
			background 0.15s ease,
			opacity 0.15s ease;
	}

	.guess-submit:hover {
		background: color-mix(in srgb, var(--led-on) 30%, var(--led-off-bg));
		box-shadow:
			0 0 16px color-mix(in srgb, var(--led-on) 70%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
	}

	.guess-submit:active {
		transform: scale(0.97);
	}

	.guess-submit:disabled {
		opacity: 0.4;
		cursor: not-allowed;
		transform: none;
		text-shadow: none;
		box-shadow: none;
	}

	.game-status {
		margin: 0;
		text-align: center;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		min-height: 1.1em;
	}

	.game-status--warning {
		color: var(--color-danger);
		font-weight: 600;
	}

	.game-banner {
		text-align: center;
		font-family: var(--font-mono);
		padding: 0.55rem 0.9rem;
		border-radius: 8px;
		border: 1px solid transparent;
		background: var(--led-off-bg);
	}

	.game-banner-main {
		margin: 0;
		font-weight: 700;
		font-size: clamp(0.8rem, 2.2vw, 0.95rem);
	}

	.game-banner-flavor {
		margin: 0.3rem 0 0;
		font-weight: 500;
		font-size: 0.72rem;
		opacity: 0.75;
	}

	.game-banner[hidden] {
		display: none;
	}

	.game-banner--success {
		border-color: var(--color-success);
		color: var(--color-success);
		text-shadow: 0 0 8px color-mix(in srgb, var(--color-success) 70%, transparent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-success) 30%, transparent);
	}

	.game-banner--failure {
		border-color: var(--color-danger);
		color: var(--color-danger);
		text-shadow: 0 0 8px color-mix(in srgb, var(--color-danger) 70%, transparent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-danger) 30%, transparent);
	}

	.play-again {
		align-self: center;
		padding: 0.35rem 1.2rem;
		border: 1px solid var(--led-on);
		border-radius: 8px;
		background: var(--led-off-bg);
		color: var(--led-on);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		box-shadow: 0 0 8px color-mix(in srgb, var(--led-on) 35%, transparent);
		transition:
			background 0.15s ease,
			color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.play-again:hover {
		background: color-mix(in srgb, var(--led-on) 22%, var(--led-off-bg));
		color: var(--led-on-digit);
		text-shadow: 0 0 6px var(--led-on);
		box-shadow: 0 0 14px color-mix(in srgb, var(--led-on) 60%, transparent);
		transform: translateY(-1px);
	}

	.play-again[hidden] {
		display: none;
	}

	.guess-history {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.guess-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		flex-wrap: wrap;
		padding: 0.2rem 0.15rem;
		border-bottom: 1px solid var(--color-border);
	}

	.guess-row:last-child {
		border-bottom: none;
	}

	.guess-tiles {
		display: flex;
		gap: 0.25rem;
		flex-wrap: wrap;
	}

	.guess-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(1.4rem, 7vw, 1.8rem);
		height: clamp(1.4rem, 7vw, 1.8rem);
		border-radius: 22%;
		border: 1px solid var(--led-off-border);
		background:
			radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.06), transparent 60%),
			var(--led-off-bg);
	}

	.guess-tile--on {
		border-color: var(--led-on);
		animation: tile-throb 3s ease-in-out infinite;
	}

	@keyframes tile-throb {
		0%,
		100% {
			box-shadow: 0 0 6px color-mix(in srgb, var(--led-on) 65%, transparent);
		}
		50% {
			box-shadow: 0 0 15px color-mix(in srgb, var(--led-on) 90%, transparent);
		}
	}

	.distance-badge {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--badge-color, var(--color-border));
		color: var(--badge-color, var(--color-text-muted));
		background: color-mix(in srgb, var(--badge-color, var(--color-text-muted)) 24%, transparent);
		white-space: nowrap;
	}

	.distance-badge--match {
		animation: badge-pop 0.35s ease;
	}

	@keyframes badge-pop {
		0% {
			transform: scale(0.8);
			opacity: 0.4;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@media (max-width: 420px) {
		.guess-row {
			justify-content: flex-start;
		}
	}
</style>

<script>
	// Flavor-text pools. Shared here so a future "Share Result" feature can reuse the
	// same selection logic and reproduce exactly what the player saw on screen.
	const WIN_FLAVOR_TEXT: Record<number, string[]> = {
		1: [
			"Lucky guess, or are you secretly the Oracle from The Matrix?",
			"One shot. Thanos would be proud.",
			"Either incredible instinct or you peeked. We won't ask.",
		],
		2: [
			"Fast. Suspiciously fast.",
			"That's faster than your WiFi reconnecting after a power cut.",
			"Sherlock Holmes could not have deduced it quicker.",
		],
		3: [
			"Solid. A modern CPU would be jealous of that clock speed.",
			"Efficient. Very 'best practices.'",
			"Clean solve. Textbook, almost.",
		],
		4: [
			"Respectable. Somewhere between a smartphone and a calculator, speed-wise.",
			"Good work — you'd survive a technical interview.",
			"R2-D2 would beep approvingly.",
		],
		5: [
			"You're slower than a Commodore 64 loading a game from tape.",
			"Getting there — like buffering on old YouTube.",
			"That's the scenic route, but you made it.",
		],
		6: [
			"Down to the wire — dial-up modem energy.",
			"Nail-biter. Respect for not giving up.",
			"Right under the wire — like finishing an exam as time's called.",
		],
	};

	const LOSS_FLAVOR_TEXT: string[] = [
		"Out of attempts. Even dial-up would've gotten there eventually.",
		"No dice. Time to reboot and try again.",
		"The signal was lost. Try recalibrating.",
		"Not today — even HAL 9000 has off days.",
		"Connection timed out. Give it another shot.",
		"System failure. Blame the hardware, not yourself.",
		"You've been disconnected. Try reconnecting.",
	];

	function pickRandom<T>(items: T[]): T {
		return items[Math.floor(Math.random() * items.length)];
	}

	function winFlavorText(attempts: number): string {
		const bucketKey = Math.min(Math.max(attempts, 1), 6);
		return pickRandom(WIN_FLAVOR_TEXT[bucketKey] ?? WIN_FLAVOR_TEXT[6]);
	}

	function lossFlavorText(): string {
		return pickRandom(LOSS_FLAVOR_TEXT);
	}

	function randomBinaryString(length: number): string {
		let result = "";
		for (let i = 0; i < length; i++) {
			result += Math.random() < 0.5 ? "0" : "1";
		}
		return result;
	}

	function attemptsLeftLabel(remaining: number): string {
		return `${remaining} attempt${remaining === 1 ? "" : "s"} left`;
	}

	function hammingDistance(a: string, b: string): number {
		let distance = 0;
		for (let i = 0; i < a.length; i++) {
			if (a[i] !== b[i]) distance++;
		}
		return distance;
	}

	function distanceColor(distance: number, bitLength: number): string {
		// distance ranges 1..bitLength here (0 is handled separately as a match).
		// Map the closest miss to a warm yellow-green and the farthest to a cool violet-blue,
		// so every step in between is a clearly distinct hue rather than clustering in one band.
		const steps = Math.max(bitLength - 1, 1);
		const t = (distance - 1) / steps;
		const hue = 90 + t * (250 - 90);
		return `hsl(${hue}deg 85% 58%)`;
	}

	function getScopeAttr(root: HTMLElement): string | null {
		return root.getAttributeNames().find((name) => name.startsWith("data-astro-cid")) ?? null;
	}

	function createScopedElement<K extends keyof HTMLElementTagNameMap>(
		tag: K,
		className: string,
		scopeAttr: string | null,
	): HTMLElementTagNameMap[K] {
		const el = document.createElement(tag);
		el.className = className;
		if (scopeAttr) el.setAttribute(scopeAttr, "");
		return el;
	}

	const SVG_NS = "http://www.w3.org/2000/svg";

	const SEGMENT_POINTS: Record<string, string> = {
		a: "8,8 14,2 46,2 52,8 46,14 14,14",
		b: "52,8 58,14 58,44 52,50 46,44 46,14",
		c: "52,50 58,56 58,86 52,92 46,86 46,56",
		d: "8,92 14,86 46,86 52,92 46,98 14,98",
		e: "8,50 14,56 14,86 8,92 2,86 2,56",
		f: "8,8 14,14 14,44 8,50 2,44 2,14",
		g: "8,50 14,44 46,44 52,50 46,56 14,56",
	};

	const SEGMENTS_BY_DIGIT: Record<string, string[]> = {
		"0": ["a", "b", "c", "d", "e", "f"],
		"1": ["b", "c"],
	};

	function applyDigit(root: Element, value: string) {
		const active = new Set(SEGMENTS_BY_DIGIT[value] ?? []);
		root.querySelectorAll<SVGPolygonElement>(".segment").forEach((segment) => {
			const segId = segment.getAttribute("data-seg");
			segment.classList.toggle("shape-on", segId !== null && active.has(segId));
		});
	}

	function createBitDigitSvg(scopeAttr: string | null): SVGSVGElement {
		const svg = document.createElementNS(SVG_NS, "svg") as unknown as SVGSVGElement;
		svg.setAttribute("viewBox", "0 0 60 100");
		svg.setAttribute("aria-hidden", "true");
		svg.setAttribute("class", "bit-digit");
		if (scopeAttr) svg.setAttribute(scopeAttr, "");
		for (const [seg, points] of Object.entries(SEGMENT_POINTS)) {
			const polygon = document.createElementNS(SVG_NS, "polygon");
			polygon.setAttribute("points", points);
			polygon.setAttribute("data-seg", seg);
			polygon.setAttribute("class", "segment");
			if (scopeAttr) polygon.setAttribute(scopeAttr, "");
			svg.appendChild(polygon);
		}
		return svg;
	}

	function initGame(root: HTMLElement) {
		const bitLength = Number(root.dataset.bitLength);
		const maxAttempts = Number(root.dataset.maxAttempts);
		const scopeAttr = getScopeAttr(root);

		const form = root.querySelector<HTMLFormElement>(".guess-form")!;
		const toggles = Array.from(root.querySelectorAll<HTMLButtonElement>(".bit-toggle"));
		const submitButton = root.querySelector<HTMLButtonElement>(".guess-submit")!;
		const status = root.querySelector<HTMLParagraphElement>(".game-status")!;
		const banner = root.querySelector<HTMLDivElement>(".game-banner")!;
		const bannerMain = banner.querySelector<HTMLParagraphElement>(".game-banner-main")!;
		const bannerFlavor = banner.querySelector<HTMLParagraphElement>(".game-banner-flavor")!;
		const playAgainButton = root.querySelector<HTMLButtonElement>(".play-again")!;
		const history = root.querySelector<HTMLDivElement>(".guess-history")!;

		let secret = randomBinaryString(bitLength);
		let attempts = 0;
		let gameOver = false;
		const previousGuesses = new Set<string>();

		function setStatus(text: string, isWarning = false) {
			status.textContent = text;
			status.classList.toggle("game-status--warning", isWarning);
		}

		function toggleBit(button: HTMLButtonElement) {
			if (gameOver) return;
			const nextValue = button.dataset.value === "0" ? "1" : "0";
			button.dataset.value = nextValue;
			applyDigit(button, nextValue);
			button.setAttribute("aria-pressed", nextValue === "1" ? "true" : "false");
			button.setAttribute(
				"aria-label",
				`Bit ${Number(button.dataset.index) + 1}, currently ${nextValue}, tap to flip`,
			);
		}

		function currentGuess(): string {
			return toggles.map((t) => t.dataset.value).join("");
		}

		function resetToggles() {
			for (const toggle of toggles) {
				toggle.dataset.value = "0";
				applyDigit(toggle, "0");
				toggle.setAttribute("aria-pressed", "false");
				toggle.setAttribute("aria-label", `Bit ${Number(toggle.dataset.index) + 1}, currently 0, tap to flip`);
			}
		}

		function renderGuessRow(guess: string, distance: number) {
			const row = createScopedElement("div", "guess-row", scopeAttr);

			const tiles = createScopedElement("div", "guess-tiles", scopeAttr);
			for (const bit of guess) {
				const tile = createScopedElement(
					"span",
					bit === "1" ? "guess-tile guess-tile--on" : "guess-tile",
					scopeAttr,
				);
				tile.setAttribute("data-value", bit);
				tile.appendChild(createBitDigitSvg(scopeAttr));
				applyDigit(tile, bit);
				tiles.appendChild(tile);
			}

			const badge = createScopedElement("span", "distance-badge", scopeAttr);
			if (distance === 0) {
				badge.classList.add("distance-badge--match");
				badge.style.setProperty("--badge-color", "var(--color-success)");
				badge.textContent = "Match!";
			} else {
				badge.style.setProperty("--badge-color", distanceColor(distance, bitLength));
				badge.textContent = `${distance} bit${distance === 1 ? "" : "s"} off`;
			}

			row.appendChild(tiles);
			row.appendChild(badge);
			history.prepend(row);
		}

		function showBanner(kind: "success" | "failure", text: string, flavor: string) {
			bannerMain.textContent = text;
			bannerFlavor.textContent = flavor;
			banner.className = `game-banner game-banner--${kind}`;
			banner.hidden = false;
		}

		function endGame(won: boolean) {
			gameOver = true;
			for (const toggle of toggles) toggle.disabled = true;
			submitButton.disabled = true;
			setStatus("");
			if (won) {
				showBanner(
					"success",
					`You matched it in ${attempts} guess${attempts === 1 ? "" : "es"}!`,
					winFlavorText(attempts),
				);
			} else {
				showBanner("failure", `Out of attempts. The answer was ${secret}.`, lossFlavorText());
			}
			playAgainButton.hidden = false;
		}

		function resetGame() {
			secret = randomBinaryString(bitLength);
			attempts = 0;
			gameOver = false;
			previousGuesses.clear();
			history.replaceChildren();
			resetToggles();
			for (const toggle of toggles) toggle.disabled = false;
			submitButton.disabled = false;
			banner.hidden = true;
			bannerMain.textContent = "";
			bannerFlavor.textContent = "";
			playAgainButton.hidden = true;
			setStatus(`${attemptsLeftLabel(maxAttempts)}. Tap bits to set your first guess.`);
		}

		function submitGuess(event: SubmitEvent) {
			event.preventDefault();
			if (gameOver) return;

			const guess = currentGuess();

			if (previousGuesses.has(guess)) {
				setStatus("You've already tried this combination.", true);
				return;
			}

			previousGuesses.add(guess);
			attempts++;
			const distance = hammingDistance(guess, secret);
			renderGuessRow(guess, distance);
			resetToggles();

			if (distance === 0) {
				endGame(true);
				return;
			}

			if (attempts >= maxAttempts) {
				endGame(false);
				return;
			}

			setStatus(attemptsLeftLabel(maxAttempts - attempts));
		}

		resetToggles();

		for (const toggle of toggles) {
			toggle.addEventListener("click", () => toggleBit(toggle));
		}
		form.addEventListener("submit", submitGuess);
		playAgainButton.addEventListener("click", resetGame);
		setStatus(`${attemptsLeftLabel(maxAttempts)}. Tap bits to set your first guess.`);
	}

	document.querySelectorAll<HTMLElement>(".hamming-game").forEach(initGame);
</script>
