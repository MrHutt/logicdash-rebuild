---
// Small decorative icon shown at the top of each card on the /learn hub —
// built entirely from the site's tile visual language plus simple CSS/SVG
// lines, one bespoke arrangement per topic. Purely cosmetic (no links or
// interactivity), so this stays a plain server-rendered component — unlike
// ByteBuilder/PracticeQuiz, nothing here is built via client-side innerHTML,
// so ordinary Astro-scoped styles apply fine.
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<div class="topic-icon" aria-hidden="true">
	{
		href === "/learn/what-is-binary" && (
			<span class="ti-flip">
				<span class="ti-tile ti-flip-face ti-flip-face--a">0</span>
				<span class="ti-tile ti-tile--on ti-flip-face ti-flip-face--b">1</span>
			</span>
		)
	}
	{
		href === "/learn/counting-in-binary" && (
			<div class="ti-rollover">
				<div class="ti-row">
					<span class="ti-tile">0</span>
					<span class="ti-tile ti-tile--on">1</span>
					<span class="ti-tile ti-tile--on">1</span>
				</div>
				<span class="ti-rollover-arrow">↓</span>
				<div class="ti-row">
					<span class="ti-tile ti-tile--on">1</span>
					<span class="ti-tile">0</span>
					<span class="ti-tile">0</span>
				</div>
			</div>
		)
	}
	{
		href === "/learn/hamming-distance" && (
			<div class="ti-hamming">
				<div class="ti-row">
					<span class="ti-tile ti-tile--on">1</span>
					<span class="ti-tile">0</span>
					<span class="ti-tile ti-tile--on">1</span>
					<span class="ti-tile">0</span>
				</div>
				<div class="ti-row">
					<span class="ti-tile ti-tile--on">1</span>
					<span class="ti-tile">0</span>
					<span class="ti-tile ti-tile--diff">0</span>
					<span class="ti-tile">0</span>
				</div>
			</div>
		)
	}
	{
		href === "/learn/bits-and-bytes" && (
			<div class="ti-row ti-row--byte">
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile">0</span>
			</div>
		)
	}
	{
		href === "/learn/reading-a-byte" && (
			<div class="ti-place-values">
				<div class="ti-pv-col">
					<span class="ti-pv-label">4</span>
					<span class="ti-tile ti-tile--on">1</span>
				</div>
				<div class="ti-pv-col">
					<span class="ti-pv-label">2</span>
					<span class="ti-tile">0</span>
				</div>
				<div class="ti-pv-col">
					<span class="ti-pv-label">1</span>
					<span class="ti-tile ti-tile--on">1</span>
				</div>
			</div>
		)
	}
	{
		href === "/learn/writing-a-byte" && (
			<div class="ti-division">
				<span class="ti-division-num">13</span>
				<span class="ti-division-arrow">↓</span>
				<span class="ti-division-num">6</span>
			</div>
		)
	}
	{
		href === "/learn/error-correction" && (
			<div class="ti-row">
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile ti-tile--flagged">1</span>
				<span class="ti-tile">0</span>
				<span class="ti-tile ti-tile--on">1</span>
			</div>
		)
	}
	{
		href === "/learn/how-computers-store-text" && (
			<div class="ti-text-map">
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-text-glyph">A</span>
			</div>
		)
	}
	{
		href === "/learn/ipv4-vs-ipv6" && (
			<div class="ti-ip-scale">
				<span class="ti-tile ti-tile--label ti-ip-tile--32">32-bit</span>
				<span class="ti-tile ti-tile--label ti-tile--on ti-ip-tile--128">128-bit</span>
			</div>
		)
	}
	{
		href === "/learn/binary-hex-decimal" && (
			<div class="ti-convert-row">
				<div class="ti-convert-col">
					<span class="ti-convert-label">DEC</span>
					<span class="ti-tile ti-tile--label">10</span>
				</div>
				<span class="ti-convert-arrow">⇄</span>
				<div class="ti-convert-col">
					<span class="ti-convert-label">HEX</span>
					<span class="ti-tile ti-tile--label">A</span>
				</div>
				<span class="ti-convert-arrow">⇄</span>
				<div class="ti-convert-col">
					<span class="ti-convert-label">BIN</span>
					<span class="ti-tile ti-tile--label">1010</span>
				</div>
			</div>
		)
	}
	{
		href === "/learn/compression" && (
			<div class="ti-convert-row">
				<span class="ti-tile ti-tile--label ti-small">AAAA</span>
				<span class="ti-convert-arrow">→</span>
				<span class="ti-tile ti-tile--label ti-tile--on">4A</span>
			</div>
		)
	}
	{
		href === "/learn/redundancy-and-fault-tolerance" && (
			<div class="ti-copies">
				<span class="ti-tile ti-copies-back">1</span>
				<span class="ti-tile ti-tile--on ti-copies-front">1</span>
			</div>
		)
	}
	{
		href === "/learn/abstraction" && (
			<div class="ti-layers">
				<span class="ti-layer ti-layer--top" />
				<span class="ti-layer" />
				<span class="ti-layer" />
			</div>
		)
	}
	{
		href === "/learn/packets-and-routing" && (
			<div class="ti-packets">
				<span class="ti-tile ti-tile--label ti-small">#2</span>
				<span class="ti-tile ti-tile--label ti-small ti-tile--on">#1</span>
				<span class="ti-tile ti-tile--label ti-small">#3</span>
			</div>
		)
	}
	{
		href === "/learn/bandwidth-and-latency" && (
			<div class="ti-pipes">
				<span class="ti-pipe ti-pipe--wide" />
				<span class="ti-pipe" />
			</div>
		)
	}
	{
		href === "/learn/scalability" && (
			<div class="ti-grow">
				<div class="ti-grow-col">
					<span class="ti-mini" />
				</div>
				<div class="ti-grow-col">
					<span class="ti-mini" />
					<span class="ti-mini" />
				</div>
				<div class="ti-grow-col">
					<span class="ti-mini ti-mini--on" />
					<span class="ti-mini ti-mini--on" />
					<span class="ti-mini ti-mini--on" />
					<span class="ti-mini ti-mini--on" />
				</div>
			</div>
		)
	}
	{
		href === "/learn/speedup" && (
			<div class="ti-convert-row">
				<span class="ti-tile ti-tile--label">1×</span>
				<span class="ti-convert-arrow">→</span>
				<span class="ti-tile ti-tile--label ti-tile--on">4×</span>
			</div>
		)
	}
	{
		href === "/learn/distributed-computing" && (
			<div class="ti-quad">
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile ti-tile--on">1</span>
				<span class="ti-tile ti-tile--on">1</span>
			</div>
		)
	}
	{
		href === "/learn/encryption-basics" && (
			<div class="ti-convert-row">
				<span class="ti-tile ti-tile--label">ABC</span>
				<span class="ti-convert-arrow">→</span>
				<span class="ti-tile ti-tile--label ti-tile--on">DEF</span>
			</div>
		)
	}
	{
		href === "/learn/public-key-cryptography" && (
			<div class="ti-convert-row">
				<svg class="ti-svg" viewBox="0 0 32 40">
					<path d="M9 18V11a7 7 0 0 1 14 0" />
					<rect x="5" y="18" width="22" height="18" rx="3" />
				</svg>
				<svg class="ti-svg ti-svg--on" viewBox="0 0 40 24">
					<circle cx="9" cy="12" r="6" />
					<path d="M15 12h21M30 12v6M35 12v5" />
				</svg>
			</div>
		)
	}
	{
		href === "/learn/password-strength" && (
			<span class="ti-tile ti-tile--label ti-tile--on ti-password">••••••</span>
		)
	}
	{
		href === "/learn/phishing" && (
			<div class="ti-convert-row">
				<span class="ti-tile ti-tile--label">@</span>
				<span class="ti-tile ti-tile--label ti-tile--on">⚑</span>
			</div>
		)
	}
	{
		href === "/learn/binary-search" && (
			<div class="ti-row ti-row--byte">
				<span class="ti-tile">1</span>
				<span class="ti-tile">2</span>
				<span class="ti-tile">3</span>
				<span class="ti-tile ti-tile--on">4</span>
				<span class="ti-tile">5</span>
				<span class="ti-tile">6</span>
				<span class="ti-tile">7</span>
			</div>
		)
	}
	{
		href === "/learn/sorting-algorithms" && (
			<div class="ti-bars">
				<span class="ti-bar" style="height: 30%" />
				<span class="ti-bar" style="height: 50%" />
				<span class="ti-bar" style="height: 70%" />
				<span class="ti-bar ti-bar--on" style="height: 100%" />
			</div>
		)
	}
	{
		href === "/learn/pseudocode-practice" && (
			<span class="ti-tile ti-tile--label ti-code">x ← 1</span>
		)
	}
</div>

<style>
	.topic-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 3.6rem;
		margin-bottom: 0.5rem;
	}

	.ti-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
		border-radius: 22%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.ti-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 14%, var(--color-bg));
		color: #fff3d6;
		box-shadow: 0 0 4px color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	.ti-tile--diff,
	.ti-tile--flagged {
		border-color: var(--color-danger);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-danger) 35%, transparent);
	}

	.ti-row {
		display: flex;
		gap: 0.25rem;
	}

	.ti-row--byte .ti-tile {
		width: 1.05rem;
		height: 1.05rem;
		font-size: 0.55rem;
	}

	.ti-hamming {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	/* Counting in Binary: 011 rolling over to 100 — the exact moment the
	   page's whole "rollover" idea is about, shown as a single before/after
	   snapshot rather than the hamming icon's static comparison. */
	.ti-rollover {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-rollover-arrow {
		color: var(--color-accent);
		font-size: 0.85rem;
		line-height: 1;
	}

	.ti-place-values {
		display: flex;
		gap: 0.5rem;
		align-items: flex-end;
	}

	.ti-pv-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-pv-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.ti-division {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--color-text);
	}

	.ti-division-arrow {
		color: var(--color-accent);
		font-size: 1.1rem;
		line-height: 1;
	}

	.ti-text-map {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.ti-text-glyph {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 4px;
		border: 1px solid var(--color-border);
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-text);
	}

	.ti-convert-row {
		display: flex;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.ti-convert-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-convert-label {
		font-family: var(--font-mono);
		font-size: 0.5rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}

	.ti-tile--label {
		width: auto;
		min-width: 1.6rem;
		padding: 0 0.25rem;
	}

	.ti-convert-arrow {
		margin-bottom: 0.5rem;
		color: var(--color-accent);
		font-size: 1rem;
	}

	/* IPv4 vs IPv6: two size-labeled tiles, the second deliberately larger
	   than the first — suggests the address-space jump without needing an
	   actual number in the icon itself. */
	.ti-ip-scale {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-ip-tile--32 {
		font-size: 0.5rem;
		height: 1.3rem;
	}

	.ti-ip-tile--128 {
		font-size: 0.68rem;
		height: 2rem;
		padding: 0 0.5rem;
	}

	/* What is Binary?: two stacked tiles perpetually crossfading between 0 and
	   1 — a plain opacity loop rather than a 3D flip, since a flip depends on
	   perspective/backface-visibility support and is fragile to verify; opacity
	   is trivial to confirm at any point in the cycle via computed style. */
	.ti-flip {
		position: relative;
		display: inline-flex;
		width: 1.6rem;
		height: 1.6rem;
	}

	.ti-flip-face {
		position: absolute;
		inset: 0;
		animation: ti-crossfade 5s ease-in-out infinite;
	}

	.ti-flip-face--a {
		animation-delay: 0s;
	}

	.ti-flip-face--b {
		animation-delay: -2.5s;
	}

	@keyframes ti-crossfade {
		0%,
		40% {
			opacity: 1;
		}
		50%,
		90% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ti-flip-face {
			animation: none;
		}

		.ti-flip-face--b {
			opacity: 0;
		}
	}
	/* --- Icons for the second batch of Learn pages. Same tile language;
	   amber (--on) marks the "result" or key element in each. */
	.ti-small {
		font-size: 0.6rem;
		height: 1.3rem;
	}

	.ti-copies {
		position: relative;
		width: 2.5rem;
		height: 2.5rem;
	}

	.ti-copies .ti-tile {
		position: absolute;
	}

	.ti-copies-back {
		top: 0;
		left: 0;
	}

	.ti-copies-front {
		right: 0;
		bottom: 0;
	}

	.ti-layers {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
	}

	.ti-layer {
		display: block;
		width: 2.8rem;
		height: 0.55rem;
		border-radius: 3px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.ti-layer--top {
		width: 1.8rem;
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
	}

	.ti-packets {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-packets .ti-tile:nth-child(1) {
		transform: translateY(-5px);
	}

	.ti-packets .ti-tile:nth-child(3) {
		transform: translateY(5px);
	}

	.ti-pipes {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.ti-pipe {
		display: block;
		width: 3rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-border);
	}

	.ti-pipe--wide {
		height: 0.9rem;
		background: var(--color-accent);
	}

	.ti-grow {
		display: flex;
		align-items: flex-end;
		gap: 0.25rem;
	}

	.ti-grow-col {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.ti-mini {
		display: block;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 2px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.ti-mini--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
	}

	.ti-quad {
		display: grid;
		grid-template-columns: repeat(2, 1.2rem);
		gap: 4px;
	}

	.ti-quad .ti-tile {
		width: 1.2rem;
		height: 1.2rem;
		font-size: 0.6rem;
	}

	.ti-svg {
		width: 1.4rem;
		height: 1.75rem;
		fill: none;
		stroke: var(--color-text-muted);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ti-svg--on {
		width: 2rem;
		stroke: var(--color-accent);
	}

	.ti-password {
		letter-spacing: 0.1em;
		padding: 0 0.5rem;
	}

	.ti-bars {
		display: flex;
		align-items: flex-end;
		gap: 4px;
		height: 2.2rem;
	}

	.ti-bar {
		display: block;
		width: 0.55rem;
		border-radius: 2px 2px 0 0;
		background: #5b6075;
	}

	.ti-bar--on {
		background: var(--color-accent);
	}

	.ti-code {
		padding: 0 0.5rem;
		font-size: 0.72rem;
	}
</style>
