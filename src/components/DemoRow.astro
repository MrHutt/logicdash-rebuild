---
// Static (non-interactive) illustration of a guess + its result, reusing the real
// seven-segment tile rendering AND the real distance-to-color logic from the game engine,
// so this never drifts out of sync with what the actual game looks like.
import { SEGMENT_POINTS, SEGMENTS_BY_DIGIT, distanceColor, distanceCloseness } from "../lib/hammingGame";

interface Props {
	/** The guess to display, e.g. "10110". */
	bits: string;
	/** How many digits differ from the (unshown) secret. 0 renders as a "Match!" badge. */
	distance: number;
}

const { bits, distance } = Astro.props;
const bitArray = bits.split("");
const isMatch = distance === 0;
const label = isMatch ? "Match!" : `${distance} bit${distance === 1 ? "" : "s"} off`;
const badgeColor = isMatch ? "var(--color-success)" : distanceColor(distance, bits.length);
const fillPercent = isMatch ? 100 : Math.round(distanceCloseness(distance, bits.length) * 100);
---

<div class="demo-row">
	<div class="demo-tiles">
		{
			bitArray.map((bit) => (
				<span class={`demo-tile ${bit === "1" ? "demo-tile--on" : ""}`}>
					<svg class="demo-digit" viewBox="0 0 60 100" aria-hidden="true">
						{Object.entries(SEGMENT_POINTS).map(([seg, points]) => (
							<polygon
								class={`demo-segment ${SEGMENTS_BY_DIGIT[bit]?.includes(seg) ? "is-on" : ""}`}
								points={points}
							/>
						))}
					</svg>
				</span>
			))
		}
	</div>
	<span class="demo-badge" style={`--badge-color: ${badgeColor}`}>
		<span class="demo-badge-label">{label}</span>
		<span class="demo-badge-bar"><span class="demo-badge-fill" style={`width: ${fillPercent}%`} /></span>
	</span>
</div>

<style>
	.demo-row {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.demo-tiles {
		display: flex;
		gap: 0.3rem;
	}

	.demo-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 22%;
		border: 1px solid #4a3826;
		background: #1c140d;
	}

	.demo-tile--on {
		border-color: #ffae2e;
		box-shadow: 0 0 10px color-mix(in srgb, #ffae2e 55%, transparent);
	}

	.demo-digit {
		width: 68%;
		height: 68%;
		overflow: visible;
	}

	.demo-segment {
		fill: #241a10;
	}

	.demo-tile:not(.demo-tile--on) .demo-segment.is-on {
		fill: #a8804f;
	}

	.demo-tile--on .demo-segment.is-on {
		fill: #fff3d6;
		filter:
			drop-shadow(0 0 3px #ffae2e)
			drop-shadow(0 0 8px #ffae2e);
	}

	.demo-badge {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.25rem;
		height: 2.4rem;
		min-width: 7.5rem;
		padding: 0.3rem 0.85rem;
		border-radius: 8px;
		border: 1px solid var(--badge-color);
		/* Mixed onto a solid --color-bg rather than transparent — see
		   HammingBoard.astro's .distance-badge for why: it keeps the badge's
		   own background reliably dark so its text stays AA-contrast no
		   matter how dark or light distanceColor()'s output is. */
		background: color-mix(in srgb, var(--badge-color) 22%, var(--color-bg));
		white-space: nowrap;
		box-sizing: border-box;
	}

	.demo-badge-label {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--badge-color);
	}

	.demo-badge-bar {
		display: block;
		height: 3px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--badge-color) 25%, transparent);
		overflow: hidden;
	}

	.demo-badge-fill {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--badge-color);
	}
</style>
