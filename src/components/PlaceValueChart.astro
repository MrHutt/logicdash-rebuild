---
// Static illustration of a byte's place values — each column shows the value
// a bit position is worth, whether that bit is lit, and (optionally) the
// addition that turns the lit positions into a decimal total.
interface Props {
	/** The bits to render, e.g. "10110101". */
	bits: string;
	/** Whether to render the "128 + 32 + ... = 181" line below the tiles. */
	showEquation?: boolean;
}

const { bits, showEquation = true } = Astro.props;
const bitArray = bits.split("");
const length = bitArray.length;
const values = bitArray.map((_, i) => 2 ** (length - 1 - i));
const litValues = values.filter((_, i) => bitArray[i] === "1");
const total = litValues.reduce((sum, value) => sum + value, 0);
---

<div class="pv-chart">
	<div class="pv-tiles">
		{
			bitArray.map((bit, i) => (
				<div class="pv-tile-col">
					<span class="pv-value-label">{values[i]}</span>
					<span class={`pv-tile ${bit === "1" ? "pv-tile--on" : ""}`}>{bit}</span>
				</div>
			))
		}
	</div>
	{
		showEquation && (
			<p class="pv-equation">
				<span class="pv-equation-terms">{litValues.length > 0 ? litValues.join(" + ") : "0"}</span>
				{litValues.length > 0 && (
					<>
						<span class="pv-equation-eq">=</span>
						<span class="pv-equation-total">{total}</span>
					</>
				)}
			</p>
		)
	}
</div>

<style>
	.pv-chart {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.pv-tiles {
		display: flex;
		width: 100%;
		max-width: 30rem;
		gap: 0.25rem;
		justify-content: center;
	}

	.pv-tile-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		flex: 1 1 0;
		max-width: 3.4rem;
	}

	.pv-value-label {
		font-family: var(--font-mono);
		font-size: clamp(0.6rem, 2.4vw, 0.75rem);
		color: var(--color-text-muted);
	}

	.pv-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 18%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1rem, 4.2vw, 1.5rem);
		color: var(--color-text-muted);
	}

	.pv-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	.pv-equation {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(0.85rem, 3vw, 1rem);
		text-align: center;
	}

	.pv-equation-terms {
		color: var(--color-text);
	}

	.pv-equation-eq {
		color: var(--color-text-muted);
		margin: 0 0.25rem;
	}

	.pv-equation-total {
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}
</style>
