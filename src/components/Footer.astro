---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<p>&copy; {year} LogicDash</p>
</footer>

<style>
	.site-footer {
		padding: 1.25rem 1.5rem;
		border-top: 1px solid var(--color-border);
		background: var(--color-surface);
		text-align: center;
		font-size: 0.85rem;
	}

	.site-footer p {
		margin: 0;
		color: var(--color-text-muted);
	}
</style>
