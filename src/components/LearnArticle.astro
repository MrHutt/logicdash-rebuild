---
// Shared shell for every Learn page: breadcrumb, centered hero, the content
// blocks (the default slot), Previous/Next cards, and — on wide screens — a
// sticky sidebar with "On this page" and "In this section" navigation.
// SEO (title, meta, canonical, Open Graph, JSON-LD) comes from Layout.astro
// + learnTopics.ts.
//
// Layout: a centered container (max 1280px). Below 1100px everything is one
// column; from 1100px the lesson sits in a main column beside a 280px
// sidebar, so wide screens are used for navigation rather than stretching
// text lines or leaving a narrow column floating in empty space.
//
// Spacing uses the 4px scale defined in Layout.astro (--space-1 … --space-8).
//
// Styles are global but namespaced under .learn-article, because several of
// the interactive demos build their markup client-side (innerHTML), which
// Astro's scoped styles can't reach.
import Layout from "../layouts/Layout.astro";
import { LEARN_TOPICS, LEVEL_LABELS, FOCUS_LABELS, getAdjacentLearnTopics } from "../lib/learnTopics";

interface Props {
	/** The topic's href exactly as listed in learnTopics.ts, e.g. "/learn/compression". */
	href: string;
	/** Meta description — keep under ~160 characters. */
	description: string;
	/** One or two sentences under the H1 (or use a `lead` slot for markup). */
	lead?: string;
	/** Optional override for the H1 (defaults to the topic's title). */
	heading?: string;
	/** Optional override for the <title> (defaults to the topic's title). */
	pageTitle?: string;
}

const { href, description, lead, heading, pageTitle } = Astro.props;
const topic = LEARN_TOPICS.find((t) => t.href === href);
if (!topic) throw new Error(`LearnArticle: no topic registered for ${href} in learnTopics.ts`);
const { prev, next } = getAdjacentLearnTopics(href);
const siblings = LEARN_TOPICS.filter((t) => t.group === topic.group && t.live);
const groupAnchor = topic.group
	.toLowerCase()
	.replace(/&/g, "and")
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/^-|-$/g, "");

// Render the page content once, give every section heading an id, and build
// the "On this page" list from those headings — so every page gets its own
// table of contents without anyone maintaining one by hand.
const rawContent = await Astro.slots.render("default");
const leadHtml = Astro.slots.has("lead") ? await Astro.slots.render("lead") : null;
const toc: { id: string; label: string }[] = [];
const usedIds = new Set<string>();
const stripTags = (html: string) =>
	html
		.replace(/<[^>]+>/g, "")
		.replace(/&amp;/g, "&")
		.replace(/&#39;|&apos;/g, "'")
		.replace(/&quot;/g, '"')
		.replace(/\s+/g, " ")
		.trim();
const content = rawContent.replace(
	/<p class="(block-title|demo-frame-title)"([^>]*)>([\s\S]*?)<\/p>/g,
	(match, cls: string, attrs: string, inner: string) => {
		if (/\sid=/.test(attrs)) return match;
		const label = stripTags(inner);
		if (!label) return match;
		const base = `s-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;
		let id = base;
		for (let n = 2; usedIds.has(id); n++) id = `${base}-${n}`;
		usedIds.add(id);
		toc.push({ id, label: cls === "demo-frame-title" ? `▸ ${label}` : label });
		return `<p class="${cls}" id="${id}"${attrs}>${inner}</p>`;
	},
);
---

<Layout title={pageTitle ?? topic.title} description={description} ogType="article" wide>
	<div class="learn-article">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/learn">Byte Lab</a>
			<span aria-hidden="true">/</span>
			<a href={`/learn#${groupAnchor}`}>{topic.group}</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{topic.title}</span>
		</nav>

		<header class="hero">
			<h1>{heading ?? topic.title}</h1>
			<p class="lesson-meta">
				<span class="lesson-meta-level">{topic.levels.map((l) => LEVEL_LABELS[l]).join(" · ")}</span>
				<span aria-hidden="true">•</span>
				<span>About {topic.minutes} min</span>
				<span aria-hidden="true">•</span>
				<span>{topic.focus.map((f) => FOCUS_LABELS[f]).join(", ")}</span>
			</p>
			{leadHtml ? <p class="hero-lead" set:html={leadHtml} /> : lead && <p class="hero-lead">{lead}</p>}
		</header>

		<div class="learn-layout">
			<div class="learn-main">
				<div class="blocks">
					<Fragment set:html={content} />
				</div>

				<nav class="learn-pagination" aria-label="Previous and next lessons">
					{
						prev && (
							<a class="learn-pagination-card learn-pagination-prev" href={prev.href}>
								<span class="learn-pagination-label">← Previous</span>
								<span class="learn-pagination-title">{prev.title}</span>
							</a>
						)
					}
					{
						next &&
							(next.live ? (
								<a class="learn-pagination-card learn-pagination-next" href={next.href}>
									<span class="learn-pagination-label">Next →</span>
									<span class="learn-pagination-title">{next.title}</span>
								</a>
							) : (
								<span class="learn-pagination-card learn-pagination-next learn-pagination-soon">
									<span class="learn-pagination-label">Coming soon</span>
									<span class="learn-pagination-title">{next.title}</span>
								</span>
							))
					}
				</nav>
			</div>

			<aside class="learn-aside" aria-label="Page navigation">
				<div class="learn-aside-inner">
					{
						toc.length > 1 && (
							<nav class="aside-card" aria-labelledby="aside-toc-title">
								<p class="aside-title" id="aside-toc-title">
									On this page
								</p>
								<ol class="aside-list">
									{toc.map((item) => (
										<li>
											<a href={`#${item.id}`}>{item.label}</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
					<nav class="aside-card" aria-labelledby="aside-section-title">
						<p class="aside-title" id="aside-section-title">
							{topic.group}
						</p>
						<ol class="aside-list">
							{
								siblings.map((t) => (
									<li>
										<a href={t.href} aria-current={t.href === href ? "page" : undefined}>
											{t.title}
										</a>
									</li>
								))
							}
						</ol>
						<a class="aside-all" href="/learn">All lessons →</a>
					</nav>
				</div>
			</aside>
		</div>
	</div>
</Layout>

<style is:global>
	.learn-article [hidden] {
		display: none !important;
	}

	/* ------------------------------------------------------------------
	   Page frame: breadcrumb, hero, main column + sidebar.
	   ------------------------------------------------------------------ */

	.learn-article .breadcrumb {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-1) var(--space-2);
		margin: 0 0 var(--space-3);
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.learn-article .breadcrumb a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.learn-article .breadcrumb a:hover {
		text-decoration: underline;
	}

	.learn-article .hero {
		max-width: 48rem;
		margin: 0 auto var(--space-6);
		text-align: center;
	}

	.learn-article .hero h1 {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
	}

	.learn-article .lesson-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-1) var(--space-2);
		margin: 0 0 var(--space-4);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.learn-article .lesson-meta-level {
		color: var(--color-accent);
		font-weight: 700;
	}

	.learn-article .hero-lead {
		margin: 0 auto;
		max-width: 40rem;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.learn-article .learn-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-6);
	}

	.learn-article .learn-aside {
		display: none;
	}

	@media (min-width: 1100px) {
		.learn-article .learn-layout {
			grid-template-columns: minmax(0, 1fr) 17.5rem;
			align-items: start;
		}

		.learn-article .learn-aside {
			display: block;
			position: sticky;
			top: var(--space-4);
		}
	}

	.learn-article .learn-aside-inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-height: calc(100vh - var(--space-6));
		overflow-y: auto;
	}

	.learn-article .aside-card {
		padding: var(--space-4);
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.learn-article .aside-title {
		margin: 0 0 var(--space-2);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.learn-article .aside-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.learn-article .aside-list a {
		display: block;
		padding: var(--space-1) var(--space-2);
		border-radius: 0 8px 8px 0;
		border-left: 2px solid transparent;
		font-size: 0.875rem;
		line-height: 1.4;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.learn-article .aside-list a:hover,
	.learn-article .aside-list a:focus-visible {
		background: var(--color-surface-alt);
		color: var(--color-text);
	}

	.learn-article .aside-list a[aria-current="page"],
	.learn-article .aside-list a.is-active {
		border-left-color: var(--color-accent);
		color: var(--color-text);
		font-weight: 600;
	}

	.learn-article .aside-all {
		display: inline-block;
		margin-top: var(--space-3);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.learn-article .aside-all:hover {
		text-decoration: underline;
	}

	/* Section headings are link targets from the sidebar — keep them clear
	   of the top edge when jumped to. */
	.learn-article [id^="s-"] {
		scroll-margin-top: var(--space-6);
	}

	/* ------------------------------------------------------------------
	   Content blocks.
	   ------------------------------------------------------------------ */

	.learn-article .blocks {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.learn-article .block {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: var(--space-4);
		min-width: 0;
	}

	@media (min-width: 768px) {
		.learn-article .block {
			padding: var(--space-5);
		}
	}

	.learn-article .block-title {
		margin: 0 0 var(--space-2);
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	/* Body copy keeps a comfortable reading width (about 75 characters)
	   even when the column is wide. */
	.learn-article .block-text {
		max-width: 75ch;
		margin: 0 0 var(--space-3);
		font-size: 1rem;
		line-height: 1.65;
	}

	.learn-article .block-text:last-child {
		margin-bottom: 0;
	}

	.learn-article .block-text em,
	.learn-article .block-list em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.learn-article .block a:not(.demo-btn):not(.related-link) {
		color: var(--color-accent);
		font-weight: 600;
	}

	.learn-article .mono-highlight {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-text);
	}

	.learn-article .block--example {
		text-align: center;
	}

	.learn-article .block--example .block-text,
	.learn-article .block--example .block-list {
		margin-inline: auto;
	}

	.learn-article .block--example .block-list {
		text-align: left;
		max-width: 36rem;
	}

	.learn-article .block-list {
		max-width: 75ch;
		margin: 0 0 var(--space-3);
		padding-left: var(--space-5);
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.learn-article .block-list li + li {
		margin-top: var(--space-2);
	}

	.learn-article .block-list:last-child {
		margin-bottom: 0;
	}

	/* The one-line "big idea" takeaway — an amber rule down the left. */
	.learn-article .block-callout {
		max-width: 75ch;
		margin: var(--space-4) 0;
		padding: var(--space-3) var(--space-4);
		border-left: 4px solid var(--color-accent);
		border-radius: 0 8px 8px 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-size: 1rem;
		line-height: 1.6;
		text-align: left;
	}

	.learn-article .block--example .block-callout {
		margin-inline: auto;
	}

	.learn-article .block-callout:last-child {
		margin-bottom: 0;
	}

	/* A dark inset panel for static diagrams and worked examples. */
	.learn-article .figure {
		margin: var(--space-4) 0 var(--space-2);
		padding: var(--space-4);
		border-radius: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		overflow-x: auto;
	}

	.learn-article .figure-caption {
		margin: var(--space-2) 0 0;
		font-size: 0.875rem;
		font-style: italic;
		color: var(--color-text-muted);
		text-align: center;
	}

	/* Pseudocode / code sample. */
	.learn-article .code-block {
		margin: var(--space-4) auto;
		padding: var(--space-3) var(--space-4);
		max-width: 36rem;
		border-radius: 8px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--color-text);
		white-space: pre;
		overflow-x: auto;
		text-align: left;
	}

	/* Comparison tables. */
	.learn-article .table-wrap {
		margin: var(--space-4) 0 var(--space-1);
		overflow-x: auto;
		border-radius: 8px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.learn-article .data-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
		text-align: left;
	}

	.learn-article .data-table th {
		padding: var(--space-2) var(--space-4);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		border-bottom: 1px solid var(--color-border);
	}

	.learn-article .data-table td {
		padding: var(--space-2) var(--space-4);
		line-height: 1.5;
		color: var(--color-text);
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
	}

	.learn-article .data-table tbody tr:last-child td {
		border-bottom: none;
	}

	@media (max-width: 480px) {
		.learn-article .data-table {
			font-size: 0.875rem;
		}

		.learn-article .data-table th,
		.learn-article .data-table td {
			padding: var(--space-2) var(--space-3);
		}
	}

	.learn-article .data-table .num {
		font-family: var(--font-mono);
		font-weight: 700;
		white-space: nowrap;
	}

	/* Side-by-side comparison cards (e.g. lossless vs lossy). They sit next
	   to each other when there's room and stack on phones. */
	.learn-article .compare-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: var(--space-3);
		margin: var(--space-4) 0 var(--space-1);
		text-align: left;
	}

	.learn-article .compare-card {
		padding: var(--space-4);
		border-radius: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.learn-article .compare-card--accent {
		border-color: color-mix(in srgb, var(--color-accent) 60%, var(--color-border));
	}

	.learn-article .compare-card-title {
		margin: 0 0 var(--space-2);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.learn-article .compare-card p {
		margin: 0 0 var(--space-2);
		font-size: 0.9375rem;
	}

	.learn-article .compare-card p:last-child {
		margin-bottom: 0;
	}

	/* "Pairs well with" pointer to a sibling page. */
	.learn-article .related-link {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin-top: var(--space-4);
		padding: var(--space-3) var(--space-4);
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	.learn-article .related-link:hover,
	.learn-article .related-link:focus-visible {
		border-color: var(--color-accent);
	}

	.learn-article .related-link-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.learn-article .related-link-title {
		font-weight: 700;
		color: var(--color-accent);
	}

	/* ------------------------------------------------------------------
	   Previous / Next cards.
	   ------------------------------------------------------------------ */

	.learn-article .learn-pagination {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	@media (min-width: 640px) {
		.learn-article .learn-pagination {
			grid-template-columns: 1fr 1fr;
		}

		.learn-article .learn-pagination-next {
			grid-column: 2;
		}
	}

	.learn-article .learn-pagination-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4);
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.learn-article a.learn-pagination-card:hover,
	.learn-article a.learn-pagination-card:focus-visible {
		border-color: var(--color-accent);
		box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 30%, transparent);
	}

	.learn-article .learn-pagination-next {
		align-items: flex-end;
		text-align: right;
	}

	.learn-article .learn-pagination-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.learn-article .learn-pagination-title {
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-accent);
	}

	.learn-article .learn-pagination-soon .learn-pagination-title {
		color: var(--color-text-muted);
	}
</style>

<script>
	// Highlight the sidebar's "On this page" entry for the section in view.
	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".learn-aside .aside-list a[href^='#']"));
	if (tocLinks.length && "IntersectionObserver" in window) {
		const byId = new Map(tocLinks.map((a) => [a.getAttribute("href")!.slice(1), a]));
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					tocLinks.forEach((a) => a.classList.remove("is-active"));
					byId.get(entry.target.id)?.classList.add("is-active");
				});
			},
			{ rootMargin: "0px 0px -70% 0px" },
		);
		byId.forEach((_, id) => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});
	}
</script>
