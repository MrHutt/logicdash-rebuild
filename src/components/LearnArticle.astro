	}

	/* ------------------------------------------------------------------
	   Previous / Next cards.
	   ------------------------------------------------------------------ */

	.learn-article .learn-pagination {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	@media (min-width: 640px) {
		.learn-article .learn-pagination {
			grid-template-columns: 1fr 1fr;
		}

		.learn-article .learn-pagination-next {
			grid-column: 2;
		}
	}

	.learn-article .learn-pagination-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4);
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
