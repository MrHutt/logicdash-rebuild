		align-items: flex-end;
		text-align: right;
	}

	.learn-article .learn-pagination-label {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.learn-article .learn-pagination-title {
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-accent);
	}

	.learn-article .learn-pagination-soon .learn-pagination-title {
		color: var(--color-text-muted);
	}
</style>

<script>
	// --- Section bar + slides -------------------------------------------
	// Each top-level block of the lesson is a "section". The bar lists them
	// (labelled by each one's title). From 1024px up it's a sticky row that
	// highlights the section you're reading; below that the sections become
	// slides you swipe or step through with Back/Next.
	const article = document.querySelector<HTMLElement>(".learn-article");
	const bar = document.querySelector<HTMLElement>("[data-section-bar]");
	const blocks = document.querySelector<HTMLElement>("[data-blocks]");
	const chipList = document.querySelector<HTMLOListElement>("[data-section-chips]");
	const slideNav = document.querySelector<HTMLElement>("[data-slide-nav]");
	// Group the lesson's blocks into sections: each titled block starts one,
	// and an untitled block travels with the section before it (wrapped
	// together so they stay on the same slide). Component <script>s that end
	// up among the blocks are skipped.
	const sections: HTMLElement[] = [];
	if (blocks) {
		const groups: HTMLElement[][] = [];
		for (const el of Array.from(blocks.children) as HTMLElement[]) {
			if (["SCRIPT", "STYLE", "TEMPLATE"].includes(el.tagName)) continue;
			if (el.querySelector("[id^='s-']") || groups.length === 0) groups.push([el]);
			else groups[groups.length - 1].push(el);
		}
		for (const group of groups) {
			if (group.length === 1) {
				sections.push(group[0]);
				continue;
			}
			const wrap = document.createElement("div");
			wrap.className = "section-group";
			group[0].before(wrap);
			wrap.append(...group);
			sections.push(wrap);
		}
	}
	const titled = sections
		.map((el) => ({ el, title: el.querySelector<HTMLElement>("[id^='s-']") }))
		.filter((s): s is { el: HTMLElement; title: HTMLElement } => s.title !== null);

	if (article && bar && blocks && chipList && slideNav && titled.length > 1 && titled.length === sections.length) {
		const count = bar.querySelector<HTMLElement>("[data-section-count]")!;
		const prevBtn = bar.querySelector<HTMLButtonElement>("[data-section-prev]")!;
		const nextBtn = bar.querySelector<HTMLButtonElement>("[data-section-next]")!;
		const slidePrev = slideNav.querySelector<HTMLButtonElement>("[data-slide-prev]")!;
		const slideNext = slideNav.querySelector<HTMLButtonElement>("[data-slide-next]")!;
		const slideNextTitle = slideNav.querySelector<HTMLElement>("[data-slide-next-title]")!;
		const labels = titled.map(({ title }) => title.textContent!.replace(/\s+/g, " ").trim());
		const select = bar.querySelector<HTMLSelectElement>("[data-section-select]")!;
		labels.forEach((label, i) => select.add(new Option(label, String(i))));
		select.addEventListener("change", () => goTo(Number(select.value), true));

		const chips = titled.map(({ title }, i) => {
			const li = document.createElement("li");
			const a = document.createElement("a");
			a.href = `#${title.id}`;
			a.textContent = labels[i];
			li.append(a);
			chipList.append(li);
			return a;
		});
		bar.hidden = false;

		// Ticks along the bar's bottom edge, one per section.
		const tickRow = bar.querySelector<HTMLElement>("[data-section-ticks]")!;
		const ticks = sections.map(() => tickRow.appendChild(document.createElement("span")));

		// First-visit hint ("Swipe or tap → …"). Once someone has moved a
		// section — on any lesson — we remember it and stop showing it.
		const hint = document.querySelector<HTMLElement>("[data-swipe-hint]");
		const HINT_KEY = "logicdash:swipe-learned";
		let learned = false;
		try {
			learned = localStorage.getItem(HINT_KEY) === "1";
		} catch {
			// Storage blocked: just show the hint each time.
		}
		function markLearned() {
			if (learned) return;
			learned = true;
			if (hint) hint.hidden = true;
			try {
				localStorage.setItem(HINT_KEY, "1");
			} catch {
				// ignore
			}
		}

		const slideQuery = window.matchMedia("(max-width: 1023px)");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let current = 0;
		let slides = false;

		function setActive(i: number) {
			if (slides && i !== current) markLearned();
			current = i;
			select.value = String(i);
			sections.forEach((el, j) => el.classList.toggle("is-current", j === i));
			ticks.forEach((t, j) => {
				t.classList.toggle("is-current", j === i);
				t.classList.toggle("is-done", j < i);
			});
			chips.forEach((chip, j) => {
				chip.classList.toggle("is-active", j === i);
				if (j === i) chip.setAttribute("aria-current", "true");
				else chip.removeAttribute("aria-current");
			});
			// Keep the active chip visible in the scrolling row.
			const chip = chips[i];
			const row = chipList!;
			const left = chip.offsetLeft - row.clientWidth / 2 + chip.offsetWidth / 2;
			row.scrollTo({ left, behavior: reduceMotion ? "auto" : "smooth" });
			if (slides) {
				count.textContent = `${i + 1} of ${sections.length}`;
				prevBtn.disabled = slidePrev.disabled = i === 0;
				nextBtn.disabled = slideNext.disabled = i === sections.length - 1;
				slideNextTitle.textContent = labels[i + 1] ?? "";
				fitHeight();
			}
		}

		// Slide mode: the strip is as tall as the section on screen.
		function fitHeight() {
			if (slides) blocks!.style.height = `${sections[current].offsetHeight}px`;
		}
		const heightWatcher = new ResizeObserver(() => fitHeight());
		sections.forEach((el) => heightWatcher.observe(el));

		function goTo(i: number, focus = false) {
			i = Math.max(0, Math.min(sections.length - 1, i));
			if (slides) {
				blocks!.scrollTo({ left: sections[i].offsetLeft - blocks!.offsetLeft, behavior: reduceMotion ? "auto" : "smooth" });
				setActive(i);
				// Bring the top of the new section into view if we're scrolled past it.
				const top = bar!.getBoundingClientRect().top;
				if (top < 0 || blocks!.getBoundingClientRect().top < 0) bar!.scrollIntoView({ block: "start", behavior: reduceMotion ? "auto" : "smooth" });
				if (focus) titled[i].title.focus({ preventScroll: true });
			} else {
				titled[i].title.scrollIntoView({ block: "start", behavior: reduceMotion ? "auto" : "smooth" });
				setActive(i);
			}
		}

		// Titles get tabindex=-1 so moving to a section can move focus there too.
		titled.forEach(({ title }) => title.setAttribute("tabindex", "-1"));

		chips.forEach((chip, i) =>
			chip.addEventListener("click", (event) => {
				event.preventDefault();
				history.replaceState(null, "", chip.hash);
				goTo(i, true);
			}),
		);
		[prevBtn, slidePrev].forEach((b) => b.addEventListener("click", () => goTo(current - 1, b === slidePrev)));
		[nextBtn, slideNext].forEach((b) => b.addEventListener("click", () => goTo(current + 1, b === slideNext)));

		// Swiping: settle on whichever slide is mostly in view.
		let scrollTimer: number | undefined;
		blocks.addEventListener(
			"scroll",
			() => {
				if (!slides) return;
				window.clearTimeout(scrollTimer);
				scrollTimer = window.setTimeout(() => {
					const width = sections[0].offsetWidth + parseFloat(getComputedStyle(blocks).columnGap || "0");
					const i = Math.round(blocks.scrollLeft / width);
					if (i !== current) setActive(Math.max(0, Math.min(sections.length - 1, i)));
				}, 80);
			},
			{ passive: true },
		);

		// Tabbing into an off-screen slide brings that slide into view. Only
		// for keyboard focus: moving the strip during a tap or click would
		// pull the button out from under the pointer and lose the click.
		let pointerAt = 0;
		blocks.addEventListener("pointerdown", () => (pointerAt = performance.now()), { capture: true, passive: true });
		blocks.addEventListener("focusin", (event) => {
			if (!slides || performance.now() - pointerAt < 800) return;
			const i = sections.findIndex((el) => el.contains(event.target as Node));
			if (i >= 0 && i !== current) {
				blocks.scrollLeft = sections[i].offsetLeft - blocks.offsetLeft;
				setActive(i);
			}
		});

		// Desktop: highlight the section being read.
		const observer = new IntersectionObserver(
			(entries) => {
				if (slides) return;
				for (const entry of entries) {
					if (entry.isIntersecting) setActive(sections.indexOf(entry.target as HTMLElement));
				}
			},
			{ rootMargin: "-20% 0px -60% 0px" },
		);
		sections.forEach((el) => observer.observe(el));

		let nudged = false;
		// The nudge must never move things under someone who's already
		// interacting, so any touch, click, key or wheel cancels it.
		let interacted = false;
		["pointerdown", "keydown", "wheel", "touchstart"].forEach((type) =>
			document.addEventListener(type, () => (interacted = true), { once: true, passive: true }),
		);
		function applyMode() {
			slides = slideQuery.matches;
			article!.classList.toggle("is-slides", slides);
			slideNav!.hidden = !slides;
			if (hint) hint.hidden = !slides || learned;
			// One gentle nudge on a first visit: the strip slides a little
			// way and back, showing that sections move sideways.
			if (slides && !learned && !nudged && !reduceMotion && current === 0) {
				nudged = true;
				window.setTimeout(() => {
					if (current !== 0 || !slides || interacted || blocks!.scrollLeft > 1) return;
					blocks!.style.scrollSnapType = "none";
					blocks!.scrollTo({ left: 56, behavior: "smooth" });
					window.setTimeout(() => blocks!.scrollTo({ left: 0, behavior: "smooth" }), 450);
					window.setTimeout(() => (blocks!.style.scrollSnapType = ""), 1000);
				}, 900);
			}
			if (slides) {
				blocks!.scrollLeft = sections[current].offsetLeft - blocks!.offsetLeft;
				setActive(current);
			} else {
				blocks!.style.height = "";
				setActive(current);
			}
		}
		slideQuery.addEventListener("change", applyMode);

		// Open on the section named in the address (e.g. from a shared link).
		const fromHash = location.hash ? titled.findIndex(({ el }) => el.querySelector(location.hash.replace(/[^#\w-]/g, "")) !== null) : -1;
		current = Math.max(0, fromHash);
		applyMode();
		if (fromHash > 0 && slides) requestAnimationFrame(() => (blocks.scrollLeft = sections[fromHash].offsetLeft - blocks.offsetLeft));
	}

	// Copy the short link. The clipboard API needs a secure context, so fall
	// back to selecting the text for a manual copy if it's unavailable.
	const copyBtn = document.querySelector<HTMLButtonElement>("[data-share-copy]");
	const shareUrl = document.querySelector<HTMLAnchorElement>("[data-share-url]");
	if (copyBtn && shareUrl) {
		copyBtn.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(shareUrl.dataset.shareUrl!);
				copyBtn.textContent = "Copied ✓";
			} catch {
				getSelection()?.selectAllChildren(shareUrl);
				copyBtn.textContent = "Press Ctrl+C";
			}
			setTimeout(() => (copyBtn.textContent = "Copy"), 2000);
		});
	}
</script>
