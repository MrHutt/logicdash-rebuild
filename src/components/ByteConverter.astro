---
// Interactive decimal-to-binary converter: type a number 0-255, submit, and
// watch the division-by-2 steps build one at a time before landing on the
// final byte as the site's standard bit-tile row.
//
// The step rows are built client-side via innerHTML (see the script below),
// so — same as PracticeQuiz.astro and ByteBuilder.astro — this component's
// styles are global and every class is prefixed "converter-" to avoid
// colliding with anything else on the page.
---

<div class="converter">
	<form class="converter-form" data-converter-form>
		<label class="converter-label" for="converter-input">Enter a decimal number (0–255)</label>
		<div class="converter-input-row">
			<input
				type="number"
				id="converter-input"
				class="converter-input"
				inputmode="numeric"
				placeholder="e.g. 200"
				data-converter-input
			/>
			<button type="submit" class="converter-submit">Convert</button>
		</div>
	</form>
	<p class="converter-error" data-converter-error hidden></p>
	<div class="converter-steps" data-converter-steps></div>
	<div class="converter-result" data-converter-result hidden>
		<p class="converter-result-label">Binary result</p>
		<div class="converter-tiles" data-converter-tiles></div>
	</div>
</div>

<script>
	import { computeDivisionSteps, decimalToBinary8, type DivisionStep } from "../lib/decimalToBinary";

	const STEP_DELAY_MS = 450;

	function wait(ms: number): Promise<void> {
		return new Promise((resolve) => setTimeout(resolve, ms));
	}

	document.querySelectorAll<HTMLElement>(".converter").forEach((root) => {
		const form = root.querySelector<HTMLFormElement>("[data-converter-form]");
		const input = root.querySelector<HTMLInputElement>("[data-converter-input]");
		const errorEl = root.querySelector<HTMLElement>("[data-converter-error]");
		const stepsEl = root.querySelector<HTMLElement>("[data-converter-steps]");
		const resultEl = root.querySelector<HTMLElement>("[data-converter-result]");
		const tilesEl = root.querySelector<HTMLElement>("[data-converter-tiles]");

		// Bumped on every new submission so a slow-running animation from a
		// previous number can't keep appending rows after a new one starts.
		let runToken = 0;

		function buildStepRow(step: DivisionStep): HTMLDivElement {
			const row = document.createElement("div");
			row.className = "converter-step-row";
			row.innerHTML = `
				<span class="converter-num">${step.dividend}</span>
				<span class="converter-op">÷ 2 =</span>
				<span class="converter-num">${step.quotient}</span>
				<span class="converter-rem-label">remainder</span>
				<span class="converter-rem-tile ${step.remainder === 1 ? "converter-rem-tile--on" : ""}">${step.remainder}</span>
			`;
			return row;
		}

		async function runConversion(value: number) {
			const token = ++runToken;

			if (errorEl) errorEl.hidden = true;
			if (stepsEl) stepsEl.innerHTML = "";
			if (resultEl) resultEl.hidden = true;

			const steps = computeDivisionSteps(value);

			for (const step of steps) {
				if (token !== runToken || !stepsEl) return;
				stepsEl.appendChild(buildStepRow(step));
				await wait(STEP_DELAY_MS);
			}

			if (token !== runToken) return;

			const bits = decimalToBinary8(value);
			if (tilesEl) {
				tilesEl.innerHTML = bits
					.split("")
					.map((bit) => `<span class="converter-tile ${bit === "1" ? "converter-tile--on" : ""}">${bit}</span>`)
					.join("");
			}
			if (resultEl) resultEl.hidden = false;
		}

		form?.addEventListener("submit", (event) => {
			event.preventDefault();
			const raw = input?.value ?? "";
			const value = Number(raw);

			if (raw.trim() === "" || !Number.isInteger(value) || value < 0 || value > 255) {
				runToken++; // cancel any in-flight animation
				if (stepsEl) stepsEl.innerHTML = "";
				if (resultEl) resultEl.hidden = true;
				if (errorEl) {
					errorEl.textContent = "Enter a whole number between 0 and 255.";
					errorEl.hidden = false;
				}
				return;
			}

			runConversion(value);
		});
	});
</script>

<style is:global>
	.converter {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		width: 100%;
	}

	.converter-form {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
	}

	.converter-label {
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.converter-input-row {
		display: flex;
		gap: 0.5rem;
	}

	.converter-input {
		width: 8rem;
		padding: 0.5rem 0.7rem;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 1rem;
		text-align: center;
	}

	.converter-input:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	.converter-submit {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg));
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
		text-shadow: 0 0 6px var(--color-accent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transition:
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	.converter-submit:hover {
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
		box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.converter-submit:active {
		transform: scale(0.95);
	}

	.converter-error {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-danger);
	}

	.converter-steps {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		width: 100%;
	}

	.converter-step-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		animation: converter-row-in 0.25s ease;
	}

	@keyframes converter-row-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.converter-num {
		min-width: 1.7rem;
		text-align: right;
		font-weight: 700;
		color: var(--color-text);
	}

	.converter-op {
		color: var(--color-text-muted);
	}

	.converter-rem-label {
		color: var(--color-text-muted);
		font-size: 0.78rem;
	}

	.converter-rem-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 22%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-text-muted);
	}

	.converter-rem-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	.converter-result {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-border);
		animation: converter-row-in 0.3s ease;
	}

	.converter-result-label {
		margin: 0;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.converter-tiles {
		display: flex;
		width: 100%;
		max-width: 26rem;
		gap: 0.35rem;
		justify-content: center;
	}

	.converter-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 1 0;
		max-width: 3rem;
		aspect-ratio: 1 / 1;
		border-radius: 18%;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(0.95rem, 4vw, 1.4rem);
		color: var(--color-text-muted);
	}

	.converter-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}
</style>
