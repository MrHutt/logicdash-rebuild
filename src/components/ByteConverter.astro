---
// Interactive decimal-to-binary converter: type a number 0-255, submit, and
// watch the division-by-2 steps build one at a time before landing on the
// final byte as the site's standard bit-tile row.
//
// The step rows are built client-side via innerHTML (see the script below),
// so — same as PracticeQuiz.astro and ByteBuilder.astro — this component's
// styles are global and every class is prefixed "converter-" to avoid
// colliding with anything else on the page.
---

<div class="converter">
	<form class="converter-form" data-converter-form>
		<label class="converter-label" for="converter-input">Enter a decimal number (0–255)</label>
		<div class="converter-input-row">
			<input
				type="number"
				id="converter-input"
				class="converter-input"
				inputmode="numeric"
				min="0"
				max="255"
				step="1"
				placeholder="e.g. 200"
				data-converter-input
			/>
			<button type="submit" class="converter-submit">Convert</button>
		</div>
	</form>
	<p class="converter-error" data-converter-error hidden></p>
	<div class="converter-steps" data-converter-steps></div>
	<div class="converter-result" data-converter-result hidden>
		<p class="converter-result-label">Binary result</p>
		<div class="converter-tiles" data-converter-tiles></div>
	</div>
</div>

<script>
	import { computeDivisionSteps, decimalToBinary8, type DivisionStep } from "../lib/decimalToBinary";

	const STEP_DELAY_MS = 450;
	const PAUSE_BEFORE_REVEAL_MS = 500;
	const TRAVEL_STEP_MS = 150;

	function wait(ms: number): Promise<void> {
		return new Promise((resolve) => setTimeout(resolve, ms));
	}

	document.querySelectorAll<HTMLElement>(".converter").forEach((root) => {
		const form = root.querySelector<HTMLFormElement>("[data-converter-form]");
		const input = root.querySelector<HTMLInputElement>("[data-converter-input]");
		const errorEl = root.querySelector<HTMLElement>("[data-converter-error]");
		const stepsEl = root.querySelector<HTMLElement>("[data-converter-steps]");
		const resultEl = root.querySelector<HTMLElement>("[data-converter-result]");
		const tilesEl = root.querySelector<HTMLElement>("[data-converter-tiles]");

		// Bumped on every new submission so a slow-running animation from a
		// previous number can't keep appending rows after a new one starts.
		let runToken = 0;

		function buildStepRow(step: DivisionStep): HTMLDivElement {
			const row = document.createElement("div");
			row.className = "converter-step-row";
			row.innerHTML = `
				<span class="converter-num">${step.dividend}</span>
				<span class="converter-op">÷ 2 =</span>
				<span class="converter-num">${step.quotient}</span>
				<span class="converter-rem-label">remainder</span>
				<span class="converter-rem-tile ${step.remainder === 1 ? "converter-rem-tile--on" : ""}">${step.remainder}</span>
			`;
			return row;
		}

		// The vertical center of a row's remainder tile, relative to `stepsEl`
		// (which must be position:relative) — used to place the traveling
		// connector exactly on each tile regardless of font size or spacing.
		function remainderTileCenterY(containerRect: DOMRect, rowEl: HTMLElement): number {
			const tile = rowEl.querySelector<HTMLElement>(".converter-rem-tile");
			if (!tile) return 0;
			const tileRect = tile.getBoundingClientRect();
			return tileRect.top - containerRect.top + tileRect.height / 2;
		}

		// After every division step is on screen, this traces the "read bottom
		// to top" rule visually: a connector travels from the bottom row's
		// remainder up to the top row's, and — in that same bottom-to-top
		// order — lights up the Binary Result tiles one at a time. Because the
		// bottom-most (last-calculated) remainder is the *first* digit of the
		// answer, that's also the first result tile to light, even though the
		// result row itself reads left to right as usual.
		//
		// The connector is left in place at the top once the reveal finishes
		// (matching the static arrow on the worked examples above), rather
		// than fading out — the next submission clears it along with
		// everything else in `stepsEl`.
		async function revealResultBottomToTop(
			stepRows: HTMLElement[],
			bits: string,
			token: number,
		): Promise<void> {
			if (!stepsEl || !resultEl || !tilesEl) return;

			const padCount = bits.length - stepRows.length;
			tilesEl.innerHTML = bits
				.split("")
				.map((bit, i) => {
					const isPadding = i < padCount;
					const settledClass = bit === "1" ? "converter-tile converter-tile--on" : "converter-tile";
					return `<span class="${isPadding ? settledClass : "converter-tile converter-tile--pending"}" data-bit="${bit}">${bit}</span>`;
				})
				.join("");
			resultEl.hidden = false;

			const resultTiles = Array.from(tilesEl.querySelectorAll<HTMLElement>(".converter-tile"));
			const orderedRows = [...stepRows].reverse(); // bottom row (last calculated) first

			const line = document.createElement("div");
			line.className = "converter-travel-line";
			const arrow = document.createElement("div");
			arrow.className = "converter-travel-arrow";
			arrow.textContent = "▲";
			stepsEl.appendChild(line);
			stepsEl.appendChild(arrow);

			function cleanupConnector() {
				line.remove();
				arrow.remove();
			}

			const containerRect = stepsEl.getBoundingClientRect();
			const startY = remainderTileCenterY(containerRect, orderedRows[0]);
			line.style.bottom = `${containerRect.height - startY}px`;
			line.style.top = `${startY}px`;
			arrow.style.top = `${startY}px`;

			// Let the connector's starting position paint before the first move.
			await wait(30);

			for (let i = 0; i < orderedRows.length; i++) {
				if (token !== runToken) {
					cleanupConnector();
					return;
				}

				const row = orderedRows[i];
				const y = remainderTileCenterY(containerRect, row);
				line.style.top = `${y}px`;
				arrow.style.top = `${y}px`;
				row.querySelector(".converter-rem-tile")?.classList.add("converter-rem-tile--visited");

				const resultTile = resultTiles[padCount + i];
				if (resultTile) {
					resultTile.classList.remove("converter-tile--pending");
					resultTile.classList.add("converter-tile--reveal");
					if (resultTile.dataset.bit === "1") resultTile.classList.add("converter-tile--on");
				}

				await wait(TRAVEL_STEP_MS);
			}

			if (token !== runToken) {
				cleanupConnector();
				return;
			}

			// The connector is placed in pixels, so re-measure it if the layout
			// changes afterwards (phone rotated, window resized) — otherwise
			// it would drift away from the remainder tiles.
			const topRow = orderedRows[orderedRows.length - 1];
			const bottomRow = orderedRows[0];
			const reposition = () => {
				if (!line.isConnected) {
					window.removeEventListener("resize", reposition);
					return;
				}
				const rect = stepsEl!.getBoundingClientRect();
				const topY = remainderTileCenterY(rect, topRow);
				const bottomY = remainderTileCenterY(rect, bottomRow);
				line.style.transition = arrow.style.transition = "none";
				line.style.top = `${topY}px`;
				line.style.bottom = `${rect.height - bottomY}px`;
				arrow.style.top = `${topY}px`;
			};
			window.addEventListener("resize", reposition);
		}

		async function runConversion(value: number) {
			const token = ++runToken;

			if (errorEl) errorEl.hidden = true;
			if (stepsEl) stepsEl.innerHTML = "";
			if (resultEl) resultEl.hidden = true;

			const steps = computeDivisionSteps(value);
			const stepRows: HTMLElement[] = [];

			for (const step of steps) {
				if (token !== runToken || !stepsEl) return;
				const row = buildStepRow(step);
				stepsEl.appendChild(row);
				stepRows.push(row);
				await wait(STEP_DELAY_MS);
			}

			if (token !== runToken) return;

			await wait(PAUSE_BEFORE_REVEAL_MS);
			if (token !== runToken) return;

			const bits = decimalToBinary8(value);
			await revealResultBottomToTop(stepRows, bits, token);
		}

		form?.addEventListener("submit", (event) => {
			event.preventDefault();
			const raw = input?.value ?? "";
			const value = Number(raw);

			if (raw.trim() === "" || !Number.isInteger(value) || value < 0 || value > 255) {
				runToken++; // cancel any in-flight animation
				if (stepsEl) stepsEl.innerHTML = "";
				if (resultEl) resultEl.hidden = true;
				if (errorEl) {
					errorEl.textContent = "Enter a whole number between 0 and 255.";
					errorEl.hidden = false;
				}
				return;
			}

			runConversion(value);
		});
	});
</script>

<style is:global>
	.converter {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	.converter-form {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
	}

	.converter-label {
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.converter-input-row {
		display: flex;
		gap: 0.5rem;
	}

	.converter-input {
		width: 8rem;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 1rem;
		text-align: center;
		/* Just let them type — no click-to-increment spinner UI. */
		appearance: textfield;
		-moz-appearance: textfield;
	}

	.converter-input::-webkit-inner-spin-button,
	.converter-input::-webkit-outer-spin-button {
		appearance: none;
		-webkit-appearance: none;
		margin: 0;
	}

	.converter-input:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 25%, transparent);
	}

	.converter-submit {
		padding: 0.5rem 1.25rem;
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg));
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
		text-shadow: 0 0 6px var(--color-accent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transition:
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	.converter-submit:hover {
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
		box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.converter-submit:active {
		transform: scale(0.95);
	}

	.converter-error {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-danger);
	}

	.converter-steps {
		/* Shrink to the widest row's own content (matching DivisionLadder's
		   .ladder-rows) rather than stretching to the card's full width —
		   otherwise the connector, anchored to this container's right edge,
		   ends up floating far from the (centered, narrower) rows instead of
		   sitting right next to them like the static arrow above. */
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-right: 1.5rem;
		box-sizing: border-box;
	}

	/*
	 * The traveling connector that plays once all steps are on screen: a
	 * dashed line anchored at the bottom remainder tile, growing upward one
	 * row at a time (via the `top` transition below), with an arrowhead
	 * leading the way — tracing the same "read bottom to top" idea, and
	 * sitting at the same distance from the tiles, as the static arrow on
	 * the worked examples above (DivisionLadder.astro's `.ladder-arrow`),
	 * just animated instead of drawn all at once. It's left in place once
	 * the reveal finishes rather than fading out.
	 */
	.converter-travel-line {
		position: absolute;
		right: 0.7rem;
		width: 2px;
		background: repeating-linear-gradient(
			to bottom,
			var(--color-accent) 0,
			var(--color-accent) 4px,
			transparent 4px,
			transparent 8px
		);
		opacity: 0.85;
		transition: top 0.15s ease;
		pointer-events: none;
	}

	.converter-travel-arrow {
		position: absolute;
		right: 0.7rem;
		transform: translate(50%, -100%);
		color: var(--color-accent);
		font-size: 0.75rem;
		line-height: 1;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		transition: top 0.15s ease;
		pointer-events: none;
	}

	.converter-step-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		animation: converter-row-in 0.25s ease;
	}

	@keyframes converter-row-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.converter-num {
		min-width: 1.7rem;
		text-align: right;
		font-weight: 700;
		color: var(--color-text);
	}

	.converter-op {
		color: var(--color-text-muted);
	}

	.converter-rem-label {
		color: var(--color-text-muted);
		font-size: 0.78rem;
	}

	.converter-rem-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 22%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-text-muted);
	}

	.converter-rem-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	/* Brief pulse as the traveling connector passes each remainder tile. */
	.converter-rem-tile--visited {
		animation: converter-visited-pulse 0.4s ease-out;
	}

	@keyframes converter-visited-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 75%, transparent);
		}
		100% {
			box-shadow: 0 0 14px 4px color-mix(in srgb, var(--color-accent) 0%, transparent);
		}
	}

	.converter-result {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-border);
		animation: converter-row-in 0.3s ease;
	}

	.converter-result-label {
		margin: 0;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.converter-tiles {
		display: flex;
		width: 100%;
		max-width: 26rem;
		gap: 0.25rem;
		justify-content: center;
	}

	.converter-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 1 0;
		max-width: 3rem;
		aspect-ratio: 1 / 1;
		border-radius: 18%;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(0.95rem, 4vw, 1.4rem);
		color: var(--color-text-muted);
	}

	.converter-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	/* Not-yet-revealed result tile, waiting for the connector to reach its
	   source remainder — barely visible so the reveal reads as "arriving". */
	.converter-tile--pending {
		opacity: 0.2;
	}

	.converter-tile--reveal {
		animation: converter-tile-reveal 0.3s ease;
	}

	@keyframes converter-tile-reveal {
		0% {
			opacity: 0.2;
			transform: scale(0.75);
		}
		60% {
			opacity: 1;
			transform: scale(1.15);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
