---
// Clean line icons for the Byte Lab and Tools cards: one simple, recognisable
// symbol per lesson or tool, drawn on a 24×24 grid with round strokes in
// `currentColor` (the card sets the color — each Byte Lab group has its own).
// Deliberately no digits or 0/1 tiles, so the cards are easy to tell apart
// at a glance. Decorative only: the card's title names it.
interface Props {
	/** A lesson href ("/learn/compression") or a tool name ("clock"). */
	name: string;
	size?: number;
}

const { name, size = 28 } = Astro.props;
const key = name.replace(/^\/learn\//, "").replace(/^\/tools\//, "");

// Each entry is the inner SVG markup for one icon.
const ICONS: Record<string, string> = {
	// Binary & Data
	"what-is-binary": '<rect x="2" y="7" width="20" height="10" rx="5"/><circle cx="16" cy="12" r="3"/>',
	"counting-in-binary": '<path d="M6 5v14M10 5v14M14 5v14M18 5v14M3 16 21 8"/>',
	"bits-and-bytes":
		'<rect x="3" y="6" width="3.5" height="5" rx="1"/><rect x="7.8" y="6" width="3.5" height="5" rx="1"/><rect x="12.7" y="6" width="3.5" height="5" rx="1"/><rect x="17.5" y="6" width="3.5" height="5" rx="1"/><rect x="3" y="13" width="3.5" height="5" rx="1"/><rect x="7.8" y="13" width="3.5" height="5" rx="1"/><rect x="12.7" y="13" width="3.5" height="5" rx="1"/><rect x="17.5" y="13" width="3.5" height="5" rx="1"/>',
	"binary-hex-decimal": '<path d="M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4"/>',
	"how-computers-store-text": '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 17l4-10 4 10M9.5 13.5h5"/>',
	compression: '<path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/>',
	// Reliability & Correction
	"hamming-distance": '<rect x="2" y="8" width="20" height="8" rx="1.5"/><path d="M6 8v3M10 8v4M14 8v3M18 8v4"/>',
	"error-correction": '<circle cx="12" cy="12" r="9"/><path d="m8 12.5 3 3 5-6"/>',
	"redundancy-and-fault-tolerance":
		'<rect x="3" y="4" width="18" height="6.5" rx="1.5"/><rect x="3" y="13.5" width="18" height="6.5" rx="1.5"/><path d="M7 7.25h.01M7 16.75h.01M11 7.25h.01M11 16.75h.01"/>',
	// Networks & Systems
	abstraction: '<path d="m12 3 9 5-9 5-9-5 9-5z"/><path d="m3 12.5 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
	"packets-and-routing":
		'<circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="19" r="2"/><path d="M7 6h10M6 7.8l5 9.4M18 7.8l-5 9.4"/>',
	"bandwidth-and-latency": '<path d="M3.5 18a8.5 8.5 0 1 1 17 0"/><path d="m12 18 4.5-6.5"/><path d="M6.5 13.5h.01M8.5 9.5h.01M12 8h.01M15.5 9.5h.01"/>',
	"ipv4-vs-ipv6": '<path d="M12 21s-7-6-7-11.5a7 7 0 0 1 14 0C19 15 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
	scalability: '<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>',
	speedup: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
	"distributed-computing":
		'<circle cx="12" cy="12" r="2.5"/><circle cx="4.5" cy="5" r="1.8"/><circle cx="19.5" cy="5" r="1.8"/><circle cx="4.5" cy="19" r="1.8"/><circle cx="19.5" cy="19" r="1.8"/><path d="M6 6.4l4.2 3.9M18 6.4l-4.2 3.9M6 17.6l4.2-3.9M18 17.6l-4.2-3.9"/>',
	// Security
	"encryption-basics": '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11M12 15v2"/>',
	"public-key-cryptography": '<circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 9.3-9.3M16.5 6.5l3 3M14 9l2 2"/>',
	"password-strength": '<rect x="2" y="7" width="20" height="10" rx="2"/><path d="M7 10v4M5.3 11l3.4 2M5.3 13l3.4-2M12 10v4M10.3 11l3.4 2M10.3 13l3.4-2M17 10v4M15.3 11l3.4 2M15.3 13l3.4-2"/>',
	phishing: '<path d="M16 3v10.5a6 6 0 0 1-12 0V12l3 3"/><circle cx="16" cy="3" r="1"/>',
	// Practice
	"reading-a-byte": '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
	"writing-a-byte": '<path d="M16.5 3.5l4 4L8 20H4v-4L16.5 3.5z"/><path d="m13.5 6.5 4 4"/>',
	"binary-search": '<circle cx="10.5" cy="10.5" r="7"/><path d="m20.5 20.5-5-5M10.5 6.5v8"/>',
	"sorting-algorithms": '<path d="M5 20v-4M10 20v-8M15 20V8M20 20V4"/>',
	"pseudocode-practice": '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
	// Added lessons
	"logic-gates": '<path d="M6 6h5a6 6 0 0 1 0 12H6z"/><path d="M2 9h4M2 15h4M17 12h5"/>',
	"data-and-bias": '<path d="M12 3a9 9 0 1 0 9 9h-9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>',
	"inside-the-cpu":
		'<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
	"digital-footprint": '<ellipse cx="8" cy="8" rx="2.5" ry="4"/><ellipse cx="16" cy="15" rx="2.5" ry="4"/><path d="M6.5 14.5h3M14.5 21.5h3"/>',
	"lists-and-loops": '<path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/>',
	"debugging-and-testing":
		'<rect x="8" y="7" width="8" height="12" rx="4"/><path d="M12 7V5M9.5 3.5 11 6M14.5 3.5 13 6M8 11H4M8 15H4M16 11h4M16 15h4M12 11v8"/>',
	simulations:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.2"/><circle cx="16" cy="8" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="8" cy="16" r="1.2"/><circle cx="16" cy="16" r="1.2"/>',
	"hard-problems": '<path d="M6 2h12M6 22h12M7 2v4l5 6-5 6v4M17 2v4l-5 6 5 6v4"/>',
	"bias-and-digital-divide": '<path d="M12 3v18M8 21h8M5 7h14"/><path d="M5 7 2 14a3 3 0 0 0 6 0L5 7zM19 7l-3 7a3 3 0 0 0 6 0l-3-7z"/>',
	"copyright-and-open-source": '<circle cx="12" cy="12" r="9"/><path d="M15 9.5a3.5 3.5 0 1 0 0 5"/>',
	// Tools
	clock: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2h5M12 2v3"/>',
	seats: '<rect x="3" y="4" width="7" height="6" rx="1.5"/><rect x="14" y="4" width="7" height="6" rx="1.5"/><rect x="3" y="14" width="7" height="6" rx="1.5"/><rect x="14" y="14" width="7" height="6" rx="1.5"/>',
	picker: '<circle cx="12" cy="7.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/><path d="M19 3l.8 1.7L21.5 5.5l-1.7.8L19 8l-.8-1.7-1.7-.8 1.7-.8L19 3z"/>',
	binary: '<circle cx="5" cy="7" r="2"/><circle cx="12" cy="7" r="2"/><circle cx="19" cy="7" r="2"/><circle cx="5" cy="17" r="2"/><circle cx="12" cy="17" r="2"/><circle cx="19" cy="17" r="2"/><path d="M4 7h2M11 7h2M11 17h2"/>',
};

const markup = ICONS[key] ?? '<circle cx="12" cy="12" r="8"/>';
---

<svg
	class="line-icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={markup}
/>
