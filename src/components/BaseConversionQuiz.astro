---
// Ten-question multiple-choice quiz mixing all three conversion directions
// covered on this page: decimal→hex, hex→binary, and binary→decimal. Mirrors
// PracticeQuiz.astro / WritingPracticeQuiz.astro exactly in structure and
// behavior (modal, intro with Timed mode, exit confirmation, timer) — kept
// as a fully self-contained component, same as those two. This file never
// loads alongside them (three separate pages), so reusing their "quiz-"
// class names here is safe.
---

<div class="quiz-intro">
	<p class="quiz-intro-text">
		Decimal, binary, hex — can you convert between all three? Ten questions, one focused round.
	</p>
	<label class="quiz-timed-toggle">
		<input type="checkbox" data-timed-toggle />
		<span>Timed mode</span>
	</label>
	<button type="button" class="quiz-start" data-start>Start Quiz</button>
</div>

<div class="quiz-modal-overlay" data-quiz-overlay hidden>
	<div class="quiz-modal" role="dialog" aria-modal="true" aria-label="Practice quiz">
		<button type="button" class="quiz-modal-close" data-quiz-close aria-label="Close">×</button>
		<p class="quiz-timer" data-timer hidden>0:00</p>
		<div class="quiz-card" data-quiz></div>
		<div class="quiz-exit-confirm" data-exit-confirm hidden>
			<p class="quiz-exit-confirm-text">Exit quiz? Your progress will be lost.</p>
			<div class="quiz-exit-confirm-actions">
				<button type="button" class="quiz-exit-confirm-keep" data-exit-confirm-keep>Keep going</button>
				<button type="button" class="quiz-exit-confirm-exit" data-exit-confirm-exit>Exit</button>
			</div>
		</div>
	</div>
</div>

<script>
	import { decimalToBinary8, decimalToHex2 } from "../lib/numberBases";

	type Mode = "dec-to-hex" | "hex-to-bin" | "bin-to-dec";
	const MODES: Mode[] = ["dec-to-hex", "hex-to-bin", "bin-to-dec"];

	type BaseLabel = "DEC" | "HEX" | "BIN";

	interface Question {
		mode: Mode;
		decimal: number;
		bin: string;
		hex: string;
		given: string;
		baseLabel: BaseLabel;
		targetLabel: string;
		hint: string;
		options: string[];
		correctIndex: number;
	}

	function shuffle<T>(items: T[]): T[] {
		const arr = items.slice();
		for (let i = arr.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[arr[i], arr[j]] = [arr[j], arr[i]];
		}
		return arr;
	}

	function randomByte(): number {
		return Math.floor(Math.random() * 256);
	}

	function formatForMode(mode: Mode, decimal: number): string {
		if (mode === "dec-to-hex") return decimalToHex2(decimal);
		if (mode === "hex-to-bin") return decimalToBinary8(decimal);
		return String(decimal);
	}

	// The base of the *given* value — this is what was ambiguous before (a
	// bare number like "59" doesn't say whether it's decimal or something
	// else), so every question carries this alongside the value itself for
	// the small DEC/HEX/BIN badge rendered next to it.
	function givenFor(mode: Mode, decimal: number, bin: string, hex: string): { given: string; baseLabel: BaseLabel } {
		if (mode === "dec-to-hex") return { given: String(decimal), baseLabel: "DEC" };
		if (mode === "hex-to-bin") return { given: hex, baseLabel: "HEX" };
		return { given: bin, baseLabel: "BIN" };
	}

	function targetLabelFor(mode: Mode): string {
		if (mode === "dec-to-hex") return "hex";
		if (mode === "hex-to-bin") return "binary";
		return "decimal";
	}

	function hintFor(mode: Mode): string {
		if (mode === "dec-to-hex") return "Divide by 16 — the quotient is the first hex digit, the remainder is the second.";
		if (mode === "hex-to-bin") return "Convert each hex digit to its own 4-bit nibble, then join them.";
		return "Add up the value of every lit position (128, 64, 32, 16, 8, 4, 2, 1).";
	}

	function explanationFor(mode: Mode, decimal: number, bin: string, hex: string): string {
		if (mode === "dec-to-hex") {
			const high = Math.floor(decimal / 16);
			const low = decimal % 16;
			return `${decimal} ÷ 16 = ${high} remainder ${low} → ${hex}.`;
		}
		if (mode === "hex-to-bin") {
			return `${hex[0]} → ${bin.slice(0, 4)}, ${hex[1]} → ${bin.slice(4)} → ${bin}.`;
		}
		const values = Array.from({ length: 8 }, (_, i) => 2 ** (7 - i));
		const lit = values.filter((_, i) => bin[i] === "1");
		return lit.length > 0 ? `${bin} = ${lit.join(" + ")} = ${decimal}.` : `${bin} = 0.`;
	}

	// Builds a pool of plausible wrong decimal values relative to the correct
	// one — a single flipped bit, a single hex nibble off by one, the two hex
	// digits (or decimal digits) transposed, and nearby place-value slips —
	// then renders each candidate in whichever format the current question
	// asks for. Working from one shared "plausible wrong decimal" pool keeps
	// distractor quality consistent across all three question directions.
	function plausibleWrongDecimals(correct: number): number[] {
		const pool: number[] = [];
		const bin = decimalToBinary8(correct);
		const hex = decimalToHex2(correct);

		for (let i = 0; i < 8; i++) {
			const flipped = bin.split("");
			flipped[i] = flipped[i] === "1" ? "0" : "1";
			pool.push(parseInt(flipped.join(""), 2));
		}

		for (let i = 0; i < 2; i++) {
			const val = parseInt(hex[i], 16);
			for (const delta of [1, -1]) {
				const nextVal = (val + delta + 16) % 16;
				const digits = hex.split("");
				digits[i] = nextVal.toString(16).toUpperCase();
				pool.push(parseInt(digits.join(""), 16));
			}
		}

		pool.push(parseInt(hex[1] + hex[0], 16));

		const decStr = String(correct);
		if (decStr.length >= 2) {
			const digits = decStr.split("");
			[digits[0], digits[1]] = [digits[1], digits[0]];
			const swapped = parseInt(digits.join(""), 10);
			if (!Number.isNaN(swapped)) pool.push(swapped);
		}

		for (const offset of [1, 2, 4, 8, 16, 32, -1, -2, -4, -8, -16, -32]) {
			pool.push(correct + offset);
		}

		return pool.filter((n) => Number.isInteger(n) && n >= 0 && n <= 255 && n !== correct);
	}

	function pickDistractors(mode: Mode, correct: number): string[] {
		const correctFormatted = formatForMode(mode, correct);
		const seen = new Set<number>([correct]);
		const chosen: string[] = [];

		for (const candidate of shuffle(plausibleWrongDecimals(correct))) {
			if (seen.has(candidate)) continue;
			const formatted = formatForMode(mode, candidate);
			if (formatted === correctFormatted) continue;
			seen.add(candidate);
			chosen.push(formatted);
			if (chosen.length === 3) break;
		}

		// Extremely rare fallback (tiny pool near the range edges): pad out
		// with random distinct bytes.
		while (chosen.length < 3) {
			const candidate = randomByte();
			if (seen.has(candidate)) continue;
			const formatted = formatForMode(mode, candidate);
			if (formatted === correctFormatted) continue;
			seen.add(candidate);
			chosen.push(formatted);
		}

		return chosen;
	}

	function generateQuestions(count: number): Question[] {
		const used = new Set<string>();
		const questions: Question[] = [];

		while (questions.length < count) {
			const decimal = randomByte();
			const mode = MODES[Math.floor(Math.random() * MODES.length)];
			const key = `${mode}:${decimal}`;
			if (used.has(key)) continue;
			used.add(key);

			const bin = decimalToBinary8(decimal);
			const hex = decimalToHex2(decimal);
			const correct = formatForMode(mode, decimal);
			const distractors = pickDistractors(mode, decimal);
			const options = shuffle([correct, ...distractors]);
			const { given, baseLabel } = givenFor(mode, decimal, bin, hex);

			questions.push({
				mode,
				decimal,
				bin,
				hex,
				given,
				baseLabel,
				targetLabel: targetLabelFor(mode),
				hint: hintFor(mode),
				options,
				correctIndex: options.indexOf(correct),
			});
		}

		return questions;
	}

	function formatTime(totalSeconds: number): string {
		const minutes = Math.floor(totalSeconds / 60);
		const seconds = totalSeconds % 60;
		return `${minutes}:${String(seconds).padStart(2, "0")}`;
	}

	function scoreMessage(score: number, total: number): string {
		if (score === total) return "Perfect — you've got this down.";
		if (score >= total * 0.7) return "Solid — you're converting between bases like a pro.";
		if (score >= total * 0.4) return "Getting there — review the examples above and try again.";
		return "Binary takes practice — check the examples above if a few tripped you up.";
	}

	function setQuizActive(active: boolean) {
		document.dispatchEvent(new CustomEvent("quiz:active-change", { detail: { active } }));
	}

	document.querySelectorAll<HTMLElement>("[data-quiz-overlay]").forEach((overlay) => {
		const root = overlay.querySelector<HTMLElement>("[data-quiz]");
		if (!root) return;

		const startBtn = document.querySelector<HTMLButtonElement>("[data-start]");
		const timedToggle = document.querySelector<HTMLInputElement>("[data-timed-toggle]");
		const closeBtn = overlay.querySelector<HTMLButtonElement>("[data-quiz-close]");
		const timerEl = overlay.querySelector<HTMLElement>("[data-timer]");
		const exitConfirm = overlay.querySelector<HTMLElement>("[data-exit-confirm]");
		const exitConfirmKeepBtn = overlay.querySelector<HTMLButtonElement>("[data-exit-confirm-keep]");
		const exitConfirmExitBtn = overlay.querySelector<HTMLButtonElement>("[data-exit-confirm-exit]");

		let questions: Question[] = [];
		let current = 0;
		let score = 0;
		let showingResult = false;
		let timedMode = false;
		let timerStartedAt = 0;
		let timerIntervalId: number | undefined;

		function startTimer() {
			timerStartedAt = Date.now();
			if (timerEl) {
				timerEl.hidden = false;
				timerEl.textContent = "0:00";
			}
			timerIntervalId = window.setInterval(() => {
				if (timerEl) timerEl.textContent = formatTime(Math.floor((Date.now() - timerStartedAt) / 1000));
			}, 1000);
		}

		function stopTimer(): number {
			if (timerIntervalId !== undefined) {
				window.clearInterval(timerIntervalId);
				timerIntervalId = undefined;
			}
			if (timerEl) timerEl.hidden = true;
			return Math.floor((Date.now() - timerStartedAt) / 1000);
		}

		function openModal() {
			questions = generateQuestions(10);
			current = 0;
			score = 0;
			showingResult = false;
			timedMode = timedToggle?.checked ?? false;
			overlay.hidden = false;
			setQuizActive(true);
			render();
			if (timedMode) startTimer();
		}

		function closeModal() {
			if (exitConfirm) exitConfirm.hidden = true;
			stopTimer();
			overlay.hidden = true;
			setQuizActive(false);
		}

		function requestClose() {
			if (showingResult) {
				closeModal();
				return;
			}
			if (exitConfirm) exitConfirm.hidden = false;
		}

		function dismissExitConfirm() {
			if (exitConfirm) exitConfirm.hidden = true;
		}

		startBtn?.addEventListener("click", openModal);
		closeBtn?.addEventListener("click", requestClose);
		exitConfirmExitBtn?.addEventListener("click", closeModal);
		exitConfirmKeepBtn?.addEventListener("click", dismissExitConfirm);
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || overlay.hidden) return;
			if (exitConfirm && !exitConfirm.hidden) dismissExitConfirm();
			else requestClose();
		});

		function render() {
			if (current >= questions.length) {
				renderResult();
				return;
			}

			showingResult = false;

			const q = questions[current];
			const isLastQuestion = current === questions.length - 1;
			const nextLabel = isLastQuestion ? "See my score →" : "Next question →";

			root.innerHTML = `
				<p class="quiz-progress">Question ${current + 1} of ${questions.length}</p>
				<p class="quiz-prompt">
					What is
					<span class="quiz-prompt-value">${q.given}<span class="quiz-base-badge">${q.baseLabel}</span></span>
					in ${q.targetLabel}?
				</p>
				<button type="button" class="quiz-hint-toggle" data-hint-toggle>Show hint</button>
				<p class="quiz-hint" data-hint hidden>${q.hint}</p>
				<div class="quiz-options" data-options>
					${q.options
						.map(
							(opt, i) => `
						<button type="button" class="quiz-option" data-option data-index="${i}">
							<span class="quiz-option-bits">${opt}</span>
						</button>
					`,
						)
						.join("")}
				</div>
				<p class="quiz-explanation" data-explanation hidden></p>
				<button type="button" class="quiz-next" data-next hidden>${nextLabel}</button>
			`;

			wireQuestion(q);
		}

		function wireQuestion(q: Question) {
			const hintToggle = root.querySelector<HTMLButtonElement>("[data-hint-toggle]");
			const hintEl = root.querySelector<HTMLElement>("[data-hint]");
			hintToggle?.addEventListener("click", () => {
				if (!hintEl) return;
				hintEl.hidden = !hintEl.hidden;
				hintToggle.textContent = hintEl.hidden ? "Show hint" : "Hide hint";
			});

			const optionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-option]"));
			const explanationEl = root.querySelector<HTMLElement>("[data-explanation]");
			const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]");
			let answered = false;

			optionButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					if (answered) return;
					answered = true;

					const chosenIndex = Number(btn.dataset.index);
					const correct = chosenIndex === q.correctIndex;
					if (correct) score++;

					optionButtons.forEach((b, i) => {
						b.disabled = true;
						if (i === q.correctIndex) b.classList.add("quiz-option--correct");
						else if (i === chosenIndex) b.classList.add("quiz-option--incorrect");
					});

					const answerValue = q.options[q.correctIndex];
					const detail = explanationFor(q.mode, q.decimal, q.bin, q.hex);

					if (explanationEl) {
						explanationEl.textContent = (correct ? "Correct! " : `Not quite — the answer is ${answerValue}. `) + detail;
						explanationEl.hidden = false;
						explanationEl.classList.toggle("quiz-explanation--correct", correct);
						explanationEl.classList.toggle("quiz-explanation--incorrect", !correct);
					}

					if (nextBtn) nextBtn.hidden = false;
				});
			});

			nextBtn?.addEventListener("click", () => {
				current++;
				render();
			});
		}

		function renderResult() {
			showingResult = true;

			const scoreLine = timedMode
				? `${score}/${questions.length} — ${formatTime(stopTimer())}`
				: `${score}/${questions.length}`;

			root.innerHTML = `
				<div class="quiz-result">
					<p class="quiz-result-label">Your score</p>
					<p class="quiz-result-score">${scoreLine}</p>
					<p class="quiz-result-message">${scoreMessage(score, questions.length)}</p>
					<button type="button" class="quiz-restart" data-restart>Try again</button>
				</div>
			`;

			root.querySelector<HTMLButtonElement>("[data-restart]")?.addEventListener("click", () => {
				questions = generateQuestions(10);
				current = 0;
				score = 0;
				timedMode = false;
				if (timedToggle) timedToggle.checked = false;
				render();
			});
		}
	});
</script>

<style is:global>
	/*
	 * This component builds its per-question markup as an HTML string and
	 * injects it via innerHTML (see the script above), so these elements never
	 * receive Astro's scoped-style attribute. The style tag is global for that
	 * reason — every class below is prefixed "quiz-" to avoid colliding with
	 * other components' styles on the page. (This file never loads alongside
	 * PracticeQuiz.astro or WritingPracticeQuiz.astro — three separate pages —
	 * so reusing those same class names here is safe.)
	 */
	.quiz-intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}

	.quiz-intro-text {
		margin: 0;
		max-width: 22rem;
		font-size: 1rem;
		color: var(--color-text);
		text-align: center;
	}

	.quiz-timed-toggle {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		cursor: pointer;
		user-select: none;
	}

	.quiz-timed-toggle input[type="checkbox"] {
		width: 1rem;
		height: 1rem;
		accent-color: var(--color-accent);
		cursor: pointer;
	}

	.quiz-start {
		padding: 0.6rem 2rem;
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg));
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		text-shadow: 0 0 6px var(--color-accent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transition:
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.15s ease,
			background 0.15s ease;
	}

	.quiz-start:hover {
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
		box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.quiz-start:active {
		transform: scale(0.95);
	}

	.quiz-modal-overlay {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		background: rgba(6, 4, 2, 0.72);
		z-index: 100;
	}

	.quiz-modal-overlay[hidden] {
		display: none;
	}

	.quiz-modal {
		position: relative;
		width: 100%;
		max-width: 34rem;
		max-height: calc(100vh - 3rem);
		overflow-y: auto;
		background: #14313a;
		border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
		border-radius: 16px;
		padding: 2.25rem 1.75rem 1.75rem;
		box-shadow: 0 0 32px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	.quiz-modal-close {
		position: absolute;
		top: 0.6rem;
		right: 0.85rem;
		border: none;
		background: none;
		color: var(--color-text-muted);
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.25rem 0.4rem;
	}

	.quiz-modal-close:hover {
		color: var(--color-text);
	}

	.quiz-timer {
		margin: 0 0 0.6rem;
		width: 100%;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-text-muted);
	}

	.quiz-timer[hidden] {
		display: none;
	}

	.quiz-exit-confirm {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 1.75rem;
		background: color-mix(in srgb, #14313a 95%, black);
		border-radius: 16px;
		text-align: center;
	}

	.quiz-exit-confirm[hidden] {
		display: none;
	}

	.quiz-exit-confirm-text {
		margin: 0;
		max-width: 20rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.quiz-exit-confirm-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.quiz-exit-confirm-keep {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg));
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quiz-exit-confirm-keep:hover {
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}

	.quiz-exit-confirm-keep:active {
		transform: scale(0.95);
	}

	.quiz-exit-confirm-exit {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: transparent;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quiz-exit-confirm-exit:hover {
		border-color: var(--color-danger);
		color: var(--color-danger);
	}

	.quiz-exit-confirm-exit:active {
		transform: scale(0.95);
	}

	.quiz-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		width: 100%;
		margin: 0 auto;
	}

	.quiz-progress {
		margin: 0;
		width: 100%;
		text-align: center;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.quiz-prompt {
		margin: 0;
		text-align: center;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1.1rem, 5vw, 1.5rem);
		color: var(--color-text);
	}

	/* The given value gets its own emphasis, separate from the surrounding
	   plain-text question — its base badge (below) anchors to this box. */
	.quiz-prompt-value {
		position: relative;
		display: inline-block;
		padding: 0 0.15rem;
		color: #fff3d6;
		text-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	/*
