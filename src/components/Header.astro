---
const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/quick-byte/", label: "Quick Byte" },
	{ href: "/#puzzles", label: "Puzzles" },
	{ href: "/learn/", label: "Learn" },
	{ href: "/tools/", label: "Tools" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<a class="brand" href="/">
		Logic<span class="brand-accent">Dash</span>
	</a>
	<button
		type="button"
		class="nav-toggle"
		data-nav-toggle
		aria-expanded="false"
		aria-controls="site-nav"
		aria-label="Open menu"
	>
		<span class="nav-toggle-bar" />
		<span class="nav-toggle-bar" />
		<span class="nav-toggle-bar" />
	</button>
	<nav id="site-nav" data-nav>
		<ul>
			{
				navLinks.map((link) => {
					const activeBase = link.href.split("#")[0].replace(/\/$/, "") || "/";
					const isActive = link.href.includes("#")
						? false
						: activeBase === "/learn" || activeBase === "/tools"
							? currentPath.startsWith(activeBase)
							: currentPath.replace(/\/$/, "") === activeBase;
					return (
						<li>
							<a href={link.href} aria-current={isActive ? "page" : undefined}>
								{link.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
	const nav = document.querySelector<HTMLElement>("[data-nav]");

	function closeMenu() {
		nav?.classList.remove("is-open");
		toggle?.setAttribute("aria-expanded", "false");
	}

	function openMenu() {
		nav?.classList.add("is-open");
		toggle?.setAttribute("aria-expanded", "true");
	}

	toggle?.addEventListener("click", () => {
		if (nav?.classList.contains("is-open")) closeMenu();
		else openMenu();
	});

	// A link click always navigates away, but closing here too avoids a flash
	// of the still-open menu on pages that restore scroll position instantly.
	nav?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", closeMenu);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMenu();
	});

	document.addEventListener("click", (event) => {
		if (!nav?.classList.contains("is-open")) return;
		const target = event.target as Node;
		if (nav.contains(target) || toggle?.contains(target)) return;
		closeMenu();
	});
</script>

<style>
	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 1.25rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface);
		gap: 0.75rem;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		width: 2.3rem;
		height: 2.3rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle-bar {
		display: block;
		width: 1.1rem;
		height: 2px;
		border-radius: 1px;
		background: var(--color-text);
	}

	.brand {
		font-weight: 700;
		font-size: 1.25rem;
		text-decoration: none;
		color: var(--color-text);
	}

	.brand-accent {
		color: var(--color-accent);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		display: inline-block;
		text-decoration: none;
		color: var(--color-text-muted);
		font-weight: 600;
		font-size: 0.95rem;
		transition:
			color 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	nav a:hover {
		color: var(--color-text);
	}

	nav a:active {
		transform: scale(0.95);
		transition:
			color 0.15s ease,
			transform 0.1s ease-out;
	}

	nav a[aria-current="page"] {
		color: var(--color-accent);
	}

	/*
	 * Below this width the full nav's links start to crowd/wrap
	 * awkwardly (the horizontal list this used to fall back to), so it's
	 * replaced with a hamburger that opens a slide-down panel instead —
	 * above it, the nav bar stays exactly as it's always been. Raised from
	 * 820px to 960px (matching the site's own `main { max-width: 960px }`)
	 * once "Tools" became a 7th item — above the old 820px cutoff there
	 * wasn't quite enough room for all seven, so individual link text
	 * (e.g. "Quick Byte") started wrapping mid-word instead of the layout
	 * falling back to the hamburger. flex-wrap + justify-content: center
	 * above are a safety net for the row itself, not a substitute for this
	 * breakpoint — they only help once wrapping happens at the group
	 * (link) level rather than mid-word within one. Now raised again from
	 * 960px to 1080px because "Stats" became an 8th item; the previous
	 * comment's warning about adding an eighth link without revisiting
	 * this breakpoint is exactly what this bump addresses.
	 */
	@media (max-width: 840px) {
		.nav-toggle {
			display: flex;
		}

		nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			display: none;
			background: var(--color-surface);
			border-bottom: 1px solid var(--color-border);
			box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.5);
			z-index: 50;
		}

		nav.is-open {
			display: block;
		}

		nav ul {
			flex-direction: column;
			gap: 0;
			padding: 0.5rem 0;
		}

		nav a {
			display: block;
			padding: 0.75rem 1.25rem;
		}
	}
</style>
