---
// Interactive 8-bit counter for /learn/counting-in-binary's "Try It Yourself"
// section: +1/−1 buttons step a value from 0-255, an 8-bit tile row updates
// instantly to match, and the decimal value is shown alongside. Tiles that
// flip on a given step get a brief highlight pulse — the whole point of this
// widget is to let a student SEE which columns change on a rollover (e.g.
// 01111111 → 10000000, every tile at once), not just read about it.
//
// Built client-side via innerHTML for the tile row (same reasoning as
// ByteConverter.astro/PracticeQuiz.astro: the tiles don't exist until a
// button is clicked, so there's nothing for Astro to render ahead of time),
// so — same as those — this component's styles are global and every class is
// prefixed "bincounter-" to avoid colliding with anything else on the page.
---

<div class="bincounter">
	<div class="bincounter-tiles" data-bincounter-tiles></div>

	<div class="bincounter-readout">
		<span class="bincounter-decimal" data-bincounter-decimal>0</span>
		<span class="bincounter-decimal-label">decimal</span>
	</div>

	<div class="bincounter-controls">
		<button type="button" class="bincounter-btn" data-bincounter-minus aria-label="Subtract 1" disabled>
			−1
		</button>
		<button type="button" class="bincounter-btn" data-bincounter-plus aria-label="Add 1">+1</button>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>(".bincounter").forEach((root) => {
		const tilesEl = root.querySelector<HTMLElement>("[data-bincounter-tiles]");
		const decimalEl = root.querySelector<HTMLElement>("[data-bincounter-decimal]");
		const minusBtn = root.querySelector<HTMLButtonElement>("[data-bincounter-minus]");
		const plusBtn = root.querySelector<HTMLButtonElement>("[data-bincounter-plus]");
		if (!tilesEl || !decimalEl || !minusBtn || !plusBtn) return;

		let value = 0;
		let bits = value.toString(2).padStart(8, "0");

		function render(previousBits: string) {
			const nextBits = value.toString(2).padStart(8, "0");
			tilesEl!.innerHTML = nextBits
				.split("")
				.map((bit, i) => {
					const classes = ["bincounter-tile"];
					if (bit === "1") classes.push("bincounter-tile--on");
					if (previousBits[i] !== bit) classes.push("bincounter-tile--changed");
					return `<span class="${classes.join(" ")}">${bit}</span>`;
				})
				.join("");
			decimalEl!.textContent = String(value);
			minusBtn!.disabled = value <= 0;
			plusBtn!.disabled = value >= 255;
			bits = nextBits;
		}

		minusBtn.addEventListener("click", () => {
			if (value <= 0) return;
			const previous = bits;
			value -= 1;
			render(previous);
		});

		plusBtn.addEventListener("click", () => {
			if (value >= 255) return;
			const previous = bits;
			value += 1;
			render(previous);
		});

		render(bits);
	});
</script>

<style is:global>
	.bincounter {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	.bincounter-tiles {
		display: flex;
		width: 100%;
		max-width: 26rem;
		gap: 0.25rem;
		justify-content: center;
	}

	.bincounter-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 1 1 0;
		max-width: 3rem;
		aspect-ratio: 1 / 1;
		border-radius: 18%;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(0.95rem, 4vw, 1.4rem);
		color: var(--color-text-muted);
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			color 0.15s ease;
	}

	.bincounter-tile--on {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		color: #fff3d6;
		text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 65%, transparent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	/* The whole point of this widget: a tile that just flipped (either
	   direction) gets a visible pulse, so a run of several tiles lighting up
	   at once on a rollover step (e.g. 01111111 → 10000000) actually reads as
	   "look, all of these just changed together" rather than requiring the
	   student to compare two states themselves. */
	.bincounter-tile--changed {
		animation: bincounter-pulse 0.4s ease-out;
	}

	@keyframes bincounter-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 80%, transparent);
			transform: scale(1.12);
		}
		100% {
			box-shadow: 0 0 14px 4px color-mix(in srgb, var(--color-accent) 0%, transparent);
			transform: scale(1);
		}
	}

	.bincounter-readout {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.bincounter-decimal {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.7rem;
		color: #fff3d6;
		text-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 60%, transparent);
	}

	.bincounter-decimal-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.bincounter-controls {
		display: flex;
		gap: 0.5rem;
	}

	.bincounter-btn {
		min-width: 4.2rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg));
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.9rem;
		text-shadow: 0 0 6px var(--color-accent);
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 45%, transparent);
		cursor: pointer;
		transition:
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.15s ease,
			background 0.15s ease,
			opacity 0.15s ease;
	}

	.bincounter-btn:hover:not(:disabled) {
		background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg));
		box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 70%, transparent);
	}

	.bincounter-btn:active:not(:disabled) {
		transform: scale(0.95);
	}

	.bincounter-btn:disabled {
		opacity: 0.35;
		border-color: var(--color-border);
		background: var(--color-bg);
		color: var(--color-text-muted);
		text-shadow: none;
		box-shadow: none;
		cursor: not-allowed;
	}
</style>
