---
import Layout from "../layouts/Layout.astro";
import DemoRow from "../components/DemoRow.astro";
import BitChip from "../components/BitChip.astro";

// Distances deliberately avoid the maximum (bit length itself) — if every single digit
// were wrong, flipping all of them would trivially solve it next guess. That's not a useful
// example of the general mechanic, so these stick to more ordinary in-between distances.
const steps = [
	{ bits: "01110", distance: 3 },
	{ bits: "10110", distance: 1 },
	{ bits: "10100", distance: 0 },
];

const games = [
	{ href: "/5-bit", name: "Classic" },
	{ href: "/overclocked", name: "OverClocked" },
	{ href: "/quick-byte", name: "Play Quick Byte" },
];
---

<Layout
	title="How to Play"
	description="Learn LogicDash rules, Hamming distance clues, Quick Byte daily scoring, streaks and the 32-day activity punchcard."
>
	<section class="hero">
		<h1>Bits, Explained.</h1>
		<p class="hero-lead">Here's everything you need before your first guess.</p>
	</section>

	<div class="blocks">
		<section class="block">
			<p class="block-title">The Basics</p>
			<p class="block-text">
				Every LogicDash secret is binary — a pattern made only of <BitChip value="0" /> and{" "}
				<BitChip value="1" />. Tap a tile to flip it, build your guess, then hit Guess. Your goal is
				simple: match the secret exactly.
			</p>
		</section>

		<section class="block">
			<p class="block-title">Your Score</p>
			<p class="block-text">
				After each guess you get one number: the <em>Hamming distance</em>. It's how many digits
				differ from the secret — never which ones. Figuring that out is the whole game.
			</p>
		</section>

		<section class="block block--example">
			<p class="block-title">See It In Action</p>
			<p class="block-text">A few example guesses and their scores:</p>
			<div class="example-rows">
				{steps.map((step) => <DemoRow bits={step.bits} distance={step.distance} />)}
			</div>
		</section>

		<section class="block">
			<p class="block-title">Today's Quick Byte</p>
			<p class="block-text">
				This is a special daily challenge: three 5-bit rounds, played back-to-back. Each round is
				scored by how many guesses it took you — fewer is better. Everyone gets the same secrets, and
				a new set unlocks tomorrow.
			</p>
			<p class="block-text">
				Your result shows as a sequence like <em>4-2-5</em> — guesses taken per round, in order —
				plus a total: the sum of all three, so lower is better there too. Miss a round within your 6
				tries and it's marked <em>X</em> in the sequence instead of a number. When that happens, no
				total is shown for the day; a run with a miss isn't fairly comparable to a full clean run, so
				it just reads <em>Incomplete</em>.
			</p>
		</section>

		<section class="block">
			<p class="block-title">Streaks &amp; Your Activity Card</p>
			<p class="block-text">
				Finish all three Quick Byte rounds successfully on consecutive days to build your streak.
				Your results include a 32-day activity punchcard: each filled slot represents a day when
				you solved all three rounds. A missed day or an incomplete result breaks your current
				streak, but your longest streak is kept.
			</p>
			<p class="block-text">
				You'll see your <em>average guesses per round today</em> compared with your previous
				successful games. Lower is better. Statistics are saved in this browser,
				so they won't automatically follow you to another device.
			</p>
		</section>

		<section class="block">
			<p class="block-title">Tries &amp; Games</p>
			<p class="block-text">Each round allows up to 6 guesses. Start with today's challenge, or practise whenever you like:</p>
			<div class="ready-links">
				{
					games.map((game) => (
						<a class="ready-link" href={game.href}>
							{game.name}
						</a>
					))
				}
			</div>
		</section>
	</div>

	<p class="closing-note">
		Want to understand the maths behind the puzzle? <a href="/learn/hamming-distance/">Explore Hamming distance</a>
		in Byte Lab — or <a href="/quick-byte/">take on today's Quick Byte</a>.
	</p>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1rem;
	}

	.hero h1 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.6rem, 5vw, 2.1rem);
	}

	.hero-lead {
		margin: 0 auto;
		font-size: 1rem;
	}

	.blocks {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.block {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 14px;
		padding: 1rem 1.15rem;
	}

	.block-title {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #ffae2e;
	}

	.block-text {
		margin: 0;
		font-size: 1rem;
	}

	.block-text + .block-text {
		margin-top: 0.6rem;
	}

	.block-text em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.block--example {
		text-align: center;
	}

	.block--example .block-text {
		margin-bottom: 0.75rem;
	}

	.example-rows {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.ready-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.7rem;
	}

	.ready-link {
		padding: 0.45rem 1.1rem;
		border-radius: 999px;
		border: 1px solid #ffae2e;
		color: #ffae2e;
		font-weight: 600;
		font-size: 0.85rem;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.ready-link:hover {
		background: #ffae2e;
		color: #241202;
	}

	.ready-link:active {
		transform: scale(0.95);
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.1s ease-out;
	}

	.closing-note a { color: var(--color-accent); font-weight: 600; }

	.closing-note {
		margin: 1.25rem 0 0;
		text-align: center;
		font-size: 0.85rem;
	}
</style>
