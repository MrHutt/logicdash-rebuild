---
import Layout from "../layouts/Layout.astro";
import DemoRow from "../components/DemoRow.astro";

const steps = [
	{ bits: "01011", result: "5 bits off", note: "Way off. Try something different." },
	{ bits: "11000", result: "2 bits off", note: "Closer. Adjust and try again." },
	{ bits: "10100", result: "Match!", note: "Got it.", variant: "match" as const },
];

const games = [
	{ href: "/5-bit", name: "Classic" },
	{ href: "/overclocked", name: "OverClocked" },
	{ href: "/quick-byte", name: "Today's Quick Byte" },
];
---

<Layout title="How to Play">
	<section class="hero">
		<h1>Bits, Explained.</h1>
		<p class="hero-subline">Guess the secret pattern of 1s and 0s.</p>
	</section>

	<section class="example">
		<div class="example-steps">
			{
				steps.map((step) => (
					<div class="example-step">
						<DemoRow bits={step.bits} result={step.result} variant={step.variant} />
						<span class="example-note">{step.note}</span>
					</div>
				))
			}
		</div>
	</section>

	<p class="rule-line">
		You always learn <em>how many</em> digits are wrong, never <em>which</em> ones.
	</p>

	<p class="attempts-line">You get 6 tries per game.</p>

	<section class="ready">
		<p class="ready-label">Ready? Pick a game:</p>
		<div class="ready-links">
			{
				games.map((game) => (
					<a class="ready-link" href={game.href}>
						{game.name}
					</a>
				))
			}
		</div>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1rem;
	}

	.hero h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.6rem, 5vw, 2.1rem);
	}

	.hero-subline {
		margin: 0 auto;
		max-width: 26rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.example {
		margin-bottom: 1rem;
	}

	.example-steps {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}

	.example-step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.example-note {
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.rule-line {
		margin: 0 auto;
		max-width: 32rem;
		text-align: center;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.rule-line em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.attempts-line {
		margin: 0.4rem auto 1.25rem;
		text-align: center;
		font-size: 0.85rem;
	}

	.ready {
		text-align: center;
	}

	.ready-label {
		margin: 0 0 0.6rem;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.ready-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.ready-link {
		padding: 0.45rem 1.1rem;
		border-radius: 999px;
		border: 1px solid #ffae2e;
		color: #ffae2e;
		font-weight: 600;
		font-size: 0.85rem;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.ready-link:hover {
		background: #ffae2e;
		color: #241202;
	}
</style>
