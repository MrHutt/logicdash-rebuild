---
import Layout from "../layouts/Layout.astro";
import { SEGMENT_POINTS, SEGMENTS_BY_DIGIT } from "../lib/hammingGame";

const teaserBits = ["1", "0", "1", "1", "0"];

const games = [
	{
		href: "/5-bit",
		name: "Classic",
		blurb: "The original 5-bit puzzle. Six guesses.",
	},
	{
		href: "/overclocked",
		name: "OverClocked",
		blurb: "Same rules, 6 bits. Tighter odds, sharper focus.",
	},
];
---

<Layout title="LogicDash">
	<section class="hero">
		<h1>Guess the bits. Beat the distance.</h1>
		<p>
			LogicDash is a quick logic game. We pick a secret pattern of 1s and 0s. You guess it. After
			each guess, we tell you <em>how many</em> digits are wrong — never <em>which</em>{" "}
			ones. Use logic to find the answer.
		</p>
		<p class="hero-flavor">Warning: known to blow a few mental fuses.</p>
	</section>

	<img
		class="hero-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="eager"
	/>

	<div class="teaser">
		<div class="teaser-tiles">
			{
				teaserBits.map((bit) => (
					<span class={`teaser-tile ${bit === "1" ? "teaser-tile--on" : ""}`}>
						<svg class="teaser-digit" viewBox="0 0 60 100" aria-hidden="true">
							{Object.entries(SEGMENT_POINTS).map(([seg, points]) => (
								<polygon
									class={`teaser-segment ${SEGMENTS_BY_DIGIT[bit].includes(seg) ? "is-on" : ""}`}
									points={points}
								/>
							))}
						</svg>
					</span>
				))
			}
		</div>
		<span class="teaser-badge">2 bits off</span>
	</div>
	<p class="teaser-caption">That's the idea. Try it for real below.</p>

	<a class="quick-byte-feature" href="/quick-byte">
		<div class="quick-byte-feature-text">
			<span class="quick-byte-feature-label">Daily challenge</span>
			<span class="quick-byte-feature-name">Today's Quick Byte</span>
			<span class="quick-byte-feature-blurb"
				>Three rounds, once a day — same puzzle for everyone. This is the one to come back for.</span
			>
		</div>
		<span class="quick-byte-feature-cta">Play Now →</span>
	</a>

	<section class="game-picker">
		<h2>Or play anytime</h2>
		<div class="game-cards">
			{
				games.map((game) => (
					<a class="game-card" href={game.href}>
						<span class="game-card-name">{game.name}</span>
						<span class="game-card-blurb">{game.blurb}</span>
					</a>
				))
			}
		</div>
	</section>

	<p class="how-to-play-note">New here? <a href="/how-to-play">Learn how to play</a> in under a minute.</p>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1rem;
	}

	.hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.5rem, 4.5vw, 2.1rem);
	}

	.hero p {
		margin: 0 auto;
		max-width: 46rem;
		font-size: 0.9rem;
	}

	.hero em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.hero-flavor {
		margin: 0.5rem auto 0;
		max-width: 40rem;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		opacity: 0.8;
	}

	.hero-art {
		display: block;
		width: 100%;
		max-width: 17.6rem;
		height: auto;
		margin: 0 auto 1rem;
	}

	.teaser {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0 0 0.4rem;
	}

	.teaser-tiles {
		display: flex;
		gap: 0.3rem;
	}

	.teaser-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 22%;
		border: 1px solid #2b1f16;
		background: #120d09;
	}

	.teaser-tile--on {
		border-color: #ffae2e;
		box-shadow: 0 0 10px color-mix(in srgb, #ffae2e 55%, transparent);
	}

	.teaser-digit {
		width: 68%;
		height: 68%;
		overflow: visible;
	}

	.teaser-segment {
		fill: #1c140f;
	}

	.teaser-tile:not(.teaser-tile--on) .teaser-segment.is-on {
		fill: #4a3420;
	}

	.teaser-tile--on .teaser-segment.is-on {
		fill: #fff3d6;
		filter:
			drop-shadow(0 0 3px #ffae2e)
			drop-shadow(0 0 8px #ffae2e);
	}

	.teaser-badge {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		border: 1px solid #ffae2e;
		color: #ffae2e;
		background: color-mix(in srgb, #ffae2e 16%, transparent);
	}

	.teaser-caption {
		text-align: center;
		margin: 0 0 1.5rem;
		font-size: 0.8rem;
	}

	.quick-byte-feature {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.9rem;
		margin-bottom: 1.5rem;
		padding: 1.4rem;
		border-radius: 14px;
		border: 1px solid var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
		text-decoration: none;
		transition:
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.quick-byte-feature:hover {
		box-shadow: 0 0 22px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transform: translateY(-1px);
	}

	.quick-byte-feature-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.quick-byte-feature-label {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.quick-byte-feature-name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.quick-byte-feature-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.quick-byte-feature-cta {
		flex-shrink: 0;
		padding: 0.6rem 1.5rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	.game-picker h2 {
		margin: 0 0 0.6rem;
		text-align: center;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.game-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.75rem;
	}

	.game-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.game-card:hover {
		border-color: #ffae2e;
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 35%, transparent);
		transform: translateY(-1px);
	}

	.game-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text);
	}

	.game-card-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.how-to-play-note {
		margin: 1.25rem 0 0;
		text-align: center;
		font-size: 0.85rem;
	}

	.how-to-play-note a {
		color: #ffae2e;
		font-weight: 600;
	}
</style>
