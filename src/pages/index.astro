---
import Layout from "../layouts/Layout.astro";

const games = [
	{
		href: "/5-bit",
		name: "Classic",
		blurb: "The original 5-bit puzzle. Six guesses.",
	},
	{
		href: "/overclocked",
		name: "OverClocked",
		blurb: "Same rules, 6 bits. Tighter odds, sharper focus.",
	},
];
---

<Layout
	title="LogicDash"
	description="Guess the secret binary pattern in 6 tries using only Hamming distance clues. Play Classic, OverClocked, or today's daily Quick Byte puzzle."
>
	<section class="hero">
		<h1>A bit of a puzzle.</h1>
		<p class="hero-subline">Guess the secret pattern of 1s and 0s in 6 tries.</p>
		<p class="hero-mechanic">
			Each guess tells you <em>how many</em> digits are wrong, never <em>which</em> ones.
		</p>
		<p class="hero-flavor">Warning: known to blow a few mental fuses.</p>
	</section>

	<img
		class="hero-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="eager"
	/>

	<p class="hero-slogan">Solve it. Bit by bit.</p>

	<a class="quick-byte-feature" href="/quick-byte/">
		<div class="quick-byte-feature-text">
			<span class="quick-byte-feature-label">Daily challenge</span>
			<span class="quick-byte-feature-name">Today's Quick Byte</span>
			<span class="quick-byte-feature-blurb"
				>Three rounds, once a day — same puzzle for everyone. This is the one to come back for.</span
			>
		</div>
		<span class="quick-byte-feature-cta">Play Now →</span>
	</a>

	<section class="game-picker">
		<h2>Or play anytime</h2>
		<div class="game-cards">
			{
				games.map((game) => (
					<a class="game-card" href={game.href}>
						<span class="game-card-name">{game.name}</span>
						<span class="game-card-blurb">{game.blurb}</span>
					</a>
				))
			}
		</div>
	</section>

	<p class="how-to-play-note">New here? <a href="/how-to-play/">Learn how to play</a> in under a minute.</p>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 0.6rem;
	}

	.hero h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.6rem, 5vw, 2.3rem);
	}

	.hero-subline {
		margin: 0 auto;
		max-width: 28rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.hero-mechanic {
		margin: 0.35rem auto 0;
		max-width: 34rem;
		font-size: 0.8rem;
	}

	.hero em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.hero-flavor {
		margin: 0.4rem auto 0;
		max-width: 40rem;
		font-size: 0.68rem;
		font-style: italic;
		color: var(--color-text-muted);
		opacity: 0.65;
	}

	.hero-art {
		display: block;
		width: 100%;
		max-width: 8.5rem;
		height: auto;
		margin: 0 auto 0.6rem;
	}

	.hero-slogan {
		text-align: center;
		margin: 0 0 1.25rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: #ffae2e;
	}

	.quick-byte-feature {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.9rem;
		margin-bottom: 1.5rem;
		padding: 1.4rem;
		border-radius: 14px;
		border: 1px solid var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
		text-decoration: none;
		transition:
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.quick-byte-feature:hover {
		box-shadow: 0 0 22px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transform: translateY(-1px);
	}

	.quick-byte-feature-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.quick-byte-feature-label {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.quick-byte-feature-name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.quick-byte-feature-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.quick-byte-feature-cta {
		flex-shrink: 0;
		padding: 0.6rem 1.5rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 55%, transparent);
		transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quick-byte-feature:active .quick-byte-feature-cta {
		transform: scale(0.95);
		transition: transform 0.1s ease-out;
	}

	.game-picker h2 {
		margin: 0 0 0.6rem;
		text-align: center;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.game-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.75rem;
	}

	.game-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.game-card:hover {
		border-color: #ffae2e;
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 35%, transparent);
		transform: translateY(-1px);
	}

	.game-card:active {
		transform: scale(0.97);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.game-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text);
	}

	.game-card-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.how-to-play-note {
		margin: 1.25rem 0 0;
		text-align: center;
		font-size: 0.85rem;
	}

	.how-to-play-note a {
		color: #ffae2e;
		font-weight: 600;
	}
</style>
