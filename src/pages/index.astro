---
import Layout from "../layouts/Layout.astro";

const games = [
	{
		href: "/5-bit",
		name: "LogicDash",
		blurb: "The original 5-bit puzzle. Six guesses, play anytime.",
	},
	{
		href: "/overclocked",
		name: "OverClocked",
		blurb: "Same rules, 6 bits. Tighter odds, sharper focus.",
	},
];
---

<Layout title="LogicDash">
	<section class="hero">
		<p class="hero-brand">Logic<span class="hero-brand-accent">Dash</span></p>
		<h1>Guess the bits. Beat the distance.</h1>
		<p>
			LogicDash is a set of quick binary logic puzzles — a sharp little workout for pattern
			recognition and deductive thinking. Flip toggles to build a guess; each round only tells you{" "}
			<em>how many</em> bits are wrong, never <em>which</em>{" "}
			ones, until you close the distance to zero.
		</p>
	</section>

	<img
		class="hero-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="eager"
	/>

	<a class="quick-byte-feature" href="/quick-byte">
		<div class="quick-byte-feature-text">
			<span class="quick-byte-feature-label">Daily challenge</span>
			<span class="quick-byte-feature-name">Today's Quick Byte</span>
			<span class="quick-byte-feature-blurb"
				>Three rounds, once a day — same puzzle for everyone. This is the one to come back for.</span
			>
		</div>
		<span class="quick-byte-feature-cta">Play Today's Byte →</span>
	</a>

	<section class="game-picker">
		<h2>Or play anytime</h2>
		<div class="game-cards">
			{
				games.map((game) => (
					<a class="game-card" href={game.href}>
						<span class="game-card-name">{game.name}</span>
						<span class="game-card-blurb">{game.blurb}</span>
					</a>
				))
			}
		</div>
	</section>

	<p class="how-to-play-note">New here? <a href="/how-to-play">Learn how to play</a> in under a minute.</p>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1rem;
	}

	.hero-brand {
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1rem, 2.5vw, 1.25rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.hero-brand-accent {
		color: var(--color-accent);
	}

	.hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.5rem, 4.5vw, 2.1rem);
	}

	.hero p {
		margin: 0 auto;
		max-width: 46rem;
		font-size: 0.9rem;
	}

	.hero em {
		color: var(--color-text);
		font-style: normal;
		font-weight: 700;
	}

	.hero-art {
		display: block;
		width: 100%;
		max-width: 17.6rem;
		height: auto;
		margin: 0 auto 1.5rem;
	}

	.quick-byte-feature {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding: 1.1rem 1.4rem;
		border-radius: 14px;
		border: 1px solid var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
		text-decoration: none;
		transition:
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.quick-byte-feature:hover {
		box-shadow: 0 0 22px color-mix(in srgb, var(--color-accent) 45%, transparent);
		transform: translateY(-1px);
	}

	.quick-byte-feature-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.quick-byte-feature-label {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.quick-byte-feature-name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.quick-byte-feature-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.quick-byte-feature-cta {
		flex-shrink: 0;
		padding: 0.6rem 1.5rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	.game-picker h2 {
		margin: 0 0 0.6rem;
		text-align: center;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.game-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 0.75rem;
	}

	.game-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease;
	}

	.game-card:hover {
		border-color: #ffae2e;
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 35%, transparent);
		transform: translateY(-1px);
	}

	.game-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text);
	}

	.game-card-blurb {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.how-to-play-note {
		margin: 1.25rem 0 0;
		text-align: center;
		font-size: 0.85rem;
	}

	.how-to-play-note a {
		color: #ffae2e;
		font-weight: 600;
	}
</style>
