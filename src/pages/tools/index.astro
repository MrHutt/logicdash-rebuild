---
import Layout from "../../layouts/Layout.astro";
import SegmentDigit from "../../components/SegmentDigit.astro";

const TOOLS = [
	{
		href: "/tools/countdown-clock",
		title: "Countdown Clock",
		blurb: "A countdown timer with ten different retro-inspired display styles to choose from, perfect for timing activities and tests.",
		icon: "clock",
	},
	{
		href: "/tools/student-picker",
		title: "Student Picker",
		blurb: "Randomly picks students from your roster with a fun reveal animation — no one gets picked twice until everyone's had a turn, plus random pairs and splitting the class into groups.",
		icon: "picker",
	},
	{
		href: "/tools/binary-clock",
		title: "Binary Clock",
		blurb: "A binary counter that counts up or down on its own — great for demonstrating, or just running in the background, how numbers look in binary.",
		icon: "binary",
	},
] as const;
---

<Layout
	title="Tools"
	description="Free classroom tools from LogicDash — a countdown clock, a random student picker, and a binary counter, ready to project."
>
	<section class="hero">
		<h1>Tools</h1>
		<p class="hero-lead">
			Free classroom tools, built to be projected at the front of the room and actually used — no sign-in, no
			ads. Each one borrows its look from a real piece of retro display tech (Nixie tubes, split-flap boards,
			VFDs) and matches LogicDash's own amber, nixie-tube-inspired style, so they feel like part of the same
			toolkit rather than a bolted-on extra. Pick one, put it on screen, and get on with class.
		</p>
	</section>

	<div class="tool-cards">
		{
			TOOLS.map((tool) => (
				<a class="tool-card" href={tool.href}>
					<div class="tool-icon" aria-hidden="true">
						{tool.icon === "clock" && (
							<div class="icon-scale-wrap">
								<div class="icon-scale-inner">
									<SegmentDigit value="1" />
									<SegmentDigit value="2" />
									<span class="mini-colon">
										<span class="mini-colon-dot" />
										<span class="mini-colon-dot" />
									</span>
									<SegmentDigit value="0" />
									<SegmentDigit value="0" />
								</div>
							</div>
						)}
						{tool.icon === "picker" && (
							<div class="ti-picker-row">
								<span class="ti-picker-name ti-picker-name--dim">Ben</span>
								<span class="ti-picker-name ti-picker-name--picked">Dana</span>
								<span class="ti-picker-name ti-picker-name--dim">Kai</span>
							</div>
						)}
						{tool.icon === "binary" && (
							<div class="icon-scale-wrap">
								<div class="icon-scale-inner">
									<SegmentDigit value="1" />
									<SegmentDigit value="0" />
									<SegmentDigit value="1" />
									<SegmentDigit value="1" />
									<SegmentDigit value="0" />
								</div>
							</div>
						)}
					</div>
					<div class="tool-card-body">
						<span class="tool-card-name">{tool.title}</span>
						<span class="tool-card-blurb">{tool.blurb}</span>
					</div>
				</a>
			))
		}
	</div>
</Layout>

<style>
	.hero {
		text-align: center;
		margin: 0 auto 1.5rem;
		max-width: 40rem;
	}

	.hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.6rem, 5vw, 2.1rem);
	}

	.hero-lead {
		margin: 0 auto;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	/* One tool per row — each card gets full width to lay out icon and text
	   side by side, rather than competing for space in a narrow column. */
	.tool-cards {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 40rem;
		margin: 0 auto;
	}

	.tool-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 0.9rem 1.25rem;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		text-align: left;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.tool-card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 35%, transparent);
		transform: translateY(-1px);
	}

	.tool-card:active {
		transform: scale(0.98);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.tool-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.tool-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text);
	}

	.tool-card-blurb {
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--color-text-muted);
	}

	/* --- Bespoke mini previews, one per tool — same "built from the site's
	   own tile visual language" approach as TopicIcon.astro on /learn. Every
	   card's icon sits in the same fixed-size box so the row of cards lines
	   up cleanly regardless of which preview is inside it. ---------------- */

	.tool-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 7rem;
		height: 2.75rem;
	}

	/* Countdown Clock and Binary Clock previews embed the real SegmentDigit
	   component (the actual /tools/countdown-clock and /tools/binary-clock
	   markup) rather than an approximation — pixel-identical to the real
	   tool, just shrunk to icon size. SegmentDigit's own natural size
	   (clamp(2.2rem, 8vw, 3.6rem), see SegmentDigit.astro) is much bigger
	   than this card's icon area and isn't overridable from outside its
	   own component scope, so it's rendered at natural size inside
	   .icon-scale-inner and visually shrunk with a transform; .icon-
	   scale-wrap is a fixed-height window that clips the untransformed
	   layout box down to size (transform doesn't change layout
	   dimensions, only paint). 0.4 (down from an earlier, cramped 0.55) is
	   what actually fits the digits' natural ~96px height inside this
	   smaller row-icon box with room to spare, instead of clipping them. */
	.icon-scale-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.icon-scale-inner {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		transform: scale(0.4);
	}

	.mini-colon {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.mini-colon-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: #fff3d6;
		box-shadow:
			0 0 2px #fff3d6,
			0 0 6px var(--color-accent);
	}

	.ti-picker-row {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.ti-picker-name {
		padding: 0.25rem 0.4rem;
		border-radius: 6px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.6rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.ti-picker-name--dim {
		opacity: 0.5;
	}

	.ti-picker-name--picked {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 16%, var(--color-bg));
		color: #fff3d6;
		box-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	@media (max-width: 460px) {
		.tool-card {
			flex-direction: column;
			text-align: center;
			padding: 1.25rem 1rem;
		}

		.tool-card-body {
			align-items: center;
		}
	}
</style>
