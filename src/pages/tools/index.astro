---
import Layout from "../../layouts/Layout.astro";
import LineIcon from "../../components/LineIcon.astro";

// Each tool gets its own soft color (same palette as the Byte Lab groups;
// no cyan) so the four cards are easy to tell apart at a glance.
const TOOLS = [
	{
		href: "/tools/countdown-clock",
		title: "Countdown Clock",
		blurb: "A big, bright timer that fills the projector screen.",
		features: ["Quick times", "Time's-up chime", "10 display styles"],
		icon: "clock",
		color: "#ffae2e",
	},
	{
		href: "/tools/seating-chart",
		title: "Seating Chart",
		blurb: "Paste your class list and get a seating plan in seconds.",
		features: ["Rows, groups or U-shape", "Keep-apart rules", "Print or project"],
		icon: "seats",
		color: "#a78bfa",
	},
	{
		href: "/tools/student-picker",
		title: "Student Picker",
		blurb: "Pick a student at random, with a fun reveal.",
		features: ["Fair turns", "Random pairs", "Split into groups"],
		icon: "picker",
		color: "#f472b6",
	},
	{
		href: "/tools/binary-clock",
		title: "Binary Clock",
		blurb: "Watch numbers count up or down in binary.",
		features: ["Counts on its own", "Great for demos", "Up or down"],
		icon: "binary",
		color: "#60a5fa",
	},
] as const;
---

<Layout
	wide
	title="Tools"
	description="Free classroom tools from LogicDash — a big countdown clock, a seating chart maker, a random student picker, and a binary clock, ready to project."
>
	<section class="hero">
		<h1>Classroom Tools</h1>
		<p class="hero-lead">Free tools made for the front of the room. No sign-in, no ads — and class lists never leave your device.</p>
	</section>

	<div class="tool-cards">
		{
			TOOLS.map((tool) => (
				<a class="tool-card" href={tool.href} style={`--c: ${tool.color}`}>
					<span class="tool-icon">
						<LineIcon name={tool.icon} size={36} />
					</span>
					<span class="tool-card-body">
						<span class="tool-card-name">{tool.title}</span>
						<span class="tool-card-blurb">{tool.blurb}</span>
						<span class="tool-card-features">
							{tool.features.map((f) => (
								<span class="tool-feature">{f}</span>
							))}
						</span>
					</span>
					<span class="tool-card-go" aria-hidden="true">
						Open →
					</span>
				</a>
			))
		}
	</div>

	<p class="tools-note">
		Every tool has a <strong>Fullscreen</strong> button for the projector. Class lists you save are kept on this device
		only. Looking for lessons? Try <a href="/learn">Byte Lab</a>.
	</p>
</Layout>

<style>
	.hero {
		text-align: center;
		margin: 0 auto var(--space-6);
		max-width: 42rem;
	}

	.hero h1 {
		margin: 0 0 var(--space-2);
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.hero-lead {
		margin: 0 auto;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	/* Two across from tablet width, one on phones. */
	.tool-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
		gap: var(--space-4);
		max-width: 64rem;
		margin: 0 auto;
	}

	.tool-card {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-areas:
			"icon body"
			"icon go";
		column-gap: var(--space-5);
		row-gap: var(--space-3);
		padding: var(--space-6);
		border-radius: 18px;
		border: 1px solid var(--color-border);
		background:
			radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--c) 12%, transparent), transparent 60%),
			var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.tool-card:hover,
	.tool-card:focus-visible {
		border-color: var(--c);
		box-shadow: 0 10px 32px -12px color-mix(in srgb, var(--c) 60%, transparent);
		transform: translateY(-2px);
	}

	.tool-card:active {
		transform: scale(0.98);
	}

	.tool-icon {
		grid-area: icon;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 72px;
		height: 72px;
		border-radius: 18px;
		background: color-mix(in srgb, var(--c) 16%, var(--color-bg));
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		color: var(--c);
	}

	.tool-card-body {
		grid-area: body;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.tool-card-name {
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-text);
	}

	.tool-card-blurb {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.tool-card-features {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}

	.tool-feature {
		padding: 2px var(--space-3);
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		font-size: 0.8125rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--color-text);
	}

	.tool-card-go {
		grid-area: go;
		justify-self: start;
		font-weight: 700;
		color: var(--c);
	}

	@media (max-width: 480px) {
		.tool-card {
			column-gap: var(--space-4);
			padding: var(--space-5);
		}

		.tool-icon {
			width: 56px;
			height: 56px;
		}

		.tool-card-body {
			min-width: 0;
		}

		.tool-feature {
			white-space: normal;
		}
	}

	.tools-note {
		max-width: 42rem;
		margin: var(--space-6) auto 0;
		text-align: center;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	.tools-note strong {
		color: var(--color-text);
	}

	.tools-note a {
		color: var(--color-accent);
		font-weight: 600;
	}
</style>
