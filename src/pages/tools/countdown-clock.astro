---
// Published classroom tool — linked from the /tools hub page (src/pages/
// tools/index.astro) and reachable from the main nav's Tools link. Indexable:
// included in the sitemap (see astro.config.mjs) and allowed in robots.txt.
import Layout from "../../layouts/Layout.astro";
import SegmentDigit from "../../components/SegmentDigit.astro";
import SplitFlapDigit from "../../components/SplitFlapDigit.astro";
import NixieGlyphDigit from "../../components/NixieGlyphDigit.astro";
import TerminalDigit from "../../components/TerminalDigit.astro";
import ChaosModeDigit from "../../components/ChaosModeDigit.astro";
import DotMatrixDigit from "../../components/DotMatrixDigit.astro";
import RefinedDigit from "../../components/RefinedDigit.astro";
---

<Layout
	wide
	title="Countdown Clock"
	description="A big, bright classroom countdown timer: one-tap times, a progress bar, a time's-up chime, and ten retro display styles that fill the projector screen."
>
	<div class="clock-tool" data-clock-root>
		<div class="clock-header">
			<h1 class="clock-title">Countdown Clock</h1>
			<p class="clock-subtitle">
				A big, bright classroom timer. Tap a time, press Start, then go fullscreen for the projector.
			</p>
		</div>

		<div class="display-shell" data-display-shell>
			<div class="display-stage" data-display-stage data-style="nixie">
				<div class="nixieglyph-display" data-nixieglyph-display hidden>
					<NixieGlyphDigit value="0" />
					<NixieGlyphDigit value="0" />
					<span class="nixie-glyph-colon" aria-hidden="true">
						<span class="nixie-glyph-colon-dot" />
						<span class="nixie-glyph-colon-dot" />
					</span>
					<NixieGlyphDigit value="0" />
					<NixieGlyphDigit value="0" />
					<span class="nixie-glyph-colon" aria-hidden="true">
						<span class="nixie-glyph-colon-dot" />
						<span class="nixie-glyph-colon-dot" />
					</span>
					<NixieGlyphDigit value="0" />
					<NixieGlyphDigit value="0" />
				</div>

				<div class="segment-display" data-segment-display hidden>
					<SegmentDigit value="0" />
					<SegmentDigit value="0" />
					<span class="segment-colon" aria-hidden="true">
						<span class="segment-colon-dot" />
						<span class="segment-colon-dot" />
					</span>
					<SegmentDigit value="0" />
					<SegmentDigit value="0" />
					<span class="segment-colon" aria-hidden="true">
						<span class="segment-colon-dot" />
						<span class="segment-colon-dot" />
					</span>
					<SegmentDigit value="0" />
					<SegmentDigit value="0" />
				</div>

				<div class="terminal-display" data-terminal-display hidden>
					<TerminalDigit value="0" />
					<TerminalDigit value="0" />
					<span class="term-colon" aria-hidden="true">
						<span class="term-colon-dot" />
						<span class="term-colon-dot" />
					</span>
					<TerminalDigit value="0" />
					<TerminalDigit value="0" />
					<span class="term-colon" aria-hidden="true">
						<span class="term-colon-dot" />
						<span class="term-colon-dot" />
					</span>
					<TerminalDigit value="0" />
					<TerminalDigit value="0" />
				</div>

				<div class="splitflap-display" data-splitflap-display hidden>
					<SplitFlapDigit value="0" />
					<SplitFlapDigit value="0" />
					<span class="flap-colon" aria-hidden="true">
						<span class="flap-colon-dot" />
						<span class="flap-colon-dot" />
					</span>
					<SplitFlapDigit value="0" />
					<SplitFlapDigit value="0" />
					<span class="flap-colon" aria-hidden="true">
						<span class="flap-colon-dot" />
						<span class="flap-colon-dot" />
					</span>
					<SplitFlapDigit value="0" />
					<SplitFlapDigit value="0" />
				</div>

				<div class="chaos-display" data-chaos-display hidden>
					<span class="chaos-star chaos-star--tl" aria-hidden="true">★</span>
					<span class="chaos-star chaos-star--br" aria-hidden="true">★</span>
					<ChaosModeDigit value="0" colorIndex={0} />
					<ChaosModeDigit value="0" colorIndex={1} />
					<span class="chaos-colon" aria-hidden="true">
						<span class="chaos-colon-dot" style="--chaos-color: #ff8c00" />
						<span class="chaos-colon-dot" style="--chaos-color: #00e5ff" />
					</span>
					<ChaosModeDigit value="0" colorIndex={2} />
					<ChaosModeDigit value="0" colorIndex={3} />
					<span class="chaos-colon" aria-hidden="true">
						<span class="chaos-colon-dot" style="--chaos-color: #ff8c00" />
						<span class="chaos-colon-dot" style="--chaos-color: #00e5ff" />
					</span>
					<ChaosModeDigit value="0" colorIndex={0} />
					<ChaosModeDigit value="0" colorIndex={1} />
				</div>

				<div class="dotmatrix-display" data-dotmatrix-display hidden>
					<DotMatrixDigit value="0" />
					<DotMatrixDigit value="0" />
					<span class="dmx-colon" aria-hidden="true">
						<span class="dmx-colon-dot" />
						<span class="dmx-colon-dot" />
					</span>
					<DotMatrixDigit value="0" />
					<DotMatrixDigit value="0" />
					<span class="dmx-colon" aria-hidden="true">
						<span class="dmx-colon-dot" />
						<span class="dmx-colon-dot" />
					</span>
					<DotMatrixDigit value="0" />
					<DotMatrixDigit value="0" />
				</div>

				<div class="refined-display" data-refined-display hidden>
					<RefinedDigit value="0" />
					<RefinedDigit value="0" />
					<span class="refined-colon" aria-hidden="true">
						<span class="refined-colon-dot" />
						<span class="refined-colon-dot" />
					</span>
					<RefinedDigit value="0" />
					<RefinedDigit value="0" />
					<span class="refined-colon" aria-hidden="true">
						<span class="refined-colon-dot" />
						<span class="refined-colon-dot" />
					</span>
					<RefinedDigit value="0" />
					<RefinedDigit value="0" />
				</div>

				<div class="crt-overlay" aria-hidden="true" />
				<div class="tint-overlay" aria-hidden="true" />
			</div>

			<p class="ampm-label" data-ampm hidden></p>

			<div class="clock-progress countdown-only" data-progress role="progressbar" aria-label="Countdown time remaining" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
				<span class="clock-progress-fill" data-progress-fill></span>
			</div>
			<p class="times-up" data-times-up role="status" aria-live="assertive" hidden>Time's up!</p>

			<!-- One control bar for both the page and fullscreen. On the page:
			     big touchscreen-sized buttons. In fullscreen only Pause and Exit
			     remain, small and faint under the clock, so the screen is just
			     the time. -->
			<div class="clock-controls" data-clock-controls>
				<div class="control-main">
					<button type="button" class="big-btn big-btn--primary countdown-only" data-toggle>
						<span aria-hidden="true" data-toggle-icon>▶</span>
						<span data-toggle-label>Start</span>
					</button>
					<button type="button" class="big-btn countdown-only page-only" data-reset>
						<span aria-hidden="true">↺</span>{" "}
						Reset
					</button>
					<button type="button" class="big-btn countdown-only page-only" data-add-minute>+1 min</button>
					<button type="button" class="big-btn page-only" data-fullscreen-btn>
						<span aria-hidden="true">⛶</span>{" "}
						Fullscreen
					</button>
					<button type="button" class="big-btn fullscreen-only" data-exit-fullscreen>
						<span aria-hidden="true">✕</span>{" "}
						Exit fullscreen
					</button>
					<button
						type="button"
						class="big-btn page-only"
						data-settings-btn
						aria-expanded="false"
						aria-controls="clock-settings"
					>
						<span aria-hidden="true">⚙</span>{" "}
						Time &amp; settings
					</button>
				</div>
			</div>
		</div>

		<section class="exam-presets countdown-only page-only" aria-label="Exam countdown presets">
			<p class="exam-presets-label">EXAM TIMES <span>Choose a duration, then press Start</span></p>
			<div class="exam-presets-grid" role="group" aria-label="Exam times in minutes">
				<button type="button" class="preset-chip" data-preset="600">10 min</button>
				<button type="button" class="preset-chip" data-preset="1800">30 min</button>
				<button type="button" class="preset-chip" data-preset="2700">45 min</button>
				<button type="button" class="preset-chip" data-preset="3000">50 min</button>
				<button type="button" class="preset-chip" data-preset="3600">60 min</button>
				<button type="button" class="preset-chip" data-preset="5400">90 min</button>
				<button type="button" class="preset-chip" data-preset="7200">120 min</button>
			</div>
		</section>

		<div class="controls-drawer" id="clock-settings" data-controls-drawer hidden>
			<div class="mode-toggle" data-mode-toggle>
				<button type="button" class="mode-btn" data-mode-btn="countdown" aria-selected="true">Countdown</button>
				<button type="button" class="mode-btn" data-mode-btn="current" aria-selected="false">Current Time</button>
			</div>

			<div class="control-panel" data-countdown-panel>
				<p class="drawer-section-label">Short classroom timers</p>
					<div class="quick-presets" role="group" aria-label="Short classroom timers">
						<button type="button" class="preset-chip" data-preset="60">1 min</button>
						<button type="button" class="preset-chip" data-preset="120">2 min</button>
						<button type="button" class="preset-chip" data-preset="180">3 min</button>
						<button type="button" class="preset-chip" data-preset="300">5 min</button>
						<button type="button" class="preset-chip" data-preset="900">15 min</button>
						<button type="button" class="preset-chip" data-preset="1200">20 min</button>
					</div>

				<p class="drawer-section-label">Any time you like</p>
				<div class="time-input-row">
					<label class="time-input-field">
						<span class="time-input-label">Hours</span>
						<input type="number" inputmode="numeric" min="0" max="23" value="0" data-input="hours" class="time-input" />
					</label>
					<label class="time-input-field">
						<span class="time-input-label">Minutes</span>
						<input type="number" inputmode="numeric" min="0" max="59" value="5" data-input="minutes" class="time-input" />
					</label>
					<label class="time-input-field">
						<span class="time-input-label">Seconds</span>
						<input type="number" inputmode="numeric" min="0" max="59" value="0" data-input="seconds" class="time-input" />
					</label>
					<button type="button" class="btn btn--ghost set-btn" data-action="set">Set</button>
				</div>


				<label class="chime-toggle">
					<input type="checkbox" data-chime-toggle checked />
					<span>Chime when countdown ends</span>
				</label>
			</div>

			<div class="control-panel" data-current-time-panel hidden>
				<label class="chime-toggle">
					<input type="checkbox" data-hour-format-toggle />
					<span>12-hour clock</span>
				</label>
			</div>

			<div class="brightness-picker" role="radiogroup" aria-label="Brightness">
				<p class="drawer-section-label">Brightness (for projectors)</p>
				<div class="mode-toggle">
					<button type="button" class="mode-btn" role="radio" data-brightness="1" aria-checked="false">Normal</button>
					<button type="button" class="mode-btn" role="radio" data-brightness="1.35" aria-checked="true">Bright</button>
					<button type="button" class="mode-btn" role="radio" data-brightness="1.7" aria-checked="false">Max</button>
				</div>
			</div>

			<!-- Cosmetic, not functional — deliberately last in the drawer
			     (and visually compact/secondary, see .style-options'/.style-btn's
			     smaller sizing) so the timer controls above it, which is what a
			     classroom user actually needs first, aren't pushed below a
			     10-option style picker on first open. -->
			<div class="style-picker" data-style-picker role="group" aria-label="Display style">
				<div class="style-picker-header">
					<p class="drawer-section-label">Display Style</p>
					<button
						type="button"
						class="info-toggle"
						data-info-toggle
						aria-label="About this display style"
						aria-expanded="false"
					>
						i
					</button>
				</div>
				<!-- Ordered to reflect the real chronological sequence of these
				     display technologies (Nixie tubes first in the 1950s,
				     through to 1990s/2000s dot-matrix LCDs) — except Chaos
				     Mode, which isn't a real technology and always stays
				     last regardless of any date logic. A fixed 5-column grid
				     (10 styles = 5x2) rather than the previous auto-fit/2-col
				     layout, sized compactly since this section is now
				     secondary to the timer controls above it. -->
				<div class="style-options">
					<button type="button" class="style-btn" data-style-btn="nixie" aria-pressed="true">
						<span class="style-swatch style-swatch--nixie" aria-hidden="true" />
						Nixie Tube
					</button>
					<button type="button" class="style-btn" data-style-btn="splitflap" aria-pressed="false">
						<span class="style-swatch style-swatch--splitflap" aria-hidden="true" />
						Split-Flap
					</button>
					<button type="button" class="style-btn" data-style-btn="terminal" aria-pressed="false">
						<span class="style-swatch style-swatch--terminal" aria-hidden="true" />
						Terminal
					</button>
					<button type="button" class="style-btn" data-style-btn="led" aria-pressed="false">
						<span class="style-swatch style-swatch--led" aria-hidden="true" />
						LED
					</button>
					<button type="button" class="style-btn" data-style-btn="sinclair" aria-pressed="false">
						<span class="style-swatch style-swatch--sinclair" aria-hidden="true" />
						Sinclair Purple
					</button>
					<button type="button" class="style-btn" data-style-btn="vfd" aria-pressed="false">
						<span class="style-swatch style-swatch--vfd" aria-hidden="true" />
						VFD
					</button>
					<button type="button" class="style-btn" data-style-btn="lcd" aria-pressed="false">
						<span class="style-swatch style-swatch--lcd" aria-hidden="true" />
						LCD
					</button>
					<button type="button" class="style-btn" data-style-btn="dotmatrix" aria-pressed="false">
						<span class="style-swatch style-swatch--dotmatrix" aria-hidden="true" />
						Dot Matrix
					</button>
					<button type="button" class="style-btn" data-style-btn="refined" aria-pressed="false">
						<span class="style-swatch style-swatch--refined" aria-hidden="true" />
						Refined
					</button>
					<button type="button" class="style-btn" data-style-btn="chaos" aria-pressed="false">
						<span class="style-swatch style-swatch--chaos" aria-hidden="true" />
						Chaos Mode
					</button>
				</div>
				<p class="style-caption" data-style-caption hidden></p>
			</div>
		</div>

		<section class="clock-help" aria-labelledby="clock-help-title">
			<h2 class="clock-help-title" id="clock-help-title">How to use it in class</h2>
			<ol class="clock-help-steps">
				<li><strong>Pick a time.</strong> Open <em>Time &amp; settings</em> and tap a quick time like <em>5 min</em>, or type any time.</li>
				<li><strong>Press Start.</strong> The bar under the digits shrinks so students can see how much time is left at a glance.</li>
				<li><strong>Go fullscreen</strong> for the projector or board. The screen shows just the clock, with a small Pause and Exit underneath that fade away while it runs — move the mouse or tap the screen to bring them back.</li>
				<li><strong>Time's up:</strong> the screen lights up, shows <em>Time's up!</em> and plays a soft chime (turn the chime off in Time &amp; settings).</li>
			</ol>
			<p class="clock-help-note">
				<strong>Keyboard:</strong> <kbd>Space</kbd> start / pause · <kbd>R</kbd> reset · <kbd>+</kbd> add a minute ·{" "}
				<kbd>F</kbd> fullscreen · <kbd>Esc</kbd> exit fullscreen
			</p>
			<p class="clock-help-note">
				<strong>Hard to read from the back of the room?</strong> Time &amp; settings → Brightness → <em>Max</em>, and try the LED or
				Refined styles — they're the boldest. Switch to <em>Current Time</em> mode for a wall clock. Your choices are
				remembered on this device.
			</p>
		</section>
	</div>
</Layout>

<script>
	import { applySegmentDigit, padTwo } from "../../lib/segmentDigits";
	import { applySplitFlapDigit, setSplitFlapDigitInstant } from "../../lib/splitFlap";
	import { dotsFor } from "../../lib/dotMatrixDigits";

	const root = document.querySelector<HTMLElement>("[data-clock-root]")!;
	const segmentCells = Array.from(root.querySelectorAll<HTMLElement>("[data-segment-digit]"));
	const flapCells = Array.from(root.querySelectorAll<HTMLElement>("[data-flap-digit]"));
	const nixieGlyphCells = Array.from(root.querySelectorAll<HTMLElement>("[data-nixie-glyph-digit]"));
	const terminalCells = Array.from(root.querySelectorAll<HTMLElement>("[data-terminal-digit]"));
	const chaosCells = Array.from(root.querySelectorAll<HTMLElement>("[data-chaos-digit]"));
	const dotmatrixCells = Array.from(root.querySelectorAll<HTMLElement>("[data-dotmatrix-digit]"));
	const refinedCells = Array.from(root.querySelectorAll<HTMLElement>("[data-refined-digit]"));
	const displayStage = root.querySelector<HTMLElement>("[data-display-stage]")!;
	const segmentDisplayEl = root.querySelector<HTMLElement>("[data-segment-display]")!;
	const splitflapDisplayEl = root.querySelector<HTMLElement>("[data-splitflap-display]")!;
	const nixieglyphDisplayEl = root.querySelector<HTMLElement>("[data-nixieglyph-display]")!;
	const terminalDisplayEl = root.querySelector<HTMLElement>("[data-terminal-display]")!;
	const chaosDisplayEl = root.querySelector<HTMLElement>("[data-chaos-display]")!;
	const dotmatrixDisplayEl = root.querySelector<HTMLElement>("[data-dotmatrix-display]")!;
	const refinedDisplayEl = root.querySelector<HTMLElement>("[data-refined-display]")!;
	const ampmLabel = root.querySelector<HTMLElement>("[data-ampm]")!;

	const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]"));
	const countdownPanel = root.querySelector<HTMLElement>("[data-countdown-panel]")!;
	const currentTimePanel = root.querySelector<HTMLElement>("[data-current-time-panel]")!;

	const hoursInput = root.querySelector<HTMLInputElement>('[data-input="hours"]')!;
	const minutesInput = root.querySelector<HTMLInputElement>('[data-input="minutes"]')!;
	const secondsInput = root.querySelector<HTMLInputElement>('[data-input="seconds"]')!;
	const setBtn = root.querySelector<HTMLButtonElement>('[data-action="set"]')!;
	const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-preset]"));
	const chimeToggle = root.querySelector<HTMLInputElement>("[data-chime-toggle]")!;
	const hourFormatToggle = root.querySelector<HTMLInputElement>("[data-hour-format-toggle]")!;
	const brightnessButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-brightness]"));

	const displayShell = root.querySelector<HTMLElement>("[data-display-shell]")!;
	const toggleBtn = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
	const toggleIcon = root.querySelector<HTMLElement>("[data-toggle-icon]")!;
	const toggleLabel = root.querySelector<HTMLElement>("[data-toggle-label]")!;
	const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset]")!;
	const addMinuteBtn = root.querySelector<HTMLButtonElement>("[data-add-minute]")!;
	const progressFill = root.querySelector<HTMLElement>("[data-progress-fill]")!;
	const progressBar = root.querySelector<HTMLElement>("[data-progress]")!;
	const timesUpEl = root.querySelector<HTMLElement>("[data-times-up]")!;
	const fullscreenBtn = root.querySelector<HTMLButtonElement>("[data-fullscreen-btn]")!;
	const exitFullscreenBtn = root.querySelector<HTMLButtonElement>("[data-exit-fullscreen]")!;
	const settingsBtn = root.querySelector<HTMLButtonElement>("[data-settings-btn]")!;
	const controlsDrawer = root.querySelector<HTMLElement>("[data-controls-drawer]")!;

	// --- Display style ---------------------------------------------------

	type DisplayStyle =
		| "nixie"
		| "vfd"
		| "led"
		| "lcd"
		| "splitflap"
		| "terminal"
		| "sinclair"
		| "dotmatrix"
		| "refined"
		| "chaos";
	// Rendering engines, one per genuinely distinct digit geometry:
	// segment-based (VFD/LED/LCD/Sinclair Purple, sharing SegmentDigit.astro
	// since they're the same real 7-segment technology differing only in
	// material/glow/filter — Sinclair Purple is literally LED's red segments
	// with a translucent color-filter overlay layered on top, nothing about
	// the segment geometry itself changes), nixieGlyph (Nixie's real
	// numeral-glyph rendering), dotMatrix (Terminal's — a real bitmap-style
	// font, VT323, lit like emitted CRT phosphor), dotMatrixPhone (the
	// separate "Dot Matrix" style's manually-toggled, deliberately coarser
	// LCD phone-screen pixel grid — these two used to share the exact same
	// 5x7 bitmap shapes with only a color swap, which is why they're kept
	// as two clearly distinct engines/components now, not variants of one),
	// refined (the calm, glow-minimal "Refined" style — the deliberate
	// opposite of chaos), chaos (the "Chaos Mode" style), and splitflap
	// (the flip-card rendering).
	type Engine = "segment" | "nixieGlyph" | "dotMatrix" | "dotMatrixPhone" | "refined" | "chaos" | "splitflap";

	// Short captions shown via the (i) info toggle next to the style picker
	// — historical for the real display technologies, a joke for the one
	// style that isn't real, and a plain statement of intent for Refined
	// (which isn't trying to evoke any particular era at all). Purely
	// flavor text, doesn't affect rendering.
	const STYLE_INFO: Record<DisplayStyle, string> = {
		nixie: "Invented in 1954 by Haydu Brothers Laboratories, later sold by Burroughs as the ‘Nixie’ — short for Numeric Indicator eXperimental #1. Ten digit-shaped wires glow inside a neon-filled glass tube, each at a different depth.",
		led: "The first LED displays were tiny, hidden behind molded plastic lenses. Later, bigger red segments took over alarm clocks and calculators everywhere — usually shown through a dark red filter to make them glow from within.",
		vfd: "Same segment-based idea as LED, different physics — VFDs glow a soft blue-green, and were common in calculators and later VCRs and microwaves. Many real VFDs used 14 or even 16 segments per digit rather than just 7, so they could display letters as well as numbers.",
		lcd: "Unglamorous, low-contrast, and grey — but LCDs sip almost no power, letting a watch or calculator run for months on a tiny battery. Practicality won over beauty.",
		splitflap:
			"No electronics glow here — just real printed numerals on mechanical flip-cards, the same tech used on old airport and train departure boards.",
		terminal: "The classic look of early computer terminals — blocky green text glowing on a black screen.",
		sinclair:
			"Some Sinclair calculators viewed their red LED segments through a deep purple filter — considered by some the prettiest version of this display ever made.",
		chaos: "You've been warned.",
		dotmatrix:
			"The look of countless pocket screens from the dot-matrix era — small, blocky, and impossible to mistake for anything else.",
		refined: "No history lesson here — just clean, considered design.",
	};

	const styleButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-style-btn]"));
	const infoToggle = root.querySelector<HTMLButtonElement>("[data-info-toggle]")!;
	const styleCaption = root.querySelector<HTMLElement>("[data-style-caption]")!;
	let currentStyle: DisplayStyle = "nixie";
	let currentEngine: Engine = "nixieGlyph";

	function engineFor(style: DisplayStyle): Engine {
		switch (style) {
			case "splitflap":
				return "splitflap";
			case "nixie":
				return "nixieGlyph";
			case "terminal":
				return "dotMatrix";
			case "dotmatrix":
				return "dotMatrixPhone";
			case "refined":
				return "refined";
			case "chaos":
				return "chaos";
			default:
				return "segment";
		}
	}

	function applyNixieGlyphDigit(cell: HTMLElement, value: string, instant = false) {
		const glyph = cell.querySelector<HTMLElement>("[data-nixie-glyph-value]");
		if (!glyph) return;
		const previous = glyph.textContent;
		if (previous === value) return;
		// Briefly show the outgoing digit as a fading "ghost" at a slightly
		// different depth/scale before it fully dissolves — see the
		// .nixie-glyph-transition-ghost comment in NixieGlyphDigit.astro for
		// why (real Nixie tubes have physically separate, differently-depth
		// wire cathodes per digit, so switching which one is lit isn't a
		// flat instant swap). Skipped when `instant`, same as
		// setSplitFlapDigitInstant() — switching *to* this style shouldn't
		// play a "digit changed" animation for a value that was simply stale
		// while this engine was hidden.
		if (!instant) {
			const ghost = cell.querySelector<HTMLElement>("[data-nixie-glyph-transition-ghost]");
			if (ghost && previous !== null) {
				ghost.textContent = previous;
				ghost.classList.remove("is-fading");
				// Force a reflow so re-adding the class restarts the fade even
				// if the digit changes again before the previous one finished.
				void ghost.offsetWidth;
				ghost.classList.add("is-fading");
			}
		}
		glyph.textContent = value;
	}

	function applyTerminalGlyphDigit(cell: HTMLElement, value: string) {
		const glyph = cell.querySelector<HTMLElement>("[data-terminal-value]");
		if (glyph) glyph.textContent = value;
	}

	function applyChaosModeDigit(cell: HTMLElement, value: string) {
		const glyph = cell.querySelector<HTMLElement>("[data-chaos-value]");
		if (glyph) glyph.textContent = value;
	}

	function applyDotMatrixPhoneDigit(cell: HTMLElement, value: string) {
		const active = dotsFor(value);
		cell.querySelectorAll<HTMLElement>(".dmx-dot").forEach((dot, i) => {
			dot.classList.toggle("is-on", active[i] ?? false);
		});
	}

	// The one style where the CHANGE itself is animated (a quiet
	// crossfade+drift), rather than the digit constantly animating at rest
	// the way every other lit style here does (flicker, wobble, blink).
	// Skipped when `instant`, same reasoning as the other restartable
	// transitions on this page — switching *to* this style shouldn't play
	// a "digit changed" animation for a value that was simply stale while
	// this engine was hidden.
	function applyRefinedDigit(cell: HTMLElement, value: string, instant = false) {
		const main = cell.querySelector<HTMLElement>("[data-refined-value]");
		if (!main) return;
		const previous = main.textContent;
		if (previous === value) return;
		if (!instant) {
			const ghost = cell.querySelector<HTMLElement>("[data-refined-ghost]");
			if (ghost && previous !== null) {
				ghost.textContent = previous;
				ghost.classList.remove("is-animating");
				void ghost.offsetWidth;
				ghost.classList.add("is-animating");
			}
			main.classList.remove("is-animating");
		}
		main.textContent = value;
		if (!instant) {
			void main.offsetWidth;
			main.classList.add("is-animating");
		}
	}

	function setStyle(next: DisplayStyle) {
		currentStyle = next;
		currentEngine = engineFor(next);
		displayStage.dataset.style = next;
		// Mirrored onto <body> too (not just .display-stage) so the
		// fullscreen ambient-glow rules below — which tint the whole
		// viewport background behind the display, not just the display
		// card itself — can select by style without needing :has().
		document.body.dataset.style = next;
		segmentDisplayEl.hidden = currentEngine !== "segment";
		nixieglyphDisplayEl.hidden = currentEngine !== "nixieGlyph";
		terminalDisplayEl.hidden = currentEngine !== "dotMatrix";
		dotmatrixDisplayEl.hidden = currentEngine !== "dotMatrixPhone";
		refinedDisplayEl.hidden = currentEngine !== "refined";
		chaosDisplayEl.hidden = currentEngine !== "chaos";
		splitflapDisplayEl.hidden = currentEngine !== "splitflap";
		styleButtons.forEach((btn) => btn.setAttribute("aria-pressed", btn.dataset.styleBtn === next ? "true" : "false"));
		// Keep the caption text current even while the panel is closed, so
		// whenever it's next opened it already matches the active style
		// instead of showing a stale one from before the switch.
		styleCaption.textContent = STYLE_INFO[next];
		// Snap the newly-visible engine to the correct value instantly — it
		// may not have been kept up to date while hidden (the split-flap
		// engine in particular only renders while it's the active one, so a
		// prior value could otherwise be stale until the next real tick).
		renderDigits(computeDisplaySeconds(), true);
		// Each style has different proportions, so re-fit now and once more
		// after its digits have finished settling.
		if (typeof fitClock === "function") {
			fitClock();
			window.setTimeout(fitClock, 250);
		}
	}

	styleButtons.forEach((btn) => {
		btn.addEventListener("click", () => setStyle(btn.dataset.styleBtn as DisplayStyle));
	});

	// --- Style info caption --------------------------------------------------
	// Collapsed by default so it doesn't clutter the picker — a click reveals
	// a short historical blurb about whichever style is currently selected.

	function setCaptionOpen(open: boolean) {
		styleCaption.hidden = !open;
		infoToggle.setAttribute("aria-expanded", String(open));
		infoToggle.classList.toggle("is-active", open);
	}

	infoToggle.addEventListener("click", (event) => {
		event.stopPropagation();
		setCaptionOpen(Boolean(styleCaption.hidden));
	});

	// --- Rendering ---------------------------------------------------------

	function renderDigits(totalSeconds: number, instant = false) {
		const clamped = Math.max(0, Math.floor(totalSeconds));
		const h = Math.min(99, Math.floor(clamped / 3600));
		const m = Math.floor((clamped % 3600) / 60);
		const s = clamped % 60;
		const str = `${padTwo(h)}${padTwo(m)}${padTwo(s)}`;

		if (currentEngine === "segment") {
			str.split("").forEach((digit, i) => {
				const cell = segmentCells[i];
				if (cell) applySegmentDigit(cell, digit);
			});
		} else if (currentEngine === "nixieGlyph") {
			str.split("").forEach((digit, i) => {
				const cell = nixieGlyphCells[i];
				if (cell) applyNixieGlyphDigit(cell, digit, instant);
			});
		} else if (currentEngine === "dotMatrix") {
			str.split("").forEach((digit, i) => {
				const cell = terminalCells[i];
				if (cell) applyTerminalGlyphDigit(cell, digit);
			});
		} else if (currentEngine === "dotMatrixPhone") {
			str.split("").forEach((digit, i) => {
				const cell = dotmatrixCells[i];
				if (cell) applyDotMatrixPhoneDigit(cell, digit);
			});
		} else if (currentEngine === "refined") {
			str.split("").forEach((digit, i) => {
				const cell = refinedCells[i];
				if (cell) applyRefinedDigit(cell, digit, instant);
			});
		} else if (currentEngine === "chaos") {
			str.split("").forEach((digit, i) => {
				const cell = chaosCells[i];
				if (cell) applyChaosModeDigit(cell, digit);
			});
		} else {
			str.split("").forEach((digit, i) => {
				const cell = flapCells[i];
				if (!cell) return;
				if (instant) setSplitFlapDigitInstant(cell, digit);
				else applySplitFlapDigit(cell, digit);
			});
		}
	}

	// --- Mode switching -----------------------------------------------------

	type Mode = "countdown" | "current";
	let mode: Mode = "countdown";

	function setMode(next: Mode) {
		mode = next;
		modeButtons.forEach((btn) => btn.setAttribute("aria-selected", btn.dataset.modeBtn === next ? "true" : "false"));
		countdownPanel.hidden = next !== "countdown";
		currentTimePanel.hidden = next !== "current";
		ampmLabel.hidden = next !== "current" || hourFormatToggle.checked === false;
		// Read by CSS: countdown-only controls (Start, Reset, presets, the
		// progress bar) are hidden in Current Time mode.
		document.body.dataset.clockMode = next;
		if (next === "current") pause();
		lastShown = -1;
		renderDigits(computeDisplaySeconds());
		requestAnimationFrame(fitClock);
	}

	modeButtons.forEach((btn) => {
		btn.addEventListener("click", () => setMode(btn.dataset.modeBtn as Mode));
	});

	// --- Settings drawer ------------------------------------------------------

	function setDrawerOpen(open: boolean) {
		controlsDrawer.hidden = !open;
		settingsBtn.setAttribute("aria-expanded", String(open));
		settingsBtn.classList.toggle("is-active", open);
		requestAnimationFrame(fitClock);
	}

	settingsBtn.addEventListener("click", () => setDrawerOpen(Boolean(controlsDrawer.hidden)));

	// --- Saved preferences (best-effort: blocked storage just means the
	// defaults come back next visit) ---------------------------------------

	const PREFS_KEY = "logicdash:countdown:v1";
	interface Prefs {
		style?: DisplayStyle;
		brightness?: string;
		chime?: boolean;
		hour12?: boolean;
		seconds?: number;
	}
	function loadPrefs(): Prefs {
		try {
			return JSON.parse(localStorage.getItem(PREFS_KEY) ?? "{}") as Prefs;
		} catch {
			return {};
		}
	}
	function savePrefs() {
		try {
			const prefs: Prefs = {
				style: currentStyle,
				brightness: displayStage.style.getPropertyValue("--clock-brightness") || "1.35",
				chime: chimeToggle.checked,
				hour12: hourFormatToggle.checked,
				seconds: configuredSeconds,
			};
			localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
		} catch {
			/* ignore */
		}
	}

	// --- Brightness -----------------------------------------------------------
	// A brightness filter lifts the lit digits (projectors wash colors out)
	// while black stays black, so contrast goes up rather than turning grey.

	function setBrightness(value: string) {
		displayStage.style.setProperty("--clock-brightness", value);
		brightnessButtons.forEach((btn) => btn.setAttribute("aria-checked", String(btn.dataset.brightness === value)));
	}
	brightnessButtons.forEach((btn) =>
		btn.addEventListener("click", () => {
			setBrightness(btn.dataset.brightness!);
			savePrefs();
		}),
	);
	styleButtons.forEach((btn) => btn.addEventListener("click", savePrefs));

	// --- Fit the clock to the screen -------------------------------------------
	// Every style's tiles, gaps and padding are sized from --clock-tile-height,
	// so measuring the active display at a known height tells us how big it
	// can go: as wide as the space allows, without pushing the controls off
	// the screen (fullscreen) or below the fold (on the page).

	function fitClock() {
		const fullscreen = document.body.classList.contains("clock-fullscreen");
		const display = [segmentDisplayEl, nixieglyphDisplayEl, terminalDisplayEl, dotmatrixDisplayEl, refinedDisplayEl, chaosDisplayEl, splitflapDisplayEl].find((el) => !el.hidden);
		if (!display) return;
		const probe = 100;
		displayShell.style.setProperty("--clock-tile-height", `${probe}px`);
		const w = display.scrollWidth;
		// The stage (not just the digits) — it reserves the tallest style's
		// height, and that reserve grows with the digits too.
		const h = displayStage.offsetHeight;
		// Everything in the shell that isn't the digits (progress bar,
		// buttons…) has to fit on screen too.
		const others = displayShell.offsetHeight - h;
		const top = fullscreen ? 16 : displayShell.getBoundingClientRect().top + window.scrollY;
		const availW = (fullscreen ? window.innerWidth * 0.96 : displayShell.clientWidth) - 4;
		const availH = Math.max(140, window.innerHeight - top - others - 24);
		let size = Math.max(36, Math.floor(probe * Math.min(availW / w, availH / h)));
		displayShell.style.setProperty("--clock-tile-height", `${size}px`);
		// Fullscreen must never scroll: if padding or the time's-up banner
		// still pushes the page past the screen, step the digits down until
		// everything fits.
		if (fullscreen) {
			const root = document.documentElement;
			for (let i = 0; i < 30 && size > 36 && root.scrollHeight > window.innerHeight + 1; i++) {
				size = Math.max(36, Math.floor(size * 0.96));
				displayShell.style.setProperty("--clock-tile-height", `${size}px`);
			}
		}
	}

	window.addEventListener("resize", () => requestAnimationFrame(fitClock));
	document.fonts?.ready.then(fitClock);

	// --- Countdown state --------------------------------------------------------
	// Counts toward a real end time (not by subtracting 1 every tick), so it
	// stays accurate even if the browser slows timers in a background tab.

	let configuredSeconds = 5 * 60;
	let progressTotal = configuredSeconds;
	let remainingSeconds = configuredSeconds;
	let endTime = 0;
	let running = false;
	let lastShown = -1;

	function remainingNow(): number {
		return running ? Math.max(0, Math.ceil((endTime - Date.now()) / 1000)) : remainingSeconds;
	}

	function readInputsAsSeconds(): number {
		const h = Number(hoursInput.value) || 0;
		const m = Number(minutesInput.value) || 0;
		const s = Number(secondsInput.value) || 0;
		return Math.min(99 * 3600 + 59 * 60 + 59, Math.max(0, h * 3600 + m * 60 + s));
	}

	function writeSecondsToInputs(totalSeconds: number) {
		hoursInput.value = String(Math.floor(totalSeconds / 3600));
		minutesInput.value = String(Math.floor((totalSeconds % 3600) / 60));
		secondsInput.value = String(totalSeconds % 60);
	}

	function clearFinished() {
		displayStage.classList.remove("is-finished");
		document.body.classList.remove("clock-finished");
		timesUpEl.hidden = true;
		requestAnimationFrame(fitClock);
	}

	function updateControls() {
		const r = remainingNow();
		toggleIcon.textContent = running ? "⏸" : "▶";
		toggleLabel.textContent = running ? "Pause" : r < progressTotal && r > 0 ? "Resume" : "Start";
		toggleBtn.disabled = !running && r <= 0;
		document.body.classList.toggle("clock-running", running);
		const fraction = progressTotal > 0 ? r / progressTotal : 0;
		const percentage = Math.max(0, Math.min(100, fraction * 100));
		progressFill.style.width = `${percentage}%`;
		progressBar.setAttribute("aria-valuenow", String(Math.round(percentage)));
		presetButtons.forEach((btn) =>
			btn.setAttribute("aria-pressed", String(!running && Number(btn.dataset.preset) === configuredSeconds && r === configuredSeconds)),
		);
	}

	function setTime(totalSeconds: number) {
		running = false;
		configuredSeconds = totalSeconds;
		progressTotal = totalSeconds;
		remainingSeconds = totalSeconds;
		clearFinished();
		writeSecondsToInputs(totalSeconds);
		if (mode === "countdown") renderDigits(remainingSeconds);
		lastShown = remainingSeconds;
		updateControls();
		savePrefs();
	}

	setBtn.addEventListener("click", () => setTime(readInputsAsSeconds()));
	[hoursInput, minutesInput, secondsInput].forEach((input) =>
		input.addEventListener("keydown", (event) => {
			if (event.key === "Enter") setTime(readInputsAsSeconds());
		}),
	);
	presetButtons.forEach((btn) => btn.addEventListener("click", () => setTime(Number(btn.dataset.preset) || 0)));

	// A soft two-tone chime synthesized with the Web Audio API. Audio is
	// unlocked on the Start press (browsers only allow sound after a tap).
	let audioCtx: AudioContext | null = null;

	function unlockAudio() {
		try {
			audioCtx ??= new AudioContext();
			if (audioCtx.state === "suspended") audioCtx.resume();
		} catch {
			/* no audio */
		}
	}

	function playChime() {
		try {
			audioCtx ??= new AudioContext();
			const ctx = audioCtx;
			const now = ctx.currentTime;
			// Two rounds of a gentle open fifth — noticeable across a room, not an alarm.
			[0, 0.9].forEach((offset) => {
				[880, 1318.5].forEach((freq, i) => {
					const osc = ctx.createOscillator();
					const gain = ctx.createGain();
					osc.type = "sine";
					osc.frequency.value = freq;
					const start = now + offset + i * 0.12;
					gain.gain.setValueAtTime(0, start);
					gain.gain.linearRampToValueAtTime(0.22, start + 0.05);
					gain.gain.exponentialRampToValueAtTime(0.0001, start + 1.4);
					osc.connect(gain);
					gain.connect(ctx.destination);
					osc.start(start);
					osc.stop(start + 1.5);
				});
			});
		} catch {
			// Web Audio unavailable/blocked — the visual flash still shows it.
		}
	}

	function start() {
		if (mode !== "countdown" || running || remainingSeconds <= 0) return;
		unlockAudio();
		clearFinished();
		endTime = Date.now() + remainingSeconds * 1000;
		running = true;
		setDrawerOpen(false);
		updateControls();
		bumpIdle();
	}

	function pause() {
		if (!running) return;
		remainingSeconds = remainingNow();
		running = false;
		updateControls();
		bumpIdle();
	}

	function reset() {
		running = false;
		remainingSeconds = configuredSeconds;
		progressTotal = configuredSeconds;
		clearFinished();
		renderDigits(remainingSeconds);
		lastShown = remainingSeconds;
		updateControls();
	}

	function addMinute() {
		if (mode !== "countdown") return;
		if (running) endTime += 60_000;
		else remainingSeconds += 60;
		progressTotal = Math.max(progressTotal, remainingNow());
		clearFinished();
		renderDigits(remainingNow());
		lastShown = remainingNow();
		updateControls();
	}

	function finish() {
		running = false;
		remainingSeconds = 0;
		displayStage.classList.add("is-finished");
		document.body.classList.add("clock-finished");
		timesUpEl.hidden = false;
		updateControls();
		bumpIdle();
		requestAnimationFrame(fitClock);
		if (chimeToggle.checked) playChime();
	}

	toggleBtn.addEventListener("click", () => (running ? pause() : start()));
	resetBtn.addEventListener("click", reset);
	addMinuteBtn.addEventListener("click", addMinute);
	chimeToggle.addEventListener("change", savePrefs);

	function computeDisplaySeconds(): number {
		if (mode === "current") {
			const now = new Date();
			let h = now.getHours();
			if (hourFormatToggle.checked) {
				ampmLabel.hidden = false;
				ampmLabel.textContent = h >= 12 ? "PM" : "AM";
				h = h % 12;
				if (h === 0) h = 12;
			} else {
				ampmLabel.hidden = true;
			}
			return h * 3600 + now.getMinutes() * 60 + now.getSeconds();
		}
		return remainingNow();
	}

	// Checks several times a second, but only redraws when the shown second
	// actually changes (the split-flap and Nixie animations run per change).
	window.setInterval(() => {
		const shown = computeDisplaySeconds();
		if (shown !== lastShown) {
			lastShown = shown;
			renderDigits(shown);
			if (mode === "countdown") updateControls();
		}
		if (mode === "countdown" && running && remainingNow() === 0) finish();
	}, 200);

	hourFormatToggle.addEventListener("change", () => {
		ampmLabel.hidden = mode !== "current" || !hourFormatToggle.checked;
		lastShown = -1;
		savePrefs();
	});

	// --- Fullscreen ------------------------------------------------------------
	// A body class gives the fullscreen look even if the browser refuses
	// real fullscreen. While the timer runs, the controls fade after a few
	// seconds of no mouse/touch activity and come back on any movement.

	let idleTimer: number | undefined;
	function bumpIdle() {
		document.body.classList.remove("clock-idle");
		window.clearTimeout(idleTimer);
		idleTimer = window.setTimeout(() => {
			if (running && document.body.classList.contains("clock-fullscreen")) document.body.classList.add("clock-idle");
		}, 3000);
	}
	["pointermove", "pointerdown", "keydown", "touchstart"].forEach((type) =>
		document.addEventListener(type, bumpIdle, { passive: true }),
	);

	function enterFullscreen() {
		setDrawerOpen(false);
		document.body.classList.add("clock-fullscreen");
		requestAnimationFrame(fitClock);
		bumpIdle();
		exitFullscreenBtn.focus();
		document.documentElement
			.requestFullscreen?.()
			.then(() => requestAnimationFrame(fitClock))
			.catch(() => {
				// Native fullscreen denied/unsupported — the CSS fullscreen look
				// still applies, so the clock remains projectable either way.
			});
	}

	function exitFullscreen() {
		document.body.classList.remove("clock-fullscreen", "clock-idle");
		if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
		requestAnimationFrame(fitClock);
		fullscreenBtn.focus();
	}

	fullscreenBtn.addEventListener("click", enterFullscreen);
	exitFullscreenBtn.addEventListener("click", exitFullscreen);

	document.addEventListener("fullscreenchange", () => {
		if (!document.fullscreenElement && document.body.classList.contains("clock-fullscreen")) exitFullscreen();
	});

	// --- Keyboard shortcuts (ignored while typing in a box) --------------------

	document.addEventListener("keydown", (event) => {
		const target = event.target as HTMLElement;
		if (target.closest("input, select, textarea") || event.ctrlKey || event.metaKey || event.altKey) return;
		if (event.key === "Escape") {
			if (document.body.classList.contains("clock-fullscreen")) exitFullscreen();
			else if (!controlsDrawer.hidden) setDrawerOpen(false);
		} else if (event.key === " " && mode === "countdown") {
			// Space always means start/pause on this page (as on most timers),
			// even if a button has focus — Enter still presses that button.
			event.preventDefault();
			running ? pause() : start();
		} else if (event.key.toLowerCase() === "r") reset();
		else if (event.key === "+" || event.key === "=") addMinute();
		else if (event.key.toLowerCase() === "f") {
			document.body.classList.contains("clock-fullscreen") ? exitFullscreen() : enterFullscreen();
		}
	});

	// Browsers "click" a focused button when Space is released; swallow that
	// too, so Space never doubles up as a click on whatever was last pressed.
	document.addEventListener("keyup", (event) => {
		const target = event.target as HTMLElement;
		if (event.key === " " && mode === "countdown" && !target.closest("input, select, textarea")) event.preventDefault();
	});

	// --- Init ------------------------------------------------------------------

	const prefs = loadPrefs();
	chimeToggle.checked = prefs.chime ?? true;
	hourFormatToggle.checked = prefs.hour12 ?? false;
	setBrightness(prefs.brightness ?? "1.35");
	setStyle(prefs.style ?? "nixie");
	document.body.dataset.clockMode = mode;
	setTime(typeof prefs.seconds === "number" && prefs.seconds > 0 ? prefs.seconds : 5 * 60);
	fitClock();
</script>

<style>
	.clock-tool {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding: 1rem 0 2rem;
	}

	.clock-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		max-width: 34rem;
		text-align: center;
	}

	.clock-title {
		margin: 0;
		font-size: 1.4rem;
	}

	.clock-subtitle {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	/* --- Tool bar / icon buttons ------------------------------------------ */

	.tool-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		max-width: 42rem;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-surface);
		color: var(--color-text-muted);
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	.icon-btn:hover {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.settings-btn.is-active {
		border-color: var(--color-accent);
		color: #fff3d6;
		background: color-mix(in srgb, var(--color-accent) 20%, var(--color-bg));
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 40%, transparent);
	}

	/*
	 * All of this page's controls — the tool-bar above and the fullscreen
	 * row below — live in NORMAL document flow near the clock rather than
	 * fixed at the top of the screen: on a large wall-mounted display or
	 * projector in classroom use, the top edge can be an awkward reach,
	 * while controls right next to (or under) the thing you're already
	 * looking at are easy to find and use. .fullscreen-controls is hidden
	 * outside fullscreen and shown as a centered row via the
	 * body.clock-fullscreen override further down; each button inside it
	 * keeps the same small/dim/brightens-on-hover treatment either way, so
	 * neither one competes with the clock for attention.
	 */
	.fullscreen-controls {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.exit-fullscreen-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-surface) 70%, transparent);
		color: var(--color-text-muted);
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.55;
		transition:
			opacity 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.exit-fullscreen-btn:hover {
		opacity: 1;
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	/*
	 * Same treatment as the exit button, but ALSO gated on Countdown mode
	 * (see the body[data-clock-mode] selector further down) — Current Time
	 * fullscreen stays exactly as before, just the display and the exit
	 * control. Deliberately just Pause/Resume, not Reset — a reset is a
	 * more consequential, deliberate action that stays behind the
	 * settings panel.
	 */
	.fullscreen-pause-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-surface) 70%, transparent);
		color: var(--color-text-muted);
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.55;
		transition:
			opacity 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.fullscreen-pause-btn:hover {
		opacity: 1;
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.fullscreen-pause-btn:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	/* --- Display stage ------------------------------------------------------ */

	.display-shell {
		/* --u is "1px at the original design size" (96px digits). Glows,
		   blurs and borders on the digits are written in --u, so they keep
		   the same proportions however big fitClock makes the clock. */
		--u: calc(var(--clock-tile-height, 96px) / 96);
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		width: 100%;
	}

	.display-stage {
		position: relative;
		width: 100%;
		/* Projector brightness (Settings → Brightness). Lifts the lit digits;
		   black stays black, so contrast increases rather than greying out. */
		filter: brightness(var(--clock-brightness, 1.35));
		display: flex;
		align-items: center;
		justify-content: center;
		/* An "invisible container": reserves enough vertical room for the
		   tallest style's natural tile — currently Nixie's glass-tube shape
		   (NixieGlyphDigit.astro's own width clamp, doubled for its 1:2
		   aspect-ratio) plus the shared display-tree padding below — so
		   switching styles never shifts the settings drawer/mode toggle/etc.
		   underneath. Every style's tree is simply centered within this
		   fixed-height frame; shorter styles just leave empty space above
		   and below instead of the frame itself resizing to hug whichever
		   one happens to be active. */
		min-height: calc(calc(var(--clock-tile-height) * 1.4667) + 2 * calc(var(--clock-tile-height) * 0.375));
	}

	.display-stage.is-finished .segment-display,
	.display-stage.is-finished .nixieglyph-display,
	.display-stage.is-finished .terminal-display,
	.display-stage.is-finished .dotmatrix-display,
	.display-stage.is-finished .refined-display,
	.display-stage.is-finished .chaos-display,
	.display-stage.is-finished .splitflap-display {
		animation: display-finish-pulse 1.6s ease-in-out infinite;
	}

	@keyframes display-finish-pulse {
		0%,
		100% {
			box-shadow:
				inset 0 0 50px rgba(0, 0, 0, 0.65),
				0 0 30px rgba(255, 92, 122, 0.3);
		}
		50% {
			box-shadow:
				inset 0 0 50px rgba(0, 0, 0, 0.65),
				0 0 90px rgba(255, 92, 122, 0.75);
		}
	}

	.segment-display,
	.nixieglyph-display,
	.terminal-display,
	.dotmatrix-display,
	.refined-display,
	.chaos-display,
	.splitflap-display {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: nowrap;
		gap: calc(var(--clock-tile-height) * 0.1);
		width: auto;
		padding: calc(var(--clock-tile-height) * 0.375) calc(var(--clock-tile-height) * 0.3333);
		border-radius: 22px;
		box-sizing: border-box;
	}

	/* An unconditional `display: flex` above otherwise beats the browser's
	   default `[hidden] { display: none }` — see the .control-panel[hidden]
	   comment further down for the full explanation. */
	.segment-display[hidden],
	.nixieglyph-display[hidden],
	.terminal-display[hidden],
	.dotmatrix-display[hidden],
	.refined-display[hidden],
	.chaos-display[hidden],
	.splitflap-display[hidden] {
		display: none;
	}

	/* Segment-display's own background is only ever seen for the three
	   styles that still share this element (VFD/LED/LCD) — each has its own
	   background override further down (see the is:global block), so this
	   base value is never actually painted, but is kept as a sane fallback. */
	.segment-display {
		background:
			radial-gradient(ellipse at center, rgba(255, 174, 46, 0.08) 0%, transparent 60%),
			radial-gradient(ellipse at center, transparent 35%, rgba(0, 0, 0, 0.55) 100%),
			#0a0705;
		box-shadow:
			inset 0 0 50px rgba(0, 0, 0, 0.65),
			0 10px 30px -10px rgba(0, 0, 0, 0.6);
		transition:
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Nixie's own dark amber vignette — its own dedicated display tree now,
	   not shared with any other style. */
	.nixieglyph-display {
		background:
			radial-gradient(ellipse at center, rgba(255, 174, 46, 0.08) 0%, transparent 60%),
			radial-gradient(ellipse at center, transparent 35%, rgba(0, 0, 0, 0.55) 100%),
			#0a0705;
		box-shadow:
			inset 0 0 50px rgba(0, 0, 0, 0.65),
			0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	.terminal-display {
		background: #010601;
		box-shadow:
			inset 0 0 40px rgba(0, 0, 0, 0.8),
			0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	/* Dot Matrix: flat dark panel, matching the tiles' own background —
	   switched from a pale backlit-LCD look to a dark one so the bright
	   lit dots have real contrast headroom (see DotMatrixDigit.astro's own
	   comment for why the pale version never resolved). Still no gradient
	   or inset vignette — flat color either way. */
	.dotmatrix-display {
		background: #1a2e1a;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	/* Refined: a calm, near-black field — no vignette, no texture, nothing
	   competing with the typography. "Generous spacing" is the one thing
	   that actually distinguishes its layout from every other style here:
	   a noticeably wider gap between digits than the shared default. */
	.refined-display {
		/* True black, not the near-black #0d0d0f other styles' cards use —
		   matches this style's own fullscreen background exactly (see
		   body.clock-fullscreen[data-style="refined"] further down, which
		   is a radial tint over #000), so entering/exiting fullscreen
		   doesn't visibly shift the background shade. */
		background: #000;
		gap: calc(var(--clock-tile-height) * 0.2167);
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	/* Chaos Mode: deliberately loud, not a considered "dark vignette" —
	   the whole point is that it looks wrong. The actual rainbow border
	   lives on ::before below, since a plain `border` can't follow this
	   element's border-radius the way a gradient background can. */
	.chaos-display {
		position: relative;
		background: #170a2e;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	/* Registered so the browser can smoothly interpolate it as an angle in
	   the @keyframes below — an unregistered custom property can't be
	   animated (the browser has no way to know it's numeric/interpolatable
	   rather than an arbitrary token), it would just snap between values. */
	@property --chaos-rainbow-angle {
		syntax: "<angle>";
		inherits: false;
		initial-value: 0deg;
	}

	.chaos-display::before {
		content: "";
		position: absolute;
		inset: calc(var(--u, 1px) * -7);
		z-index: -1;
		border-radius: calc(var(--u, 1px) * 28);
		background: conic-gradient(
			from var(--chaos-rainbow-angle),
			#ff2fd4,
			#ff2f2f,
			#fff700,
			#39ff14,
			#00e5ff,
			#7a2fff,
			#ff2fd4
		);
		animation: chaos-rainbow-spin 5s linear infinite;
	}

	/* Animates the gradient's own angle instead of rotating the element
	   with `transform: rotate()` — this element is wide and short (it
	   traces the whole digit row), so rotating its actual box swung its
	   bounding box up to ~2.5x taller at the diagonal, overflowing the
	   page and forcing a scrollbar in both normal and Fullscreen view. The
	   box itself never moves now — only the colors sweep — so there's
	   nothing left that can overflow, while the spinning-rainbow look is
	   identical. */
	@keyframes chaos-rainbow-spin {
		to {
			--chaos-rainbow-angle: 360deg;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chaos-display::before {
			animation: none;
		}
	}

	/* A pair of small spinning stars in opposite corners — pure early-2000s
	   "sparkle gif" noise, no functional purpose, just more visual chaos.
	   Spinning in opposite directions so they don't read as one synced
	   effect. */
	.chaos-star {
		position: absolute;
		z-index: 6;
		font-size: calc(var(--clock-tile-height) * 0.25);
		line-height: 1;
		color: #fff700;
		text-shadow:
			0 0 calc(var(--u, 1px) * 4) #fff700,
			0 0 calc(var(--u, 1px) * 10) #ff2fd4;
		pointer-events: none;
		animation: chaos-star-spin 1.4s linear infinite;
	}

	.chaos-star--tl {
		top: 0.5rem;
		left: 0.7rem;
	}

	.chaos-star--br {
		bottom: 0.5rem;
		right: 0.7rem;
		color: #00e5ff;
		text-shadow:
			0 0 4px #00e5ff,
			0 0 10px #39ff14;
		animation-direction: reverse;
		animation-duration: 1.8s;
	}

	@keyframes chaos-star-spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chaos-star {
			animation: none;
		}
	}

	.splitflap-display {
		background: #05070c;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
	}

	.segment-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.segment-colon-dot {
		width: calc(var(--clock-tile-height) * 0.0833);
		height: calc(var(--clock-tile-height) * 0.0833);
		border-radius: 50%;
		background: #fff3d6;
		box-shadow:
			0 0 calc(var(--u, 1px) * 2) #fff3d6,
			0 0 calc(var(--u, 1px) * 6) #ffae2e,
			0 0 calc(var(--u, 1px) * 14) color-mix(in srgb, #ffae2e 60%, transparent);
		animation: segment-colon-flicker 4.5s ease-in-out infinite;
	}

	.segment-colon-dot:nth-child(2) {
		animation-delay: -2.2s;
	}

	@keyframes segment-colon-flicker {
		0%,
		100% {
			opacity: 1;
		}
		18% {
			opacity: 0.9;
		}
		34% {
			opacity: 1;
		}
		60% {
			opacity: 0.94;
		}
		82% {
			opacity: 1;
		}
	}

	/* Flat, static colon for the Split-Flap style — no glow, matching the
	   mechanical-board aesthetic (see the brief: "No glow effects"). */
	.flap-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.flap-colon-dot {
		width: calc(var(--clock-tile-height) * 0.075);
		height: calc(var(--clock-tile-height) * 0.075);
		border-radius: 2px;
		background: #e8e6df;
	}

	/* Nixie's colon — same glowing-dot look as before, now living on its own
	   dedicated display tree instead of the shared segment one. */
	.nixie-glyph-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.nixie-glyph-colon-dot {
		width: calc(var(--clock-tile-height) * 0.0833);
		height: calc(var(--clock-tile-height) * 0.0833);
		border-radius: 50%;
		background: #ff6a1a;
		box-shadow:
			0 0 calc(var(--u, 1px) * 2) #ff8a3d,
			0 0 calc(var(--u, 1px) * 6) #ff5000,
			0 0 calc(var(--u, 1px) * 14) rgba(255, 90, 0, 0.6);
		animation: nixie-glyph-colon-flicker 4.5s ease-in-out infinite;
	}

	.nixie-glyph-colon-dot:nth-child(2) {
		animation-delay: -2.2s;
	}

	@keyframes nixie-glyph-colon-flicker {
		0%,
		100% {
			opacity: 1;
		}
		18% {
			opacity: 0.9;
		}
		34% {
			opacity: 1;
		}
		60% {
			opacity: 0.94;
		}
		82% {
			opacity: 1;
		}
	}

	/* Terminal's colon — small glowing green squares, matching
	   TerminalDigit.astro's own phosphor-glow treatment. */
	.term-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.term-colon-dot {
		width: calc(var(--clock-tile-height) * 0.075);
		height: calc(var(--clock-tile-height) * 0.075);
		border-radius: 1px;
		background: #33ff33;
		filter:
			drop-shadow(0 0 calc(var(--u, 1px) * 1.5) #33ff33)
			drop-shadow(0 0 calc(var(--u, 1px) * 4) rgba(51, 255, 51, 0.6));
	}

	/* Dot Matrix's colon — same blocky dark-on-backlight material as its
	   digit tiles, no glow. */
	.dmx-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.dmx-colon-dot {
		width: calc(var(--clock-tile-height) * 0.075);
		height: calc(var(--clock-tile-height) * 0.075);
		border-radius: 1px;
		/* Matches the digit tiles' new bright "lit" color, not the old dark
		   ink color — the colon should read as "on" the same way a lit
		   pixel does. */
		background: #4ade80;
	}

	/* Refined's colon — small, quiet, round dots in the same ivory as the
	   digits, no pulse/blink/flicker of any kind — this style holds
	   perfectly still except when a digit actually changes. */
	.refined-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.2);
		align-self: stretch;
	}

	.refined-colon-dot {
		width: calc(var(--clock-tile-height) * 0.0667);
		height: calc(var(--clock-tile-height) * 0.0667);
		border-radius: 50%;
		background: #f2ede2;
		opacity: 0.7;
	}

	/* Chaos Mode's colon — each dot gets its own clashing neon color via
	   an inline --chaos-color, same as the digit tiles, plus a silly pulse. */
	.chaos-colon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--clock-tile-height) * 0.1667);
		align-self: stretch;
	}

	.chaos-colon-dot {
		width: calc(var(--clock-tile-height) * 0.0917);
		height: calc(var(--clock-tile-height) * 0.0917);
		border-radius: 50%;
		background: var(--chaos-color, #ff2fd4);
		box-shadow: 0 0 calc(var(--u, 1px) * 8) var(--chaos-color, #ff2fd4);
		animation: chaos-colon-pulse 1.4s ease-in-out infinite;
	}

	.chaos-colon-dot:nth-child(2) {
		animation-delay: -0.7s;
	}

	@keyframes chaos-colon-pulse {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.35);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.chaos-colon-dot {
			animation: none;
		}
	}

	/* CRT scanline + vignette overlay — only visible for the Terminal style
	   (see the [data-style="terminal"] override further down). Sized to
	   match .segment-display/.splitflap-display exactly since it's an
	   absolutely-positioned sibling covering whichever one is showing. */
	.crt-overlay {
		position: absolute;
		inset: 0;
		z-index: 10;
		pointer-events: none;
		opacity: 0;
		border-radius: 22px;
		background:
			repeating-linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0) 0px,
				rgba(0, 0, 0, 0) 2px,
				rgba(0, 0, 0, 0.22) 3px,
				rgba(0, 0, 0, 0.22) 4px
			),
			radial-gradient(ellipse at center, transparent 50%, rgba(0, 0, 0, 0.55) 100%);
		transition: opacity 0.2s ease;
	}

	/* Translucent color-filter overlay — only visible for Sinclair Purple
	   (see the [data-style="sinclair"] override further down). A real
	   physical filter placed in front of the display, not a change to the
	   segments themselves, so this sits above everything as its own layer.
	   Plain alpha compositing (no mix-blend-mode) rather than multiply —
	   multiply can only ever darken a channel, so laying a purple over an
	   already-saturated red (255,43,43) barely shifted its hue, just dimmed
	   it. Normal blending actually mixes in the overlay's blue channel,
	   pushing the red segments toward the magenta/pink-red the real filter
	   is known for, while the dark background between them reads as a
	   deep plum/purple instead of black. */
	.tint-overlay {
		position: absolute;
		inset: 0;
		z-index: 11;
		pointer-events: none;
		opacity: 0;
		border-radius: 22px;
		background:
			radial-gradient(ellipse at center, rgba(168, 51, 219, 0.22) 0%, rgba(107, 24, 161, 0.28) 100%);
		transition: opacity 0.2s ease;
	}

	.ampm-label {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	/* Frequently used exam durations stay on the page, sharing existing preset logic. */
	.exam-presets { width:100%; padding:.6rem .4rem .25rem; margin:0 auto; }
	body.clock-running .exam-presets { display:none !important; }
	.exam-presets-label { display:flex; align-items:baseline; justify-content:center; gap:.6rem; flex-wrap:wrap; margin:0 0 .6rem; font:700 .72rem var(--font-mono); letter-spacing:.08em; color:var(--color-accent); text-align:center; }
	.exam-presets-label span { font:400 .72rem sans-serif; letter-spacing:0; color:var(--color-text-muted); }
	.exam-presets-grid { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:.4rem; max-width:58rem; margin-inline:auto; }
	.exam-presets-grid .preset-chip { width:100%; min-width:0; min-height:44px; padding:.45rem .15rem; font-size:clamp(.69rem,1.45vw,.92rem); white-space:nowrap; }
	@media (max-width:700px) { .exam-presets-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } .exam-presets-grid .preset-chip { font-size:.83rem; } }
	@media (max-width:350px) { .exam-presets { padding-inline:0; } .exam-presets-grid { gap:.3rem; } .exam-presets-grid .preset-chip { font-size:.76rem; padding-inline:0; } }

	/* --- Controls drawer ---------------------------------------------------- */

	.controls-drawer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		width: 100%;
		animation: drawer-in 0.18s ease;
	}

	@keyframes drawer-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Same reasoning as .control-panel[hidden] below: an unconditional
	   `display: flex` beats the browser's own `[hidden] { display: none }`. */
	.controls-drawer[hidden] {
		display: none;
	}

	.drawer-section-label {
		margin: 0;
		text-align: center;
		font-size: 0.7rem;
