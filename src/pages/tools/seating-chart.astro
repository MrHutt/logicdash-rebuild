---
// Published classroom tool — linked from the /tools hub page, indexable.
//
// A teacher's seating-chart workflow in four steps (class → room → purpose
// → optional rules), with the chart beside the steps on wide screens. The
// seating logic lives in src/lib/seatingChart.ts and src/lib/layoutEngine.ts;
// class lists are shared with /tools/student-picker via src/lib/rosterStore.ts
// and never leave the teacher's browser.
import Layout from "../../layouts/Layout.astro";
---

<Layout
	wide
	title="Seating Chart"
	description="A free classroom seating chart maker: paste your class list, pick rows, pods, pairs or a U-shape, add keep-apart rules, then project or print the chart."
>
	<div class="seating-tool" data-seating-root>
		<header class="seating-header">
			<h1 class="seating-title">Seating Chart</h1>
			<p class="seating-lead">
				Make a fair, random seating plan in under a minute — then swap anyone by hand, project it, or print it.
			</p>
		</header>

		<div class="seating-layout">
			<!-- ============================ Setup steps ============================ -->
			<section class="setup-panel" aria-label="Set up the seating chart">
				<!-- Step 1: class -->
				<div class="step-card">
					<h2 class="step-title"><span class="step-num">1</span> Your class</h2>

					<div class="roster-picker" data-roster-picker>
						<label class="field">
							<span class="field-label">Class list</span>
							<select class="select-input" data-roster-select></select>
						</label>
						<div class="inline-actions">
							<button type="button" class="link-btn" data-edit-roster>Edit names</button>
							<button type="button" class="link-btn" data-new-roster>+ New class</button>
						</div>
					</div>

					<div class="roster-editor" data-roster-editor hidden>
						<label class="field">
							<span class="field-label">Class name</span>
							<input class="text-input" type="text" maxlength="40" placeholder="e.g. Period 3 CS" data-roster-name />
						</label>
						<label class="field">
							<span class="field-label">Student names — one per line (or paste from a spreadsheet)</span>
							<textarea class="text-input roster-textarea" rows="8" spellcheck="false" data-roster-text></textarea>
						</label>
						<p class="field-error" data-roster-error hidden></p>
						<div class="inline-actions">
							<button type="button" class="btn btn--primary" data-save-roster>Save class</button>
							<button type="button" class="btn" data-cancel-roster>Cancel</button>
							<button type="button" class="link-btn" data-sample-roster>Fill in sample names</button>
						</div>
					</div>

					<div class="student-chips-wrap" data-chips-wrap hidden>
						<p class="hint">Tap a name to mark someone absent today — they won't be given a seat.</p>
						<ul class="student-chips" data-student-chips></ul>
					</div>

					<p class="hint privacy-hint">
						Names are saved only on this device, and shared with the <a href="/tools/student-picker">Student Picker</a>.
					</p>
				</div>

				<!-- Step 2: room -->
				<div class="step-card">
					<h2 class="step-title"><span class="step-num">2</span> Room layout</h2>
					<div class="template-grid" role="radiogroup" aria-label="Layout">
						<button type="button" class="template-btn" role="radio" data-template-btn="rows" aria-checked="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<rect x="3" y="4.5" width="18" height="4" rx="1"></rect>
								<rect x="3" y="10" width="18" height="4" rx="1"></rect>
								<rect x="3" y="15.5" width="18" height="4" rx="1"></rect>
							</svg>
							<span>Rows</span>
						</button>
						<button type="button" class="template-btn" role="radio" data-template-btn="pods" aria-checked="false">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<rect x="3.5" y="3.5" width="7" height="7" rx="1"></rect>
								<rect x="13.5" y="3.5" width="7" height="7" rx="1"></rect>
								<rect x="3.5" y="13.5" width="7" height="7" rx="1"></rect>
								<rect x="13.5" y="13.5" width="7" height="7" rx="1"></rect>
							</svg>
							<span>Groups (pods)</span>
						</button>
						<button type="button" class="template-btn" role="radio" data-template-btn="pairs" aria-checked="false">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<rect x="2.5" y="8" width="8" height="8" rx="1"></rect>
								<rect x="13.5" y="8" width="8" height="8" rx="1"></rect>
							</svg>
							<span>Pairs</span>
						</button>
						<button type="button" class="template-btn" role="radio" data-template-btn="u-shape" aria-checked="false">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path d="M5 20 V8 H9 V16 H15 V8 H19 V20"></path>
							</svg>
							<span>U-shape</span>
						</button>
					</div>
					<div class="param-fields" data-param-fields></div>
					<p class="capacity" data-capacity aria-live="polite"></p>
				</div>

				<!-- Step 3: purpose -->
				<div class="step-card">
					<h2 class="step-title"><span class="step-num">3</span> What's it for?</h2>
					<div class="mode-options" role="radiogroup" aria-label="Purpose">
						<button type="button" class="mode-option" role="radio" data-mode-btn="general" aria-checked="true">
							<span class="mode-name">Everyday</span>
							<span class="mode-desc">A fresh random mix that follows your rules.</span>
						</button>
						<button type="button" class="mode-option" role="radio" data-mode-btn="group" aria-checked="false">
							<span class="mode-name">Group work</span>
							<span class="mode-desc">With pods, spreads stronger and weaker students evenly (set skill levels in Rules).</span>
						</button>
						<button type="button" class="mode-option" role="radio" data-mode-btn="exam" aria-checked="false">
							<span class="mode-name">Test day</span>
							<span class="mode-desc">Leaves empty seats between students when there's room, and treats "keep apart" as top priority.</span>
						</button>
					</div>
				</div>

				<!-- Step 4: rules -->
				<details class="step-card step-card--rules">
					<summary class="step-title">
						<span class="step-num">4</span> Rules <span class="optional">(optional)</span>
						<span class="rule-count" data-rule-count-badge hidden></span>
					</summary>
					<p class="hint">
						<strong>Keep apart</strong>: never side by side. <strong>Keep together</strong>: always side by side.{" "}
						<strong>Fixed seat</strong>: e.g. near the front for a student who needs it. <strong>Skill level</strong>: used by Group work.
					</p>
					<div class="rule-form">
						<label class="field">
							<span class="field-label">Rule type</span>
							<select class="select-input" data-rule-type-select>
								<option value="keep-apart">Keep apart</option>
								<option value="keep-together">Keep together</option>
								<option value="pinned">Fixed seat</option>
								<option value="skill-balance">Skill level (Group work)</option>
							</select>
						</label>
						<div class="rule-fields" data-rule-fields></div>
						<p class="field-error" data-rule-error hidden></p>
						<button type="button" class="btn" data-add-rule>Add rule</button>
					</div>
					<ul class="rule-list" data-rule-list></ul>
					<label class="check-row">
						<input type="checkbox" data-avoid-repeat-toggle checked />
						<span>Try not to repeat last time's neighbors</span>
					</label>
				</details>

				<button type="button" class="btn btn--primary btn--big" data-generate-btn>Make seating chart</button>
			</section>

			<!-- ============================ Chart ============================ -->
			<section class="chart-panel" data-chart-panel aria-label="Seating chart">
				<div class="chart-toolbar" data-chart-toolbar hidden>
					<button type="button" class="btn" data-regenerate-btn><span aria-hidden="true">⟳</span> Shuffle again</button>
					<button type="button" class="btn" data-flip-btn><span aria-hidden="true">⇅</span> Flip</button>
					<button type="button" class="btn" data-print-btn><span aria-hidden="true">⎙</span> Print</button>
					<button type="button" class="btn" data-fullscreen-btn><span aria-hidden="true">⛶</span> Fullscreen</button>
					<button type="button" class="btn chart-exit" data-exit-fullscreen><span aria-hidden="true">✕</span> Exit</button>
				</div>

				<div class="chart-sheet" data-chart-sheet>
					<p class="print-heading" data-print-heading></p>
					<div class="room-front" data-room-front>Front of room · board</div>
					<div class="chart-stage" data-chart-stage></div>
					<p class="chart-empty" data-chart-empty>
						Your chart will appear here. Add your class in step 1, then press <strong>Make seating chart</strong>.
					</p>
				</div>

				<p class="chart-status" data-chart-status aria-live="polite"></p>
				<p class="hint chart-swap-hint" data-swap-hint hidden>
					To move someone, tap their seat, then tap the seat you want them in — the two swap.
				</p>
			</section>
		</div>

		<section class="seating-help" aria-labelledby="seating-help-title">
			<h2 class="seating-help-title" id="seating-help-title">Tips for teachers</h2>
			<ul class="seating-help-list">
				<li><strong>First time?</strong> Press <em>+ New class</em> → <em>Fill in sample names</em> to see how it works.</li>
				<li><strong>Not enough seats?</strong> Step 2 tells you how many seats you have for how many students present.</li>
				<li><strong>Project it</strong> with <em>Fullscreen</em> so students can find their seats; use <em>Flip</em> if your board is at the other end of the plan.</li>
				<li><strong>Each class's last chart is saved</strong> on this device — open the page next lesson and it's still there.</li>
			</ul>
		</section>
	</div>
</Layout>

<script>
	import {
		loadRosters,
		saveRoster,
		deleteRoster,
		loadActiveRosterName,
		saveActiveRosterName,
		type Roster,
	} from "../../lib/rosterStore";
	import {
		buildLayout,
		defaultParams,
		PARAM_FIELDS,
		uShapeArms,
		type LayoutTemplate,
		type LayoutConfig,
	} from "../../lib/layoutEngine";
	import {
		generateSeatingChart,
		recentAdjacencySet,
		pushAdjacencyHistory,
		type Rule,
		type RuleType,
		type Mode,
	} from "../../lib/seatingChart";

	const root = document.querySelector<HTMLElement>("[data-seating-root]")!;
	const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

	const rosterSelect = $<HTMLSelectElement>("[data-roster-select]");
	const rosterPicker = $("[data-roster-picker]");
	const rosterEditor = $("[data-roster-editor]");
	const rosterNameInput = $<HTMLInputElement>("[data-roster-name]");
	const rosterText = $<HTMLTextAreaElement>("[data-roster-text]");
	const rosterError = $("[data-roster-error]");
	const chipsWrap = $("[data-chips-wrap]");
	const chipsEl = $("[data-student-chips]");
	const editBtn = $<HTMLButtonElement>("[data-edit-roster]");
	const templateButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-template-btn]"));
	const paramFieldsEl = $("[data-param-fields]");
	const capacityEl = $("[data-capacity]");
	const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]"));
	const ruleTypeSelect = $<HTMLSelectElement>("[data-rule-type-select]");
	const ruleFieldsEl = $("[data-rule-fields]");
	const ruleErrorEl = $("[data-rule-error]");
	const addRuleBtn = $<HTMLButtonElement>("[data-add-rule]");
	const ruleListEl = $("[data-rule-list]");
	const ruleBadge = $("[data-rule-count-badge]");
	const avoidRepeatToggle = $<HTMLInputElement>("[data-avoid-repeat-toggle]");
	const generateBtn = $<HTMLButtonElement>("[data-generate-btn]");
	const toolbar = $("[data-chart-toolbar]");
	const chartStage = $("[data-chart-stage]");
	const chartEmpty = $("[data-chart-empty]");
	const chartStatus = $("[data-chart-status]");
	const swapHint = $("[data-swap-hint]");
	const roomFront = $("[data-room-front]");
	const printHeading = $("[data-print-heading]");

	// ------------------------------------------------------------------ state

	let roster: Roster = { name: "", students: [] };
	let template: LayoutTemplate = "rows";
	let params: Record<string, number> = defaultParams("rows");
	let mode: Mode = "general";
	let rules: Rule[] = [];
	let ruleId = 0;
	let flipped = false;
	let editingName: string | null = null; // roster being edited (null = new)

	interface SavedChart {
		config: LayoutConfig;
		assignments: (string | null)[];
		date: string;
		flipped: boolean;
	}
	let chart: SavedChart | null = null;
	let selectedSeat: number | null = null;

	const CHART_KEY = "logicdash-seating-chart-last:";
	const SETUP_KEY = "logicdash-seating-chart-setup";

	const escapeHtml = (v: string) =>
		v.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
	const present = () => roster.students.filter((s) => !s.absent).map((s) => s.name);
	const config = (): LayoutConfig => ({ template, params: { ...params } });

	function saveSetup() {
		try {
			localStorage.setItem(SETUP_KEY, JSON.stringify({ template, params, mode, flipped }));
		} catch {
			/* ignore */
		}
	}

	// ------------------------------------------------------------- step 1: class

	function renderRosterSelect() {
		const all = loadRosters();
		const names = Object.keys(all).sort((a, b) => a.localeCompare(b));
		if (names.length === 0) {
			roster = { name: "", students: [] };
			rosterPicker.hidden = true;
			openEditor(null);
			return;
		}
		rosterPicker.hidden = false;
		if (!all[roster.name]) {
			const active = loadActiveRosterName();
			roster = all[active && all[active] ? active : names[0]];
		} else {
			roster = all[roster.name];
		}
		rosterSelect.innerHTML = names
			.map((n) => `<option value="${escapeHtml(n)}" ${n === roster.name ? "selected" : ""}>${escapeHtml(n)} (${all[n].students.length})</option>`)
			.join("");
		renderChips();
	}

	function renderChips() {
		chipsWrap.hidden = roster.students.length === 0 || !rosterEditor.hidden;
		chipsEl.innerHTML = roster.students
			.map(
				(s, i) =>
					`<li><button type="button" class="student-chip${s.absent ? " is-absent" : ""}" data-chip="${i}" aria-pressed="${s.absent}">${escapeHtml(s.name)}${s.absent ? '<span class="chip-tag">absent</span>' : ""}</button></li>`,
			)
			.join("");
		renderCapacity();
		renderRuleFields();
		generateBtn.disabled = present().length === 0;
	}

	chipsEl.addEventListener("click", (event) => {
		const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-chip]");
		if (!btn) return;
		const s = roster.students[Number(btn.dataset.chip)];
		s.absent = !s.absent;
		saveRoster(roster);
		// Rules naming someone who's now absent are dropped (they can't apply).
		const here = new Set(present());
		rules = rules.filter((r) => r.studentNames.every((n) => here.has(n)));
		renderRuleList();
		renderChips();
		root.querySelector<HTMLButtonElement>(`[data-chip="${btn.dataset.chip}"]`)?.focus();
	});

	rosterSelect.addEventListener("change", () => {
		roster = loadRosters()[rosterSelect.value] ?? roster;
		saveActiveRosterName(roster.name);
		rules = [];
		renderRuleList();
		renderChips();
		restoreChart();
	});

	function openEditor(existing: Roster | null) {
		editingName = existing ? existing.name : null;
		rosterNameInput.value = existing ? existing.name : "";
		rosterText.value = existing ? existing.students.map((s) => s.name).join("\n") : "";
		rosterError.hidden = true;
		rosterEditor.hidden = false;
		chipsWrap.hidden = true;
		(existing ? rosterText : rosterNameInput).focus({ preventScroll: true });
		$<HTMLButtonElement>("[data-cancel-roster]").hidden = Object.keys(loadRosters()).length === 0;
	}

	function closeEditor() {
		rosterEditor.hidden = true;
		renderChips();
	}

	$("[data-new-roster]").addEventListener("click", () => openEditor(null));
	editBtn.addEventListener("click", () => openEditor(roster.name ? roster : null));
	$("[data-cancel-roster]").addEventListener("click", closeEditor);

	const SAMPLE = [
		"Ava", "Ben", "Chloe", "Dev", "Ella", "Finn", "Grace", "Hugo", "Isla", "Jay", "Kai", "Lena",
		"Milo", "Nia", "Omar", "Priya", "Quinn", "Rosa", "Sam", "Tara", "Umar", "Vik", "Wren", "Zoe",
	];
	$("[data-sample-roster]").addEventListener("click", () => {
		if (!rosterNameInput.value.trim()) rosterNameInput.value = "Sample class";
		rosterText.value = SAMPLE.join("\n");
	});

	$("[data-save-roster]").addEventListener("click", () => {
		const name = rosterNameInput.value.trim();
		// Accept one per line, or comma/tab separated (pasted from a sheet).
		const names = rosterText.value
			.split(/[\n\t,]+/)
			.map((n) => n.trim().replace(/\s+/g, " "))
			.filter(Boolean);
		const unique = [...new Set(names)];
		if (!name) return showRosterError("Give the class a name, e.g. “Period 3”.");
		if (unique.length === 0) return showRosterError("Add at least one student name.");
		const all = loadRosters();
		if (name !== editingName && all[name]) return showRosterError("You already have a class with that name.");
		const absentBefore = new Set((editingName && all[editingName]?.students.filter((s) => s.absent).map((s) => s.name)) || []);
		// Renamed: save under the new name, remove the old entry.
		if (editingName && editingName !== name) deleteRoster(editingName);
		roster = { name, students: unique.map((n) => ({ name: n, absent: absentBefore.has(n) })) };
		saveRoster(roster);
		saveActiveRosterName(name);
		const dupes = names.length - unique.length;
		rosterEditor.hidden = true;
		renderRosterSelect();
		chartStatus.textContent = `Saved “${name}” with ${unique.length} students${dupes ? ` (${dupes} duplicate name${dupes === 1 ? "" : "s"} removed)` : ""}.`;
		restoreChart();
	});

	function showRosterError(message: string) {
		rosterError.textContent = message;
		rosterError.hidden = false;
	}

	// -------------------------------------------------------------- step 2: room

	function renderParamFields() {
		paramFieldsEl.innerHTML = PARAM_FIELDS[template]
			.map(
				(f) => `
			<label class="field field--number">
				<span class="field-label">${f.label}</span>
				<span class="stepper">
					<button type="button" class="stepper-btn" data-step="${f.key}" data-delta="-1" aria-label="Fewer ${f.label.toLowerCase()}">−</button>
					<input type="number" class="number-input" min="${f.min}" max="${f.max}" value="${params[f.key]}" data-param-input="${f.key}" />
					<button type="button" class="stepper-btn" data-step="${f.key}" data-delta="1" aria-label="More ${f.label.toLowerCase()}">+</button>
				</span>
			</label>`,
			)
			.join("");
	}

	function setParam(key: string, value: number) {
		const f = PARAM_FIELDS[template].find((x) => x.key === key)!;
		params[key] = Math.min(f.max, Math.max(f.min, Number.isFinite(value) ? Math.round(value) : f.min));
		const input = paramFieldsEl.querySelector<HTMLInputElement>(`[data-param-input="${key}"]`);
		if (input) input.value = String(params[key]);
		rules = rules.filter((r) => r.type !== "pinned" || (r.seatIndex ?? 0) < buildLayout(config()).seatCount);
		renderRuleList();
		renderCapacity();
		renderRuleFields();
		saveSetup();
	}

	paramFieldsEl.addEventListener("change", (event) => {
		const input = event.target as HTMLInputElement;
		if (input.dataset.paramInput) setParam(input.dataset.paramInput, Number(input.value));
	});
	paramFieldsEl.addEventListener("click", (event) => {
		const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-step]");
		if (btn) setParam(btn.dataset.step!, params[btn.dataset.step!] + Number(btn.dataset.delta));
	});

	function renderCapacity() {
		const seats = buildLayout(config()).seatCount;
		const n = present().length;
		if (n === 0) {
			capacityEl.textContent = `${seats} seats.`;
			capacityEl.className = "capacity";
			return;
		}
		const spare = seats - n;
		capacityEl.textContent =
			spare >= 0
				? `${seats} seats for ${n} students — ${spare === 0 ? "a perfect fit" : `${spare} spare`}. ✓`
				: `${seats} seats for ${n} students — ${-spare} short. Add more seats.`;
		capacityEl.className = spare >= 0 ? "capacity capacity--ok" : "capacity capacity--short";
	}

	function setTemplate(next: LayoutTemplate) {
		template = next;
		params = defaultParams(next);
		templateButtons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.templateBtn === next)));
		rules = rules.filter((r) => r.type !== "pinned");
		renderParamFields();
		renderRuleList();
		renderCapacity();
		renderRuleFields();
		saveSetup();
	}
	templateButtons.forEach((b) => b.addEventListener("click", () => setTemplate(b.dataset.templateBtn as LayoutTemplate)));

	// ----------------------------------------------------------- step 3: purpose

	function setMode(next: Mode) {
		mode = next;
		modeButtons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.modeBtn === next)));
		saveSetup();
	}
	modeButtons.forEach((b) => b.addEventListener("click", () => setMode(b.dataset.modeBtn as Mode)));

	// ------------------------------------------------------------- step 4: rules

	function options(selected = 0) {
		return present()
			.map((n, i) => `<option value="${escapeHtml(n)}" ${i === selected ? "selected" : ""}>${escapeHtml(n)}</option>`)
			.join("");
	}

	function renderRuleFields() {
		const type = ruleTypeSelect.value as RuleType;
		const names = present();
		ruleErrorEl.hidden = true;
		if (names.length === 0) {
			ruleFieldsEl.innerHTML = `<p class="hint">Add your class in step 1 first.</p>`;
			addRuleBtn.disabled = true;
			return;
		}
		const student = (label: string, i: number, sel: number) =>
			`<label class="field"><span class="field-label">${label}</span><select class="select-input" data-rule-student="${i}">${options(sel)}</select></label>`;
		if (type === "keep-apart" || type === "keep-together") {
			ruleFieldsEl.innerHTML = student("Student", 0, 0) + student("and", 1, Math.min(1, names.length - 1));
			addRuleBtn.disabled = names.length < 2;
		} else if (type === "pinned") {
			const seats = buildLayout(config()).seatCount;
			ruleFieldsEl.innerHTML =
				student("Student", 0, 0) +
				`<label class="field"><span class="field-label">Seat number</span><select class="select-input" data-rule-seat>${Array.from(
					{ length: seats },
					(_, i) => `<option value="${i}">Seat ${i + 1}</option>`,
				).join("")}</select></label>`;
			addRuleBtn.disabled = false;
		} else {
			ruleFieldsEl.innerHTML =
				student("Student", 0, 0) +
				`<label class="field"><span class="field-label">Skill level</span><select class="select-input" data-rule-tier><option value="1">1 – needs support</option><option value="2">2 – on track</option><option value="3">3 – confident</option></select></label>`;
			addRuleBtn.disabled = false;
		}
	}
	ruleTypeSelect.addEventListener("change", renderRuleFields);

	function ruleText(r: Rule) {
		const [a, b] = r.studentNames.map(escapeHtml);
		if (r.type === "keep-apart") return `Keep apart: ${a} &amp; ${b}`;
		if (r.type === "keep-together") return `Keep together: ${a} &amp; ${b}`;
		if (r.type === "pinned") return `Fixed seat: ${a} → seat ${(r.seatIndex ?? 0) + 1}`;
		return `Skill level ${r.skillTier}: ${a}`;
	}

	function renderRuleList() {
		ruleListEl.innerHTML = rules
			.map(
				(r) =>
					`<li class="rule-row" data-rule-id="${r.id}"><span>${ruleText(r)}</span><button type="button" class="remove-btn" data-remove-rule aria-label="Remove rule">×</button></li>`,
			)
			.join("");
		ruleBadge.hidden = rules.length === 0;
		ruleBadge.textContent = String(rules.length);
	}

	addRuleBtn.addEventListener("click", () => {
		const type = ruleTypeSelect.value as RuleType;
		const pick = (i: number) => ruleFieldsEl.querySelector<HTMLSelectElement>(`[data-rule-student="${i}"]`)?.value ?? "";
		ruleErrorEl.hidden = true;
		if (type === "keep-apart" || type === "keep-together") {
			const a = pick(0);
			const b = pick(1);
			if (!a || !b || a === b) {
				ruleErrorEl.textContent = "Pick two different students.";
				ruleErrorEl.hidden = false;
				return;
			}
			rules.push({ id: `r${++ruleId}`, type, studentNames: [a, b] });
		} else if (type === "pinned") {
			const name = pick(0);
			const seatIndex = Number(ruleFieldsEl.querySelector<HTMLSelectElement>("[data-rule-seat]")!.value);
			rules = rules.filter((r) => !(r.type === "pinned" && (r.studentNames[0] === name || r.seatIndex === seatIndex)));
			rules.push({ id: `r${++ruleId}`, type, studentNames: [name], seatIndex });
		} else {
			const name = pick(0);
			const skillTier = Number(ruleFieldsEl.querySelector<HTMLSelectElement>("[data-rule-tier]")!.value) as 1 | 2 | 3;
			rules = rules.filter((r) => !(r.type === "skill-balance" && r.studentNames[0] === name));
			rules.push({ id: `r${++ruleId}`, type, studentNames: [name], skillTier });
		}
		renderRuleList();
	});

	ruleListEl.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;
		const row = target.closest<HTMLElement>("[data-rule-id]");
		if (!row || !target.closest("[data-remove-rule]")) return;
		rules = rules.filter((r) => r.id !== row.dataset.ruleId);
		renderRuleList();
	});

	// --------------------------------------------------------------- chart

	function seatHtml(i: number): string {
		const name = chart!.assignments[i];
		const cls = ["seat", name ? "" : "seat--empty", selectedSeat === i ? "is-selected" : ""].filter(Boolean).join(" ");
		const label = name ? `Seat ${i + 1}: ${name}` : `Seat ${i + 1}: empty`;
		return `<button type="button" class="${cls}" data-seat="${i}" aria-label="${escapeHtml(label)}" aria-pressed="${selectedSeat === i}"><span class="seat-num" aria-hidden="true">${i + 1}</span><span class="seat-name" aria-hidden="true">${name ? escapeHtml(name) : "empty"}</span></button>`;
	}

	function renderChart() {
		if (!chart) {
			chartStage.innerHTML = "";
			chartEmpty.hidden = false;
			toolbar.hidden = true;
			swapHint.hidden = true;
			roomFront.hidden = true;
			return;
		}
		const { config: c } = chart;
		const range = (from: number, n: number) => Array.from({ length: n }, (_, k) => from + k);
		let html = "";
		if (c.template === "rows") {
			html = `<div class="rows-grid" style="--cols:${c.params.cols}">${range(0, chart.assignments.length).map(seatHtml).join("")}</div>`;
		} else if (c.template === "pods") {
			// Balanced grid of pods: e.g. 6 pods → 3 across, 2 down.
			const podCols = Math.min(4, Math.ceil(Math.sqrt(c.params.podCount)));
			html = `<div class="pods-grid" style="--pod-cols:${podCols}">${range(0, c.params.podCount)
				.map((p) => `<div class="pod" style="--pod:${c.params.podSize}">${range(p * c.params.podSize, c.params.podSize).map(seatHtml).join("")}</div>`)
				.join("")}</div>`;
		} else if (c.template === "pairs") {
			html = `<div class="pairs-grid">${range(0, c.params.pairCount)
				.map((p) => `<div class="pair">${seatHtml(p * 2)}${seatHtml(p * 2 + 1)}</div>`)
				.join("")}</div>`;
		} else {
			// U-shape opens toward the front of the room: the arms point at the
			// board, the base row is at the back.
			const { left, top, right } = uShapeArms(c.params.seatCount);
			html = `<div class="ushape" style="--u-top:${top}">
				<div class="u-arm">${range(0, left).map(seatHtml).join("")}</div>
				<div class="u-mid"></div>
				<div class="u-arm">${range(left + top, right).reverse().map(seatHtml).join("")}</div>
				<div class="u-base">${range(left, top).map(seatHtml).join("")}</div>
			</div>`;
		}
		chartStage.innerHTML = html;
		chartEmpty.hidden = true;
		toolbar.hidden = false;
		swapHint.hidden = false;
		roomFront.hidden = false;
		root.querySelector("[data-chart-sheet]")!.classList.toggle("is-flipped", chart.flipped);
		printHeading.textContent = `Seating chart — ${roster.name} — ${new Date(chart.date).toLocaleDateString()}`;
	}

	function saveChart() {
		if (!chart || !roster.name) return;
		try {
			localStorage.setItem(CHART_KEY + roster.name, JSON.stringify(chart));
		} catch {
			/* ignore */
		}
	}

	function restoreChart() {
		selectedSeat = null;
		chart = null;
		try {
			const raw = roster.name ? localStorage.getItem(CHART_KEY + roster.name) : null;
			if (raw) chart = JSON.parse(raw) as SavedChart;
		} catch {
			chart = null;
		}
		renderChart();
		if (chart) chartStatus.textContent = `Showing ${roster.name}'s last chart from ${new Date(chart.date).toLocaleDateString()}.`;
	}

	function generate() {
		const names = present();
		if (names.length === 0) return;
		const c = config();
		const layout = buildLayout(c);
		const result = generateSeatingChart({
			layout,
			students: names,
			mode,
			rules,
			avoidRepeatNeighbors: avoidRepeatToggle.checked,
			recentAdjacency: recentAdjacencySet(roster.name),
		});
		pushAdjacencyHistory(roster.name, result.adjacencyPairs);
		chart = { config: c, assignments: result.assignments, date: new Date().toISOString(), flipped };
		selectedSeat = null;
		renderChart();
		saveChart();
		const seated = result.assignments.filter(Boolean).length;
		const parts = [`${seated} students seated.`];
		if (seated < names.length) parts.push(`${names.length - seated} without a seat — add more seats in step 2.`);
		// Only the teacher's own rules count here; "don't repeat neighbors" is
		// a best effort and isn't worth a warning.
		const seatOf = new Map(result.assignments.map((n, i) => [n, i] as const));
		const broken = rules.filter((r) => {
			if (r.type !== "keep-apart" && r.type !== "keep-together") return false;
			const [a, b] = r.studentNames.map((n) => seatOf.get(n));
			if (a === undefined || b === undefined) return false;
			const together = layout.adjacency[a]?.includes(b) ?? false;
			return r.type === "keep-apart" ? together : !together;
		});
		if (broken.length) parts.push(`${broken.length} rule${broken.length === 1 ? "" : "s"} couldn't be met this time — press Shuffle again.`);
		chartStatus.textContent = parts.join(" ");
		if (window.matchMedia("(max-width: 1099px)").matches) {
			root.querySelector("[data-chart-panel]")!.scrollIntoView({ behavior: "smooth", block: "start" });
		}
	}

	generateBtn.addEventListener("click", generate);
	$("[data-regenerate-btn]").addEventListener("click", generate);

	// Tap two seats to swap them (a teacher's final say over the random plan).
	chartStage.addEventListener("click", (event) => {
		const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-seat]");
		if (!btn || !chart) return;
		const i = Number(btn.dataset.seat);
		if (selectedSeat === null) {
			if (!chart.assignments[i]) return;
			selectedSeat = i;
			chartStatus.textContent = `${chart.assignments[i]} selected — now tap the seat to move them to.`;
		} else if (selectedSeat === i) {
			selectedSeat = null;
			chartStatus.textContent = "Swap cancelled.";
		} else {
			const a = chart.assignments[selectedSeat];
			const b = chart.assignments[i];
			chart.assignments[selectedSeat] = b;
			chart.assignments[i] = a;
			chartStatus.textContent = b ? `Swapped ${a} and ${b}.` : `Moved ${a} to seat ${i + 1}.`;
			selectedSeat = null;
			saveChart();
		}
		renderChart();
		root.querySelector<HTMLButtonElement>(`[data-seat="${i}"]`)?.focus();
	});

	$("[data-flip-btn]").addEventListener("click", () => {
		flipped = !flipped;
		if (chart) chart.flipped = flipped;
		renderChart();
		saveChart();
		saveSetup();
	});

	$("[data-print-btn]").addEventListener("click", () => window.print());

	// Fullscreen: just the chart, sized for the projector.
	function exitFullscreen() {
		document.body.classList.remove("seating-fullscreen");
		if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
	}
	$("[data-fullscreen-btn]").addEventListener("click", () => {
		document.body.classList.add("seating-fullscreen");
		document.documentElement.requestFullscreen?.().catch(() => {});
		$<HTMLButtonElement>("[data-exit-fullscreen]").focus();
	});
	$("[data-exit-fullscreen]").addEventListener("click", exitFullscreen);
	document.addEventListener("fullscreenchange", () => {
		if (!document.fullscreenElement) document.body.classList.remove("seating-fullscreen");
	});
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		if (document.body.classList.contains("seating-fullscreen")) exitFullscreen();
		else if (selectedSeat !== null) {
			selectedSeat = null;
			renderChart();
			chartStatus.textContent = "Swap cancelled.";
		}
	});

	// ----------------------------------------------------------------- init

	(function init() {
		try {
			const setup = JSON.parse(localStorage.getItem(SETUP_KEY) ?? "null");
			if (setup && PARAM_FIELDS[setup.template as LayoutTemplate]) {
				template = setup.template;
				params = { ...defaultParams(template), ...setup.params };
				mode = setup.mode ?? "general";
				flipped = !!setup.flipped;
			}
		} catch {
			/* ignore */
		}
		templateButtons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.templateBtn === template)));
		setMode(mode);
		renderParamFields();
		renderRosterSelect();
		renderRuleList();
		renderCapacity();
		restoreChart();
	})();
</script>

