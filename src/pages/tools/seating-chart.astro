---
// Unpublished classroom tool — reachable only by direct URL, same treatment
// as /tools/countdown-clock and /tools/student-picker: not linked from
// Header.astro/Footer.astro, and excluded from the sitemap (see the
// sitemap() filter in astro.config.mjs). /tools/ is also disallowed
// wholesale in public/robots.txt already, so no robots.txt change was
// needed for this page specifically.
import Layout from "../../layouts/Layout.astro";
---

<Layout
	title="Seating Chart"
	description="A classroom seating chart generator — four layout templates, exam/group/general modes, keep-apart/keep-together/pinned rules, and no-repeat-neighbor tracking."
>
	<div class="seating-tool" data-seating-root>
		<h1 class="seating-title">Seating Chart</h1>

		<section class="setup-panel">
			<div class="panel-card">
				<p class="panel-title">Layout Template</p>
				<div class="template-grid" data-template-grid>
					<button type="button" class="template-btn" data-template-btn="rows" aria-pressed="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<rect x="3" y="4.5" width="18" height="4" rx="1"></rect>
							<rect x="3" y="10" width="18" height="4" rx="1"></rect>
							<rect x="3" y="15.5" width="18" height="4" rx="1"></rect>
						</svg>
						<span>Rows</span>
					</button>
					<button type="button" class="template-btn" data-template-btn="pods" aria-pressed="false">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<rect x="3.5" y="3.5" width="7" height="7" rx="1"></rect>
							<rect x="13.5" y="3.5" width="7" height="7" rx="1"></rect>
							<rect x="3.5" y="13.5" width="7" height="7" rx="1"></rect>
							<rect x="13.5" y="13.5" width="7" height="7" rx="1"></rect>
						</svg>
						<span>Pods</span>
					</button>
					<button type="button" class="template-btn" data-template-btn="pairs" aria-pressed="false">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<rect x="2.5" y="8" width="8" height="8" rx="1"></rect>
							<rect x="13.5" y="8" width="8" height="8" rx="1"></rect>
						</svg>
						<span>Pairs</span>
					</button>
					<button type="button" class="template-btn" data-template-btn="u-shape" aria-pressed="false">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
							<path d="M5 4 V16 H9 V8 H15 V16 H19 V4"></path>
						</svg>
						<span>U-Shape</span>
					</button>
				</div>
				<div class="param-fields" data-param-fields></div>
			</div>

			<div class="panel-card">
				<p class="panel-title">Mode</p>
				<div class="mode-toggle" data-mode-toggle>
					<button type="button" class="mode-btn" data-mode-btn="exam" aria-selected="false">Exam</button>
					<button type="button" class="mode-btn" data-mode-btn="group" aria-selected="false">Group</button>
					<button type="button" class="mode-btn" data-mode-btn="general" aria-selected="true">General</button>
				</div>
			</div>

			<div class="panel-card">
				<p class="panel-title">Roster</p>
				<select class="select-input" data-roster-select aria-label="Roster"></select>
				<p class="panel-hint">
					Rosters are shared with <a href="/tools/student-picker">Student Picker</a> — add students there.
				</p>
				<p class="empty-hint" data-roster-empty hidden>No rosters yet.</p>
			</div>

			<div class="panel-card">
				<p class="panel-title">Rules (<span data-rule-count>0</span>)</p>
				<div class="rule-form" data-rule-form>
					<label class="field-label-row">
						<span class="field-label">Rule type</span>
						<select class="select-input" data-rule-type-select>
							<option value="keep-apart">Keep Apart</option>
							<option value="keep-together">Keep Together</option>
							<option value="pinned">Pinned Seat</option>
							<option value="skill-balance">Skill Tier</option>
						</select>
					</label>
					<div class="rule-fields" data-rule-fields></div>
					<p class="rule-error" data-rule-error hidden></p>
					<button type="button" class="btn btn--ghost" data-add-rule>Add Rule</button>
				</div>
				<ul class="rule-list" data-rule-list></ul>
				<p class="empty-hint" data-rule-empty>No rules added yet.</p>
			</div>

			<div class="panel-card">
				<label class="norepeat-toggle">
					<input type="checkbox" data-avoid-repeat-toggle />
					<span>Avoid repeat neighbors across generations</span>
				</label>
			</div>

			<div class="generate-row">
				<button type="button" class="btn" data-generate-btn>Generate Seating Chart</button>
				<button type="button" class="btn btn--ghost" data-regenerate-btn disabled>Regenerate</button>
			</div>
		</section>

		<section class="chart-section">
			<p class="violation-warning" data-violation-warning hidden>
				Some constraints couldn't all be satisfied this time.
			</p>
			<p class="capacity-hint" data-capacity-hint hidden></p>
			<div class="chart-stage" data-chart-stage></div>
			<p class="empty-hint" data-chart-empty>Set up your roster and rules above, then generate a chart.</p>
		</section>
	</div>
</Layout>

<script>
	import { loadRosters, loadActiveRosterName, type Roster } from "../../lib/rosterStore";
	import {
		buildLayout,
		defaultParams,
		PARAM_FIELDS,
		uShapeArms,
		type LayoutTemplate,
		type LayoutConfig,
		type SeatLayout,
	} from "../../lib/layoutEngine";
	import {
		generateSeatingChart,
		recentAdjacencySet,
		pushAdjacencyHistory,
		type Rule,
		type RuleType,
		type Mode,
	} from "../../lib/seatingChart";

	const root = document.querySelector<HTMLElement>("[data-seating-root]")!;

	// --- Element refs ------------------------------------------------------

	const templateButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-template-btn]"));
	const paramFieldsEl = root.querySelector<HTMLElement>("[data-param-fields]")!;
	const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]"));

	const rosterSelect = root.querySelector<HTMLSelectElement>("[data-roster-select]")!;
	const rosterEmptyEl = root.querySelector<HTMLElement>("[data-roster-empty]")!;

	const ruleTypeSelect = root.querySelector<HTMLSelectElement>("[data-rule-type-select]")!;
	const ruleFieldsEl = root.querySelector<HTMLElement>("[data-rule-fields]")!;
	const ruleErrorEl = root.querySelector<HTMLElement>("[data-rule-error]")!;
	const addRuleBtn = root.querySelector<HTMLButtonElement>("[data-add-rule]")!;
	const ruleListEl = root.querySelector<HTMLElement>("[data-rule-list]")!;
	const ruleEmptyEl = root.querySelector<HTMLElement>("[data-rule-empty]")!;
	const ruleCountEl = root.querySelector<HTMLElement>("[data-rule-count]")!;

	const avoidRepeatToggle = root.querySelector<HTMLInputElement>("[data-avoid-repeat-toggle]")!;
	const generateBtn = root.querySelector<HTMLButtonElement>("[data-generate-btn]")!;
	const regenerateBtn = root.querySelector<HTMLButtonElement>("[data-regenerate-btn]")!;

	const violationWarningEl = root.querySelector<HTMLElement>("[data-violation-warning]")!;
	const capacityHintEl = root.querySelector<HTMLElement>("[data-capacity-hint]")!;
	const chartStageEl = root.querySelector<HTMLElement>("[data-chart-stage]")!;
	const chartEmptyEl = root.querySelector<HTMLElement>("[data-chart-empty]")!;

	// --- State ---------------------------------------------------------

	let currentRoster: Roster = { name: "", students: [] };
	let template: LayoutTemplate = "rows";
	let params: Record<string, number> = defaultParams("rows");
	let mode: Mode = "general";
	let rules: Rule[] = [];
	let ruleIdCounter = 0;

	// Snapshot captured on Generate — Regenerate re-runs the algorithm
	// against exactly this, without re-reading the live form state (so
	// fiddling with fields after generating doesn't silently change what
	// Regenerate produces).
	let lastGenerate: { layout: SeatLayout; config: LayoutConfig; students: string[]; mode: Mode; rules: Rule[]; avoidRepeatNeighbors: boolean } | null = null;

	function escapeHtml(value: string): string {
		return value.replace(
			/[&<>"']/g,
			(char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]!,
		);
	}

	function eligibleStudents(): string[] {
		return currentRoster.students.filter((s) => !s.absent).map((s) => s.name);
	}

	function currentLayoutConfig(): LayoutConfig {
		return { template, params: { ...params } };
	}

	// --- Roster ------------------------------------------------------------

	function renderRosterSelect() {
		const all = loadRosters();
		const names = Object.keys(all).sort((a, b) => a.localeCompare(b));
		rosterEmptyEl.hidden = names.length > 0;
		rosterSelect.hidden = names.length === 0;
		if (names.length === 0) {
			currentRoster = { name: "", students: [] };
			rosterSelect.innerHTML = "";
			return;
		}
		if (!names.includes(currentRoster.name)) {
			const active = loadActiveRosterName();
			currentRoster = all[active && all[active] ? active : names[0]];
		}
		rosterSelect.innerHTML = names
			.map(
				(name) =>
					`<option value="${escapeHtml(name)}" ${name === currentRoster.name ? "selected" : ""}>${escapeHtml(name)}</option>`,
			)
			.join("");
	}

	rosterSelect.addEventListener("change", () => {
		const all = loadRosters();
		currentRoster = all[rosterSelect.value] ?? { name: rosterSelect.value, students: [] };
		// Rules referencing a student no longer on the selected roster (or now
		// absent) no longer make sense — drop them rather than leave a rule
		// silently pointing at nobody.
		const eligible = new Set(eligibleStudents());
		rules = rules.filter((rule) => rule.studentNames.every((name) => eligible.has(name)));
		renderRuleFields();
		renderRuleList();
		updateGenerateAvailability();
	});

	// --- Template & params ---------------------------------------------------

	function renderParamFields() {
		const fields = PARAM_FIELDS[template];
		paramFieldsEl.innerHTML = fields
			.map(
				(field) => `
			<label class="field-label-row" data-param-field="${field.key}">
				<span class="field-label">${field.label}</span>
				<input
					type="number"
					class="number-input"
					min="${field.min}"
					max="${field.max}"
					value="${params[field.key] ?? field.min}"
					data-param-input="${field.key}"
				/>
			</label>
		`,
			)
			.join("");
	}

	paramFieldsEl.addEventListener("change", (event) => {
		const target = event.target as HTMLInputElement;
		const key = target.dataset.paramInput;
		if (!key) return;
		const field = PARAM_FIELDS[template].find((f) => f.key === key)!;
		const value = Math.round(Number(target.value));
		params[key] = Number.isFinite(value) ? Math.min(field.max, Math.max(field.min, value)) : field.min;
		target.value = String(params[key]);
		renderRuleFields();
	});

	function setTemplate(next: LayoutTemplate) {
		template = next;
		params = defaultParams(next);
		templateButtons.forEach((btn) => btn.setAttribute("aria-pressed", btn.dataset.templateBtn === next ? "true" : "false"));
		renderParamFields();
		// A pinned rule's seat index only makes sense for the layout it was
		// created under — switching templates invalidates any pinned seats.
		rules = rules.filter((rule) => rule.type !== "pinned");
		renderRuleFields();
		renderRuleList();
	}

	templateButtons.forEach((btn) => btn.addEventListener("click", () => setTemplate(btn.dataset.templateBtn as LayoutTemplate)));

	// --- Mode ------------------------------------------------------------

	function setMode(next: Mode) {
		mode = next;
		modeButtons.forEach((btn) => btn.setAttribute("aria-selected", btn.dataset.modeBtn === next ? "true" : "false"));
	}

	modeButtons.forEach((btn) => btn.addEventListener("click", () => setMode(btn.dataset.modeBtn as Mode)));

	// --- Rule form -----------------------------------------------------------

	function studentOptions(selectedIndex = 0): string {
		const students = eligibleStudents();
		return students
			.map((name, i) => `<option value="${escapeHtml(name)}" ${i === selectedIndex ? "selected" : ""}>${escapeHtml(name)}</option>`)
			.join("");
	}

	function seatOptions(): string {
		const layout = buildLayout(currentLayoutConfig());
		return Array.from({ length: layout.seatCount }, (_, i) => `<option value="${i}">Seat ${i + 1}</option>`).join("");
	}

	function renderRuleFields() {
		const type = ruleTypeSelect.value as RuleType;
		const students = eligibleStudents();
		ruleErrorEl.hidden = true;

		if (students.length === 0) {
			ruleFieldsEl.innerHTML = `<p class="panel-hint">Add students to this roster first.</p>`;
			addRuleBtn.disabled = true;
			return;
		}

		if (type === "keep-apart" || type === "keep-together") {
			ruleFieldsEl.innerHTML = `
				<label class="field-label-row">
					<span class="field-label">Student A</span>
					<select class="select-input" data-rule-student="0">${studentOptions(0)}</select>
				</label>
				<label class="field-label-row">
					<span class="field-label">Student B</span>
					<select class="select-input" data-rule-student="1">${studentOptions(Math.min(1, students.length - 1))}</select>
				</label>
			`;
			addRuleBtn.disabled = students.length < 2;
		} else if (type === "pinned") {
			ruleFieldsEl.innerHTML = `
				<label class="field-label-row">
					<span class="field-label">Student</span>
					<select class="select-input" data-rule-student="0">${studentOptions(0)}</select>
				</label>
				<label class="field-label-row">
					<span class="field-label">Seat</span>
					<select class="select-input" data-rule-seat>${seatOptions()}</select>
				</label>
			`;
			addRuleBtn.disabled = false;
		} else {
			ruleFieldsEl.innerHTML = `
				<label class="field-label-row">
					<span class="field-label">Student</span>
					<select class="select-input" data-rule-student="0">${studentOptions(0)}</select>
				</label>
				<label class="field-label-row">
					<span class="field-label">Skill tier</span>
					<select class="select-input" data-rule-tier>
						<option value="1">Tier 1</option>
						<option value="2">Tier 2</option>
						<option value="3">Tier 3</option>
					</select>
				</label>
			`;
			addRuleBtn.disabled = false;
		}
	}

	ruleTypeSelect.addEventListener("change", renderRuleFields);

	function ruleSummary(rule: Rule): string {
		if (rule.type === "keep-apart") return `Keep apart: ${rule.studentNames[0]} &amp; ${rule.studentNames[1]}`;
		if (rule.type === "keep-together") return `Keep together: ${rule.studentNames[0]} &amp; ${rule.studentNames[1]}`;
		if (rule.type === "pinned") return `Pinned: ${rule.studentNames[0]} → Seat ${(rule.seatIndex ?? 0) + 1}`;
		return `Skill tier ${rule.skillTier}: ${rule.studentNames[0]}`;
	}

	function renderRuleList() {
		ruleCountEl.textContent = String(rules.length);
		ruleEmptyEl.hidden = rules.length > 0;
		ruleListEl.innerHTML = rules
			.map(
				(rule) => `
			<li class="rule-row" data-rule-id="${rule.id}">
				<span class="rule-summary">${ruleSummary(rule)}</span>
				<button type="button" class="remove-btn" data-remove-rule aria-label="Remove rule">×</button>
			</li>
		`,
			)
			.join("");
	}

	function showRuleError(message: string) {
		ruleErrorEl.textContent = message;
		ruleErrorEl.hidden = false;
	}

	addRuleBtn.addEventListener("click", () => {
		const type = ruleTypeSelect.value as RuleType;
		ruleErrorEl.hidden = true;

		if (type === "keep-apart" || type === "keep-together") {
			const a = ruleFieldsEl.querySelector<HTMLSelectElement>('[data-rule-student="0"]')!.value;
			const b = ruleFieldsEl.querySelector<HTMLSelectElement>('[data-rule-student="1"]')!.value;
			if (!a || !b || a === b) {
				showRuleError("Pick two different students.");
				return;
			}
			rules.push({ id: `rule-${++ruleIdCounter}`, type, studentNames: [a, b] });
		} else if (type === "pinned") {
			const name = ruleFieldsEl.querySelector<HTMLSelectElement>('[data-rule-student="0"]')!.value;
			const seatIndex = Number(ruleFieldsEl.querySelector<HTMLSelectElement>("[data-rule-seat]")!.value);
			if (!name) {
				showRuleError("Pick a student.");
				return;
			}
			// Only one pin per student, and only one student per seat — a new
			// pin replaces any earlier one that conflicts with it.
			rules = rules.filter(
				(rule) => !(rule.type === "pinned" && (rule.studentNames[0] === name || rule.seatIndex === seatIndex)),
			);
			rules.push({ id: `rule-${++ruleIdCounter}`, type, studentNames: [name], seatIndex });
		} else {
			const name = ruleFieldsEl.querySelector<HTMLSelectElement>('[data-rule-student="0"]')!.value;
			const skillTier = Number(ruleFieldsEl.querySelector<HTMLSelectElement>("[data-rule-tier]")!.value) as 1 | 2 | 3;
			if (!name) {
				showRuleError("Pick a student.");
				return;
			}
			rules = rules.filter((rule) => !(rule.type === "skill-balance" && rule.studentNames[0] === name));
			rules.push({ id: `rule-${++ruleIdCounter}`, type, studentNames: [name], skillTier });
		}

		renderRuleList();
	});

	ruleListEl.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;
		const row = target.closest<HTMLElement>("[data-rule-id]");
		if (!row || !target.closest("[data-remove-rule]")) return;
		rules = rules.filter((rule) => rule.id !== row.dataset.ruleId);
		renderRuleList();
		renderRuleFields();
	});

	// --- Chart rendering -------------------------------------------------

	function seatCellHtml(index: number, name: string | null, pinned: boolean, revealIndex: number): string {
		const classes = ["seat-cell"];
		if (!name) classes.push("seat-cell--empty");
		if (pinned) classes.push("seat-cell--pinned");
		return `
			<div class="${classes.join(" ")}" style="--seat-i: ${Math.min(revealIndex, 40)}">
				<span class="seat-index">${index + 1}</span>
				<span class="seat-name">${name ? escapeHtml(name) : "—"}</span>
			</div>
		`;
	}

	function renderChart(config: LayoutConfig, layout: SeatLayout, assignments: (string | null)[], pinnedSeats: Set<number>) {
		let html = "";
		let revealIndex = 0;

		if (config.template === "rows") {
			const cols = config.params.cols;
			html = `<div class="rows-grid" style="--cols: ${cols}">${assignments
				.map((name, i) => seatCellHtml(i, name, pinnedSeats.has(i), revealIndex++))
				.join("")}</div>`;
		} else if (config.template === "pods") {
			const podSize = config.params.podSize;
			const podCount = config.params.podCount;
			const pods: string[] = [];
			for (let p = 0; p < podCount; p++) {
				const seats = Array.from({ length: podSize }, (_, k) => p * podSize + k);
				pods.push(
					`<div class="pod-box">${seats.map((seat) => seatCellHtml(seat, assignments[seat], pinnedSeats.has(seat), revealIndex++)).join("")}</div>`,
				);
			}
			html = `<div class="pods-grid">${pods.join("")}</div>`;
		} else if (config.template === "pairs") {
			const pairCount = config.params.pairCount;
			const pairs: string[] = [];
			for (let p = 0; p < pairCount; p++) {
				const seats = [p * 2, p * 2 + 1];
				pairs.push(
					`<div class="pair-box">${seats.map((seat) => seatCellHtml(seat, assignments[seat], pinnedSeats.has(seat), revealIndex++)).join("")}</div>`,
				);
			}
			html = `<div class="pairs-grid">${pairs.join("")}</div>`;
		} else {
			const { left, top, right } = uShapeArms(config.params.seatCount);
			const leftSeats = Array.from({ length: left }, (_, i) => i);
			const topSeats = Array.from({ length: top }, (_, i) => left + i);
			const rightSeats = Array.from({ length: right }, (_, i) => left + top + i);
			html = `
				<div class="ushape-layout">
					<div class="ushape-top">
						${topSeats.map((seat) => seatCellHtml(seat, assignments[seat], pinnedSeats.has(seat), revealIndex++)).join("")}
					</div>
					<div class="ushape-arms">
						<div class="ushape-left">
							${[...leftSeats]
								.reverse()
								.map((seat) => seatCellHtml(seat, assignments[seat], pinnedSeats.has(seat), revealIndex++))
								.join("")}
						</div>
						<div class="ushape-right">
							${rightSeats.map((seat) => seatCellHtml(seat, assignments[seat], pinnedSeats.has(seat), revealIndex++)).join("")}
						</div>
					</div>
				</div>
			`;
		}

		chartStageEl.innerHTML = html;
		chartStageEl.classList.remove("is-revealing");
		void chartStageEl.offsetWidth;
		chartStageEl.classList.add("is-revealing");
		chartEmptyEl.hidden = true;
		chartStageEl.hidden = false;
	}

	// --- Generate / Regenerate -----------------------------------------------

	function updateGenerateAvailability() {
		generateBtn.disabled = eligibleStudents().length === 0;
	}

	function runGenerate(layout: SeatLayout, config: LayoutConfig, students: string[], useMode: Mode, useRules: Rule[], avoidRepeat: boolean) {
		const recentAdjacency = recentAdjacencySet(currentRoster.name);
		const result = generateSeatingChart({
			layout,
			students,
			mode: useMode,
			rules: useRules,
			avoidRepeatNeighbors: avoidRepeat,
			recentAdjacency,
		});
		pushAdjacencyHistory(currentRoster.name, result.adjacencyPairs);

		const pinnedSeats = new Set(
			useRules.filter((r) => r.type === "pinned" && r.seatIndex !== undefined).map((r) => r.seatIndex!),
		);
		renderChart(config, layout, result.assignments, pinnedSeats);

		violationWarningEl.hidden = result.satisfied;

		const seatedCount = result.assignments.filter(Boolean).length;
		const unseated = students.length - seatedCount;
		if (unseated > 0) {
			capacityHintEl.hidden = false;
			capacityHintEl.textContent = `${students.length} students, ${layout.seatCount} seats — ${unseated} student${unseated === 1 ? "" : "s"} won't be seated.`;
		} else {
			capacityHintEl.hidden = true;
		}

		regenerateBtn.disabled = false;
	}

	generateBtn.addEventListener("click", () => {
		const students = eligibleStudents();
		if (students.length === 0) return;
		const config = currentLayoutConfig();
		const layout = buildLayout(config);
		const avoidRepeat = avoidRepeatToggle.checked;
		const ruleSnapshot = rules.map((r) => ({ ...r, studentNames: [...r.studentNames] }));
		lastGenerate = { layout, config, students, mode, rules: ruleSnapshot, avoidRepeatNeighbors: avoidRepeat };
		runGenerate(layout, config, students, mode, ruleSnapshot, avoidRepeat);
	});

	regenerateBtn.addEventListener("click", () => {
		if (!lastGenerate) return;
		runGenerate(
			lastGenerate.layout,
			lastGenerate.config,
			lastGenerate.students,
			lastGenerate.mode,
			lastGenerate.rules,
			lastGenerate.avoidRepeatNeighbors,
		);
	});

	// --- Init ------------------------------------------------------------

	(function init() {
		renderRosterSelect();
		renderParamFields();
		renderRuleFields();
		renderRuleList();
		updateGenerateAvailability();
	})();
</script>

