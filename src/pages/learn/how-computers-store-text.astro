---
import LearnArticle from "../../components/LearnArticle.astro";
import BitChip from "../../components/BitChip.astro";
import TextToBinary from "../../components/TextToBinary.astro";
import DecoderChallenge from "../../components/DecoderChallenge.astro";

const word = "HI";
const letters = word.split("").map((char) => ({
	char,
	code: char.charCodeAt(0),
	bits: char.charCodeAt(0).toString(2).padStart(8, "0"),
}));

// Splits `items` into `parts` contiguous, roughly-equal chunks (reading down
// one column before moving to the next, like a dictionary or phone book),
// rather than round-robin dealing — so a column reads as a natural
// alphabetical/numeric run instead of every Nth entry.
function chunkInto<T>(items: T[], parts: number): T[][] {
	const size = Math.ceil(items.length / parts);
	const chunks: T[][] = [];
	for (let i = 0; i < items.length; i += size) chunks.push(items.slice(i, i + size));
	return chunks;
}

// Reference table data, grouped the way a reader would actually scan it —
// not the raw 0-127 ASCII order, which scatters letters, digits, and
// punctuation together. Each group is then split into side-by-side columns
// (count scaled to the group's size) so long lists like the 26-entry letter
// groups don't read as one endless vertical scroll.
const asciiGroups = [
	{ label: "Uppercase Letters", chars: Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i)), columns: 4 },
	{ label: "Lowercase Letters", chars: Array.from({ length: 26 }, (_, i) => String.fromCharCode(97 + i)), columns: 4 },
	{ label: "Digits", chars: Array.from({ length: 10 }, (_, i) => String.fromCharCode(48 + i)), columns: 2 },
	{ label: "Punctuation", chars: [" ", ".", ",", "!", "?"], columns: 1 },
].map((group) => {
	const entries = group.chars.map((char) => ({
		display: char === " " ? "Space" : char,
		decimal: char.charCodeAt(0),
		bits: char.charCodeAt(0).toString(2).padStart(8, "0"),
	}));
	return { label: group.label, columns: chunkInto(entries, group.columns) };
});
---

<LearnArticle
	href="/learn/how-computers-store-text"
	description="How computers turn keyboard characters into binary using ASCII, with an interactive tool, quick-reference table, and decoding challenge."
>
	<Fragment slot="lead">You already know a computer's secrets are just 0s and 1s. So how does a keyboard letter like
		"H" become binary?</Fragment>

	<section class="block">
		<p class="block-title">Every Character Gets a Number</p>
		<p class="block-text">
			Long before your screen shows a letter, your computer has already turned it into a number.
			Computers and keyboards agree in advance on exactly which number means which character — so
			"H" always means the same thing to every device.
		</p>
		<p class="block-text">
			Once it's a number, it's easy: just write that number in binary, the same way you've already
			seen with any other value.
		</p>
	</section>

	<section class="block block--example">
		<p class="block-title">ASCII: One of the First Systems</p>
		<p class="block-text">
			One of the earliest standards, called ASCII, assigned a number to every letter, digit, and
			punctuation mark on a standard keyboard — 128 characters in total, each fitting in a single
			byte.
		</p>
		<p class="block-text">
			Take the word "HI." Your computer stores it as two numbers — H is 72, I is 73 — written out
			here as 8-bit binary, one byte each:
		</p>

		<div class="byte-demo">
			{
				letters.map((letter) => (
					<div class="byte-demo-group">
						<div class="byte-demo-tiles">
							{letter.bits.split("").map((bit) => (
								<BitChip value={bit as "0" | "1"} />
							))}
						</div>
						<span class="byte-demo-label">
							"{letter.char}" = {letter.code}
						</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="block">
		<p class="block-title">Why 128 Characters Wasn't Enough</p>
		<p class="block-text">
			ASCII covers English letters, numbers, and basic punctuation — plenty for a 1960s
			teleprinter, not enough for a modern one. It has no room for accented letters, other
			alphabets like Arabic or Chinese, or a single emoji.
		</p>
		<p class="block-text">
			That's why almost every computer today uses Unicode instead — a much bigger system built to
			give every character in every language (and yes, every 😀) its own number. The letters and
			numbers you already know still work exactly the same way underneath.
		</p>
	</section>

	<section class="block">
		<p class="block-title">Text Is Just Another Kind of Bits</p>
		<p class="block-text">
			Every message you've ever sent, every word on this page, is binary underneath — no different
			in kind from a LogicDash secret. The only difference is scale: your guess is 5 or 6 bits; a
			text message is thousands.
		</p>
	</section>

	<section id="try-it-yourself" class="block block--example">
		<p class="block-title">Try It Yourself</p>
		<TextToBinary />
	</section>

	<section class="block">
		<p class="block-title">ASCII Quick Reference</p>
		<p class="block-text">
			Every character your keyboard can type, mapped to its decimal value and 8-bit binary. Handy
			any time you need to look one up.
		</p>
		<p class="ascii-note">
			Note: uppercase and lowercase letters are different characters to a computer — "A" (65) and
			"a" (97) are not the same number.
		</p>
		{
			asciiGroups.map((group) => (
				<div class="ascii-group">
					<p class="ascii-group-label">{group.label}</p>
					<div class="ascii-columns">
						{
							group.columns.map((column) => (
								<div class="ascii-table-wrap">
									<table class="ascii-table">
										<thead>
											<tr>
												<th>Char</th>
												<th>Dec</th>
												<th>Binary</th>
											</tr>
										</thead>
										<tbody>
											{column.map((entry) => (
												<tr>
													<td class="ascii-char">{entry.display}</td>
													<td class="ascii-dec">{entry.decimal}</td>
													<td class="ascii-bin">{entry.bits}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							))
						}
					</div>
				</div>
			))
		}
	</section>

	<section class="block block--example block--practice">
		<p class="block-title">Crack the Code</p>
		<p class="block-text">
			Someone hid a message in binary. Decode each byte back into a letter — using the reference
			table above, or the math from earlier in this lesson — to reveal it.
		</p>
		<div class="decoder-group">
			<DecoderChallenge label="Warm-up" word="BIT" />
			<div class="decoder-divider" />
			<DecoderChallenge label="Main Challenge" word="DIGITAL" />
		</div>
	</section>

</LearnArticle>

<style>

	.byte-demo {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 1rem 0 0.25rem;
		padding: 1rem;
		border-radius: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.byte-demo-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.byte-demo-tiles {
		display: flex;
		gap: 0.25rem;
	}

	.byte-demo-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.block--practice {
		background: #14313a;
		border: 1px solid color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
		box-shadow: 0 0 28px -10px color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	.ascii-note {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--color-text-muted);
	}

	.ascii-group {
		margin: 1rem 0 0;
	}

	.ascii-group:first-of-type {
		margin-top: 1rem;
	}

	.ascii-group-label {
		margin: 0 0 0.5rem;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	/* auto-fit (not auto-fill) collapses any track past the actual number of
	   columns a group has — Digits only splits into 2, Punctuation into 1 —
	   so those don't leave dead space on wide screens the way auto-fill's
	   reserved-but-empty tracks would. The bounded max (13rem, tuned so the
	   4-column groups' real columns fit on one row within this page's
	   ~880px content width rather than wrapping a lone 4th column onto its
	   own line) keeps a single surviving column (Punctuation) from
	   stretching edge-to-edge once its sibling tracks collapse. */
	.ascii-columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 13rem));
		gap: 0.5rem;
		align-items: start;
	}

	.ascii-table-wrap {
		overflow-x: auto;
		border-radius: 10px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.ascii-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.ascii-table th {
		padding: 0.25rem 0.75rem;
		text-align: left;
		font-family: var(--font-sans);
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		border-bottom: 1px solid var(--color-border);
	}

	.ascii-table td {
		padding: 0.25rem 0.75rem;
		line-height: 1.4;
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
	}

	.ascii-table tbody tr:last-child td {
		border-bottom: none;
	}

	.ascii-table tbody tr:nth-child(even) {
		background: color-mix(in srgb, var(--color-surface) 60%, transparent);
	}

	.ascii-char {
		width: 3.2rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.ascii-dec {
		width: 3.4rem;
		color: var(--color-text-muted);
	}

	.ascii-bin {
		color: color-mix(in srgb, var(--color-accent) 70%, var(--color-text-muted));
	}

	.decoder-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-top: 1rem;
	}

	.decoder-divider {
		width: 100%;
		max-width: 20rem;
		height: 1px;
		background: var(--color-border);
	}

</style>
