---
import LearnArticle from "../../components/LearnArticle.astro";
import DemoFrame from "../../components/DemoFrame.astro";
import { LEVELS, LEVEL_HINTS, LEVEL_LABELS, TOPICS, TOPIC_LABELS } from "../../lib/pseudo/core";
import { LEGEND_BLOCKED, LEGEND_ROBOT, LEGEND_TARGET } from "../../lib/pseudo/robotSvg";

const cheatSheet = [
	{ code: "a ← 5", means: "Store 5 in the variable a" },
	{ code: "DISPLAY(a)", means: "Show a's value, followed by a space" },
	{ code: "a / b", means: "Ordinary division: 17 / 5 is 3.4" },
	{ code: "a MOD b", means: "The remainder: 17 MOD 5 is 2 (same precedence as * and /)" },
	{ code: "= ≠ < > ≤ ≥", means: "Compare two values (true or false)" },
	{ code: "AND  OR  NOT", means: "Combine or flip true/false values" },
	{ code: "IF (c) … ELSE …", means: "Run the first block if c is true, otherwise the second" },
	{ code: "REPEAT n TIMES", means: "Run the block exactly n times" },
	{ code: "REPEAT UNTIL (c)", means: "Check c before each pass; stop as soon as c is true" },
	{ code: "FOR EACH x IN list", means: "Run the block once for each item, first to last" },
	{ code: "list[1]", means: "The FIRST item — lists start at 1. Index < 1 or > LENGTH is an error" },
	{ code: "APPEND(list, v)", means: "Add v to the end" },
	{ code: "INSERT(list, i, v)", means: "Put v at index i; later items shift right" },
	{ code: "REMOVE(list, i)", means: "Delete the item at index i; later items shift left" },
	{ code: "LENGTH(list)", means: "How many items are in the list" },
	{ code: "RETURN(x)", means: "Send x back from a procedure and stop it immediately" },
	{ code: "RANDOM(a, b)", means: "A random whole number from a to b, including both" },
];
---

<LearnArticle
	href="/learn/pseudocode-practice"
	description="Pseudocode practice at three levels: read code, predict the result, and learn from every answer. Topics, mixed practice and a review of your mistakes."
	sections={false}
>
	<DemoFrame label="Pseudocode practice" title="Pseudocode Practice">
		<div class="pp" data-pp>
			<!-- ============================ Start ============================ -->
			<section class="pp-start" data-pp-start aria-labelledby="pp-start-title">
				<h2 class="sr-only" id="pp-start-title">Start practicing</h2>
				<p class="pp-instr">
					Read the code, predict the result, then choose an answer. Check the explanation before continuing.{" "}
					<strong>Lists start at 1.</strong>
				</p>

				<div class="pp-continue" data-pp-continue hidden>
					<button type="button" class="pp-btn pp-btn--primary pp-btn--wide" data-pp-continue-btn>
						Continue practice <span class="pp-continue-label" data-pp-continue-label></span>
					</button>
				</div>

				<div class="pp-routes" role="radiogroup" aria-label="How do you want to practice?">
					<button type="button" class="pp-route" role="radio" aria-checked="true" data-pp-route="topic">
						<span class="pp-route-name">Practice a topic</span>
						<span class="pp-route-hint">Choose a topic and level</span>
					</button>
					<button type="button" class="pp-route" role="radio" aria-checked="false" data-pp-route="mixed">
						<span class="pp-route-name">Mixed practice</span>
						<span class="pp-route-hint">Every topic, one level</span>
					</button>
					<button type="button" class="pp-route" role="radio" aria-checked="false" data-pp-route="review">
						<span class="pp-route-name">Review mistakes</span>
						<span class="pp-route-hint" data-pp-review-hint>No mistakes to review yet</span>
					</button>
				</div>

				<div class="pp-setup" data-pp-setup>
					<fieldset class="pp-field" data-pp-topic-field>
						<legend>Topic</legend>
						<div class="pp-topics">
							{
								TOPICS.map((t) => (
									<label class="pp-topic">
										<input type="radio" name="pp-topic" value={t} />
										<span class="pp-topic-name">{TOPIC_LABELS[t]}</span>
										<span class="pp-topic-state" data-pp-topic-state={t} />
									</label>
								))
							}
						</div>
					</fieldset>
					<fieldset class="pp-field">
						<legend>Level</legend>
						<div class="pp-levels">
							{
								LEVELS.map((l) => (
									<label class="pp-level">
										<input type="radio" name="pp-level" value={l} />
										<span class="pp-level-name">{LEVEL_LABELS[l]}</span>
										<span class="pp-level-hint">{LEVEL_HINTS[l]}</span>
									</label>
								))
							}
						</div>
					</fieldset>
					<p class="pp-setup-note" data-pp-setup-note aria-live="polite"></p>
					<div class="pp-actions">
						<button type="button" class="pp-btn pp-btn--primary" data-pp-begin>Start practicing →</button>
						<button type="button" class="pp-link" data-pp-help-open aria-controls="pp-help">Pseudocode help</button>
					</div>
				</div>

				<details class="pp-progress">
					<summary>Your progress by topic</summary>
					<ul class="pp-progress-list" data-pp-progress-list></ul>
					<p class="pp-small">
						These are practice indicators based on your recent first tries — not a prediction of test results. Progress is
						saved in this browser only.
					</p>
				</details>
			</section>

			<!-- =========================== Session =========================== -->
			<section class="pp-session" data-pp-session hidden aria-label="Practice question">
				<div class="pp-bar">
					<p class="pp-scope"><span data-pp-scope></span> <button type="button" class="pp-link" data-pp-change>Change</button></p>
					<div class="pp-bar-right">
						<label class="pp-level-select">
							<span>Level</span>
							<select data-pp-level-select>
								{LEVELS.map((l) => <option value={l}>{LEVEL_LABELS[l]}</option>)}
							</select>
						</label>
						<button type="button" class="pp-link" data-pp-help-open aria-controls="pp-help">Pseudocode help</button>
					</div>
				</div>
				<p class="pp-stats" data-pp-stats></p>

				<div class="pp-advice" data-pp-advice hidden role="status">
					<p data-pp-advice-text></p>
					<div class="pp-actions">
						<button type="button" class="pp-btn pp-btn--primary" data-pp-advice-yes></button>
						<button type="button" class="pp-btn" data-pp-advice-no>Not now</button>
					</div>
				</div>

				<article class="pp-card" data-pp-card>
					<p class="pp-meta" data-pp-meta></p>
					<p class="pp-prompt" data-pp-prompt tabindex="-1"></p>
					<div class="pp-body" data-pp-body>
						<pre class="pp-code" data-pp-code tabindex="0" aria-label="Code"></pre>
						<figure class="pp-figure" data-pp-figure hidden>
							<div class="pp-grid" data-pp-grid></div>
							<figcaption class="pp-legend">
								<span><Fragment set:html={LEGEND_ROBOT} /> Robot (points the way it faces)</span>
								<span><Fragment set:html={LEGEND_BLOCKED} /> Blocked</span>
								<span><Fragment set:html={LEGEND_TARGET} /> Labeled square</span>
							</figcaption>
						</figure>
					</div>
					<div class="pp-options" data-pp-options role="group" aria-label="Answer choices"></div>
					<div class="pp-next-row">
						<span class="pp-keys" aria-hidden="true">Keys: 1–4 answer · Enter next · T trace</span>
						<button type="button" class="pp-btn pp-btn--primary" data-pp-next disabled>Next question →</button>
					</div>
					<div class="pp-feedback" data-pp-feedback aria-live="polite" hidden>
						<p class="pp-verdict" data-pp-verdict></p>
						<p class="pp-picked" data-pp-picked></p>
						<p class="pp-expl" data-pp-expl></p>
						<p class="pp-why" data-pp-why hidden></p>
						<button type="button" class="pp-btn" data-pp-trace-btn aria-expanded="false" aria-controls="pp-trace" hidden>Show trace</button>
					</div>
					<div class="pp-trace" id="pp-trace" data-pp-trace hidden>
						<p class="pp-trace-note" data-pp-trace-note></p>
						<div class="pp-trace-controls">
							<button type="button" class="pp-btn" data-pp-t-back>← Back</button>
							<button type="button" class="pp-btn pp-btn--primary" data-pp-t-step>Step →</button>
							<button type="button" class="pp-btn" data-pp-t-play>Play</button>
							<button type="button" class="pp-btn" data-pp-t-reset>Reset</button>
							<span class="pp-trace-count" data-pp-t-count aria-live="polite"></span>
						</div>
						<p class="pp-trace-now" data-pp-t-now></p>
						<div class="pp-trace-body">
							<pre class="pp-code pp-trace-code" data-pp-t-code tabindex="0" aria-label="Code being traced"></pre>
							<div class="pp-trace-side">
								<div class="pp-trace-grid" data-pp-t-grid hidden></div>
								<div data-pp-t-vars-box>
									<p class="pp-trace-label">Variables</p>
									<p class="pp-trace-vars" data-pp-t-vars></p>
								</div>
								<div data-pp-t-out-box>
									<p class="pp-trace-label">Output so far</p>
									<p class="pp-trace-out" data-pp-t-out></p>
								</div>
							</div>
						</div>
					</div>
				</article>

				<article class="pp-checkpoint" data-pp-checkpoint hidden tabindex="-1" aria-labelledby="pp-cp-title">
					<h3 id="pp-cp-title">Checkpoint</h3>
					<p class="pp-cp-score" data-pp-cp-score></p>
					<p data-pp-cp-skills></p>
					<p class="pp-cp-next" data-pp-cp-next></p>
					<div class="pp-actions">
						<button type="button" class="pp-btn pp-btn--primary" data-pp-cp-continue>Continue</button>
						<button type="button" class="pp-btn" data-pp-cp-review>Review mistakes</button>
						<button type="button" class="pp-btn" data-pp-cp-level hidden></button>
						<button type="button" class="pp-btn" data-pp-cp-change>Change topic</button>
					</div>
				</article>
			</section>

			<!-- ============================= Help ============================ -->
			<section class="pp-help" id="pp-help" data-pp-help hidden aria-labelledby="pp-help-title" tabindex="-1">
				<div class="pp-help-head">
					<h3 id="pp-help-title">Pseudocode help</h3>
					<button type="button" class="pp-btn" data-pp-help-close>Close</button>
				</div>
				<div class="table-wrap">
					<table class="data-table">
						<tbody>
							{
								cheatSheet.map((row) => (
									<tr>
										<td class="num">{row.code}</td>
										<td>{row.means}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="pp-small">
					<strong>Robot:</strong> MOVE_FORWARD() moves one square the way the robot faces. ROTATE_LEFT() and ROTATE_RIGHT()
					turn it 90° in place. CAN_MOVE("left"), ("right"), ("forward") or ("backward") checks the square on that side
					<em>of the robot</em>. If the robot tries to move into a blocked square or off the grid, it stays where it is and the
					program ends.
				</p>
				<p class="pp-small"><strong>Keys:</strong> 1–4 choose an answer · Enter or N next question · T show or hide the trace.</p>
			</section>

			<p class="pp-storage-note" data-pp-storage-note hidden>Your browser isn't letting this page save progress, so it will reset when you leave.</p>
		</div>
	</DemoFrame>

	<section class="block">
		<p class="block-title">For Teachers</p>
		<ul class="block-list">
			<li>
				<em>Levels describe reasoning, not number size.</em> Easy: one idea in short code. Medium: two ideas, or more
				to keep track of. Challenging: several ideas together, edge cases, or reasoning about what an algorithm does.
			</li>
			<li>
				<em>Mistakes come back as new examples.</em> A missed skill returns after two or three other questions with
				different code or values, so students re-reason rather than remember an answer.
			</li>
			<li>
				<em>Progress is a practice indicator.</em> "Ready for a harder challenge" appears after at least 8 correct
				first tries in the last 10 at a level, across at least 3 kinds of question. It's a nudge, not a grade.
			</li>
			<li>
				The notation follows the exam reference sheet: ← for assignment, ordinary division, MOD, 1-based lists, and the
				robot rules. Use <em>Pseudocode help</em> during practice.
			</li>
		</ul>
	</section>
</LearnArticle>

<script>
	import { questionById } from "../../lib/pseudo/bank";
	import { LEVELS, LEVEL_LABELS, TOPICS, TOPIC_LABELS, TYPE_LABELS, type Level, type Question, type Topic } from "../../lib/pseudo/core";
	import { run, type TraceStep } from "../../lib/pseudo/interpreter";
	import {
		STORAGE_KEY,
		SKILL_STATE_LABELS,
		checkpoint,
		checkpointDue,
		closeCheckpoint,
		dismissAdvice,
		freshState,
		levelSuggestion,
		loadState,
		pickNext,
		poolSize,
		recordAnswer,
		reviewFor,
		topicProgress,
		type ReviewItem,
		type Route,
		type Settings,
		type State,
	} from "../../lib/pseudo/progress";
	import { robotSvg } from "../../lib/pseudo/robotSvg";

	const root = document.querySelector<HTMLElement>("[data-pp]")!;
	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
	const $$ = <T extends HTMLElement = HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel));
	const frame = root.closest<HTMLElement>("[data-demo-frame]")!;
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	// --- Storage (best effort) --------------------------------------------------
	let storageOk = true;
	function load(): State {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) {
				const s = loadState(JSON.parse(raw));
				if (s) return s;
				// Unreadable data is kept aside rather than silently erased.
				localStorage.setItem(`${STORAGE_KEY}:unreadable`, raw);
			}
		} catch {
			storageOk = false;
		}
		return freshState();
	}
	function save() {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
		} catch {
			storageOk = false;
			$("[data-pp-storage-note]").hidden = false;
		}
	}

	let state = load();
	if (!storageOk) $("[data-pp-storage-note]").hidden = false;
	let settings: Settings = state.settings ?? { route: "topic", topic: "variables", level: "easy" };
	let route: Route = state.settings ? settings.route : "topic";
	let current: Question | null = null;
	let currentReview: ReviewItem | null = null;
	let answered = false;
	let order: number[] = [];

	// =========================================================== Start screen
	const startEl = $("[data-pp-start]");
	const sessionEl = $("[data-pp-session]");
	const routeBtns = $$<HTMLButtonElement>("[data-pp-route]");
	const topicField = $("[data-pp-topic-field]");
	const topicInputs = $$<HTMLInputElement>('input[name="pp-topic"]');
	const levelInputs = $$<HTMLInputElement>('input[name="pp-level"]');
	const setupNote = $("[data-pp-setup-note]");
	const beginBtn = $<HTMLButtonElement>("[data-pp-begin]");

	// Brings a part of the practice into view when it changes, so a student
	// who scrolled down to read feedback isn't left looking at the old card.
	// Fullscreen fits everything on screen already, so it's skipped there.
	function reveal(el: HTMLElement, always = false) {
		if (frame.classList.contains("is-fullscreen")) return;
		const top = el.getBoundingClientRect().top;
		if (!always && top >= 0 && top < window.innerHeight * 0.5) return;
		window.scrollTo({ top: window.scrollY + top - 12, behavior: reduceMotion ? "auto" : "smooth" });
	}

	const scopeText = (s: Settings) =>
		s.route === "review" ? `Review mistakes · ${LEVEL_LABELS[s.level]}` : `${s.route === "topic" ? TOPIC_LABELS[s.topic] : "Mixed"} · ${LEVEL_LABELS[s.level]}`;

	function renderStart() {
		const cont = $("[data-pp-continue]");
		cont.hidden = !state.settings;
		if (state.settings) $("[data-pp-continue-label]").textContent = `— ${scopeText(state.settings)}`;
		const reviewCount = state.review.length;
		$("[data-pp-review-hint]").textContent = reviewCount ? `${reviewCount} skill${reviewCount === 1 ? "" : "s"} to revisit` : "No mistakes to review yet";
		routeBtns.forEach((b) => {
			const on = b.dataset.ppRoute === route;
			b.setAttribute("aria-checked", String(on));
			b.tabIndex = on ? 0 : -1;
		});
		topicField.hidden = route !== "topic";
		topicInputs.forEach((i) => (i.checked = i.value === settings.topic));
		levelInputs.forEach((i) => (i.checked = i.value === settings.level));
		for (const t of TOPICS) {
			const p = topicProgress(state, t);
			const el = root.querySelector<HTMLElement>(`[data-pp-topic-state="${t}"]`)!;
			el.textContent = SKILL_STATE_LABELS[p.state];
			el.dataset.state = p.state;
		}
		if (route === "review" && reviewCount === 0) {
			setupNote.textContent = "Nothing to review yet — mistakes you make will appear here. Try a topic or mixed practice first.";
			beginBtn.disabled = true;
		} else {
			const n = route === "review" ? reviewCount : poolSize({ ...settings, route });
			setupNote.textContent = route === "review" ? `You'll get fresh examples of ${n} skill${n === 1 ? "" : "s"} you missed.` : "";
			beginBtn.disabled = false;
		}
		const list = $("[data-pp-progress-list]");
		list.innerHTML = TOPICS.map((t) => {
			const p = topicProgress(state, t);
			const detail = p.firstTries ? `${p.correct} of ${p.firstTries} first tries right${p.level ? ` · last at ${LEVEL_LABELS[p.level]}` : ""}` : "Not started";
			return `<li><span class="pp-progress-topic">${TOPIC_LABELS[t]}</span><span class="pp-badge" data-state="${p.state}">${SKILL_STATE_LABELS[p.state]}</span><span class="pp-progress-detail">${detail}</span></li>`;
		}).join("");
	}

	function chooseRoute(r: Route, focus = false) {
		route = r;
		renderStart();
		if (focus) root.querySelector<HTMLButtonElement>(`[data-pp-route="${r}"]`)?.focus();
	}
	routeBtns.forEach((b, i) => {
		b.addEventListener("click", () => chooseRoute(b.dataset.ppRoute as Route));
		b.addEventListener("keydown", (e) => {
			const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
			if (!step) return;
			e.preventDefault();
			chooseRoute(routeBtns[(i + step + routeBtns.length) % routeBtns.length].dataset.ppRoute as Route, true);
		});
	});
	topicInputs.forEach((i) => i.addEventListener("change", () => ((settings = { ...settings, topic: i.value as Topic }), renderStart())));
	levelInputs.forEach((i) => i.addEventListener("change", () => ((settings = { ...settings, level: i.value as Level }), renderStart())));

	function startSession(s: Settings) {
		settings = s;
		route = s.route;
		state = { ...state, settings: s };
		save();
		startEl.hidden = true;
		sessionEl.hidden = false;
		$<HTMLSelectElement>("[data-pp-level-select]").value = s.level;
		showQuestion(true);
		reveal(sessionEl, true);
	}
	beginBtn.addEventListener("click", () => startSession({ ...settings, route }));
	$("[data-pp-continue-btn]").addEventListener("click", () => startSession(state.settings!));

	function backToStart() {
		stopPlay();
		sessionEl.hidden = true;
		startEl.hidden = false;
		current = null;
		renderStart();
		reveal(startEl);
		routeBtns.find((b) => b.dataset.ppRoute === route)?.focus({ preventScroll: true });
	}
	$("[data-pp-change]").addEventListener("click", backToStart);

	// ================================================================ Session
	const metaEl = $("[data-pp-meta]");
	const promptEl = $("[data-pp-prompt]");
	const codeEl = $("[data-pp-code]");
	const figureEl = $("[data-pp-figure]");
	const gridEl = $("[data-pp-grid]");
	const optionsEl = $("[data-pp-options]");
	const nextBtn = $<HTMLButtonElement>("[data-pp-next]");
	const feedbackEl = $("[data-pp-feedback]");
	const traceBtn = $<HTMLButtonElement>("[data-pp-trace-btn]");
	const traceEl = $("[data-pp-trace]");
	const cardEl = $("[data-pp-card]");
	const cpEl = $("[data-pp-checkpoint]");

	function renderStats() {
		const inSet = state.attempts.length - state.setStart;
		const setRight = state.attempts.slice(state.setStart).filter((a) => a.correct).length;
		$("[data-pp-scope]").textContent = scopeText(settings);
		$("[data-pp-stats]").textContent = `This set: ${inSet} of 10 · ${setRight} right first time · Streak ${state.streak}`;
	}

	function renderAdvice() {
		const box = $("[data-pp-advice]");
		const sug = settings.route === "review" ? null : levelSuggestion(state, settings);
		box.hidden = !sug;
		if (!sug) return;
		$("[data-pp-advice-text]").textContent = `${sug.reason} ${sug.kind === "up" ? `Ready to try ${LEVEL_LABELS[sug.to]}?` : `Want to try ${LEVEL_LABELS[sug.to]} for a while?`}`;
		const yes = $<HTMLButtonElement>("[data-pp-advice-yes]");
		yes.textContent = `Switch to ${LEVEL_LABELS[sug.to]}`;
		yes.onclick = () => changeLevel(sug.to);
	}
	$("[data-pp-advice-no]").addEventListener("click", () => {
		state = dismissAdvice(state);
		save();
		renderAdvice();
	});

	function changeLevel(level: Level) {
		settings = { ...settings, level };
		state = { ...state, settings };
		save();
		$<HTMLSelectElement>("[data-pp-level-select]").value = level;
		renderAdvice();
		// An unanswered question is simply replaced; nothing is recorded.
		showQuestion(true);
	}
	$<HTMLSelectElement>("[data-pp-level-select]").addEventListener("change", (e) => changeLevel((e.target as HTMLSelectElement).value as Level));

	const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

	function showQuestion(moveFocus = false) {
		stopPlay();
		if (settings.route === "review" && reviewFor(state, null).length === 0) {
			settings = { ...settings, route: "mixed" };
			state = { ...state, settings };
			save();
		}
		const pick = pickNext(state, settings);
		current = pick.question;
		currentReview = pick.review;
		answered = false;
		delete frame.dataset.fitHold;
		cpEl.hidden = true;
		cardEl.hidden = false;

		metaEl.innerHTML = `<span>${esc(TOPIC_LABELS[current.topic])}</span><span>${LEVEL_LABELS[current.level]}</span><span>${TYPE_LABELS[current.type]}</span>${currentReview ? '<span class="pp-tag">Review: new example</span>' : ""}`;
		promptEl.textContent = current.prompt;
		codeEl.hidden = !current.code;
		codeEl.textContent = current.code ?? "";
		if (current.grid) {
			figureEl.hidden = false;
			gridEl.innerHTML = robotSvg(current.grid);
		} else {
			figureEl.hidden = true;
			gridEl.innerHTML = "";
		}
		$("[data-pp-body]").classList.toggle("has-grid", !!current.grid);

		order = current.fixedOrder ? [0, 1, 2, 3] : shuffle([0, 1, 2, 3]);
		optionsEl.innerHTML = "";
		order.forEach((oi, pos) => {
			const o = current!.options[oi];
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = `pp-option${o.code ? " pp-option--code" : ""}`;
			btn.dataset.oi = String(oi);
			btn.innerHTML = `<span class="pp-key" aria-hidden="true">${pos + 1}</span><span class="pp-option-text">${esc(o.text)}</span><span class="pp-option-tag" aria-hidden="true"></span>`;
			btn.setAttribute("aria-label", `Answer ${pos + 1}: ${o.text}`);
			btn.addEventListener("click", () => answer(oi));
			optionsEl.append(btn);
		});

		nextBtn.disabled = true;
		feedbackEl.hidden = true;
		traceBtn.hidden = true;
		traceEl.hidden = true;
		traceBtn.setAttribute("aria-expanded", "false");
		traceBtn.textContent = "Show trace";
		renderStats();
		renderAdvice();
		if (moveFocus) {
			promptEl.focus({ preventScroll: true });
			reveal(cardEl);
		}
	}

	function shuffle(a: number[]) {
		for (let i = a.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[a[i], a[j]] = [a[j], a[i]];
		}
		return a;
	}

	function answer(oi: number) {
		// One attempt per question: later clicks or key presses are ignored.
		if (!current || answered) return;
		answered = true;
		const q = current;
		const chosen = q.options[oi];
		const correctIdx = q.options.findIndex((o) => o.correct);
		const ok = chosen.correct;
		state = recordAnswer(state, q, ok, currentReview);
		save();

		$$<HTMLButtonElement>(".pp-option").forEach((btn) => {
			const i = Number(btn.dataset.oi);
			btn.disabled = true;
			const tag = btn.querySelector(".pp-option-tag")!;
			if (i === correctIdx) {
				btn.classList.add("is-correct");
				tag.textContent = i === oi ? "✓ Your answer — correct" : "✓ Correct answer";
			} else if (i === oi) {
				btn.classList.add("is-wrong");
				tag.textContent = "✗ Your answer";
			}
			const label = i === correctIdx ? (i === oi ? "your answer, correct" : "correct answer") : i === oi ? "your answer, not correct" : "";
			if (label) btn.setAttribute("aria-label", `${btn.getAttribute("aria-label")} — ${label}`);
		});

		frame.dataset.fitHold = "1";
		const posOf = (i: number) => order.indexOf(i) + 1;
		const short = (o: { text: string; code?: boolean }) => (o.code || o.text.includes("\n") || o.text.length > 60 ? "" : `: ${o.text}`);
		const verdict = $("[data-pp-verdict]");
		verdict.className = `pp-verdict ${ok ? "demo-verdict--good" : "demo-verdict--bad"}`;
		verdict.textContent = ok ? "✓ Correct" : "✗ Not quite";
		$("[data-pp-picked]").textContent = ok
			? `You chose ${posOf(oi)}${short(chosen)}.`
			: `You chose ${posOf(oi)}${short(chosen)}. The correct answer is ${posOf(correctIdx)}${short(q.options[correctIdx])}.`;
		$("[data-pp-expl]").textContent = q.explanation;
		const why = $("[data-pp-why]");
		why.hidden = ok || !chosen.why;
		why.textContent = !ok && chosen.why ? `About your answer: ${chosen.why}` : "";
		if (!ok) why.insertAdjacentText("beforeend", currentReview || !q.skill ? "" : " This skill will come back soon with a different example.");
		if (!ok && !chosen.why) {
			why.hidden = false;
			why.textContent = "This skill will come back soon with a different example.";
		}
		traceBtn.hidden = !q.trace;
		feedbackEl.hidden = false;
		nextBtn.disabled = false;
		nextBtn.textContent = checkpointDue(state) ? "See your checkpoint →" : "Next question →";
		nextBtn.focus({ preventScroll: true });
		renderStats();
	}

	function next() {
		if (!answered) return;
		if (checkpointDue(state)) showCheckpoint();
		else showQuestion(true);
	}
	nextBtn.addEventListener("click", next);

	// ============================================================ Checkpoint
	function showCheckpoint() {
		stopPlay();
		const cp = checkpoint(state, settings);
		cardEl.hidden = true;
		cpEl.hidden = false;
		$("[data-pp-cp-score]").textContent = `You got ${cp.correct} of ${cp.total} right on the first try.`;
		$("[data-pp-cp-skills]").textContent = cp.trickySkills.length ? `Skills that caused difficulty: ${cp.trickySkills.join("; ")}.` : "No skills caused difficulty in this set.";
		$("[data-pp-cp-next]").textContent = `Next step: ${cp.recommendation.text}`;
		const reviewBtn = $<HTMLButtonElement>("[data-pp-cp-review]");
		reviewBtn.hidden = state.review.length === 0;
		const lvlBtn = $<HTMLButtonElement>("[data-pp-cp-level]");
		lvlBtn.hidden = !cp.recommendation.level;
		if (cp.recommendation.level) {
			lvlBtn.textContent = `Switch to ${LEVEL_LABELS[cp.recommendation.level]}`;
			lvlBtn.onclick = () => {
				state = closeCheckpoint(state);
				changeLevel(cp.recommendation.level!);
			};
		}
		cpEl.focus({ preventScroll: true });
		reveal(cpEl);
	}
	$("[data-pp-cp-continue]").addEventListener("click", () => {
		state = closeCheckpoint(state);
		save();
		showQuestion(true);
	});
	$("[data-pp-cp-review]").addEventListener("click", () => {
		state = closeCheckpoint(state);
		startSession({ ...settings, route: "review" });
	});
	$("[data-pp-cp-change]").addEventListener("click", () => {
		state = closeCheckpoint(state);
		save();
		backToStart();
	});

	// ================================================================= Trace
	let steps: TraceStep[] = [];
	let at = 0;
	let playTimer: number | undefined;
	let traceLines: string[] = [];

	function openTrace() {
		if (!current?.trace) return;
		const t = current.trace;
		const r = run(t.code, { grid: t.grid, inputs: t.inputs, trace: true, maxSteps: 300 });
		steps = r.steps;
		if (r.ended === "limit") steps.push({ line: steps.at(-1)?.line ?? 0, text: "…and so on. This loop would never stop, so the trace ends here.", vars: steps.at(-1)?.vars ?? {}, output: steps.at(-1)?.output ?? [] });
		if (r.ended === "blocked") steps.at(-1) && (steps.at(-1)!.text = "Blocked: the square ahead is blocked or off the grid. The robot stays put and the program ends.");
		traceLines = t.code.split("\n");
		$("[data-pp-trace-note]").textContent = t.note ?? "Step through the code to see each value change.";
		$("[data-pp-t-grid]").hidden = !t.grid;
		// A robot program with no variables or output doesn't need empty panels.
		$("[data-pp-t-vars-box]").hidden = !!t.grid && steps.every((st) => Object.keys(st.vars).length === 0);
		$("[data-pp-t-out-box]").hidden = !!t.grid && steps.every((st) => st.output.length === 0);
		at = 0;
		traceEl.hidden = false;
		traceBtn.setAttribute("aria-expanded", "true");
		traceBtn.textContent = "Hide trace";
		renderTrace();
	}
	function closeTrace() {
		stopPlay();
		traceEl.hidden = true;
		traceBtn.setAttribute("aria-expanded", "false");
		traceBtn.textContent = "Show trace";
	}
	traceBtn.addEventListener("click", () => (traceEl.hidden ? openTrace() : closeTrace()));

	function renderTrace() {
		const step = steps[at - 1]; // at = number of steps taken (0 = start)
		const prev = steps[at - 2];
		$("[data-pp-t-count]").textContent = `Step ${at} of ${steps.length}`;
		$("[data-pp-t-now]").textContent = step ? step.text : "Start: nothing has run yet. Press Step.";
		$("[data-pp-t-code]").innerHTML = traceLines.map((l, i) => `<span class="${step && step.line === i ? "is-active" : ""}">${esc(l) || " "}</span>`).join("\n");
		const vars = step ? Object.entries(step.vars) : [];
		$("[data-pp-t-vars]").innerHTML = vars.length
			? vars.map(([k, v]) => `<span class="pp-var${prev?.vars[k] !== v ? " is-changed" : ""}"><span>${esc(k)}</span> = ${esc(v)}</span>`).join(" ")
			: '<span class="pp-muted">none yet</span>';
		const outNow = step ? step.output.join(" ") : "";
		$("[data-pp-t-out]").innerHTML = outNow ? esc(outNow) : '<span class="pp-muted">nothing yet</span>';
		const t = current?.trace;
		if (t?.grid) {
			const trail = [t.grid.robot, ...steps.slice(0, at).map((s) => s.robot!).filter(Boolean)];
			const robot = step?.robot ?? t.grid.robot;
			$("[data-pp-t-grid]").innerHTML = robotSvg(t.grid, robot, { trail, crashed: !!step && /Blocked/.test(step.text) });
		}
		$<HTMLButtonElement>("[data-pp-t-back]").disabled = at === 0;
		$<HTMLButtonElement>("[data-pp-t-step]").disabled = at >= steps.length;
		$<HTMLButtonElement>("[data-pp-t-play]").disabled = at >= steps.length;
		$("[data-pp-t-code] .is-active")?.scrollIntoView({ block: "nearest", inline: "nearest" });
	}
	function stopPlay() {
		window.clearInterval(playTimer);
		playTimer = undefined;
		$("[data-pp-t-play]").textContent = "Play";
	}
	$("[data-pp-t-step]").addEventListener("click", () => {
		stopPlay();
		if (at < steps.length) at++;
		renderTrace();
	});
	$("[data-pp-t-back]").addEventListener("click", () => {
		stopPlay();
		if (at > 0) at--;
		renderTrace();
	});
	$("[data-pp-t-reset]").addEventListener("click", () => {
		stopPlay();
		at = 0;
		renderTrace();
	});
	$("[data-pp-t-play]").addEventListener("click", () => {
		if (playTimer) return stopPlay();
		if (at >= steps.length) at = 0;
		$("[data-pp-t-play]").textContent = "Pause";
		// Reduced motion: still steps (it's the content), just more slowly and without transitions.
		playTimer = window.setInterval(
			() => {
				if (at >= steps.length) return stopPlay();
				at++;
				renderTrace();
			},
			reduceMotion ? 1600 : 900,
		);
	});

	// ================================================================= Help
	const helpEl = $("[data-pp-help]");
	let helpReturn: HTMLElement | null = null;
	$$("[data-pp-help-open]").forEach((b) =>
		b.addEventListener("click", () => {
			helpReturn = b;
			helpEl.hidden = false;
			$$("[data-pp-help-open]").forEach((x) => x.setAttribute("aria-expanded", "true"));
			helpEl.focus({ preventScroll: false });
		}),
	);
	function closeHelp() {
		helpEl.hidden = true;
		$$("[data-pp-help-open]").forEach((x) => x.setAttribute("aria-expanded", "false"));
		helpReturn?.focus({ preventScroll: true });
	}
	$("[data-pp-help-close]").addEventListener("click", closeHelp);

	// ============================================================== Keyboard
	document.addEventListener("keydown", (e) => {
		const target = e.target as HTMLElement;
		if (e.metaKey || e.ctrlKey || e.altKey) return;
		if (e.key === "Escape" && !helpEl.hidden) return closeHelp();
		if (sessionEl.hidden || cardEl.hidden || target.closest("input, select, textarea")) return;
		if (!answered && /^[1-4]$/.test(e.key)) {
			$$<HTMLButtonElement>(".pp-option")[Number(e.key) - 1]?.click();
		} else if (answered && (e.key === "Enter" || e.key.toLowerCase() === "n") && !target.closest("button")) {
			e.preventDefault();
			next();
		} else if (answered && e.key.toLowerCase() === "n" && target.closest("button")) {
			e.preventDefault();
			next();
		} else if (answered && e.key.toLowerCase() === "t" && current?.trace) {
			traceEl.hidden ? openTrace() : closeTrace();
		}
	});

	// Test hook for the browser checks (tests/ui.test.mjs). The question bank
	// is in the page anyway, so this gives nothing away.
	if (new URLSearchParams(location.search).has("pp-test")) (window as unknown as { __ppCurrent: () => Question | null }).__ppCurrent = () => current;

	renderStart();
</script>

