---
import LearnArticle from "../../components/LearnArticle.astro";
import DemoFrame from "../../components/DemoFrame.astro";
import { PSEUDO_CATEGORIES, PSEUDO_LEVELS, PSEUDO_QUESTIONS } from "../../lib/pseudocodeQuestions";

const cheatSheet = [
	{ code: "a ← 5", means: "Store 5 in the variable a" },
	{ code: "DISPLAY(a)", means: "Show a's value (followed by a space)" },
	{ code: "a MOD b", means: "The remainder when a is divided by b" },
	{ code: "= ≠ < > ≤ ≥", means: "Compare two values (true or false)" },
	{ code: "AND  OR  NOT", means: "Combine or flip true/false values" },
	{ code: "REPEAT n TIMES", means: "Run the block exactly n times" },
	{ code: "REPEAT UNTIL (c)", means: "Check c first; keep running the block until c is true" },
	{ code: "list[1]", means: "The FIRST item — lists here start at 1, not 0" },
	{ code: "APPEND / INSERT / REMOVE", means: "Add to the end / add at an index / delete at an index" },
	{ code: "LENGTH(list)", means: "How many items are in the list" },
	{ code: "RETURN(x)", means: "Send x back from a procedure and stop it immediately" },
	{ code: "CAN_MOVE(\"forward\")", means: "true if the robot's next square is open" },
];

const LEVEL_INFO = {
	easy: { label: "Easy", hint: "One idea at a time" },
	medium: { label: "Medium", hint: "Two ideas combined" },
	challenging: { label: "Challenging", hint: "Longer code, several ideas" },
};
const levelCounts = Object.fromEntries(PSEUDO_LEVELS.map((l) => [l, PSEUDO_QUESTIONS.filter((q) => q.level === l).length]));
---

<LearnArticle
	href="/learn/pseudocode-practice"
	description="Endless pseudocode practice at three levels: code-reading questions on variables, MOD, loops, lists, procedures and robots. Streaks, not scores."
	lead="Read the code, predict what it does. There's no end and no score — just keep going and build a streak."
>
	<section class="block">
		<p class="block-title">How This Works</p>
		<ul class="block-list">
			<li>
				<em>Pick a level.</em> Easy questions test one idea at a time. Medium ones combine two. Challenging
				ones use longer code that mixes several ideas — the kind of tracing you'll meet in a real computer
				science course.
			</li>
			<li><em>Miss one?</em> Read the explanation. That question will come back again soon — and keep coming back until you get it.</li>
			<li><em>Get one right?</em> It shows up less often for a while, but it can still return later.</li>
			<li>There's no final score. Just a streak of right answers in a row. Hit 2, 4, 8, 16… for a milestone.</li>
		</ul>
		<p class="block-text">
			Your progress is saved in this browser only. Keyboard shortcuts: <span class="mono-highlight">1–4</span>{" "}
			to answer, <span class="mono-highlight">Enter</span> for the next question.
		</p>
	</section>

	<DemoFrame label="Pseudocode practice" title="Practice">
		<div class="pp-tool" data-pp-tool>
			<div class="pp-levels" role="radiogroup" aria-label="Difficulty">
				{
					PSEUDO_LEVELS.map((level) => (
						<button type="button" class="pp-level" role="radio" aria-checked="false" data-pp-level={level}>
							<span class="pp-level-name">{LEVEL_INFO[level].label}</span>
							<span class="pp-level-hint">
								{LEVEL_INFO[level].hint} · {levelCounts[level]} questions
							</span>
						</button>
					))
				}
			</div>

			<div class="pp-top">
				<div class="pp-streak" aria-live="polite">
					<span class="pp-streak-value" data-pp-streak>0</span>
					<span class="pp-streak-label">in a row</span>
				</div>
				<div class="pp-top-meta">
					<span>Best on <span data-pp-best-level>Easy</span>: <strong data-pp-best>0</strong></span>
					<span>Answered: <strong data-pp-answered>0</strong></span>
					<span data-pp-waiting-wrap hidden>Coming back: <strong data-pp-waiting>0</strong></span>
				</div>
			</div>

			<p class="pp-milestone" data-pp-milestone role="status" hidden></p>

			<details class="pp-topics">
				<summary>Topics: <span data-pp-topic-summary>all</span></summary>
				<div class="pp-topic-chips">
					{
						PSEUDO_CATEGORIES.map((cat) => (
							<button type="button" class="pp-chip" data-pp-topic={cat} aria-pressed="true">
								{cat} <span class="pp-chip-count" data-pp-topic-count={cat}></span>
							</button>
						))
					}
				</div>
			</details>

			<details class="pp-topics pp-help">
				<summary>Notation help</summary>
				<div class="table-wrap pp-help-table">
					<table class="data-table">
						<tbody>
							{
								cheatSheet.map((row) => (
									<tr>
										<td class="num">{row.code}</td>
										<td>{row.means}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="pp-help-note">
					Robot questions: the triangle is the robot, pointing the way it faces. Dark squares are blocked.
					ROTATE_LEFT() and ROTATE_RIGHT() turn it without moving it. If it tries to move into a blocked square
					or off the grid, it stays put and the program stops.
				</p>
			</details>

			<article class="pp-card">
				<p class="pp-card-cat" data-pp-cat></p>
				<p class="pp-card-prompt" data-pp-prompt tabindex="-1"></p>
				<div class="pp-card-body">
					<pre class="pp-code" data-pp-code hidden></pre>
					<div class="pp-grid" data-pp-grid hidden></div>
				</div>
				<div class="pp-options" data-pp-options role="group" aria-label="Answer choices"></div>
				<div class="pp-feedback" data-pp-feedback aria-live="polite" hidden>
					<p class="pp-verdict" data-pp-verdict></p>
					<p class="pp-explanation" data-pp-explanation></p>
				</div>
				<div class="demo-controls">
					<button type="button" class="demo-btn demo-btn--primary" data-pp-next hidden>Next question →</button>
				</div>
			</article>

			<p class="pp-reset-row">
				<button type="button" class="pp-reset" data-pp-reset>Reset my progress</button>
			</p>
		</div>
	</DemoFrame>

</LearnArticle>

<script>
	import { PSEUDO_CATEGORIES, PSEUDO_QUESTIONS, type PseudoQuestion, type PseudoCategory, type PseudoLevel } from "../../lib/pseudocodeQuestions";
	import {
		freshState,
		pickNext,
		markShown,
		recordAnswer,
		waitingCount,
		loadPracticeState,
		setLevel,
		type PracticeState,
	} from "../../lib/pseudocodePractice";

	const STORAGE_KEY = "logicdash:pseudocode-practice:v1";
	const root = document.querySelector<HTMLElement>("[data-pp-tool]")!;
	const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
	const streakEl = $("[data-pp-streak]");
	const bestEl = $("[data-pp-best]");
	const bestLevelEl = $("[data-pp-best-level]");
	const levelButtons = root.querySelectorAll<HTMLButtonElement>("[data-pp-level]");
	const LEVEL_NAMES: Record<PseudoLevel, string> = { easy: "Easy", medium: "Medium", challenging: "Challenging" };
	const answeredEl = $("[data-pp-answered]");
	const waitingWrap = $("[data-pp-waiting-wrap]");
	const waitingEl = $("[data-pp-waiting]");
	const milestoneEl = $("[data-pp-milestone]");
	const topicSummary = $("[data-pp-topic-summary]");
	const topicChips = root.querySelectorAll<HTMLButtonElement>("[data-pp-topic]");
	const catEl = $("[data-pp-cat]");
	const promptEl = $("[data-pp-prompt]");
	const codeEl = $<HTMLPreElement>("[data-pp-code]");
	const gridEl = $("[data-pp-grid]");
	const optionsEl = $("[data-pp-options]");
	const feedbackEl = $("[data-pp-feedback]");
	const verdictEl = $("[data-pp-verdict]");
	const explanationEl = $("[data-pp-explanation]");
	const nextBtn = $<HTMLButtonElement>("[data-pp-next]");
	const resetBtn = $<HTMLButtonElement>("[data-pp-reset]");

	// --- Persistence (best-effort: private windows or blocked storage just
	// mean progress lasts for this visit only). ---------------------------
	function load(): PracticeState {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) {
				const parsed = loadPracticeState(JSON.parse(raw));
				if (parsed) {
					parsed.categories = parsed.categories.filter((c) => PSEUDO_CATEGORIES.includes(c));
					if (parsed.categories.length === 0) parsed.categories = [...PSEUDO_CATEGORIES];
					return parsed;
				}
			}
		} catch {
			/* ignore */
		}
		return freshState(PSEUDO_CATEGORIES);
	}

	function save() {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
		} catch {
			/* ignore */
		}
	}

	let state = load();
	let current: PseudoQuestion | null = null;
	let answered = false;
	let optionOrder: number[] = [];
	let milestoneTimer: number | undefined;

	function shuffled(n: number): number[] {
		const order = Array.from({ length: n }, (_, i) => i);
		for (let i = n - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[order[i], order[j]] = [order[j], order[i]];
		}
		return order;
	}

	function renderStats() {
		streakEl.textContent = String(state.streak);
		bestEl.textContent = String(state.bestByLevel[state.level] ?? 0);
		bestLevelEl.textContent = LEVEL_NAMES[state.level];
		answeredEl.textContent = String(state.answered);
		const waiting = waitingCount(state, PSEUDO_QUESTIONS);
		waitingWrap.hidden = waiting === 0;
		waitingEl.textContent = String(waiting);
	}

	function renderLevels() {
		levelButtons.forEach((btn) => {
			const on = btn.dataset.ppLevel === state.level;
			btn.setAttribute("aria-checked", String(on));
			btn.tabIndex = on ? 0 : -1;
		});
	}

	function renderTopics() {
		root.querySelectorAll<HTMLElement>("[data-pp-topic-count]").forEach((el) => {
			const cat = el.dataset.ppTopicCount as PseudoCategory;
			const n = PSEUDO_QUESTIONS.filter((q) => q.level === state.level && q.topics.includes(cat)).length;
			el.textContent = `(${n})`;
		});
		topicChips.forEach((chip) => {
			chip.setAttribute("aria-pressed", String(state.categories.includes(chip.dataset.ppTopic as PseudoCategory)));
		});
		topicSummary.textContent =
			state.categories.length === PSEUDO_CATEGORIES.length ? "all" : `${state.categories.length} of ${PSEUDO_CATEGORIES.length}`;
	}

	function renderGrid(q: PseudoQuestion) {
		gridEl.innerHTML = "";
		if (!q.grid) {
			gridEl.hidden = true;
			return;
		}
		const { rows, robot } = q.grid;
		gridEl.hidden = false;
		gridEl.style.setProperty("--cols", String(rows[0].length));
		const facingWord = { up: "up", down: "down", left: "left", right: "right" }[robot.facing];
		gridEl.setAttribute("role", "img");
		const labels: string[] = [];
		rows.forEach((row, r) => {
			Array.from(row).forEach((ch, c) => {
				const cell = document.createElement("span");
				cell.className = "pp-cell";
				if (ch === "#") cell.classList.add("pp-cell--blocked");
				if (/[A-D]/.test(ch)) {
					cell.textContent = ch;
					cell.classList.add("pp-cell--label");
					labels.push(`${ch} at row ${r + 1}, column ${c + 1}`);
				}
				if (r === robot.row && c === robot.col) {
					const bot = document.createElement("span");
					bot.className = `pp-robot pp-robot--${robot.facing}`;
					bot.textContent = "▲";
					cell.append(bot);
				}
				gridEl.append(cell);
			});
		});
		const blocked = rows.flatMap((row, r) => Array.from(row).flatMap((ch, c) => (ch === "#" ? [`row ${r + 1}, column ${c + 1}`] : [])));
		gridEl.setAttribute(
			"aria-label",
			`A ${rows.length} by ${rows[0].length} grid. The robot is at row ${robot.row + 1}, column ${robot.col + 1}, facing ${facingWord}.` +
				(labels.length ? ` Squares: ${labels.join("; ")}.` : "") +
				(blocked.length ? ` Blocked: ${blocked.join("; ")}.` : ""),
		);
	}

	/** `moveFocus` is for user-triggered changes, so keyboard and screen-reader users land on the new question. */
	function showQuestion(moveFocus = false) {
		current = pickNext(state, PSEUDO_QUESTIONS);
		state = markShown(state, current.id);
		answered = false;
		optionOrder = shuffled(current.options.length);

		catEl.textContent = `${LEVEL_NAMES[current.level]} · ${current.topics.join(" + ")}`;
		promptEl.textContent = current.prompt;
		codeEl.hidden = !current.code;
		codeEl.textContent = current.code ?? "";
		renderGrid(current);

		optionsEl.innerHTML = "";
		optionOrder.forEach((optIndex, pos) => {
			const btn = document.createElement("button");
			btn.type = "button";
			btn.className = "pp-option";
			btn.dataset.optIndex = String(optIndex);
			const key = document.createElement("span");
			key.className = "pp-option-key";
			key.textContent = String(pos + 1);
			key.setAttribute("aria-hidden", "true");
			const text = document.createElement("span");
			text.className = "pp-option-text";
			text.textContent = current!.options[optIndex];
			btn.append(key, text);
			btn.addEventListener("click", () => answer(optIndex));
			optionsEl.append(btn);
		});

		feedbackEl.hidden = true;
		nextBtn.hidden = true;
		renderStats();
		save();
		if (moveFocus) promptEl.focus({ preventScroll: true });
	}

	function answer(optIndex: number) {
		if (!current || answered) return;
		answered = true;
		const correct = optIndex === current.answer;
		const result = recordAnswer(state, current.id, correct);
		state = result.state;

		optionsEl.querySelectorAll<HTMLButtonElement>(".pp-option").forEach((btn) => {
			const i = Number(btn.dataset.optIndex);
			btn.disabled = true;
			const key = btn.querySelector(".pp-option-key")!;
			if (i === current!.answer) {
				btn.classList.add("pp-option--correct");
				key.textContent = "✓"; // the mark replaces the number, so color isn't the only cue
			} else if (i === optIndex) {
				btn.classList.add("pp-option--incorrect");
				key.textContent = "✗";
			}
		});

		const correctPos = optionOrder.indexOf(current.answer) + 1;
		verdictEl.className = `pp-verdict ${correct ? "demo-verdict--good" : "demo-verdict--bad"}`;
		verdictEl.textContent = correct
			? "✓ Correct!"
			: `✗ Not quite — the answer is ${correctPos}: ${current.options[current.answer]}. This one will come back soon.`;
		explanationEl.textContent = current.explanation;
		feedbackEl.hidden = false;
		nextBtn.hidden = false;
		nextBtn.focus({ preventScroll: true });

		if (result.milestone) showMilestone(result.milestone);
		renderStats();
		save();
	}

	function showMilestone(n: number) {
		const power = Math.log2(n);
		milestoneEl.textContent = `Streak of ${n}! That's 2${toSuperscript(power)} in a row.`;
		milestoneEl.hidden = false;
		milestoneEl.classList.remove("is-pop");
		void milestoneEl.offsetWidth; // restart the animation
		milestoneEl.classList.add("is-pop");
		window.clearTimeout(milestoneTimer);
		milestoneTimer = window.setTimeout(() => (milestoneEl.hidden = true), 4000);
	}

	function toSuperscript(n: number): string {
		const map = "⁰¹²³⁴⁵⁶⁷⁸⁹";
		return String(n)
			.split("")
			.map((d) => map[Number(d)])
			.join("");
	}

	nextBtn.addEventListener("click", () => showQuestion(true));

	topicChips.forEach((chip) => {
		chip.addEventListener("click", () => {
			const cat = chip.dataset.ppTopic as PseudoCategory;
			const on = state.categories.includes(cat);
			if (on && state.categories.length === 1) return; // always keep at least one topic
			state = { ...state, categories: on ? state.categories.filter((c) => c !== cat) : [...state.categories, cat] };
			renderTopics();
			save();
			// Move on if the current question's topic was just switched off.
			if (current && !current.topics.some((t) => state.categories.includes(t))) showQuestion(true);
			else renderStats();
		});
	});

	resetBtn.addEventListener("click", () => {
		if (!window.confirm("Reset your streak, best streak, and question history?")) return;
		state = freshState(PSEUDO_CATEGORIES, state.level);
		renderLevels();
		renderTopics();
		showQuestion(true);
	});

	// 1–4 answer, Enter / N moves on — ignored while typing in a form field
	// or while the topic chips have focus.
	document.addEventListener("keydown", (event) => {
		const target = event.target as HTMLElement;
		if (target.closest("input, select, textarea, summary, .pp-topics, .pp-levels") || event.metaKey || event.ctrlKey || event.altKey) return;
		if (!answered && /^[1-4]$/.test(event.key)) {
			const btn = optionsEl.querySelectorAll<HTMLButtonElement>(".pp-option")[Number(event.key) - 1];
			btn?.click();
		} else if (answered && (event.key === "Enter" || event.key.toLowerCase() === "n") && target !== nextBtn) {
			event.preventDefault();
			showQuestion(true);
		}
	});

	// Level picker: a radio group, so arrow keys move between levels too.
	function chooseLevel(level: PseudoLevel, focus = false) {
		if (level !== state.level) {
			state = setLevel(state, level);
			renderLevels();
			renderTopics();
			showQuestion(!focus);
		}
		if (focus) root.querySelector<HTMLButtonElement>(`[data-pp-level="${level}"]`)?.focus();
	}

	levelButtons.forEach((btn, i) => {
		btn.addEventListener("click", () => chooseLevel(btn.dataset.ppLevel as PseudoLevel));
		btn.addEventListener("keydown", (event) => {
			const step = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 0;
			if (!step) return;
			event.preventDefault();
			const next = levelButtons[(i + step + levelButtons.length) % levelButtons.length];
			chooseLevel(next.dataset.ppLevel as PseudoLevel, true);
		});
	});

	renderLevels();
	renderTopics();
	showQuestion();
</script>

<style is:global>
	.pp-tool .pp-levels {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5em;
		margin-bottom: 1em;
	}

	.pp-tool .pp-level {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25em;
		min-height: 3.2em;
		padding: 0.5em 0.5em;
		border-radius: 10px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: 0.95em;
		cursor: pointer;
		text-align: center;
	}

	.pp-tool .pp-level:hover,
	.pp-tool .pp-level:focus-visible {
		border-color: var(--color-accent);
	}

	.pp-tool .pp-level[aria-checked="true"] {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 16%, var(--color-bg));
		box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 30%, transparent);
	}

	.pp-tool .pp-level-name {
		font-weight: 700;
		font-size: 1em;
	}

	.pp-tool .pp-level[aria-checked="true"] .pp-level-name::before {
		content: "✓ ";
		color: var(--color-accent);
	}

	.pp-tool .pp-level-hint {
		font-size: 0.78em;
		line-height: 1.3;
		color: var(--color-text-muted);
	}

	@media (max-width: 480px) {
		.pp-tool .pp-level-hint {
			display: none;
		}
	}

	.pp-tool .pp-help-table {
		margin-top: 0.5em;
		font-size: 0.95em;
	}

	.pp-tool .pp-help-note {
		margin: 0.5em 0 0;
		font-size: 0.95em;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.pp-tool .pp-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5em 1em;
	}

	.pp-tool .pp-streak {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
	}

	.pp-tool .pp-streak-value {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 2.2em;
		line-height: 1;
		color: #fff3d6;
		text-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 55%, transparent);
	}

	.pp-tool .pp-streak-label {
		font-size: 0.85em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.pp-tool .pp-top-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em 1em;
		font-size: 0.88em;
		color: var(--color-text-muted);
	}

	.pp-tool .pp-top-meta strong {
		font-family: var(--font-mono);
		color: var(--color-text);
	}

	.pp-tool .pp-milestone {
		margin: 0.75em 0 0;
		padding: 0.5em 1em;
		border-radius: 10px;
		border: 1px solid var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 14%, var(--color-bg));
		text-align: center;
		font-family: var(--font-mono);
		font-weight: 700;
		color: #fff3d6;
	}

	.pp-tool .pp-milestone.is-pop {
		animation: pp-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@keyframes pp-pop {
		from {
			transform: scale(0.85);
			opacity: 0;
		}
		to {
			transform: none;
			opacity: 1;
		}
	}

	.pp-tool .pp-topics {
		margin-top: 0.75em;
		font-size: 0.9em;
		color: var(--color-text-muted);
	}

	.pp-tool .pp-topics summary {
		cursor: pointer;
		min-height: 2.2em;
		display: flex;
		align-items: center;
		gap: 0.25em;
		font-weight: 600;
	}

	.pp-tool .pp-topics summary::before {
		content: "▸";
		color: var(--color-accent);
	}

	.pp-tool .pp-topics[open] summary::before {
		content: "▾";
	}

	.pp-tool .pp-topics summary::-webkit-details-marker {
		display: none;
	}

	.pp-tool .pp-topics summary {
		list-style: none;
	}

	.pp-tool .pp-topic-chips {
