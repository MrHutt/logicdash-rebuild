---
import LearnArticle from "../../components/LearnArticle.astro";
import ConceptQuiz, { type QuizQuestion } from "../../components/ConceptQuiz.astro";
import BitChip from "../../components/BitChip.astro";

const byteExample = "10110010".split("");

const units = [
	{ name: "Kilobyte (KB)", approx: "≈ 1,000 bytes", example: "a page of plain text" },
	{ name: "Megabyte (MB)", approx: "≈ 1,000 kilobytes", example: "a few photos, or a short song" },
	{ name: "Gigabyte (GB)", approx: "≈ 1,000 megabytes", example: "a couple of movies, or thousands of photos" },
	{ name: "Terabyte (TB)", approx: "≈ 1,000 gigabytes", example: "a large external hard drive" },
];

const QUIZ: QuizQuestion[] = [
	{
		q: "How many bits are in one byte?",
		options: ["8", "4", "10", "16"],
		explain: "A byte is a group of 8 bits, like 10110010.",
	},
	{
		q: "How many different values can one byte represent?",
		options: ["256", "255", "8", "128"],
		explain: "2 multiplied by itself 8 times is 256 — from 00000000 up to 11111111.",
	},
	{
		q: "How many different values can 3 bits represent?",
		options: ["8", "3", "6", "9"],
		explain: "Each bit doubles the options: 2, then 4, then 8.",
	},
	{
		q: "LogicDash's Classic mode uses 5 bits (32 possible secrets). How many possible patterns would 7 bits give?",
		options: ["128", "70", "64", "14"],
		explain: "Two more bits means doubling twice: 32 → 64 → 128.",
	},
	{
		q: "Which of these holds the most data?",
		options: ["1 terabyte", "1 gigabyte", "1 megabyte", "1 kilobyte"],
		explain: "Each step is about 1,000 times bigger: kilobyte, megabyte, gigabyte, terabyte.",
	},
];
---

<LearnArticle
	href="/learn/bits-and-bytes/"
	description="What a byte actually is, how 8 bits combine into 256 values, and how kilobytes, megabytes, and gigabytes measure data."
>
	<Fragment slot="lead">You've met bits. Now let's talk about what happens when you group them together.</Fragment>

	<section class="block">
		<p class="block-title">A Bit Is One 0 or 1</p>
		<p class="block-text">
			That's the smallest unit — a single switch, on or off. On its own, a bit can't say much. Two
			possible values isn't a lot to work with.
		</p>
	</section>

	<section class="block block--example">
		<p class="block-title">A Byte Is 8 Bits</p>
		<p class="block-text">
			Group 8 bits together and you get a byte — like <span class="mono-highlight">10110010</span>.
			With 8 bits, you can represent 256 different values (2 multiplied by itself 8 times). That's
			enough to represent a letter, a small number, or one pixel's worth of a simple color.
		</p>

		<div class="byte-demo">
			<div class="byte-demo-group">
				<div class="byte-demo-tiles">
					<BitChip value="1" />
				</div>
				<span class="byte-demo-label">1 bit</span>
			</div>
			<div class="byte-demo-group">
				<div class="byte-demo-tiles">
					{byteExample.map((bit) => <BitChip value={bit as "0" | "1"} />)}
				</div>
				<span class="byte-demo-label">1 byte</span>
			</div>
		</div>
	</section>

	<section class="block">
		<p class="block-title">Why "256"?</p>
		<p class="block-text">
			Each bit doubles your options. 1 bit = 2 values (0 or 1). 2 bits = 4 values. 3 bits = 8
			values. By 8 bits, you've got 256 possible combinations — from{" "}
			<span class="mono-highlight">00000000</span> all the way to{" "}
			<span class="mono-highlight">11111111</span>.
		</p>
		<p class="block-text">
			This is also why LogicDash's Classic mode (5 bits) has exactly 32 possible secrets, and
			OverClocked (6 bits) has 64. Every extra bit doubles the possibilities — and doubles the
			challenge.
		</p>
	</section>

	<section class="block">
		<p class="block-title">Beyond the Byte</p>
		<p class="block-text">
			Once you're storing real things — photos, songs, entire apps — you need a lot more than one
			byte. That's where these familiar terms come from:
		</p>

		<ul class="unit-list">
			{
				units.map((unit) => (
					<li>
						<span class="unit-name">{unit.name}</span> {unit.approx} — {unit.example}
					</li>
				))
			}
		</ul>

		<p class="block-text">
			Every one of these, all the way up, is still just bits — 0s and 1s — grouped into bigger and
			bigger chunks.
		</p>
	</section>


	<ConceptQuiz questions={QUIZ} />
</LearnArticle>

<style>

	.byte-demo {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 1rem 0 0.25rem;
		padding: 1rem;
		border-radius: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.byte-demo-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.byte-demo-tiles {
		display: flex;
		gap: 0.25rem;
	}

	.byte-demo-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.unit-list {
		display: inline-block;
		text-align: left;
		margin: 0 0 1rem;
		padding: 0.75rem 1rem 0.75rem 1.5rem;
		border-radius: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.unit-list li {
		margin: 0.25rem 0;
	}

	.unit-name {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-text);
	}

</style>
