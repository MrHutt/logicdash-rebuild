---
import Layout from "../../layouts/Layout.astro";
import TopicIcon from "../../components/TopicIcon.astro";
import { LEARN_TOPICS, GROUP_ORDER } from "../../lib/learnTopics";

// GROUP_ORDER is shared with learnTopics.ts's HUB_ORDERED_TOPICS, which
// drives every article's prev/next — so this grid and that pagination always
// agree on what "next" means.
const groups = GROUP_ORDER.map((name) => ({
	name,
	topics: LEARN_TOPICS.filter((topic) => topic.group === name),
})).filter((group) => group.topics.length > 0);
---

<Layout
	title="Bit by Bit"
	description="Bit by Bit: free lessons on binary, bytes, hexadecimal, and error correction — the ideas behind LogicDash's puzzle, explained simply."
>
	<section class="hero">
		<h1>Bit by Bit</h1>
		<p class="hero-lead">The ideas behind the puzzle, explained simply.</p>
	</section>

	{
		groups.map((group) => (
			<div class="topic-group">
				<h2 class="topic-group-title">{group.name}</h2>
				<div class="topic-cards">
					{group.topics.map((topic) =>
						topic.live ? (
							<a class="topic-card" href={topic.href}>
								<TopicIcon href={topic.href} />
								<span class="topic-card-name">{topic.title}</span>
								<span class="topic-card-blurb">{topic.blurb}</span>
							</a>
						) : (
							<div class="topic-card topic-card--soon">
								<TopicIcon href={topic.href} />
								<span class="topic-card-name">{topic.title}</span>
								<span class="topic-card-blurb">{topic.blurb}</span>
								<span class="topic-card-badge">Coming soon</span>
							</div>
						),
					)}
				</div>
			</div>
		))
	}
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1.25rem;
	}

	.hero h1 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.6rem, 5vw, 2.1rem);
	}

	.hero-lead {
		margin: 0 auto;
		font-size: 1rem;
	}

	.topic-group {
		margin-bottom: 1.4rem;
	}

	.topic-group:last-child {
		margin-bottom: 0;
	}

	.topic-group-title {
		margin: 0 0 0.6rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.topic-cards {
		display: grid;
		/* auto-fit (not auto-fill) collapses any unfilled tracks and hands
		   their space to the real cards — every group here has just 2 or 3
		   topics, so without this the row stays pinned to a narrow strip on
		   the left with a lot of dead space to the right on wide screens. The
		   minmax cap still keeps cards from ballooning past a sane size when
		   a row genuinely has room to spare. */
		grid-template-columns: repeat(auto-fit, minmax(11.5rem, 16rem));
		gap: 0.6rem;
	}

	/* Below this width, auto-fit can only fit a single track — but that
	   track is still capped at the minmax max (16rem), so CSS Grid's default
	   justify-content: start left-anchors that one narrower card, leaving
	   dead space beside it instead of using the full row. Forcing a single
	   1fr column here makes that lone card stretch to the container's full
	   width instead. */
	@media (max-width: 460px) {
		.topic-cards {
			grid-template-columns: 1fr;
		}
	}

	/* At wide viewports, also widen the page itself (this page only — a
	   card grid can use more width than the site's usual prose column
	   without hurting readability) and let cards grow a bit further, so the
	   grid actually fills more of the screen instead of just floating in a
	   960px column with empty space beside it. */
	@media (min-width: 1200px) {
		:global(main) {
			max-width: 1200px;
		}

		/* Uncapped (1fr) here on purpose — at this width there's enough
		   screen real estate that letting a 2-card row actually stretch to
		   fill it reads as "a wide gallery," not "a few oversized tiles." */
		.topic-cards {
			grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
		}
	}

	.topic-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0.75rem 0.7rem;
		border-radius: 10px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		text-align: center;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	a.topic-card:hover {
		border-color: #ffae2e;
		box-shadow: 0 0 14px color-mix(in srgb, #ffae2e 35%, transparent);
		transform: translateY(-1px);
	}

	a.topic-card:active {
		transform: scale(0.97);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.topic-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		line-height: 1.25;
		color: var(--color-text);
	}

	.topic-card-blurb {
		font-size: 0.7rem;
		line-height: 1.35;
		color: var(--color-text-muted);
	}

	.topic-card--soon {
		opacity: 0.6;
	}

	.topic-card-badge {
		margin-top: 0.1rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		font-size: 0.6rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}
</style>
