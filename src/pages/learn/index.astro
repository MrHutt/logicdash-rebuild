---
import { readFileSync } from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import TopicIcon from "../../components/TopicIcon.astro";
import {
	LEARN_TOPICS,
	GROUP_ORDER,
	GROUP_BLURBS,
	LEVEL_ORDER,
	LEVEL_LABELS,
	LEVEL_HINTS,
	FOCUS_ORDER,
	FOCUS_LABELS,
} from "../../lib/learnTopics";

// GROUP_ORDER is shared with learnTopics.ts's HUB_ORDERED_TOPICS, which
// drives every article's prev/next — so this grid and that pagination always
// agree on what "next" means.
const slug = (name: string) =>
	name
		.toLowerCase()
		.replace(/&/g, "and")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");

// Which lessons end with a quick quiz — read from the page source, so the
// badge can never drift out of date.
const hasQuiz = (href: string) => {
	try {
		const file = path.join(process.cwd(), "src/pages", `${href}.astro`);
		return readFileSync(file, "utf8").includes("<ConceptQuiz");
	} catch {
		return false;
	}
};

const groups = GROUP_ORDER.map((name) => ({
	name,
	id: slug(name),
	blurb: GROUP_BLURBS[name],
	topics: LEARN_TOPICS.filter((topic) => topic.group === name),
})).filter((group) => group.topics.length > 0);
const liveCount = LEARN_TOPICS.filter((topic) => topic.live).length;
const codeMap = Object.fromEntries(LEARN_TOPICS.filter((topic) => topic.live).map((topic) => [topic.code, topic.href]));
---

<Layout
	title="Byte Lab"
	wide
	description="Byte Lab: free, plain-English computer science lessons on binary, networks, cybersecurity, and programming, with hands-on demos and quick quizzes."
>
	<section class="hero">
		<h1>Byte Lab</h1>
		<p class="hero-lead">
			Short, hands-on computer science lessons. Read a little, try a demo, check yourself with a quiz.
		</p>
		<p class="hero-count">{liveCount} lessons and practice tools · free · no sign-up</p>
		<form class="code-go" data-code-form data-codes={JSON.stringify(codeMap)} hidden>
			<label for="lesson-code">Got a lesson code?</label>
			<input
				id="lesson-code"
				name="code"
				maxlength="40"
				placeholder="5A2"
				autocomplete="off"
				autocapitalize="characters"
				spellcheck="false"
				aria-describedby="lesson-code-msg"
			/>
			<button type="submit">Go</button>
			<p class="code-go-msg" id="lesson-code-msg" aria-live="polite" data-code-msg></p>
		</form>
	</section>

	<section class="how-to" aria-labelledby="how-to-title">
		<h2 class="sr-only" id="how-to-title">How to use Byte Lab</h2>
		<div class="how-card">
			<h3>For students</h3>
			<ol>
				<li>Got a code from your teacher? Type it in the box above. Otherwise pick a lesson — start with <strong>Starter</strong> if the topic is new to you.</li>
				<li>Read each section, then do the <strong>Try it yourself</strong> activity.</li>
				<li>Finish with the quiz or practice. Wrong answers explain why, so read them.</li>
			</ol>
		</div>
		<div class="how-card">
			<h3>For teachers</h3>
			<ol>
				<li>Filter by <strong>level</strong> and <strong>focus</strong> to find lessons for your class. Every lesson has a short link, like <strong>logicdash.io/5A2</strong> — it is under the lesson title and in the corner of each card.</li>
				<li>Press <strong>Fullscreen</strong> on any demo or quiz to project it. It fits the whole screen and shows the short link, so students can open it on their own device.</li>
				<li>Each lesson takes about 5–15 minutes: use one as a starter, a demo, or an exit ticket.</li>
			</ol>
		</div>
	</section>

	<div class="filters" data-filters hidden>
		<div class="filter-row" role="group" aria-labelledby="filter-level-label">
			<span class="filter-label" id="filter-level-label">Level</span>
			<button type="button" class="chip" data-level="all" aria-pressed="true">All</button>
			{
				LEVEL_ORDER.map((level) => (
					<button type="button" class="chip" data-level={level} aria-pressed="false" title={LEVEL_HINTS[level]}>
						{LEVEL_LABELS[level]}
					</button>
				))
			}
		</div>
		<div class="filter-row" role="group" aria-labelledby="filter-focus-label">
			<span class="filter-label" id="filter-focus-label">Focus</span>
			<button type="button" class="chip" data-focus="all" aria-pressed="true">All</button>
			{
				FOCUS_ORDER.map((focus) => (
					<button type="button" class="chip" data-focus={focus} aria-pressed="false">
						{FOCUS_LABELS[focus]}
					</button>
				))
			}
		</div>
		<p class="level-key">
			{
				LEVEL_ORDER.map((level) => (
					<span>
						<strong>{LEVEL_LABELS[level]}</strong> — {LEVEL_HINTS[level]}
					</span>
				))
			}
		</p>
		<p class="filter-status" aria-live="polite" data-filter-status></p>
	</div>

	<nav class="group-jump" aria-label="Jump to a section">
		<ul>
			{
				groups.map((group) => (
					<li data-jump={group.id}>
						<a href={`#${group.id}`}>{group.name}</a>
					</li>
				))
			}
		</ul>
	</nav>

	{
		groups.map((group) => (
			<section class="topic-group" id={group.id} aria-labelledby={`${group.id}-title`} data-group>
				<h2 class="topic-group-title" id={`${group.id}-title`}>{group.name}</h2>
				<p class="topic-group-blurb">{group.blurb}</p>
				<div class="topic-cards">
					{group.topics.map((topic) => {
						const Tag = topic.live ? "a" : "div";
						return (
							<Tag
								class:list={["topic-card", { "topic-card--soon": !topic.live }]}
								href={topic.live ? topic.href : undefined}
								data-card
								data-levels={topic.levels.join(" ")}
								data-focus={topic.focus.join(" ")}
							>
								<span class="card-code">
									<span class="sr-only">Short link code </span>
									{topic.code}
								</span>
								<TopicIcon href={topic.href} />
								<span class="topic-card-name">{topic.title}</span>
								<span class="topic-card-blurb">{topic.blurb}</span>
								<span class="topic-card-meta">
									{topic.levels.map((level) => (
										<span class="tag tag--level">{LEVEL_LABELS[level]}</span>
									))}
									<span class="tag">{topic.minutes} min</span>
									{topic.kind === "tool" && <span class="tag tag--strong">Practice</span>}
									{topic.kind !== "tool" && hasQuiz(topic.href) && <span class="tag">Quiz</span>}
									{!topic.live && <span class="tag">Coming soon</span>}
								</span>
							</Tag>
						);
					})}
				</div>
			</section>
		))
	}

	<div class="empty" data-empty hidden>
		<p>No lessons match both filters yet.</p>
		<button type="button" class="chip" data-reset>Show all lessons</button>
	</div>
</Layout>

<script>
	// "Got a lesson code?" — the same codes as the logicdash.io/5A2 short links.
	const codeForm = document.querySelector<HTMLFormElement>("[data-code-form]");
	if (codeForm) {
		codeForm.hidden = false;
		const codes = JSON.parse(codeForm.dataset.codes!) as Record<string, string>;
		const input = codeForm.querySelector("input")!;
		const msg = codeForm.querySelector<HTMLElement>("[data-code-msg]")!;
		codeForm.addEventListener("submit", (event) => {
			event.preventDefault();
			const code = input.value.trim().toUpperCase().replace(/^.*\//, "");
			const href = codes[code];
			if (href) location.href = href;
			else msg.textContent = code ? `No lesson has the code ${code}. Check it and try again.` : "Type the 3-character code.";
		});
	}

	// Filters are a progressive enhancement: without JavaScript every lesson
	// shows. The current filter is kept in the address (?level=…&focus=…), so a
	// teacher can share a link that opens on, say, every Starter cybersecurity
	// lesson.
	const root = document.querySelector<HTMLElement>("[data-filters]");
	if (root) {
		root.hidden = false;
		const cards = [...document.querySelectorAll<HTMLElement>("[data-card]")];
		const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
		const status = root.querySelector<HTMLElement>("[data-filter-status]")!;
		const empty = document.querySelector<HTMLElement>("[data-empty]")!;
		const levelBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-level]")];
		const focusBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-focus]")];

		const params = new URLSearchParams(location.search);
		let level = params.get("level") ?? "all";
		let focus = params.get("focus") ?? "all";
		if (!levelBtns.some((b) => b.dataset.level === level)) level = "all";
		if (!focusBtns.some((b) => b.dataset.focus === focus)) focus = "all";

		const apply = () => {
			levelBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.level === level)));
			focusBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.focus === focus)));
			let shown = 0;
			for (const card of cards) {
				const ok =
					(level === "all" || card.dataset.levels!.split(" ").includes(level)) &&
					(focus === "all" || card.dataset.focus!.split(" ").includes(focus));
				card.hidden = !ok;
				if (ok) shown++;
			}
			for (const group of groups) {
				const visible = group.querySelector("[data-card]:not([hidden])") !== null;
				group.hidden = !visible;
				const jump = document.querySelector<HTMLElement>(`[data-jump="${group.id}"]`);
				if (jump) jump.hidden = !visible;
			}
			empty.hidden = shown > 0;
			status.textContent =
				level === "all" && focus === "all" ? `Showing all ${cards.length}` : `Showing ${shown} of ${cards.length}`;

			const next = new URLSearchParams();
			if (level !== "all") next.set("level", level);
			if (focus !== "all") next.set("focus", focus);
			const qs = next.toString();
			history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
		};

		levelBtns.forEach((b) =>
			b.addEventListener("click", () => {
				level = b.dataset.level!;
				apply();
			}),
		);
		focusBtns.forEach((b) =>
			b.addEventListener("click", () => {
				focus = b.dataset.focus!;
				apply();
			}),
		);
		document.querySelector("[data-reset]")?.addEventListener("click", () => {
			level = "all";
			focus = "all";
			apply();
		});
		apply();
	}
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	[hidden] {
		display: none !important;
	}

	.hero {
		text-align: center;
		margin-bottom: var(--space-5);
	}

	.hero h1 {
		margin: 0 0 var(--space-2);
		font-size: clamp(1.75rem, 5vw, 2.5rem);
	}

	.hero-lead {
		margin: 0 auto;
		max-width: 38rem;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.hero-count {
		margin: var(--space-2) 0 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	/* Two short how-to cards: side by side from tablet width up. */
	.how-to {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-4);
		max-width: 60rem;
		margin: 0 auto var(--space-6);
	}

	.how-card {
		padding: var(--space-4) var(--space-5);
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.how-card h3 {
		margin: 0 0 var(--space-2);
		font-size: 1rem;
		color: var(--color-accent);
	}

	.how-card ol {
		margin: 0;
		padding-left: 1.25rem;
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.how-card li + li {
		margin-top: var(--space-1);
	}

	.how-card strong {
		color: var(--color-text);
	}

	/* Filter chips */
	.filters {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-5);
	}

	.filter-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-2);
	}

	.filter-label {
		min-width: 3.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
	}

	.chip {
		min-height: 2.5rem;
		padding: var(--space-1) var(--space-4);
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.chip:hover,
	.chip:focus-visible {
		border-color: var(--color-accent);
	}

	.chip[aria-pressed="true"] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-accent-contrast);
	}

	.level-key {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-1) var(--space-4);
		margin: var(--space-1) 0 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.level-key strong {
		color: var(--color-text);
	}

	.filter-status {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	/* Section shortcuts. Plain wrapping pills — they simply flow onto a
	   second (or third) line when space runs out, so there's no breakpoint
	   where they can collide or overflow. */
	.group-jump {
		margin: 0 0 var(--space-6);
	}

	.group-jump ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.group-jump a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: var(--space-1) var(--space-3);
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.15s ease;
	}

	.group-jump a:hover,
	.group-jump a:focus-visible {
		border-color: var(--color-accent);
	}

	.topic-group {
		scroll-margin-top: var(--space-4);
		margin-bottom: var(--space-6);
	}

	.topic-group-blurb {
		margin: 0 0 var(--space-3);
		font-size: 0.9375rem;
	}

	.topic-group-title {
		margin: 0 0 var(--space-2);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid var(--color-border);
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	/* One consistent grid for every section: columns keep the same width
	   and line up from section to section (4 across on wide screens, then
	   3, 2 and 1 as space runs out). auto-fill — not auto-fit — keeps a
	   short section's cards the same size as everyone else's. */
	.topic-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: var(--space-3);
	}

	.topic-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-4) var(--space-3) var(--space-3);
		border-radius: 10px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		text-align: center;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	a.topic-card:hover,
	a.topic-card:focus-visible {
		border-color: var(--color-accent);
		box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent) 35%, transparent);
		transform: translateY(-1px);
	}

	a.topic-card:active {
		transform: scale(0.97);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.topic-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.875rem;
		line-height: 1.25;
		color: var(--color-text);
	}

	.topic-card-blurb {
		flex: 1;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--color-text-muted);
	}

	.topic-card--soon {
		opacity: 0.6;
	}

	.topic-card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-1);
		margin-top: var(--space-2);
	}

	.tag {
		padding: 2px var(--space-2);
		border-radius: 999px;
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: var(--color-text-muted);
	}

	.tag--level {
		color: var(--color-accent);
		border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
	}

	.card-code {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		color: var(--color-text-muted);
	}

	.code-go {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-2);
		margin: var(--space-4) 0 0;
	}

	.code-go label {
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.code-go input {
		width: 5.5rem;
		min-height: 2.5rem;
		padding: 0 var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-align: center;
		text-transform: uppercase;
	}

	.code-go input:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}

	.code-go button {
		min-height: 2.5rem;
		padding: 0 var(--space-4);
		border: 1px solid var(--color-accent);
		border-radius: 8px;
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.code-go-msg {
		flex-basis: 100%;
		margin: 0;
		min-height: 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.code-go-msg:empty {
		display: none;
	}

	.tag--strong {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-accent-contrast);
	}

	.empty {
		text-align: center;
		margin: var(--space-6) 0;
	}

	.empty p {
		margin: 0 0 var(--space-3);
	}
</style>
