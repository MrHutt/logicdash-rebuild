---
import Layout from "../../layouts/Layout.astro";
import TopicIcon from "../../components/TopicIcon.astro";
import { LEARN_TOPICS, GROUP_ORDER, GROUP_BLURBS } from "../../lib/learnTopics";

// GROUP_ORDER is shared with learnTopics.ts's HUB_ORDERED_TOPICS, which
// drives every article's prev/next — so this grid and that pagination always
// agree on what "next" means.
const slug = (name: string) =>
	name
		.toLowerCase()
		.replace(/&/g, "and")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");

const groups = GROUP_ORDER.map((name) => ({
	name,
	id: slug(name),
	blurb: GROUP_BLURBS[name],
	topics: LEARN_TOPICS.filter((topic) => topic.group === name),
})).filter((group) => group.topics.length > 0);
const liveCount = LEARN_TOPICS.filter((topic) => topic.live).length;
---

<Layout
	title="Bit by Bit"
	wide
	description="Bit by Bit: free, plain-English lessons on binary, data, networks, and cybersecurity — with hands-on demos, quick quizzes, and endless pseudocode practice."
>
	<section class="hero">
		<h1>Bit by Bit</h1>
		<p class="hero-lead">The ideas behind the puzzle — and the computer science around it — explained simply.</p>
		<p class="hero-count">{liveCount} lessons and practice tools</p>
	</section>

	<nav class="group-jump" aria-label="Jump to a section">
		<ul>
			{
				groups.map((group) => (
					<li>
						<a href={`#${group.id}`}>{group.name}</a>
					</li>
				))
			}
		</ul>
	</nav>

	{
		groups.map((group) => (
			<section class="topic-group" id={group.id} aria-labelledby={`${group.id}-title`}>
				<h2 class="topic-group-title" id={`${group.id}-title`}>{group.name}</h2>
				<p class="topic-group-blurb">{group.blurb}</p>
				<div class="topic-cards">
					{group.topics.map((topic) =>
						topic.live ? (
							<a class="topic-card" href={topic.href}>
								<TopicIcon href={topic.href} />
								<span class="topic-card-name">{topic.title}</span>
								<span class="topic-card-blurb">{topic.blurb}</span>
								{topic.kind === "tool" && <span class="topic-card-badge topic-card-badge--tool">Practice tool</span>}
							</a>
						) : (
							<div class="topic-card topic-card--soon">
								<TopicIcon href={topic.href} />
								<span class="topic-card-name">{topic.title}</span>
								<span class="topic-card-blurb">{topic.blurb}</span>
								<span class="topic-card-badge">Coming soon</span>
							</div>
						),
					)}
				</div>
			</section>
		))
	}
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 1.25rem;
	}

	.hero h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.6rem, 5vw, 2.1rem);
	}

	.hero-lead {
		margin: 0 auto;
		max-width: 36rem;
		font-size: 1rem;
	}

	.hero-count {
		margin: 0.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	/* Section shortcuts. Plain wrapping pills — they simply flow onto a
	   second (or third) line when space runs out, so there's no breakpoint
	   where they can collide or overflow. */
	.group-jump {
		margin: 0 0 1.5rem;
	}

	.group-jump ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.group-jump a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: border-color 0.15s ease;
	}

	.group-jump a:hover,
	.group-jump a:focus-visible {
		border-color: var(--color-accent);
	}

	.topic-group {
		scroll-margin-top: 1rem;
	}

	.topic-group-blurb {
		margin: -0.25rem 0 0.75rem;
		font-size: 0.9rem;
	}

	.topic-group {
		margin-bottom: 1.5rem;
	}

	.topic-group:last-child {
		margin-bottom: 0;
	}

	.topic-group-title {
		margin: 0 0 0.5rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	/* One consistent grid for every section: columns keep the same width
	   and line up from section to section (4 across on wide screens, then
	   3, 2 and 1 as space runs out). auto-fill — not auto-fit — keeps a
	   short section's cards the same size as everyone else's. */
	.topic-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: var(--space-3);
	}

	.topic-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0.75rem 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		text-align: center;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	a.topic-card:hover {
		border-color: #ffae2e;
		box-shadow: 0 0 14px color-mix(in srgb, #ffae2e 35%, transparent);
		transform: translateY(-1px);
	}

	a.topic-card:active {
		transform: scale(0.97);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.topic-card-name {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		line-height: 1.25;
		color: var(--color-text);
	}

	.topic-card-blurb {
		font-size: 0.78rem;
		line-height: 1.35;
		color: var(--color-text-muted);
	}

	.topic-card--soon {
		opacity: 0.6;
	}

	.topic-card-badge {
		margin-top: 0.25rem;
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
	}

	.topic-card-badge--tool {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>
