---
import Layout from "../layouts/Layout.astro";
import HammingGame from "../components/HammingGame.astro";
---

<Layout
	title="Classic"
	description="Play LogicDash Classic: guess the secret 5-bit binary pattern in 6 tries. Each guess reveals only how many bits are wrong, never which ones."
>
	<div class="page-intro">
		<h1>Classic</h1>
		<p>Guess the 5-bit secret. Each guess shows how many bits differ from the answer.</p>
	</div>
	<HammingGame bitLength={5} maxAttempts={6} />

	<img
		class="game-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="lazy"
	/>
</Layout>

<style>
	.page-intro {
		margin-bottom: 0.5rem;
	}

	.page-intro h1 {
		margin: 0 0 0.15rem;
		font-size: clamp(1.25rem, 3vw, 1.6rem);
	}

	.page-intro p {
		margin: 0;
		font-size: 0.85rem;
	}

	.game-art {
		display: block;
		width: 100%;
		max-width: 6rem;
		height: auto;
		margin: 1.5rem auto 0;
		opacity: 0.85;
	}
</style>
