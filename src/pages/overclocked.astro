---
import Layout from "../layouts/Layout.astro";
import HammingGame from "../components/HammingGame.astro";
---

<Layout title="Overclocked">
	<div class="page-intro">
		<h1>Overclocked</h1>
		<p>Guess the 6-bit secret. Each guess shows how many bits differ from the answer.</p>
	</div>
	<HammingGame bitLength={6} maxAttempts={6} />
</Layout>

<style>
	.page-intro {
		margin-bottom: 0.5rem;
	}

	.page-intro h1 {
		margin: 0 0 0.15rem;
		font-size: clamp(1.25rem, 3vw, 1.6rem);
	}

	.page-intro p {
		margin: 0;
		font-size: 0.85rem;
	}
</style>
