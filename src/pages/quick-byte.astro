---
import Layout from "../layouts/Layout.astro";
import HammingBoard from "../components/HammingBoard.astro";
---

<Layout
	title="Today's Quick Byte"
	description="LogicDash's daily challenge: three 5-bit binary puzzles back-to-back, the same for everyone each day. Solve them and share your score."
>
	<div class="page-intro">
		<h1>Today's Quick Byte</h1>
		<p>Three 5-bit rounds. Same puzzles for everyone today — come back tomorrow for new ones.</p>
	</div>

	<div class="quick-byte-play">
		<p class="quick-byte-round-label"></p>
		<HammingBoard bitLength={5} maxAttempts={6} />
		<button type="button" class="quick-byte-next" hidden>Next Round</button>
	</div>

	<!-- Today's result first; sharing is deliberately above optional detailed statistics. -->
	<div class="quick-byte-results" hidden>
		<p class="quick-byte-results-label">Today's result</p>
		<p class="quick-byte-sequence"></p>
		<p class="quick-byte-total"></p>
		<p class="quick-byte-special" hidden></p>

		<div class="quick-byte-averages">
			<div class="quick-byte-average-card"><span>TODAY'S AVERAGE</span><strong data-today-average>—</strong><small>guesses / round</small></div>
			<div class="quick-byte-average-card"><span>OVERALL AVERAGE</span><strong data-overall-average>—</strong><small>guesses / round, before today</small></div>
		</div>
		<p class="quick-byte-avg-feedback" hidden></p>
		<p class="quick-byte-streak" hidden></p>
		<p class="quick-byte-operator-mark" hidden>✦ CERTIFIED BYTE OPERATOR · FULL DECK [32]</p>
		<div class="quick-byte-share-row">
			<button type="button" class="quick-byte-share quick-byte-share--result">Share Result</button>
			<button type="button" class="quick-byte-share quick-byte-share--copy">Copy</button>
			<a class="quick-byte-share quick-byte-share--x" href="#" target="_blank" rel="noopener noreferrer">X</a>
			<a class="quick-byte-share quick-byte-share--whatsapp" href="#" target="_blank" rel="noopener noreferrer">WhatsApp</a>
		</div>

		<details class="quick-byte-details">
			<summary><span class="stats-toggle-icon" aria-hidden="true"><span class="stats-toggle-open">+</span><span class="stats-toggle-close">−</span></span><span class="stats-toggle-text"><span class="stats-toggle-open">OPEN</span><span class="stats-toggle-close">CLOSE</span> ACTIVITY LOG</span><span class="stats-toggle-count" aria-hidden="true">[32]</span></summary>
			<div class="quick-byte-details-content">
				<div class="quick-byte-punchcard">
					<div class="quick-byte-punchcard-top"><span>LOGICDASH SYSTEMS / ACTIVITY RECORD</span><span>32 DAYS</span></div>
					<p>DO NOT FOLD, SPINDLE OR MUTILATE</p>
					<div class="quick-byte-punch-scroll"><div class="quick-byte-punch-rows" role="group" aria-label="Successes over the past 32 days"></div></div>
					<small>01 = today · 32 = 31 days ago · Filled slots = three successful rounds</small>
				</div>
				<p class="quick-byte-history-summary"></p>
				<p class="quick-byte-local-note">Statistics are saved in this browser only.</p>
			</div>
		</details>
		<p class="quick-byte-return-note">Come back tomorrow for a new Quick Byte — next challenge in <span class="quick-byte-countdown"></span>.</p>
	</div>

	<!-- Hidden until a player reaches 32 consecutive fully solved days. -->
	<div class="full-deck-overlay" hidden>
		<section class="full-deck-dialog" role="dialog" aria-modal="true" aria-labelledby="full-deck-title" aria-describedby="full-deck-description" tabindex="-1">
			<button type="button" class="full-deck-close" aria-label="Close Full Deck certificate">×</button>
			<div class="full-deck-certificate">
				<div class="full-deck-meta"><span>LOGICDASH SYSTEMS</span><span>FORM 032</span></div>
				<p class="full-deck-stamp">✦ 32 / 32 ✦</p>
				<h2 id="full-deck-title">FULL DECK!</h2>
				<p class="full-deck-subtitle">CERTIFIED BYTE OPERATOR</p>
				<div class="full-deck-holes" aria-hidden="true"></div>
				<p class="full-deck-warning">DO NOT FOLD, SPINDLE OR MUTILATE</p>
			</div>
			<p id="full-deck-description" class="full-deck-message">32 days. 32 successful Quick Bytes. Somewhere, an IBM mainframe is quietly applauding.</p>
			<div class="full-deck-actions">
				<button type="button" class="full-deck-share">Share Achievement</button>
				<button type="button" class="full-deck-done">Back to results</button>
			</div>
			<p class="full-deck-private">Your achievement is stored in this browser only.</p>
		</section>
	</div>

	<img
		class="game-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="lazy"
	/>
</Layout>

<style>
	.page-intro {
		margin-bottom: 0.75rem;
	}

	.page-intro h1 {
		margin: 0 0 0.15rem;
		font-size: clamp(1.25rem, 3vw, 1.6rem);
	}

	.page-intro p {
		margin: 0;
		font-size: 0.85rem;
	}

	.game-art {
		display: block;
		width: 100%;
		max-width: 6rem;
		height: auto;
		margin: 1.5rem auto 0;
		opacity: 0.85;
	}

	.quick-byte-play {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.quick-byte-play[hidden] {
		display: none;
	}

	.quick-byte-round-label {
		margin: 0;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.quick-byte-next {
		align-self: center;
		padding: 0.45rem 1.6rem;
		border: 1px solid #ffae2e;
		border-radius: 8px;
		background: color-mix(in srgb, #ffae2e 18%, #1c140d);
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		text-shadow: 0 0 6px #ffae2e;
		box-shadow: 0 0 10px color-mix(in srgb, #ffae2e 45%, transparent);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quick-byte-next:hover {
		background: color-mix(in srgb, #ffae2e 30%, #1c140d);
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 70%, transparent);
	}

	.quick-byte-next:active {
		transform: scale(0.95);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.quick-byte-next[hidden] {
		display: none;
	}

	.quick-byte-results {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem 1rem;
		text-align: center;
	}

	.quick-byte-results[hidden] {
		display: none;
	}

	.quick-byte-results-label {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.quick-byte-sequence {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1.5rem, 6vw, 2.25rem);
		color: #fff3d6;
		text-shadow:
			0 0 6px #ffae2e,
			0 0 14px #ffae2e;
	}

	.quick-byte-total {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-text);
	}

	.quick-byte-special {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		font-style: italic;
		color: var(--color-text);
	}

	.quick-byte-special[hidden] {
		display: none;
	}

	/* Post-game comparison against the player's historical PER-ROUND average. */
	.quick-byte-avg-feedback {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		font-weight: 700;
	}

	.quick-byte-avg-feedback[hidden] {
		display: none;
	}

	.quick-byte-avg-feedback.is-better {
		color: var(--color-success);
	}

	.quick-byte-avg-feedback.is-worse {
		color: var(--color-danger);
	}

	.quick-byte-avg-feedback.is-same {
		color: var(--color-text-muted);
	}

	.quick-byte-streak {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.quick-byte-streak[hidden] {
		display: none;
	}

	/* --- Mini punchcard preview: last 7 days as one compact flex row of squares --- */
	.quick-byte-mini-punch {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.6rem 0 0;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.quick-byte-mini-punch[hidden] {
		display: none;
	}

	.quick-byte-mini-punch-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
	}

	.mini-punch-cells {
		display: flex;
		gap: 4px;
	}

	.mini-punch-cell {
		width: 12px;
		height: 12px;
		border-radius: 2px;
		background: #f4f1ea; /* missed / future day = blank beige */
		opacity: 0.35;
	}

	.mini-punch-cell.is-punched {
		background: #ffae2e;
		opacity: 1;
		box-shadow:
			inset 0 1px 2px rgba(26, 28, 35, 0.45),
			0 0 6px rgba(255, 174, 46, 0.7);
	}

	.quick-byte-view-stats {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.quick-byte-view-stats:hover {
		color: #fff3d6;
	}

	.quick-byte-countdown {
		font-family: var(--font-mono);
		font-weight: 700;
		color: #ffae2e;
	}

	.quick-byte-return-note {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
	}

	.quick-byte-share-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 0.6rem;
		position: relative;
	}

	.quick-byte-share {
		display:inline-flex; align-items:center; justify-content:center; text-decoration:none;
		padding: 0.5rem 1.5rem;
		border: 1px solid #ffae2e;
		border-radius: 999px;
		background: transparent;
		color: #ffae2e;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quick-byte-share:hover {
		background: #ffae2e;
		color: #241202;
	}

	.quick-byte-share:active {
		transform: scale(0.95);
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.1s ease-out;
	}

	/* Brief "Copied!" toast shown when native share is unavailable or was dismissed. */
	.share-toast {
		position: absolute;
		top: -2rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-surface-alt);
		border: 1px solid var(--color-success);
		color: var(--color-success);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.2rem 0.7rem;
		border-radius: 999px;
		pointer-events: none;
		white-space: nowrap;
	}

	.share-toast[hidden] {
		display: none;
	}
	/* Compact comparison and authentic numbered activity card, below primary sharing. */
	.quick-byte-averages { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.6rem; margin:.8rem auto 0; max-width:34rem; text-align:center; }
	.quick-byte-average-card { display:flex; flex-direction:column; align-items:center; gap:.2rem; padding:.8rem .4rem; background:var(--color-surface); border:1px solid var(--color-border); border-radius:12px; }
	.quick-byte-average-card span { font-size:.68rem; font-weight:700; letter-spacing:.05em; color:var(--color-text-muted); }
	.quick-byte-average-card strong { font-size:clamp(1.5rem,5vw,2rem); font-family:var(--font-mono); }
	.quick-byte-average-card small { font-size:.69rem; color:var(--color-text-muted); }
	.quick-byte-details { max-width:40rem; margin:1rem auto 0; text-align:left; }
	.quick-byte-details summary { cursor:pointer; width:fit-content; margin:0 auto; padding:.48rem .75rem; font-family:var(--font-mono); font-size:.75rem; font-weight:700; letter-spacing:.055em; color:var(--color-accent); list-style:none; display:flex; gap:.55rem; align-items:center; border:1px dashed color-mix(in srgb, var(--color-accent) 55%, transparent); border-radius:6px; background:color-mix(in srgb, var(--color-accent) 6%, transparent); transition:background .15s ease,border-color .15s ease; }
	.quick-byte-details summary:hover { background:color-mix(in srgb, var(--color-accent) 13%, transparent); border-color:var(--color-accent); }
	.quick-byte-details summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
	.quick-byte-details summary::-webkit-details-marker { display:none; }
	.stats-toggle-icon { display:grid; place-items:center; width:1.3rem; height:1.3rem; border:1px solid currentColor; border-radius:3px; font-size:1rem; line-height:1; }
	.stats-toggle-count { font-size:.65rem; opacity:.7; }
	.stats-toggle-close { display:none; }
	.quick-byte-details[open] .stats-toggle-open { display:none; }
	.quick-byte-details[open] .stats-toggle-close { display:inline; }
	.quick-byte-details-content { margin-top:.7rem; padding:.8rem; border:1px solid var(--color-border); border-radius:12px; background:var(--color-surface); }
	.quick-byte-punchcard { background:#e8ddc4; color:#403a2c; border-radius:8px; padding:1rem .7rem; font-family:var(--font-mono); }
	.quick-byte-punchcard-top { display:flex; justify-content:space-between; gap:.5rem; font-size:.58rem; font-weight:700; }
	.quick-byte-punchcard p { text-align:center; margin:.65rem 0; font-size:.61rem; font-weight:700; letter-spacing:.04em; color:#53472f; }
	.quick-byte-punchcard small { display:block; margin-top:.6rem; font-size:.59rem; }
	.quick-byte-punch-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
	.quick-byte-punch-rows { min-width:425px; display:grid; gap:.7rem; }
	:global(.quick-byte-punch-row) { display:grid; grid-template-columns:20px repeat(16,minmax(19px,1fr)); gap:4px; align-items:end; }
	:global(.quick-byte-punch-row-label) { font-weight:700; font-size:.65rem; align-self:center; }
	:global(.quick-byte-punch-position) { display:flex; flex-direction:column; align-items:center; gap:4px; }
	:global(.quick-byte-punch-number) { font-size:.54rem; color:#423927; line-height:1.3; }
	:global(.quick-byte-punch-hole) { display:block; width:12px; height:22px; background:#c7bda6; border-radius:2px; box-shadow:inset 0 1px 2px #a89a7d; }
	:global(.quick-byte-punch-hole.is-punched) { background:#966020; box-shadow:inset 0 1px 3px #493016; }
	.quick-byte-history-summary,.quick-byte-local-note { text-align:center; font-size:.78rem; color:var(--color-text-muted); margin:.8rem 0 .1rem; }
	@media (max-width:390px) { .quick-byte-average-card span { font-size:.6rem; } }

	/* 32-day surprise: intentionally hidden for all other players. */
	.quick-byte-operator-mark { width:fit-content; margin:.4rem auto; padding:.35rem .65rem; border:1px solid var(--color-accent); border-radius:5px; color:var(--color-accent); font-family:var(--font-mono); font-size:.7rem; font-weight:700; letter-spacing:.04em; }
	.quick-byte-operator-mark[hidden],.full-deck-overlay[hidden] { display:none; }
	.full-deck-overlay { position:fixed; inset:0; z-index:1100; background:rgba(5,7,12,.86); display:flex; align-items:center; justify-content:center; padding:1rem; overflow-y:auto; }
	.full-deck-dialog { position:relative; width:min(100%,31rem); max-height:calc(100vh - 2rem); overflow-y:auto; border:1px solid var(--color-accent); border-radius:12px; background:var(--color-surface); box-shadow:0 20px 70px rgba(0,0,0,.5); padding:1.2rem; text-align:center; }
	.full-deck-close { position:absolute; z-index:1; top:.25rem; right:.45rem; background:transparent; border:0; color:var(--color-text); font-size:1.7rem; cursor:pointer; }
	.full-deck-certificate { background:#e8ddc4; color:#302b20; border-radius:6px; padding:1.4rem .85rem 1rem; font-family:var(--font-mono); }
	.full-deck-meta { display:flex; justify-content:space-between; gap:.5rem; font-size:.56rem; font-weight:700; letter-spacing:.06em; }
	.full-deck-stamp { color:#966020; font-size:1.2rem; margin:.8rem 0 .1rem; font-weight:700; }
	.full-deck-certificate h2 { margin:.25rem 0; font-size:clamp(1.7rem,6vw,2.7rem); line-height:1.1; letter-spacing:.04em; color:#302b20; }
	.full-deck-subtitle { font-weight:700; font-size:clamp(.75rem,3vw,1rem); letter-spacing:.08em; margin:.4rem 0 .8rem; }
	.full-deck-holes { display:grid; grid-template-columns:repeat(16,minmax(0,1fr)); gap:4px; }
	:global(.full-deck-hole) { display:block; height:22px; border-radius:2px; background:#966020; box-shadow:inset 0 2px 3px #503415; }
	.full-deck-warning { font-size:.6rem; font-weight:700; letter-spacing:.08em; margin:.9rem 0 0; }
	.full-deck-message { max-width:26rem; margin:1rem auto; font-size:.91rem; line-height:1.6; }
	.full-deck-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:.5rem; }
	.full-deck-actions button { cursor:pointer; border:1px solid var(--color-accent); border-radius:999px; padding:.65rem 1rem; background:transparent; color:var(--color-accent); font-family:var(--font-mono); font-size:.74rem; font-weight:700; }
	.full-deck-actions .full-deck-share { background:var(--color-accent); color:#241202; }
	.full-deck-private { font-size:.68rem; color:var(--color-text-muted); margin:.9rem 0 0; }

</style>

<script>
	import { createHammingGame } from "../lib/hammingGame";
	import { getLocalDateString, generateDailySecrets } from "../lib/dailySeed";
	import {
		roundScore,
		formatResultSequence,
		formatTotalLine,
		totalScore,
		type RoundResult,
	} from "../lib/quickByteScoring";
	import {
		getBinaryStreak,
		getCurrentStreak,
		getLongestStreak,
		getGamesCompleted,
		getTotalGuesses,
		getAvgGuessesPerRound,
		addGameStats,
		recordPlayDate,
		hasPlayedOn,
	} from "../lib/stats";

	// Result storage is browser-local only for now (no accounts yet), keyed by the
	// player's local calendar day. Cross-device sync will come later once accounts exist.
	const STORAGE_PREFIX = "logicdash:quickbyte:";
	const PROGRESS_PREFIX = "logicdash:quickbyte:progress:";
	const STREAK_KEY = "logicdash:quickbyte:streak";
	const FULL_DECK_KEY = "logicdash:quickbyte:full-deck";

	const BIT_LENGTH = 5;
	const MAX_ATTEMPTS = 6;
	const ROUND_COUNT = 3;

	interface QuickByteResult {
		perRound: RoundResult[];
		total: number | null;
		completedAt: string;
	}

	// Saved after every single guess (not just on full completion) so navigating away
	// mid-round and coming back restores exactly where the player left off — same round,
	// same guess history, same attempts remaining. Cleared once the day is fully complete.
	interface QuickByteProgress {
		roundIndex: number;
		completedRounds: RoundResult[];
		guessesThisRound: string[];
	}

	interface StreakRecord {
		last: string;
		count: number;
		longest: number;
	}

	const dateString = getLocalDateString();
	const storageKey = STORAGE_PREFIX + dateString;
	const progressKey = PROGRESS_PREFIX + dateString;

	const playSection = document.querySelector<HTMLElement>(".quick-byte-play")!;
	const roundLabel = document.querySelector<HTMLElement>(".quick-byte-round-label")!;
	const nextButton = document.querySelector<HTMLButtonElement>(".quick-byte-next")!;
	const resultsSection = document.querySelector<HTMLElement>(".quick-byte-results")!;
	const sequenceEl = document.querySelector<HTMLElement>(".quick-byte-sequence")!;
	const totalEl = document.querySelector<HTMLElement>(".quick-byte-total")!;
	const shareResultBtn = document.querySelector<HTMLButtonElement>(".quick-byte-share--result")!;
	const shareCopyBtn = document.querySelector<HTMLButtonElement>(".quick-byte-share--copy")!;
	const shareXLink = document.querySelector<HTMLAnchorElement>(".quick-byte-share--x")!;
	const shareWhatsAppLink = document.querySelector<HTMLAnchorElement>(".quick-byte-share--whatsapp")!;
	const todayAvgEl = document.querySelector<HTMLElement>("[data-today-average]")!;
	const overallAvgEl = document.querySelector<HTMLElement>("[data-overall-average]")!;
	const fullDeckOverlay = document.querySelector<HTMLElement>(".full-deck-overlay")!;
	const fullDeckDialog = document.querySelector<HTMLElement>(".full-deck-dialog")!;
	const fullDeckMark = document.querySelector<HTMLElement>(".quick-byte-operator-mark")!;
	const fullDeckClose = document.querySelector<HTMLButtonElement>(".full-deck-close")!;
	const fullDeckDone = document.querySelector<HTMLButtonElement>(".full-deck-done")!;
	const fullDeckShare = document.querySelector<HTMLButtonElement>(".full-deck-share")!;

	// Set whenever results are shown (either just now, or on revisiting an already-completed
	// day), so the share buttons always have the right scores regardless of which path ran.
	let resultScores: RoundResult[] = [];

	// Today's clean-sweep total (null on an incomplete day) — used by the share text.
	let currentGameTotal: number | null = null;

	// --- Easter eggs for special score sequences (666, 111, …) ---
	function isPowerOfTwo(n: number): boolean { return n >= 2 && Number.isInteger(Math.log2(n)); }

	function getSequenceEasterEgg(sequenceText: string): string {
		const TEST_MODE = false; // flip to true to see the egg on ANY score (for testing)
		if (TEST_MODE) return "🧪 Test egg — wiring works!";
		const seq = sequenceText.replace(/[^0-9X]/g, "").toUpperCase();
		if (seq === "666") return "😈 The Devil's Run!";
		if (seq === "111") return "😇 Flawless!";
		if (seq === "123") return "📈 The Escalator!";
		if (seq === "321") return "🚀 Countdown!";
		if (seq === "XXX") return "💀 Strikeout!";
		return "";
	}

	// --- Human-readable dates ("18 Nov 2026"), parsed LOCAL from YYYY-MM-DD ---
	const MONTH_ABBR = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

	function humanDate(dateString: string): string {
		const [year, month, day] = dateString.split("-").map(Number);
		return `${String(day).padStart(2, "0")} ${MONTH_ABBR[month - 1]} ${year}`;
	}

	// --- Clean share texts (single source — no duplicated lines) ---
	function buildResultShareText(): string {
		const sequence = formatResultSequence(resultScores);
		const streakCount = getCurrentStreak();
		const lines = [`LogicDash Quick Byte – ${humanDate(dateString)}`, `${sequence} (${currentGameTotal ?? "Incomplete"} guesses)`];
		const extras: string[] = [];
		if (currentGameTotal !== null) extras.push(`Avg: ${(currentGameTotal / ROUND_COUNT).toFixed(1)}/round`);
		if (streakCount > 0) extras.push(`Streak: ${getBinaryStreak(streakCount)} (${streakCount} days) 🔥${isPowerOfTwo(streakCount) ? " ✦ Power of 2!" : ""}`);
		if (extras.length > 0) lines.push(extras.join(" · "));
		const egg = getSequenceEasterEgg(sequence);
		if (egg) lines.push(egg);
		if (hasFullDeck()) lines.push("✦ FULL DECK — Certified Byte Operator [32]");
		lines.push("", "logicdash.io");
		return lines.join("\n");
	}

	const shareRow = document.querySelector<HTMLElement>(".quick-byte-share-row")!;
	const shareToast = document.createElement("span");
	shareToast.className = "share-toast";
	shareToast.hidden = true;
	shareRow.appendChild(shareToast);

	let toastTimeout: ReturnType<typeof setTimeout> | undefined;

	function showToast(message: string) {
		shareToast.textContent = message;
		shareToast.hidden = false;
		clearTimeout(toastTimeout);
		toastTimeout = setTimeout(() => {
			shareToast.hidden = true;
		}, 2000);
	}

	async function copyFallback(text: string, button: HTMLButtonElement) {
		try {
			await navigator.clipboard.writeText(text);
			showToast("Copied!");
			const original = button.textContent ?? "";
			button.textContent = "Copied!";
			setTimeout(() => {
				button.textContent = original;
			}, 2000);
		} catch {
			showToast("Couldn't copy — try again.");
		}
	}

	// Native share first; clipboard + "Copied!" toast fallback if unsupported or it fails.
	async function shareText(button: HTMLButtonElement, text: string, url: string) {
		if (typeof navigator.share === "function") {
			try {
				await navigator.share({ title: "LogicDash", text, url });
				return;
			} catch (err) {
				// User dismissed the share sheet — nothing further to do.
				if (err instanceof DOMException && err.name === "AbortError") return;
				// Any other failure falls through to the clipboard.
			}
		}
		await copyFallback(text, button);
	}

	shareResultBtn.addEventListener("click", () => {
		shareText(shareResultBtn, buildResultShareText(), "https://logicdash.io/");
	});

	shareCopyBtn.addEventListener("click", () => copyFallback(buildResultShareText(), shareCopyBtn));
	function updateShareLinks() {
		const message = encodeURIComponent(buildResultShareText());
		shareXLink.href = `https://twitter.com/intent/tweet?text=${message}`;
		shareWhatsAppLink.href = `https://wa.me/?text=${message}`;
	}


	// Full Deck is awarded once, on the first successful completion of day 32.
	// A permanent local marker remains visible, even after a streak ends.
	function hasFullDeck(): boolean {
		try { return localStorage.getItem(FULL_DECK_KEY) === "earned"; } catch { return false; }
	}
	function showFullDeck() {
		fullDeckOverlay.hidden = false;
		fullDeckDialog.focus();
	}
	function closeFullDeck() { fullDeckOverlay.hidden = true; }
	function buildFullDeckShareText() {
		return ["✦ FULL DECK! ✦", "Certified Byte Operator", "32 consecutive Quick Byte days — 32/32", "DO NOT FOLD, SPINDLE OR MUTILATE", "logicdash.io/quick-byte/"].join("\n");
	}
	fullDeckClose.addEventListener("click", closeFullDeck);
	fullDeckDone.addEventListener("click", closeFullDeck);
	fullDeckOverlay.addEventListener("click", (event) => { if (event.target === fullDeckOverlay) closeFullDeck(); });
	document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !fullDeckOverlay.hidden) closeFullDeck(); });
	fullDeckShare.addEventListener("click", () => shareText(fullDeckShare, buildFullDeckShareText(), "https://logicdash.io/quick-byte/"));
	const holeContainer = document.querySelector<HTMLElement>(".full-deck-holes")!;
	for (let i = 0; i < 32; i++) {
		const hole = document.createElement("span"); hole.className = "full-deck-hole"; holeContainer.append(hole);
	}

	function readStoredResult(): QuickByteResult | null {
		try {
			const raw = localStorage.getItem(storageKey);
			if (!raw) return null;
			return JSON.parse(raw) as QuickByteResult;
		} catch {
			return null;
		}
	}

	function storeResult(result: QuickByteResult) {
		try {
			localStorage.setItem(storageKey, JSON.stringify(result));
			localStorage.removeItem(progressKey);
		} catch {}
	}

	function readProgress(): QuickByteProgress | null {
		try {
			const raw = localStorage.getItem(progressKey);
			if (!raw) return null;
			return JSON.parse(raw) as QuickByteProgress;
		} catch {
			return null;
		}
	}

	function storeProgress(progress: QuickByteProgress) {
		try {
			localStorage.setItem(progressKey, JSON.stringify(progress));
		} catch {}
	}

	// --- Streak logic ---
	function readStreak(): StreakRecord {
		try {
			const raw = localStorage.getItem(STREAK_KEY);
			if (raw) return JSON.parse(raw) as StreakRecord;
		} catch {}
		return { last: "", count: 0, longest: 0 };
	}

	function dayDiff(from: string, to: string): number {
		const [ay, am, ad] = from.split("-").map(Number);
		const [by, bm, bd] = to.split("-").map(Number);
		return Math.round((Date.UTC(by, bm - 1, bd) - Date.UTC(ay, am - 1, ad)) / 86400000);
	}

	function recordStreak(perRound: RoundResult[]): number {
		const streak = readStreak();
		if (streak.longest === undefined) streak.longest = streak.count || 0;
		const perfect = perRound.every((r) => r !== null);

		if (!perfect) {
			// An unsuccessful completed day breaks the run but never erases the personal best.
			streak.count = 0;
			streak.last = "";
			try { localStorage.setItem(STREAK_KEY, JSON.stringify(streak)); } catch {}
			return 0;
		}

		if (streak.last !== dateString) {
			streak.count = streak.last && dayDiff(streak.last, dateString) === 1 ? streak.count + 1 : 1;
			streak.last = dateString;
			if (streak.count > streak.longest) streak.longest = streak.count;
			try { localStorage.setItem(STREAK_KEY, JSON.stringify(streak)); } catch {}
		}
		return streak.count;
	}

	// --- Post-game feedback vs. the player's historical PER-ROUND average (QuickByte-only) ---
	// History is read BEFORE today's game is folded into it, so "your average" means
	// "your usual", not "your usual including this run". QuickByte days are 3 rounds, so
	// both sides of the comparison are per-round numbers: today's total / 3 vs. the stored
	// total_guesses / (games_completed * 3). No history yet → skip the arrow entirely.
	function getHistoricalAverage(perRound: RoundResult[]): number | null {
		// Revisited results should compare against the same pre-today baseline.
		const total = totalScore(perRound);
		if (!hasPlayedOn(dateString) || total === null) return getAvgGuessesPerRound();
		const previousGames = getGamesCompleted() - 1;
		return previousGames > 0 ? (getTotalGuesses() - total) / (previousGames * ROUND_COUNT) : null;
	}

	function renderAvgFeedback(perRound: RoundResult[]) {
		const feedbackEl = document.querySelector<HTMLElement>(".quick-byte-avg-feedback")!;
		feedbackEl.className = "quick-byte-avg-feedback";
		const total = totalScore(perRound);
		if (total === null) {
			// Incomplete day — no fair comparison to make; skip the arrow entirely.
			feedbackEl.hidden = true;
			return;
		}
		const historicalAvg = getHistoricalAverage(perRound);
		if (historicalAvg === null) {
			feedbackEl.hidden = true; // No history yet — nothing to compare against.
			return;
		}
		const currentAvg = total / ROUND_COUNT;
		if (currentAvg < historicalAvg) {
			feedbackEl.textContent = `↓ ${(historicalAvg - currentAvg).toFixed(1)} fewer guesses per round today!`;
			feedbackEl.classList.add("is-better");
		} else if (currentAvg > historicalAvg) {
			feedbackEl.textContent = `↑ ${(currentAvg - historicalAvg).toFixed(1)} more guesses per round today.`;
			feedbackEl.classList.add("is-worse");
		} else {
			feedbackEl.textContent = "➖ Exactly your usual average.";
			feedbackEl.classList.add("is-same");
		}
		feedbackEl.hidden = false;
	}

	// Fold today's finished game into the lifetime aggregates exactly once per day,
	// guarded by the play-dates array so revisits never double-count. Failures never
	// reach this: only a clean sweep of all 3 rounds records a play date.
	function saveNewGameStats(perRound: RoundResult[]) {
		const total = totalScore(perRound);
		if (total === null || hasPlayedOn(dateString)) return;
		recordPlayDate();
		addGameStats(total);
	}

	// Numbered 32-position punchcard; today is slot 01 and yesterday is 02.
	function renderPunchcard() {
		const rows = document.querySelector<HTMLElement>(".quick-byte-punch-rows")!;
		rows.replaceChildren();
		for (let r = 0; r < 2; r++) {
			const row = document.createElement("div"); row.className = "quick-byte-punch-row";
			const label = document.createElement("span"); label.className = "quick-byte-punch-row-label"; label.textContent = r === 0 ? "A" : "B"; row.append(label);
			for (let c = 0; c < 16; c++) {
				const offset = r * 16 + c;
				const d = new Date(); d.setDate(d.getDate() - offset);
				const date = getLocalDateString(d), success = hasPlayedOn(date);
				const slot = document.createElement("span"); slot.className = "quick-byte-punch-position";
				const number = document.createElement("span"); number.className = "quick-byte-punch-number"; number.textContent = String(offset + 1).padStart(2,"0");
				const hole = document.createElement("span"); hole.className = "quick-byte-punch-hole" + (success ? " is-punched" : "");
				slot.title = `${date}: ${success ? "Solved" : "Not solved"}`;
				slot.setAttribute("aria-label", slot.title); slot.append(number,hole); row.append(slot);
			}
			rows.append(row);
		}
		const summary = document.querySelector<HTMLElement>(".quick-byte-history-summary")!;
		summary.textContent = `Games completed: ${getGamesCompleted()} · Longest streak: ${getLongestStreak()} days`;
	}

	function showResults(perRound: RoundResult[], isNewlyCompleted = false) {
		resultScores = perRound;
		currentGameTotal = totalScore(perRound);
		updateShareLinks();
		playSection.hidden = true;
		resultsSection.hidden = false;
		sequenceEl.textContent = formatResultSequence(perRound);
		totalEl.textContent = formatTotalLine(perRound);

		const specialEl = document.querySelector<HTMLElement>(".quick-byte-special")!;
		const specialMsg = getSequenceEasterEgg(formatResultSequence(perRound));
		specialEl.textContent = specialMsg;
		specialEl.hidden = !specialMsg;

		// Compare against history before saving the new result; both averages are per round.
		const historicalAvg = getHistoricalAverage(perRound);
		todayAvgEl.textContent = currentGameTotal === null ? "—" : (currentGameTotal / ROUND_COUNT).toFixed(1);
		overallAvgEl.textContent = historicalAvg === null ? "—" : historicalAvg.toFixed(1);
		renderAvgFeedback(perRound);
		if (isNewlyCompleted) saveNewGameStats(perRound);

		const perfect = perRound.every((r) => r !== null);
		const streakCount = recordStreak(perRound);
		const streakData = readStreak();
		const longest = streakData.longest || 0;
		if (isNewlyCompleted && perfect && streakCount === 32 && !hasFullDeck()) {
			try { localStorage.setItem(FULL_DECK_KEY, "earned"); } catch {}
			showFullDeck();
		}
		fullDeckMark.hidden = !hasFullDeck();
		const streakEl = document.querySelector<HTMLElement>(".quick-byte-streak")!;

		let streakText = "";
		if (streakCount > 0) {
			streakText = perfect ? `🔥 ${streakCount}-day streak` : `🔥 ${streakCount}-day streak ended today`;
			// Neon binary flourish on the live-streak line, e.g. "· 111₂".
			if (perfect) streakText += ` · ${getBinaryStreak(streakCount)}`;
			if (perfect && isPowerOfTwo(streakCount)) streakText += " ✦ Power of 2!";
			if (longest > streakCount) {
				streakText += ` · Longest: ${longest}`;
			} else if (longest === streakCount && streakCount > 1) {
				streakText += ` · New best!`;
			}
		} else if (longest > 0) {
			streakText = `Longest streak: ${longest}`;
		}

		streakEl.textContent = streakText;
		streakEl.hidden = !streakText;

		renderPunchcard();
	}

	// --- Countdown to the next daily puzzle (local midnight) ---
	const countdownEl = document.querySelector<HTMLElement>(".quick-byte-countdown");
	function tickCountdown() {
		if (!countdownEl) return;
		const now = new Date();
		const midnight = new Date(now);
		midnight.setHours(24, 0, 0, 0);
		const ms = midnight.getTime() - now.getTime();
		const h = Math.floor(ms / 3600000);
		const m = Math.floor((ms % 3600000) / 60000);
		countdownEl.textContent = `${h}h ${m}m`;
	}
	tickCountdown();
	setInterval(tickCountdown, 30000);

	const alreadyPlayed = readStoredResult();

	if (alreadyPlayed) {
		showResults(alreadyPlayed.perRound);
	} else {
		const secrets = generateDailySecrets(dateString, BIT_LENGTH, ROUND_COUNT);
		const savedProgress = readProgress();

		const perRound: RoundResult[] = savedProgress?.completedRounds ?? [];
		let roundIndex = Math.min(Math.max(savedProgress?.roundIndex ?? 0, 0), ROUND_COUNT - 1);
		let guessesThisRound: string[] = savedProgress ? [...savedProgress.guessesThisRound] : [];

		function updateRoundLabel() {
			roundLabel.textContent = `Round ${roundIndex + 1} of ${ROUND_COUNT}`;
		}

		function persistProgress() {
			storeProgress({ roundIndex, completedRounds: perRound, guessesThisRound });
		}

		const board = document.querySelector<HTMLElement>(".hamming-game")!;
		const controller = createHammingGame(board, {
			bitLength: BIT_LENGTH,
			maxAttempts: MAX_ATTEMPTS,
			secret: secrets[roundIndex],
			showPlayAgain: false,
			onGuess: ({ bits }) => {
				guessesThisRound.push(bits);
				persistProgress();
			},
			onRoundEnd: ({ won, attempts }) => {
				if (perRound.length === roundIndex) {
					perRound.push(roundScore(won, attempts));
				}
				nextButton.textContent = roundIndex < ROUND_COUNT - 1 ? "Next Round" : "See Results";
				nextButton.hidden = false;
			},
		});

		updateRoundLabel();

		if (guessesThisRound.length > 0) {
			const toReplay = guessesThisRound;
			guessesThisRound = [];
			controller.restore(toReplay);
		}

		nextButton.addEventListener("click", () => {
			nextButton.hidden = true;
			if (roundIndex < ROUND_COUNT - 1) {
				roundIndex++;
				guessesThisRound = [];
				persistProgress();
				updateRoundLabel();
				controller.reset(secrets[roundIndex]);
			} else {
				storeResult({ perRound, total: totalScore(perRound), completedAt: new Date().toISOString() });
				showResults(perRound, true);
			}
		});
	}
</script>
