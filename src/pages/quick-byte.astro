---
import Layout from "../layouts/Layout.astro";
import HammingBoard from "../components/HammingBoard.astro";
---

<Layout
	title="Today's Quick Byte"
	description="LogicDash's daily challenge: three 5-bit binary puzzles back-to-back, the same for everyone each day. Solve them and share your score."
>
	<div class="page-intro">
		<h1>Today's Quick Byte</h1>
		<p>Three 5-bit rounds. Same puzzles for everyone today — come back tomorrow for new ones.</p>
	</div>

	<div class="quick-byte-play">
		<p class="quick-byte-round-label"></p>
		<HammingBoard bitLength={5} maxAttempts={6} />
		<button type="button" class="quick-byte-next" hidden>Next Round</button>
	</div>

	<div class="quick-byte-results" hidden>
		<p class="quick-byte-results-label">Today's result</p>
		<p class="quick-byte-sequence"></p>
		<p class="quick-byte-total"></p>
		<button type="button" class="quick-byte-share">Share Result</button>
		<p class="quick-byte-return-note">Come back tomorrow for a new Quick Byte.</p>
	</div>

	<img
		class="game-art"
		src="/logicdash-runners.png"
		alt="Two cartoon figures shaped like a running &quot;0&quot; and &quot;1&quot;, sprinting side by side"
		width="904"
		height="319"
		loading="lazy"
	/>

	<div class="share-modal-overlay" hidden>
		<div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="share-modal-title">
			<button type="button" class="share-modal-close" aria-label="Close">×</button>
			<p id="share-modal-title" class="share-modal-title">Share Your Result</p>
			<div class="share-preview">
				<p class="share-preview-date"></p>
				<p class="share-preview-sequence"></p>
				<p class="share-preview-site">logicdash.io</p>
			</div>
			<div class="share-actions">
				<button type="button" class="share-copy-btn">Copy</button>
				<span class="share-copied-note" hidden>Copied!</span>
			</div>
			<div class="share-links">
				<a class="share-link share-link--twitter" target="_blank" rel="noopener noreferrer">Share on X</a>
				<a class="share-link share-link--whatsapp" target="_blank" rel="noopener noreferrer">Share on WhatsApp</a>
			</div>
			<button type="button" class="share-native-btn" hidden>Share via Device</button>
		</div>
	</div>
</Layout>

<style>
	.page-intro {
		margin-bottom: 0.75rem;
	}

	.page-intro h1 {
		margin: 0 0 0.15rem;
		font-size: clamp(1.25rem, 3vw, 1.6rem);
	}

	.page-intro p {
		margin: 0;
		font-size: 0.85rem;
	}

	.game-art {
		display: block;
		width: 100%;
		max-width: 6rem;
		height: auto;
		margin: 1.5rem auto 0;
		opacity: 0.85;
	}

	.quick-byte-play {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.quick-byte-play[hidden] {
		display: none;
	}

	.quick-byte-round-label {
		margin: 0;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.quick-byte-next {
		align-self: center;
		padding: 0.45rem 1.6rem;
		border: 1px solid #ffae2e;
		border-radius: 8px;
		background: color-mix(in srgb, #ffae2e 18%, #1c140d);
		color: #fff3d6;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		text-shadow: 0 0 6px #ffae2e;
		box-shadow: 0 0 10px color-mix(in srgb, #ffae2e 45%, transparent);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quick-byte-next:hover {
		background: color-mix(in srgb, #ffae2e 30%, #1c140d);
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 70%, transparent);
	}

	.quick-byte-next:active {
		transform: scale(0.95);
		transition:
			background 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.1s ease-out;
	}

	.quick-byte-next[hidden] {
		display: none;
	}

	.quick-byte-results {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.5rem 1rem;
		text-align: center;
	}

	.quick-byte-results[hidden] {
		display: none;
	}

	.quick-byte-results-label {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.quick-byte-sequence {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(1.5rem, 6vw, 2.25rem);
		color: #fff3d6;
		text-shadow:
			0 0 6px #ffae2e,
			0 0 14px #ffae2e;
	}

	.quick-byte-total {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-text);
	}

	.quick-byte-return-note {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
	}

	.quick-byte-share {
		margin-top: 0.6rem;
		padding: 0.5rem 1.5rem;
		border: 1px solid #ffae2e;
		border-radius: 999px;
		background: transparent;
		color: #ffae2e;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.quick-byte-share:hover {
		background: #ffae2e;
		color: #241202;
	}

	.quick-byte-share:active {
		transform: scale(0.95);
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.1s ease-out;
	}

	.share-modal-overlay {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		background: rgba(6, 4, 2, 0.72);
		z-index: 100;
	}

	.share-modal-overlay[hidden] {
		display: none;
	}

	.share-modal {
		position: relative;
		width: 100%;
		max-width: 24rem;
		background: var(--color-surface);
		border: 1px solid #ffae2e;
		border-radius: 16px;
		padding: 1.25rem;
		box-shadow: 0 0 24px color-mix(in srgb, #ffae2e 30%, transparent);
		text-align: center;
	}

	.share-modal-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		border: none;
		background: none;
		color: var(--color-text-muted);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.25rem;
	}

	.share-modal-close:hover {
		color: var(--color-text);
	}

	.share-modal-title {
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #ffae2e;
	}

	.share-preview {
		margin: 0 0 0.85rem;
		padding: 0.75rem 0.85rem;
		border-radius: 10px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		line-height: 1.5;
		text-align: left;
	}

	.share-preview p {
		margin: 0;
		color: var(--color-text);
	}

	.share-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-bottom: 0.85rem;
	}

	.share-copy-btn {
		padding: 0.45rem 1.4rem;
		border: 1px solid #ffae2e;
		border-radius: 8px;
		background: #ffae2e;
		color: #241202;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		cursor: pointer;
		box-shadow: 0 0 10px color-mix(in srgb, #ffae2e 45%, transparent);
		transition:
			transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.15s ease;
	}

	.share-copy-btn:hover {
		box-shadow: 0 0 16px color-mix(in srgb, #ffae2e 65%, transparent);
	}

	.share-copy-btn:active {
		transform: scale(0.95);
		transition:
			transform 0.1s ease-out,
			box-shadow 0.15s ease;
	}

	.share-copied-note {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-success);
	}

	.share-copied-note[hidden] {
		display: none;
	}

	.share-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
	}

	.share-link {
		padding: 0.4rem 1rem;
		border: 1px solid #ffae2e;
		border-radius: 999px;
		color: #ffae2e;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.share-link:hover {
		background: #ffae2e;
		color: #241202;
	}

	.share-native-btn {
		display: block;
		margin: 0.85rem auto 0;
		padding: 0.35rem 0.9rem;
		border: none;
		background: none;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
		cursor: pointer;
	}

	.share-native-btn:hover {
		color: var(--color-text);
	}

	.share-native-btn[hidden] {
		display: none;
	}
</style>

<script>
	import { createHammingGame } from "../lib/hammingGame";
	import { getLocalDateString, generateDailySecrets } from "../lib/dailySeed";
	import {
		roundScore,
		formatResultSequence,
		formatTotalLine,
		totalScore,
		buildShareText,
		type RoundResult,
	} from "../lib/quickByteScoring";

	// Result storage is browser-local only for now (no accounts yet), keyed by the
	// player's local calendar day. Cross-device sync will come later once accounts exist.
	const STORAGE_PREFIX = "logicdash:quickbyte:";
	const PROGRESS_PREFIX = "logicdash:quickbyte:progress:";

	const BIT_LENGTH = 5;
	const MAX_ATTEMPTS = 6;
	const ROUND_COUNT = 3;

	interface QuickByteResult {
		perRound: RoundResult[];
		total: number | null;
		completedAt: string;
	}

	// Saved after every single guess (not just on full completion) so navigating away
	// mid-round and coming back restores exactly where the player left off — same round,
	// same guess history, same attempts remaining. Cleared once the day is fully complete.
	interface QuickByteProgress {
		roundIndex: number;
		completedRounds: RoundResult[];
		guessesThisRound: string[];
	}

	const dateString = getLocalDateString();
	const storageKey = STORAGE_PREFIX + dateString;
	const progressKey = PROGRESS_PREFIX + dateString;

	const playSection = document.querySelector<HTMLElement>(".quick-byte-play")!;
	const roundLabel = document.querySelector<HTMLElement>(".quick-byte-round-label")!;
	const nextButton = document.querySelector<HTMLButtonElement>(".quick-byte-next")!;
	const resultsSection = document.querySelector<HTMLElement>(".quick-byte-results")!;
	const sequenceEl = document.querySelector<HTMLElement>(".quick-byte-sequence")!;
	const totalEl = document.querySelector<HTMLElement>(".quick-byte-total")!;
	const shareButton = document.querySelector<HTMLButtonElement>(".quick-byte-share")!;
	const shareOverlay = document.querySelector<HTMLElement>(".share-modal-overlay")!;
	const shareModalCloseBtn = document.querySelector<HTMLButtonElement>(".share-modal-close")!;
	const sharePreviewDate = document.querySelector<HTMLElement>(".share-preview-date")!;
	const sharePreviewSequence = document.querySelector<HTMLElement>(".share-preview-sequence")!;
	const shareCopyBtn = document.querySelector<HTMLButtonElement>(".share-copy-btn")!;
	const shareCopiedNote = document.querySelector<HTMLElement>(".share-copied-note")!;
	const shareTwitterLink = document.querySelector<HTMLAnchorElement>(".share-link--twitter")!;
	const shareWhatsappLink = document.querySelector<HTMLAnchorElement>(".share-link--whatsapp")!;
	const shareNativeBtn = document.querySelector<HTMLButtonElement>(".share-native-btn")!;

	// Set whenever results are shown (either just now, or on revisiting an already-completed
	// day), so the share button always has the right scores regardless of which path ran.
	let resultScores: RoundResult[] = [];

	function renderSharePreview(scores: RoundResult[]) {
		sharePreviewDate.textContent = `Quick Byte — ${dateString.replaceAll("-", ".")}`;
		sharePreviewSequence.textContent = `${formatResultSequence(scores)}   ${formatTotalLine(scores)}`;
	}

	function openShareModal() {
		renderSharePreview(resultScores);
		const shareText = buildShareText(dateString, resultScores);
		const encoded = encodeURIComponent(shareText);
		shareTwitterLink.href = `https://twitter.com/intent/tweet?text=${encoded}`;
		shareWhatsappLink.href = `https://wa.me/?text=${encoded}`;
		// navigator.share's presence isn't a reliable "this is a phone" signal — some desktop
		// browsers (e.g. Windows Edge/Chrome) support it too. So the modal is always the
		// primary path; this button is just an optional extra, offered only when supported,
		// and only triggered by an explicit tap — never automatically.
		shareNativeBtn.hidden = !navigator.share;
		shareOverlay.hidden = false;
	}

	function closeShareModal() {
		shareOverlay.hidden = true;
	}

	shareButton.addEventListener("click", () => {
		openShareModal();
	});

	shareNativeBtn.addEventListener("click", () => {
		const shareText = buildShareText(dateString, resultScores);
		navigator.share({ text: shareText }).catch(() => {});
	});

	shareModalCloseBtn.addEventListener("click", closeShareModal);

	shareOverlay.addEventListener("click", (event) => {
		if (event.target === shareOverlay) closeShareModal();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && !shareOverlay.hidden) closeShareModal();
	});

	let copiedNoteTimeout: ReturnType<typeof setTimeout> | undefined;

	shareCopyBtn.addEventListener("click", async () => {
		try {
			await navigator.clipboard.writeText(buildShareText(dateString, resultScores));
			shareCopiedNote.hidden = false;
			clearTimeout(copiedNoteTimeout);
			copiedNoteTimeout = setTimeout(() => {
				shareCopiedNote.hidden = true;
			}, 1500);
		} catch {
			// Clipboard access denied or unavailable — the preview text is still visible
			// and selectable by hand.
		}
	});

	function readStoredResult(): QuickByteResult | null {
		try {
			const raw = localStorage.getItem(storageKey);
			if (!raw) return null;
			return JSON.parse(raw) as QuickByteResult;
		} catch {
			return null;
		}
	}

	function storeResult(result: QuickByteResult) {
		try {
			localStorage.setItem(storageKey, JSON.stringify(result));
			localStorage.removeItem(progressKey);
		} catch {
			// localStorage unavailable (private browsing, quota, etc.) — the result just
			// won't persist across reloads; gameplay itself is unaffected.
		}
	}

	function readProgress(): QuickByteProgress | null {
		try {
			const raw = localStorage.getItem(progressKey);
			if (!raw) return null;
			return JSON.parse(raw) as QuickByteProgress;
		} catch {
			return null;
		}
	}

	function storeProgress(progress: QuickByteProgress) {
		try {
			localStorage.setItem(progressKey, JSON.stringify(progress));
		} catch {
			// Same as storeResult — persistence is best-effort, not required for gameplay.
		}
	}

	function showResults(perRound: RoundResult[]) {
		resultScores = perRound;
		playSection.hidden = true;
		resultsSection.hidden = false;
		sequenceEl.textContent = formatResultSequence(perRound);
		totalEl.textContent = formatTotalLine(perRound);
	}

	const alreadyPlayed = readStoredResult();

	if (alreadyPlayed) {
		showResults(alreadyPlayed.perRound);
	} else {
		const secrets = generateDailySecrets(dateString, BIT_LENGTH, ROUND_COUNT);
		const savedProgress = readProgress();

		const perRound: RoundResult[] = savedProgress?.completedRounds ?? [];
		let roundIndex = Math.min(Math.max(savedProgress?.roundIndex ?? 0, 0), ROUND_COUNT - 1);
		let guessesThisRound: string[] = savedProgress ? [...savedProgress.guessesThisRound] : [];

		function updateRoundLabel() {
			roundLabel.textContent = `Round ${roundIndex + 1} of ${ROUND_COUNT}`;
		}

		function persistProgress() {
			storeProgress({ roundIndex, completedRounds: perRound, guessesThisRound });
		}

		const board = document.querySelector<HTMLElement>(".hamming-game")!;
		const controller = createHammingGame(board, {
			bitLength: BIT_LENGTH,
			maxAttempts: MAX_ATTEMPTS,
			secret: secrets[roundIndex],
			showPlayAgain: false,
			onGuess: ({ bits }) => {
				guessesThisRound.push(bits);
				persistProgress();
			},
			onRoundEnd: ({ won, attempts }) => {
				// Guard against double-counting: replaying a round that had already ended
				// before the player navigated away re-fires this same callback. Only record
				// a score the first time this round finishes (i.e. no score for it yet).
				if (perRound.length === roundIndex) {
					perRound.push(roundScore(won, attempts));
				}
				nextButton.textContent = roundIndex < ROUND_COUNT - 1 ? "Next Round" : "See Results";
				nextButton.hidden = false;
			},
		});

		updateRoundLabel();

		if (guessesThisRound.length > 0) {
			// Fast-forward the fresh board to exactly where the player left off. This
			// replays through the same guess logic used for real play, so it naturally
			// re-triggers onRoundEnd (and shows Next/See Results) if that round had
			// already been finished when the player navigated away.
			const toReplay = guessesThisRound;
			guessesThisRound = [];
			controller.restore(toReplay);
		}

		nextButton.addEventListener("click", () => {
			nextButton.hidden = true;
			if (roundIndex < ROUND_COUNT - 1) {
				roundIndex++;
				guessesThisRound = [];
				persistProgress();
				updateRoundLabel();
				controller.reset(secrets[roundIndex]);
			} else {
				storeResult({ perRound, total: totalScore(perRound), completedAt: new Date().toISOString() });
				showResults(perRound);
			}
		});
	}
</script>
