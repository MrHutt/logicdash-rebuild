  "name": "LogicDash production preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    4323
  ],
  "portsAttributes": {
    "4323": {
      "label": "LogicDash production preview",
      "onAutoForward": "openBrowser"
    }
